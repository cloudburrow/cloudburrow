+// CloudBurrow (#2029): PROPERTY_EXISTS, as Spanner documents it.
+TEST_P(QueryEngineTest, GqlPropertyExists) {
+  if (GetParam() == database_api::DatabaseDialect::POSTGRESQL) {
+    GTEST_SKIP();
+  }
+  Query query{"GRAPH test_graph MATCH (a)-[e]->(b) WHERE a.id = 1 "
+            "RETURN PROPERTY_EXISTS(a, id) AS on_node, "
+            "PROPERTY_EXISTS(e, id) AS on_edge, b.id AS b_id ORDER BY b_id"};
+  GOOGLESQL_ASSERT_OK_AND_ASSIGN(
+      QueryResult result,
+      query_engine().ExecuteSql(query, QueryContext{property_graph_schema(),
+                                                    property_graph_reader()}));
+
+  ASSERT_NE(result.rows, nullptr);
+  EXPECT_THAT(GetAllColumnValues(std::move(result.rows)),
+              IsOkAndHolds(ElementsAre(
+                  ElementsAre(Bool(true), Bool(false), Int64(2)),
+                  ElementsAre(Bool(true), Bool(false), Int64(4)))));
+}
+
+// CloudBurrow (#2029): COUNT of a group variable (horizontal aggregation).
+TEST_P(QueryEngineTest, GqlCountOfGroupVariable) {
+  if (GetParam() == database_api::DatabaseDialect::POSTGRESQL) {
+    GTEST_SKIP();
+  }
+  Query query{"GRAPH test_graph MATCH (a {id: 1})-[e]->{1,2}(b) "
+            "LET hops = COUNT(e) RETURN b.id AS b_id, hops ORDER BY b_id, hops"};
+  GOOGLESQL_ASSERT_OK_AND_ASSIGN(
+      QueryResult result,
+      query_engine().ExecuteSql(query, QueryContext{property_graph_schema(),
+                                                    property_graph_reader()}));
+
+  ASSERT_NE(result.rows, nullptr);
+  EXPECT_THAT(GetAllColumnValues(std::move(result.rows)),
+              IsOkAndHolds(ElementsAre(ElementsAre(Int64(1), Int64(2)),
+                                       ElementsAre(Int64(2), Int64(1)),
+                                       ElementsAre(Int64(4), Int64(1)),
+                                       ElementsAre(Int64(4), Int64(2)))));
+}
+
+// CloudBurrow (#2029): ANY CHEAPEST with an edge COST.
+TEST_P(QueryEngineTest, GqlAnyCheapest) {
+  if (GetParam() == database_api::DatabaseDialect::POSTGRESQL) {
+    GTEST_SKIP();
+  }
+  Query query{"GRAPH test_graph MATCH ANY CHEAPEST "
+            "(a {id: 1})-[e COST e.to_id]->{1,2}(b) "
+            "LET cost = SUM(e.to_id) RETURN b.id AS b_id, cost ORDER BY b_id"};
+  GOOGLESQL_ASSERT_OK_AND_ASSIGN(
+      QueryResult result,
+      query_engine().ExecuteSql(query, QueryContext{property_graph_schema(),
+                                                    property_graph_reader()}));
+
+  ASSERT_NE(result.rows, nullptr);
+  EXPECT_THAT(GetAllColumnValues(std::move(result.rows)),
+              IsOkAndHolds(ElementsAre(ElementsAre(Int64(1), Int64(5)),
+                                       ElementsAre(Int64(2), Int64(2)),
+                                       ElementsAre(Int64(4), Int64(4)))));
+}
