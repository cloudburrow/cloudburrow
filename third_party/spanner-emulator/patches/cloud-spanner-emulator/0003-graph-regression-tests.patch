+// CloudBurrow (#2029): a GQL RETURN ... ORDER BY keeps its order.
+TEST_P(QueryEngineTest, GqlReturnOrderByKeepsItsOrder) {
+  if (GetParam() == database_api::DatabaseDialect::POSTGRESQL) {
+    GTEST_SKIP();
+  }
+  Query query{"GRAPH test_graph MATCH (a) RETURN a.id AS node_id ORDER BY node_id"};
+  GOOGLESQL_ASSERT_OK_AND_ASSIGN(
+      QueryResult result,
+      query_engine().ExecuteSql(query, QueryContext{property_graph_schema(),
+                                                    property_graph_reader()}));
+
+  ASSERT_NE(result.rows, nullptr);
+  EXPECT_THAT(GetAllColumnValues(std::move(result.rows)),
+              IsOkAndHolds(ElementsAre(ElementsAre(Int64(1)), ElementsAre(Int64(2)),
+                                       ElementsAre(Int64(4)))));
+}
+
+TEST_P(QueryEngineTest, GqlReturnOrderByDescKeepsItsOrder) {
+  if (GetParam() == database_api::DatabaseDialect::POSTGRESQL) {
+    GTEST_SKIP();
+  }
