@@ -0,0 +1,186 @@
+package googlesql
+
+// CloudBurrow patch (cloudburrow/cloudburrow#2134): a generated method
+// copies its handles' C++ pointers into its request and then waits for the
+// module's lock; a handle with no Go use after that copy could be
+// finalized in between, and its C++ object freed, before the call read
+// it. CloudBurrow's build rewrites the bindings (tools/bqengine,
+// keepalive.go) so that every method keeps its receiver and its handle
+// arguments alive until its call has returned, with each finalizer on the
+// struct that holds the pointer. These tests force a collection in that
+// gap, through testHookBeforeCall, and fail if the handle's free reached
+// the module before the call did.
+
+import (
+	"bytes"
+	"errors"
+	"runtime"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// gcSentinel has a pointer, so it is never tiny-allocated (a tiny object's
+// finalizer may never run).
+type gcSentinel struct {
+	p *int
+	_ [16]byte
+}
+
+// collectAndFinalize runs the garbage collector until the finalizers
+// queued by its first cycle have run: the runtime runs finalizers on one
+// goroutine, a cycle's queue before the next's, so once a sentinel queued
+// by a later cycle has been finalized, every earlier one has been too.
+func collectAndFinalize(t *testing.T) {
+	t.Helper()
+	runtime.GC()
+	for i := 0; i < 2; i++ {
+		done := make(chan struct{})
+		s := &gcSentinel{}
+		runtime.SetFinalizer(s, func(*gcSentinel) { close(done) })
+		s = nil
+		runtime.GC()
+		select {
+		case <-done:
+		case <-time.After(10 * time.Second):
+			t.Fatalf("a sentinel's finalizer did not run within 10s")
+		}
+	}
+}
+
+var errFreedBeforeCall = errors.New("the handle was freed before the call that reads it ran")
+
+// freedMidCall arms the hooks for the next call whose request carries the
+// C++ pointer ptr: in the gap before it runs, the collector runs and
+// every pending finalizer with it, and if a request freeing ptr reached
+// the module meanwhile, the call is not made and returns
+// errFreedBeforeCall. ptr is all it holds of the handle.
+func freedMidCall(t *testing.T, ptr uint64) (hooked *atomic.Bool) {
+	t.Helper()
+	if ptr == 0 {
+		t.Fatal("the handle has no C++ object")
+	}
+	// A handle travels as the submessage {1: ptr}; its free's request is
+	// that alone.
+	field := pbAppendUint64(nil, 1, ptr)
+	freeReq := pbAppendHandle(nil, 1, ptr)
+	var armed, waiting, freed atomic.Bool
+	hooked = new(atomic.Bool)
+	armed.Store(true)
+	before := func(_, _ int32, req []byte) error {
+		if !bytes.Contains(req, field) || !armed.CompareAndSwap(true, false) {
+			return nil
+		}
+		hooked.Store(true)
+		// While the method waits here, any request carrying ptr alone
+		// is a free: the method's own request has not been sent.
+		waiting.Store(true)
+		collectAndFinalize(t)
+		waiting.Store(false)
+		if freed.Load() {
+			return errFreedBeforeCall
+		}
+		return nil
+	}
+	invoke := func(_, _ int32, req []byte) {
+		if waiting.Load() && bytes.Equal(req, freeReq) {
+			freed.Store(true)
+		}
+	}
+	testHookBeforeCall.Store(&before)
+	testHookInvoke.Store(&invoke)
+	t.Cleanup(func() {
+		testHookBeforeCall.Store(nil)
+		testHookInvoke.Store(nil)
+	})
+	return hooked
+}
+
+func mustNoErr(t *testing.T, what string, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatalf("%s: %v", what, err)
+	}
+}
+
+func checkCall(t *testing.T, hooked *atomic.Bool, err error) {
+	t.Helper()
+	if !hooked.Load() {
+		t.Fatal("the hook never saw the call: the test does not test the gap")
+	}
+	if errors.Is(err, errFreedBeforeCall) {
+		t.Fatal(err)
+	}
+	if err != nil {
+		t.Fatalf("call: %v", err)
+	}
+}
+
+// newLanguageOptionsPtr returns a LanguageOptions that only the caller
+// holds, and its C++ pointer.
+func newLanguageOptionsPtr(t *testing.T) (*LanguageOptions, uint64) {
+	t.Helper()
+	lo, err := NewLanguageOptions()
+	mustNoErr(t, "NewLanguageOptions", err)
+	return lo, lo.ptr
+}
+
+// The receiver, whose class has the pointer itself.
+func TestKeepAliveReceiver(t *testing.T) {
+	ensureInit(t)
+	lo, ptr := newLanguageOptionsPtr(t)
+	hooked := freedMidCall(t, ptr)
+	err := lo.EnableMaximumLanguageFeatures() // lo's last use
+	checkCall(t, hooked, err)
+}
+
+// A receiver of a base class's method: FullName is Catalog's, and the
+// SimpleCatalog wrapper that embeds it is not the receiver.
+func TestKeepAliveBaseClassReceiver(t *testing.T) {
+	ensureInit(t)
+	tf, err := NewTypeFactory()
+	mustNoErr(t, "NewTypeFactory", err)
+	c, err := NewSimpleCatalog("keepalive", tf)
+	mustNoErr(t, "NewSimpleCatalog", err)
+	// What c.FullName() passes: the receiver is the embedded wrapper, and
+	// c has no use after this.
+	cat := c.EnumerableCatalog.Catalog
+	hooked := freedMidCall(t, cat.ptr)
+	_, err = cat.FullName()
+	checkCall(t, hooked, err)
+	runtime.KeepAlive(tf)
+}
+
+// A handle argument.
+func TestKeepAliveArgument(t *testing.T) {
+	ensureInit(t)
+	tf, err := NewTypeFactory()
+	mustNoErr(t, "NewTypeFactory", err)
+	i64, err := tf.GetInt64()
+	mustNoErr(t, "GetInt64", err)
+	at, err := tf.MakeArrayType(i64)
+	mustNoErr(t, "MakeArrayType", err)
+	lo, ptr := newLanguageOptionsPtr(t)
+	hooked := freedMidCall(t, ptr)
+	_, err = at.IsSupportedType(lo) // lo's last use
+	checkCall(t, hooked, err)
+	runtime.KeepAlive(at)
+	runtime.KeepAlive(tf)
+}
+
+// A handle inside an options struct: newSimpleCatalog's LanguageOptions
+// in googlesqlite, which hung main CI (#2134).
+func TestKeepAliveHandleInOptions(t *testing.T) {
+	ensureInit(t)
+	tf, err := NewTypeFactory()
+	mustNoErr(t, "NewTypeFactory", err)
+	c, err := NewSimpleCatalog("keepalive", tf)
+	mustNoErr(t, "NewSimpleCatalog", err)
+	lo, ptr := newLanguageOptionsPtr(t)
+	mustNoErr(t, "EnableMaximumLanguageFeatures", lo.EnableMaximumLanguageFeatures())
+	hooked := freedMidCall(t, ptr)
+	err = c.AddGoogleSQLFunctions2(&BuiltinFunctionOptions{LanguageOptions: lo}) // lo's last use
+	checkCall(t, hooked, err)
+	runtime.KeepAlive(c)
+	runtime.KeepAlive(tf)
+}
