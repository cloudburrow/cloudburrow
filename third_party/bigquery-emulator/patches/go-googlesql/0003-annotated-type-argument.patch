+package googlesql
+
+import (
+	"encoding/binary"
+
+	wasm2go "github.com/goccy/googlesqlwasm2go"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1508): the C++ bridge reads
+// an AnnotatedType argument as a handle, a pointer to a C++
+// AnnotatedType { const Type* type; const AnnotationMap* annotation_map; }
+// in wasm memory, which it copies. The generated binding marshaled it as
+// a value message of two handles, so the bridge took the first handle
+// (the annotation map) for the struct: the column's type was the map's
+// vtable pointer and its annotation map a word of the map, and reading
+// either called through a null function pointer ("wasm trap: interface
+// conversion: interface {} is nil"). appendAnnotatedTypeArg lays the
+// struct out in wasm memory and appends its handle; free releases it
+// once the call has copied it.
+func appendAnnotatedTypeArg(buf []byte, field uint32, v *AnnotatedType) (out []byte, free func()) {
+	if v == nil {
+		return buf, func() {}
+	}
+	var typ, am uint32
+	if v.Type_ != nil {
+		typ = uint32(v.Type_.rawPtr())
+	}
+	if v.AnnotationMap != nil {
+		am = uint32(v.AnnotationMap.ptr)
+	}
+	m := module()
+	m.mu.Lock()
+	ptr := wasm2go.WasmAlloc(m.g, 8)
+	mem := wasm2go.Memory(m.g)
+	binary.LittleEndian.PutUint32(mem[uint32(ptr):], typ)
+	binary.LittleEndian.PutUint32(mem[uint32(ptr)+4:], am)
+	m.mu.Unlock()
+	return pbAppendHandle(buf, field, uint64(uint32(ptr))), func() {
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		wasm2go.WasmFree(m.g, ptr)
+	}
+}
