+package googlesql_test
+
+import (
+	"testing"
+
+	"github.com/goccy/go-googlesql"
+)
+
+// TestSimpleColumnAnnotatedType is CloudBurrow patch 3's regression test
+// (cloudburrow/cloudburrow#1508): a column built from an AnnotatedType
+// reads back its type and annotation map, and a query reading it
+// analyzes. Before the patch the column's type was garbage ("unknown C++
+// type") and analyzing `SELECT s` trapped "interface conversion:
+// interface {} is nil".
+func TestSimpleColumnAnnotatedType(t *testing.T) {
+	t.Cleanup(gc)
+	catalog, opts, tf, _ := setupAnalyzer(t)
+	st, err := tf.GetString()
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := googlesql.NewCollationMakeScalar("und:ci")
+	if err != nil {
+		t.Fatal(err)
+	}
+	am, err := c.ToAnnotationMap(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if am, err = tf.TakeOwnership(am, true); err != nil {
+		t.Fatal(err)
+	}
+	table, err := googlesql.NewSimpleTable("users", 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	col, err := googlesql.NewSimpleColumn2("users", "s", &googlesql.AnnotatedType{AnnotationMap: am, Type_: st}, false, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	typ, err := col.GetType()
+	if err != nil {
+		t.Fatalf("GetType: %v", err)
+	}
+	if d, err := typ.DebugString(false); err != nil || d != "STRING" {
+		t.Fatalf("type = %q, %v; want STRING", d, err)
+	}
+	cam, err := col.GetTypeAnnotationMap()
+	if err != nil || cam == nil {
+		t.Fatalf("GetTypeAnnotationMap: %v, %v", cam, err)
+	}
+	if d, err := cam.DebugString(); err != nil || d != `{Collation:"und:ci"}` {
+		t.Fatalf("annotation map = %q, %v", d, err)
+	}
+	if err := table.AddColumn2(col, false); err != nil {
+		t.Fatal(err)
+	}
+	if err := catalog.AddTable(table); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := googlesql.AnalyzeStatement("SELECT s FROM users WHERE s = 'A'", opts, catalog, tf); err != nil {
+		t.Fatalf("AnalyzeStatement: %v", err)
+	}
+}
