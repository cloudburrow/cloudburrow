--- /dev/null
+++ b/utc_time_zone.go
@@ -0,0 +1,37 @@
+package googlesql
+
+import (
+	"sync"
+
+	wasm2go "github.com/goccy/googlesqlwasm2go"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1189): the bindings have no
+// way to build an absl::TimeZone, so AnalyzerOptions.SetDefaultTimeZone
+// could not be called and the analyzer kept its built-in default,
+// America/Los_Angeles. An absl::TimeZone is one pointer to its zone's
+// implementation, and a null one is UTC (cctz: "time_zone() // in effect
+// UTC", utc_time_zone() returns a default-constructed time_zone), so a
+// zeroed block of wasm memory is a TimeZone of UTC. SetDefaultTimeZone
+// copies it; the block is allocated once and never freed.
+
+var (
+	utcTimeZoneOnce sync.Once
+	utcTimeZone     *TimeZone
+)
+
+// UTCTimeZone returns a TimeZone of UTC, for SetDefaultTimeZone.
+func UTCTimeZone() *TimeZone {
+	utcTimeZoneOnce.Do(func() {
+		m := module()
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		// 8 bytes: the 4-byte pointer, rounded up to an alignment that
+		// does not depend on the wasm target's pointer size.
+		ptr := wasm2go.WasmAlloc(m.g, 8)
+		mem := wasm2go.Memory(m.g)
+		clear(mem[uint32(ptr) : uint32(ptr)+8])
+		utcTimeZone = &TimeZone{ptr: uint64(uint32(ptr))}
+	})
+	return utcTimeZone
+}
