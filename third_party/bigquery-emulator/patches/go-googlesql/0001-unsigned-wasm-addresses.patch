+++ b/wasm_high_address_test.go
@@ -0,0 +1,70 @@
+package googlesql
+
+import (
+	"testing"
+
+	wasm2go "github.com/goccy/googlesqlwasm2go"
+)
+
+// TestInvokeAboveTwoGiB is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1061, #989): once the WebAssembly heap grows
+// past 2 GiB, a buffer can sit at an address that is negative as an int32,
+// and the bridge sliced Go's view of wasm memory with that signed value,
+// which panicked "slice bounds out of range [-2147355456:]". It fills the
+// heap below 2 GiB, then makes calls whose request and response buffers
+// must land above it. It needs about 4 GiB of memory, so -short skips it.
+func TestInvokeAboveTwoGiB(t *testing.T) {
+	if testing.Short() {
+		t.Skip("allocates about 4 GiB")
+	}
+	ensureInit(t)
+	m := module()
+	const chunk = 128 << 20
+	var fillers []int32
+	defer func() {
+		m.mu.Lock()
+		for _, p := range fillers {
+			wasm2go.WasmFree(m.g, p)
+		}
+		m.mu.Unlock()
+	}()
+	m.mu.Lock()
+	for {
+		p := wasm2go.WasmAlloc(m.g, chunk)
+		if p == 0 {
+			m.mu.Unlock()
+			t.Fatalf("WasmAlloc(%d) failed with the heap at %d bytes", chunk, len(wasm2go.Memory(m.g)))
+		}
+		fillers = append(fillers, p)
+		if uint64(uint32(p))+chunk > 1<<31 {
+			break
+		}
+	}
+	// The request buffer of ParseStatement, allocated by invoke. Take
+	// same-sized blocks until one is above 2 GiB, then free it: the
+	// allocator hands that block to the next request of the size.
+	req := pbAppendString(nil, 1, "SELECT 1 AS x")
+	req = pbAppendHandlePtr(req, 2, (*ParserOptions)(nil))
+	high := int32(0)
+	for i := 0; i < 1<<16 && high == 0; i++ {
+		p := wasm2go.WasmAlloc(m.g, int32(len(req)))
+		if p < 0 {
+			high = p
+			break
+		}
+		fillers = append(fillers, p)
+	}
+	if high == 0 {
+		m.mu.Unlock()
+		t.Fatal("no allocation landed above 2 GiB")
+	}
+	wasm2go.WasmFree(m.g, high)
+	m.mu.Unlock()
+	out, err := invokeMethod(0, 10, req, wasm2go.Inv_0_10)
+	if err != nil {
+		t.Fatalf("ParseStatement with its request above 2 GiB: %v", err)
+	}
+	if ptr := readPtrAtField(out, 2); ptr == 0 {
+		t.Fatal("ParseStatement above 2 GiB returned no output")
+	}
+}
