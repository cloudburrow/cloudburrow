 	if reqLen > 0 {
 		buf := make([]byte, reqLen)
-		copy(buf, mem[reqPtr:reqPtr+reqLen])
+		// CloudBurrow patch (cloudburrow/cloudburrow#1061, #989): wasm
+		// addresses are unsigned 32-bit; as int32 an address at or past
+		// 2 GiB is negative and slicing with it panics.
+		copy(buf, mem[uint32(reqPtr):uint32(reqPtr)+uint32(reqLen)])
