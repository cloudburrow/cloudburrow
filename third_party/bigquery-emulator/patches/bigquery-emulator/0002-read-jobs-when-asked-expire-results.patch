+// From here to FindDataset, CloudBurrow patch 2 to
+// goccy/bigquery-emulator v0.8.1 (cloudburrow/cloudburrow#1086).
+
+// migrateJobOrder moves the job lists that the projects of a database
+// made before this patch hold into cloudburrow_job_order, and reads the
+// last sequence number used.
+func (r *Repository) migrateJobOrder(ctx context.Context, tx *sql.Tx) error {
+	var last sql.NullInt64
+	if err := tx.QueryRowContext(ctx, "SELECT MAX(seq) FROM cloudburrow_job_order").Scan(&last); err != nil {
+		return fmt.Errorf("failed to read the job order: %w", err)
+	}
+	r.jobSeq = last.Int64
+	rows, err := tx.QueryContext(ctx, "SELECT id, jobIDs FROM projects")
+	if err != nil {
+		return err
+	}
+	lists := map[string][]string{}
+	var order []string
+	for rows.Next() {
+		var (
+			projectID string
+			jobIDs    []interface{}
+		)
+		if err := rows.Scan(&projectID, &jobIDs); err != nil {
+			rows.Close()
+			return err
+		}
+		if len(jobIDs) > 0 {
+			lists[projectID] = r.convertToStrings(jobIDs)
+			order = append(order, projectID)
+		}
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		return err
+	}
+	rows.Close()
+	for _, projectID := range order {
+		for _, id := range lists[projectID] {
+			exists, err := r.jobExists(ctx, tx, projectID, id)
+			if err != nil {
+				return err
+			}
+			if exists {
+				if err := r.addJobOrder(ctx, tx, projectID, id); err != nil {
+					return err
+				}
+			}
+		}
+		if _, err := tx.ExecContext(ctx, "UPDATE projects SET jobIDs = @jobIDs WHERE id = @id",
+			sql.Named("jobIDs", []string{}), sql.Named("id", projectID)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// addJobOrder records a job as its project's newest.
+func (r *Repository) addJobOrder(ctx context.Context, tx *sql.Tx, projectID, jobID string) error {
+	r.jobSeqMu.Lock()
+	r.jobSeq++
+	seq := r.jobSeq
+	r.jobSeqMu.Unlock()
+	_, err := tx.ExecContext(ctx,
+		"INSERT cloudburrow_job_order (projectID, id, seq) VALUES (@projectID, @id, @seq)",
+		sql.Named("projectID", projectID), sql.Named("id", jobID), sql.Named("seq", seq))
+	return err
+}
+
+// jobExists reports whether the jobs table has the job.
+func (r *Repository) jobExists(ctx context.Context, tx *sql.Tx, projectID, jobID string) (bool, error) {
+	rows, err := tx.QueryContext(ctx, "SELECT id FROM jobs WHERE projectID = @projectID AND id = @id",
+		sql.Named("projectID", projectID), sql.Named("id", jobID))
+	if err != nil {
+		return false, err
 	}
+	defer rows.Close()
+	exists := rows.Next()
+	return exists, rows.Err()
+}
+
+// findProjectJobs reads every job of a project with its metadata, not its
+// result, in the order they were added.
+func (r *Repository) findProjectJobs(ctx context.Context, projectID string) ([]*Job, error) {
+	conn, err := r.getConnection(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	tx, err := conn.BeginTx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Commit()
+	rows, err := tx.QueryContext(ctx,
+		"SELECT id FROM cloudburrow_job_order WHERE projectID = @projectID ORDER BY seq",
+		sql.Named("projectID", projectID))
+	if err != nil {
+		return nil, err
+	}
+	var ids []string
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		ids = append(ids, id)
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		return nil, err
+	}
+	rows.Close()
