+package metadata
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	internaltypes "github.com/goccy/bigquery-emulator/internal/types"
+	"github.com/goccy/go-json"
+	_ "github.com/goccy/googlesqlite"
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+)
+
+// CloudBurrow regression tests (cloudburrow/cloudburrow#1086).
+
+func testRepository(t *testing.T) (*Repository, *sql.DB) {
+	t.Helper()
+	f := filepath.Join(t.TempDir(), "db")
+	if err := os.WriteFile(f, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	db, err := sql.Open("googlesqlite", fmt.Sprintf("file:%s?cache=shared", f))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	r, err := NewRepository(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r, db
+}
+
+// inTx runs f in a transaction on a connection of the repository's, as
+// the server's handlers do, and commits it.
+func inTx(t *testing.T, r *Repository, f func(ctx context.Context, tx *sql.Tx) error) {
+	t.Helper()
+	ctx := context.Background()
+	conn, err := r.getConnection(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	tx, err := conn.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f(ctx, tx); err != nil {
+		tx.Rollback()
+		t.Fatal(err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// queryJob is a query job whose result is n rows of one INT64 column.
+func queryJob(r *Repository, id string, n int) *Job {
+	rows := make([]*internaltypes.TableRow, n)
+	for i := range rows {
+		rows[i] = &internaltypes.TableRow{F: []*internaltypes.TableCell{{V: fmt.Sprint(i)}}}
+	}
+	content := &bigqueryv2.Job{
+		JobReference:  &bigqueryv2.JobReference{ProjectId: "p", JobId: id},
+		Configuration: &bigqueryv2.JobConfiguration{Query: &bigqueryv2.JobConfigurationQuery{Query: "SELECT n"}},
+	}
+	response := &internaltypes.QueryResponse{
+		Schema:      &bigqueryv2.TableSchema{Fields: []*bigqueryv2.TableFieldSchema{{Name: "n", Type: "INTEGER"}}},
+		Rows:        rows,
+		TotalRows:   uint64(n),
+		JobComplete: true,
+	}
+	return NewJob(r, "p", id, content, response, nil)
+}
+
+func addJobs(t *testing.T, r *Repository, jobs ...*Job) *Project {
+	t.Helper()
+	ctx := context.Background()
+	project, err := r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+	inTx(t, r, func(ctx context.Context, tx *sql.Tx) error {
+		if project == nil {
+			project = NewProject(r, "p", nil, nil)
+			if err := project.Insert(ctx, tx); err != nil {
+				return err
+			}
+		}
+		for _, j := range jobs {
+			if err := project.AddJob(ctx, tx, j); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+	return project
+}
+
+// Finding a project, which every request does, reads none of its jobs'
+// results: with one job's result made unreadable, the project, the job and
+// the job list are still found, and only reading that result fails. In
+// the upstream emulator FindProject decoded every job's result, so it
+// failed here, and each request got slower with every job kept.
+func TestFindProjectReadsNoJobResults(t *testing.T) {
+	r, db := testRepository(t)
+	addJobs(t, r, queryJob(r, "a", 3), queryJob(r, "b", 2))
+	if _, err := db.Exec("UPDATE jobs SET result = 'not JSON' WHERE id = 'a'"); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	project, err := r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatalf("FindProject read a job's result: %v", err)
+	}
+	job, err := project.Job(ctx, "a")
+	if err != nil || job == nil {
+		t.Fatalf("Job(a) = %v, %v", job, err)
+	}
+	if got := job.Content().JobReference.JobId; got != "a" {
+		t.Errorf("job a's metadata names job %q", got)
+	}
+	if job, err := project.Job(ctx, "nope"); job != nil || err != nil {
+		t.Errorf("Job(nope) = %v, %v, want nil, nil", job, err)
+	}
+	jobs, err := project.Jobs(ctx)
+	if err != nil || len(jobs) != 2 || jobs[0].ID != "a" || jobs[1].ID != "b" || jobs[1].Content() == nil {
+		t.Fatalf("Jobs() = %v, %v, want a and b with their metadata", jobs, err)
+	}
+	if _, err := r.FindJob(ctx, "p", "a"); err == nil {
+		t.Error("reading job a's unreadable result succeeded")
+	}
+	b, err := r.FindJob(ctx, "p", "b")
+	if err != nil || b == nil || len(b.response.Rows) != 2 {
+		t.Fatalf("FindJob(b) = %v, %v, want its 2 rows", b, err)
+	}
+}
+
+// A result is dropped once it is older than ResultsMaxAge, or the oldest
+// first while the results kept pass ResultsMaxBytes, at the next job;
+// Wait then answers ErrResultExpired, the job itself is kept, and a recent
+// job's result is still read.
+func TestResultsExpire(t *testing.T) {
+	clock := time.Date(2026, 9, 28, 0, 0, 0, 0, time.UTC)
+	defer func(n func() time.Time, b int) { now, ResultsMaxBytes = n, b }(now, ResultsMaxBytes)
+	now = func() time.Time { return clock }
+	r, _ := testRepository(t)
+	ctx := context.Background()
+	var project *Project
+	wait := func(id string) (*internaltypes.QueryResponse, error) {
+		t.Helper()
+		project, err := r.FindProject(ctx, "p")
+		if err != nil {
+			t.Fatal(err)
+		}
+		job, err := project.Job(ctx, id)
+		if err != nil || job == nil {
+			t.Fatalf("Job(%s) = %v, %v: the job was not kept", id, job, err)
+		}
+		wctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+		defer cancel()
+		return job.Wait(wctx)
+	}
+
+	addJobs(t, r, queryJob(r, "old", 5))
+	clock = clock.Add(ResultsMaxAge - time.Minute)
+	addJobs(t, r, queryJob(r, "recent", 5))
+	if res, err := wait("old"); err != nil || len(res.Rows) != 5 {
+		t.Fatalf("old, within its age: %v, %v, want 5 rows", res, err)
+	}
+	clock = clock.Add(2 * time.Minute)
+	addJobs(t, r, queryJob(r, "new", 5))
+	if _, err := wait("old"); !errors.Is(err, ErrResultExpired) {
+		t.Fatalf("old, past its age: %v, want ErrResultExpired", err)
+	}
+	for _, id := range []string{"recent", "new"} {
+		if res, err := wait(id); err != nil || len(res.Rows) != 5 {
+			t.Fatalf("%s: %v, %v, want 5 rows", id, res, err)
+		}
+	}
+
+	// By size: room for two and a half results of 1,000 rows.
+	big, err := json.Marshal(queryJob(r, "x", 1000).response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ResultsMaxBytes = 2*len(big) + len(big)/2
+	addJobs(t, r, queryJob(r, "big1", 1000))
+	addJobs(t, r, queryJob(r, "big2", 1000))
+	addJobs(t, r, queryJob(r, "big3", 1000))
+	for id, want := range map[string]error{"recent": ErrResultExpired, "new": ErrResultExpired, "big1": ErrResultExpired, "big2": nil, "big3": nil} {
+		if _, err := wait(id); !errors.Is(err, want) {
+			t.Errorf("%s: %v, want %v", id, err, want)
+		}
+	}
+	// The newest is kept, however large.
+	ResultsMaxBytes = 1
+	addJobs(t, r, queryJob(r, "huge", 2000))
+	if res, err := wait("huge"); err != nil || len(res.Rows) != 2000 {
+		t.Errorf("huge: %v, %v, want its 2000 rows", res, err)
+	}
+
+	// A deleted job's result no longer counts.
+	project, err = r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+	inTx(t, r, func(ctx context.Context, tx *sql.Tx) error { return project.DeleteJob(ctx, tx, "huge") })
+	if r.resultsBytes != 0 || len(r.results) != 0 {
+		t.Errorf("after the only kept job was deleted: %d results, %d bytes kept", len(r.results), r.resultsBytes)
+	}
+}
+
+// The project's row no longer lists its jobs, which it wrote again at each
+// job; the jobs table and cloudburrow_job_order say which exist, and in
+// what order jobs.list gives them.
+func TestJobsKeepTheirOrder(t *testing.T) {
+	r, db := testRepository(t)
+	ctx := context.Background()
+	addJobs(t, r, queryJob(r, "c", 1))
+	addJobs(t, r, queryJob(r, "a", 1), queryJob(r, "b", 1))
+	ids := func() []string {
+		t.Helper()
+		project, err := r.FindProject(ctx, "p")
+		if err != nil {
+			t.Fatal(err)
+		}
+		jobs, err := project.Jobs(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var ids []string
+		for _, j := range jobs {
+			ids = append(ids, j.ID)
+		}
+		return ids
+	}
+	if got := fmt.Sprint(ids()); got != "[c a b]" {
+		t.Errorf("jobs = %s, want [c a b]", got)
+	}
+	var listed []interface{}
+	if err := db.QueryRow("SELECT jobIDs FROM projects WHERE id = 'p'").Scan(&listed); err != nil || len(listed) != 0 {
+		t.Errorf("the project's row lists jobs %v (%v)", listed, err)
+	}
+	project, err := r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+	inTx(t, r, func(ctx context.Context, tx *sql.Tx) error { return project.DeleteJob(ctx, tx, "a") })
+	if got := fmt.Sprint(ids()); got != "[c b]" {
+		t.Errorf("jobs after deleting a = %s, want [c b]", got)
+	}
+	project, err = r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn, err := r.getConnection(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	tx, err := conn.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback()
+	if err := project.AddJob(ctx, tx, queryJob(r, "b", 1)); err == nil {
+		t.Error("a second job b was added")
+	}
+	if err := project.DeleteJob(ctx, tx, "a"); err == nil {
+		t.Error("job a, deleted, was deleted again")
+	}
+}
+
+// A database the unpatched emulator made lists its jobs in the project's
+// row; they are moved to cloudburrow_job_order, in that order.
+func TestJobOrderMigrates(t *testing.T) {
+	_, db := testRepository(t)
+	for _, q := range []string{
+		"INSERT projects (id, datasetIDs, jobIDs) VALUES ('p', [], ['y', 'gone', 'x'])",
+		`INSERT jobs (id, projectID, metadata, result, error) VALUES ('x', 'p', '{}', 'null', '')`,
+		`INSERT jobs (id, projectID, metadata, result, error) VALUES ('y', 'p', '{}', 'null', '')`,
+	} {
+		if _, err := db.Exec(q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	r, err := NewRepository(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	project, err := r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+	jobs, err := project.Jobs(ctx)
+	if err != nil || len(jobs) != 2 || jobs[0].ID != "y" || jobs[1].ID != "x" {
+		t.Fatalf("Jobs() = %v, %v, want y and x", jobs, err)
+	}
+	addJobs(t, r, queryJob(r, "z", 1))
+	if jobs, err := project.Jobs(ctx); err != nil || len(jobs) != 3 || jobs[2].ID != "z" {
+		t.Errorf("Jobs() after z = %v, %v, want y, x, z", jobs, err)
+	}
+}
