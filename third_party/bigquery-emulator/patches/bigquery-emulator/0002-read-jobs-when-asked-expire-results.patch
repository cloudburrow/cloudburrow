+
+func (r *Repository) findJobsMetadataTx(ctx context.Context, tx *sql.Tx, projectID string, jobIDs []string) ([]*Job, error) {
+	if len(jobIDs) == 0 {
+		return nil, nil
+	}
+	rows, err := tx.QueryContext(
+		ctx,
+		"SELECT id, metadata, error FROM jobs WHERE projectID = @projectID AND id IN UNNEST(@jobIDs)",
+		sql.Named("projectID", projectID),
+		sql.Named("jobIDs", jobIDs),
+	)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	byID := make(map[string]*Job, len(jobIDs))
+	for rows.Next() {
+		var jobID, metadata, jobErr string
+		if err := rows.Scan(&jobID, &metadata, &jobErr); err != nil {
+			return nil, err
+		}
+		var content bigqueryv2.Job
+		if len(metadata) > 0 {
+			if err := json.Unmarshal([]byte(metadata), &content); err != nil {
+				return nil, fmt.Errorf("failed to decode metadata content %s: %w", metadata, err)
+			}
+		}
+		var resErr error
+		if jobErr != "" {
+			resErr = errors.New(jobErr)
+		}
+		byID[jobID] = NewJob(r, projectID, jobID, &content, nil, resErr)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	jobs := make([]*Job, 0, len(byID))
+	for _, id := range jobIDs {
+		if job := byID[id]; job != nil {
+			jobs = append(jobs, job)
+		}
+	}
+	return jobs, nil
+}
+
+// A query job's result rows are kept in its row of the jobs table, for
+// jobs.getQueryResults, for as long as BigQuery keeps a query's result,
+// "up to 24 hours" and best-effort
+// (https://cloud.google.com/bigquery/docs/writing-results#temporary_and_permanent_tables),
+// and while the results kept come to at most ResultsMaxBytes of JSON,
+// the oldest dropped first; a dropped result is replaced by expiredResult,
+// and Wait answers ErrResultExpired for it. The job itself is kept, as
+// BigQuery keeps a job's history.
+var (
+	ResultsMaxAge   = 24 * time.Hour
+	ResultsMaxBytes = 256 << 20
+	// now is the clock, for a test.
+	now = time.Now
+)
+
+// expiredResult stands in the jobs table for a result dropped; it is not
+// JSON, so no result is ever read as it.
+const expiredResult = "cloudburrow:expired"
+
+type keptResult struct {
+	projectID, jobID string
+	bytes            int
+	at               time.Time
+}
+
+// keepResult records the result a job's row now holds, of n bytes of
+// JSON, and drops those past ResultsMaxAge or ResultsMaxBytes in the same
+// transaction.
+func (r *Repository) keepResult(ctx context.Context, tx *sql.Tx, job *Job, n int) error {
+	if job.response == nil {
+		return nil
+	}
+	r.resultsMu.Lock()
+	r.results = append(r.results, keptResult{projectID: job.ProjectID, jobID: job.ID, bytes: n, at: now()})
+	r.resultsBytes += n
+	var due []keptResult
+	cutoff := now().Add(-ResultsMaxAge)
+	// The newest is kept whatever its size, so a job's own answer is.
+	for len(r.results) > 1 && (r.results[0].at.Before(cutoff) || r.resultsBytes > ResultsMaxBytes) {
+		due = append(due, r.results[0])
+		r.resultsBytes -= r.results[0].bytes
+		r.results = r.results[1:]
+	}
+	r.resultsMu.Unlock()
+	for _, k := range due {
+		if _, err := tx.ExecContext(
+			ctx,
+			"UPDATE jobs SET result = @result WHERE projectID = @projectID AND id = @id",
+			sql.Named("result", expiredResult),
+			sql.Named("projectID", k.projectID),
+			sql.Named("id", k.jobID),
+		); err != nil {
+			return fmt.Errorf("failed to expire the result of job %s: %w", k.jobID, err)
+		}
+	}
 	return nil
+}
+
+// forgetResult forgets a job's kept result, as its row is deleted or
+// written again.
+func (r *Repository) forgetResult(projectID, jobID string) {
+	r.resultsMu.Lock()
+	defer r.resultsMu.Unlock()
+	for i, k := range r.results {
+		if k.projectID == projectID && k.jobID == jobID {
+			r.resultsBytes -= k.bytes
+			r.results = append(r.results[:i:i], r.results[i+1:]...)
+			return
+		}
+	}
 }
 
