 // (cloudburrow/cloudburrow#1456).
 const DefaultTimeZoneHeader = "X-Cloudburrow-Default-Time-Zone"
 
+// JobIDPrefixHeader carries a prefix for the IDs of the jobs a request
+// makes when it names none: a jobs.query's, and a jobs.insert's without a
+// jobReference.jobId. CloudBurrow's front sends it with the queries it
+// runs itself, so that their jobs are known as the front's for as long
+// as they are kept. CloudBurrow patch (cloudburrow/cloudburrow#1555).
+const JobIDPrefixHeader = "X-Cloudburrow-Job-Id-Prefix"
+
+type jobIDPrefixKey struct{}
+
+// validJobIDPrefix reports whether p may begin a job ID: BigQuery's "only
+// letters (a-z, A-Z), numbers (0-9), underscores (_), or dashes (-)", and
+// at most 64 of them.
+func validJobIDPrefix(p string) bool {
+	if p == "" || len(p) > 64 {
+		return false
+	}
+	for _, c := range p {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '-') {
+			return false
+		}
+	}
+	return true
+}
+
+// newJobID is a job ID the engine makes for a job of ctx's request: a
+// random one, after the request's JobIDPrefixHeader if it sent one.
+func newJobID(ctx context.Context) string {
+	prefix, _ := ctx.Value(jobIDPrefixKey{}).(string)
+	return prefix + randomID()
+}
