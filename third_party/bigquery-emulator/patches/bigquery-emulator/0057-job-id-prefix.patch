--- /dev/null
+++ b/server/job_id_prefix_test.go
@@ -0,0 +1,94 @@
+package server_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestJobIDPrefixHeader is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1555): CloudBurrow's front kept the IDs of the
+// queries it runs itself in memory alone, so a restarted front listed
+// them as a client's jobs. The engine now begins the ID of a job it makes
+// for a request with the request's X-Cloudburrow-Job-Id-Prefix, which the
+// front sends with its own queries, and the ID is kept with the job.
+func TestJobIDPrefixHeader(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(types.NewProject("test"))); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	base := testServer.URL + "/bigquery/v2/projects/test"
+	post := func(path, prefix string, body any) string {
+		t.Helper()
+		b, _ := json.Marshal(body)
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, base+path, bytes.NewReader(b))
+		req.Header.Set("Content-Type", "application/json")
+		if prefix != "" {
+			req.Header.Set(server.JobIDPrefixHeader, prefix)
+		}
+		resp, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		var got struct {
+			JobReference struct {
+				JobID string `json:"jobId"`
+			} `json:"jobReference"`
+		}
+		if resp.StatusCode != http.StatusOK || json.NewDecoder(resp.Body).Decode(&got) != nil {
+			t.Fatalf("POST %s: %s", path, resp.Status)
+		}
+		return got.JobReference.JobID
+	}
+	query := map[string]any{"query": "SELECT 1", "useLegacySql": false}
+	// A jobReference with no jobId: the emulator reads the reference
+	// without looking for it (#973).
+	insert := map[string]any{"jobReference": map[string]any{"projectId": "test"}, "configuration": map[string]any{"query": query}}
+
+	marked := post("/queries", "_cloudburrow_", query)
+	if !strings.HasPrefix(marked, "_cloudburrow_") || len(marked) <= len("_cloudburrow_") {
+		t.Errorf("jobs.query with the prefix: job %q, want _cloudburrow_ and a random ID", marked)
+	}
+	insertMarked := post("/jobs", "_cloudburrow_", insert)
+	if !strings.HasPrefix(insertMarked, "_cloudburrow_") {
+		t.Errorf("jobs.insert without a jobId, with the prefix: job %q, want it to begin _cloudburrow_", insertMarked)
+	}
+	named := post("/jobs", "_cloudburrow_", map[string]any{"jobReference": map[string]any{"jobId": "mine"},
+		"configuration": map[string]any{"query": query}})
+	if named != "mine" {
+		t.Errorf("jobs.insert naming its job, with the prefix: job %q, want mine", named)
+	}
+	for _, prefix := range []string{"", "bad prefix", "a/b"} {
+		if id := post("/queries", prefix, query); strings.ContainsAny(id, " /") || strings.HasPrefix(id, "_") {
+			t.Errorf("jobs.query with prefix %q: job %q, want a random ID alone", prefix, id)
+		}
+	}
+
+	req, _ := http.NewRequestWithContext(ctx, http.MethodGet, base+"/jobs/"+marked, nil)
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		t.Errorf("jobs.get %s: %s, want the job kept under its ID", marked, resp.Status)
+	}
+}
