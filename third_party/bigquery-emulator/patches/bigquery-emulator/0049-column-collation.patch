--- /dev/null
+++ b/server/collation_test.go
@@ -0,0 +1,82 @@
+package server_test
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"cloud.google.com/go/bigquery"
+	"google.golang.org/api/option"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestCollatedColumn is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1508): a STRING column tables.insert gives the
+// collation 'und:ci' compares case-insensitively; the engine's table had
+// no collation, so `s = 'ABC'` did not match 'Abc'.
+func TestCollatedColumn(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(types.NewProject("test", types.NewDataset("ds")))); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	client, err := bigquery.NewClient(ctx, "test", option.WithEndpoint(testServer.URL), option.WithoutAuthentication())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	if err := client.Dataset("ds").Table("c").Create(ctx, &bigquery.TableMetadata{Schema: bigquery.Schema{
+		{Name: "s", Type: bigquery.StringFieldType, Collation: "und:ci"},
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	job, err := client.Query("INSERT INTO ds.c (s) VALUES ('Abc')").Run(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if status, err := job.Wait(ctx); err != nil || status.Err() != nil {
+		t.Fatalf("insert: %v, %v", err, status.Err())
+	}
+	it, err := client.Query("SELECT COUNT(*) FROM ds.c WHERE s = 'aBC'").Read(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var row []bigquery.Value
+	if err := it.Next(&row); err != nil {
+		t.Fatal(err)
+	}
+	if len(row) != 1 || row[0] != int64(1) {
+		t.Errorf("COUNT(*) WHERE s = 'aBC' = %v, want 1", row)
+	}
+	// A CREATE TABLE column's collation reads back from tables.get.
+	job, err = client.Query("CREATE TABLE ds.d (s STRING, e STRING COLLATE '', n INT64) DEFAULT COLLATE 'und:ci'").Run(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if status, err := job.Wait(ctx); err != nil || status.Err() != nil {
+		t.Fatalf("create: %v, %v", err, status.Err())
+	}
+	md, err := client.Dataset("ds").Table("d").Metadata(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got []string
+	for _, f := range md.Schema {
+		got = append(got, f.Name+"="+f.Collation)
+	}
+	if want := "s=und:ci e= n="; strings.Join(got, " ") != want {
+		t.Errorf("DDL table's collations %q, want %q", strings.Join(got, " "), want)
+	}
+}
