--- /dev/null
+++ b/internal/metadata/cloudburrow_routine.go
@@ -0,0 +1,21 @@
+package metadata
+
+import (
+	"encoding/json"
+
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+)
+
+// Content is the Routine resource kept of r (CloudBurrow patch,
+// cloudburrow/cloudburrow#1522).
+func (r *Routine) Content() (*bigqueryv2.Routine, error) {
+	b, err := json.Marshal(r.metadata)
+	if err != nil {
+		return nil, err
+	}
+	var content bigqueryv2.Routine
+	if err := json.Unmarshal(b, &content); err != nil {
+		return nil, err
+	}
+	return &content, nil
+}
--- /dev/null
+++ b/server/cloudburrow_routines.go
@@ -0,0 +1,57 @@
+package server
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+
+	"github.com/goccy/googlesqlite"
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+
+	"github.com/goccy/bigquery-emulator/internal/metadata"
+)
+
+// keepRoutine records routine, which routines.insert just made in the
+// engine, in the metadata store (CloudBurrow patch,
+// cloudburrow/cloudburrow#1522). The emulator made the function in the
+// engine's catalog alone, so routines.get and routines.list, which read
+// the metadata store, had nothing of it (they were stubs, answering
+// "unsupported"). CloudBurrow's front serves those methods itself, and
+// reads the emulator's when it needs the definition of a function it did
+// not see made: one routines.insert made before the front started, when a
+// deletion of its dataset is kept for undelete. A routine made again
+// under the same ID replaces the one kept. The creation and modification
+// times are the engine's clock, the front's (googlesqlite.Now).
+func keepRoutine(ctx context.Context, server *Server, tx *sql.Tx, projectID string, dataset *metadata.Dataset, routine *bigqueryv2.Routine) error {
+	ref := routine.RoutineReference
+	if ref == nil || ref.RoutineId == "" {
+		return nil
+	}
+	kept := *routine
+	keptRef := *ref
+	if keptRef.ProjectId == "" {
+		keptRef.ProjectId = projectID
+	}
+	if keptRef.DatasetId == "" {
+		keptRef.DatasetId = dataset.ID
+	}
+	kept.RoutineReference = &keptRef
+	now := googlesqlite.Now().UnixMilli()
+	if kept.CreationTime == 0 {
+		kept.CreationTime = now
+	}
+	kept.LastModifiedTime = now
+	b, err := json.Marshal(&kept)
+	if err != nil {
+		return err
+	}
+	var m map[string]interface{}
+	if err := json.Unmarshal(b, &m); err != nil {
+		return err
+	}
+	r := metadata.NewRoutine(server.metaRepo, keptRef.ProjectId, keptRef.DatasetId, keptRef.RoutineId, m)
+	if dataset.Routine(keptRef.RoutineId) != nil {
+		return server.metaRepo.UpdateRoutine(ctx, tx, r)
+	}
+	return server.metaRepo.AddRoutine(ctx, tx, r)
+}
