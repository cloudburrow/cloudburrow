+// JobsAfter returns, as Jobs does, the jobs of the project added after
+// the job after (all of them when after is "" or no job of the project),
+// and those of ids (those added before after first), in the order they
+// were added. CloudBurrow patch
+// (cloudburrow/cloudburrow#1528): a client that has listed the jobs reads
+// only the ones new or changed since, which costs what they cost, not
+// what every job of the project does.
+func (p *Project) JobsAfter(ctx context.Context, after string, ids []string) ([]*Job, error) {
+	return p.repo.findProjectJobsAfter(ctx, p.ID, after, ids)
+}
