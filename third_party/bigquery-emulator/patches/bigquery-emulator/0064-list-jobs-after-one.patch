+// findProjectJobsAfter reads the jobs of projectID added after the job
+// after (Project.JobsAfter), and those of ids, as findProjectJobs reads
+// every job: those of ids added before after first, in the order of ids. CloudBurrow patch (cloudburrow/cloudburrow#1528).
+func (r *Repository) findProjectJobsAfter(ctx context.Context, projectID, after string, ids []string) ([]*Job, error) {
+	conn, err := r.getConnection(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	named := map[string]bool{}
+	for _, id := range ids {
+		named[id] = true
+	}
+	tx, err := conn.BeginTx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Commit()
+	seq := int64(-1) // every job is after none
+	if after != "" {
+		if err := tx.QueryRowContext(ctx,
+			"SELECT seq FROM cloudburrow_job_order WHERE projectID = @projectID AND id = @id",
+			sql.Named("projectID", projectID), sql.Named("id", after)).Scan(&seq); err != nil && !errors.Is(err, sql.ErrNoRows) {
+			return nil, err
+		}
+	}
+	rows, err := tx.QueryContext(ctx,
+		"SELECT id FROM cloudburrow_job_order WHERE projectID = @projectID AND seq > @seq ORDER BY seq",
+		sql.Named("projectID", projectID), sql.Named("seq", seq))
+	if err != nil {
+		return nil, err
+	}
+	var order []string
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			rows.Close()
+			return nil, err
+		}
+		order = append(order, id)
+		delete(named, id)
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		return nil, err
+	}
+	rows.Close()
+	if err := tx.Commit(); err != nil {
+		return nil, err
+	}
+	if len(named) > 0 {
+		// The jobs named before after, in the order they were added.
+		var earlier []string
+		for _, id := range ids {
+			if named[id] {
+				earlier = append(earlier, id)
+				delete(named, id)
+			}
+		}
+		older, err := r.findJobsMetadata(ctx, projectID, earlier)
+		if err != nil {
+			return nil, err
+		}
+		newer, err := r.findJobRowsByID(ctx, conn, projectID, order)
+		if err != nil {
+			return nil, err
+		}
+		return append(older, newer...), nil
+	}
+	return r.findJobRowsByID(ctx, conn, projectID, order)
 }
 
+// findJobRowsByID reads the jobs of ids, in their order, with their
+// metadata and error, as findProjectJobs does, with one SQLite query of
+// their rows. CloudBurrow patch (cloudburrow/cloudburrow#1528).
+func (r *Repository) findJobRowsByID(ctx context.Context, conn *sql.Conn, projectID string, ids []string) ([]*Job, error) {
+	jobs := make([]*Job, 0, len(ids))
+	for len(ids) > 0 {
+		n := min(len(ids), 500)
+		batch := ids[:n]
+		ids = ids[n:]
+		byID := map[string]*jobRow{}
+		err := conn.Raw(func(c interface{}) error {
+			gsqlConn, ok := c.(*googlesqlite.Conn)
+			if !ok {
+				return fmt.Errorf("failed to get *googlesqlite.Conn from %T", c)
+			}
+			encProject, err := googlesqlite.EncodeString(projectID)
+			if err != nil {
+				return err
+			}
+			args := []any{encProject}
+			marks := make([]string, len(batch))
+			for i, id := range batch {
+				enc, err := googlesqlite.EncodeString(id)
+				if err != nil {
+					return err
+				}
+				args = append(args, enc)
+				marks[i] = "?"
+			}
+			rows, err := gsqlConn.QueryRawContext(ctx,
+				"SELECT `id`, `metadata`, `error` FROM `jobs` WHERE `projectID` = ? AND `id` IN ("+strings.Join(marks, ", ")+")", args...)
+			if err != nil {
+				return fmt.Errorf("failed to read the jobs of %s: %w", projectID, err)
+			}
+			defer rows.Close()
+			for rows.Next() {
+				var cols [3]any
+				if err := rows.Scan(&cols[0], &cols[1], &cols[2]); err != nil {
+					return err
+				}
+				var dec [3]string
+				for i, v := range cols {
+					s, _, err := googlesqlite.DecodeString(v)
+					if err != nil {
+						return fmt.Errorf("failed to decode a job of %s: %w", projectID, err)
+					}
+					dec[i] = s
+				}
+				byID[dec[0]] = &jobRow{metadata: dec[1], err: dec[2]}
+			}
+			return rows.Err()
+		})
+		if err != nil {
+			return nil, err
+		}
+		for _, id := range batch {
+			row, ok := byID[id]
+			if !ok {
+				continue
+			}
+			var content bigqueryv2.Job
+			if len(row.metadata) > 0 {
+				if err := json.Unmarshal([]byte(row.metadata), &content); err != nil {
+					return nil, fmt.Errorf("failed to decode metadata content %s: %w", row.metadata, err)
+				}
+			}
+			var resErr error
+			if row.err != "" {
+				resErr = errors.New(row.err)
+			}
+			jobs = append(jobs, NewJob(r, projectID, id, &content, nil, resErr))
+		}
+	}
+	return jobs, nil
+}
+
 // findProjectJobRows reads the metadata and error of every row of the jobs
 // table of projectID, by job ID, as SQLite SQL (googlesqlite patch 0019),
 // as findJobRow reads one.
