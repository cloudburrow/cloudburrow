+// splitJobIDs reads a comma-separated list of job IDs. CloudBurrow patch
+// (cloudburrow/cloudburrow#1528).
+func splitJobIDs(s string) []string {
+	var ids []string
+	for _, id := range strings.Split(s, ",") {
+		if id != "" {
+			ids = append(ids, id)
+		}
+	}
+	return ids
 }
 
