+// RangeSQLType is the GoogleSQL type of a RANGE column whose
+// rangeElementType is elem: RANGE<DATE>, RANGE<DATETIME> or
+// RANGE<TIMESTAMP>. Without it a table made by tables.insert (or a column
+// added by tables.patch) with a RANGE column was refused 500 "Type not
+// found: TYPE_UNKNOWN": the DDL made for it named no type. CloudBurrow
+// patch (cloudburrow/cloudburrow#1492).
+func RangeSQLType(elem string) string {
+	return "RANGE<" + Type(elem).TypeKind().String() + ">"
+}
+
+// RangeText is v, a RANGE value as tabledata.insertAll or a JSON load
+// gives it, an object of start and end (each null or absent when
+// UNBOUNDED), or its text "[start, end)", as the text a CAST to RANGE
+// takes; ok is false for anything else. CloudBurrow patch
+// (cloudburrow/cloudburrow#1492).
+func RangeText(v interface{}) (string, bool) {
+	switch x := v.(type) {
+	case string:
+		return x, true
+	case map[string]interface{}:
+		for k := range x {
+			if !strings.EqualFold(k, "start") && !strings.EqualFold(k, "end") {
+				return "", false
+			}
+		}
+		bound := func(key string) string {
+			for k, b := range x {
+				if !strings.EqualFold(k, key) || b == nil {
+					continue
+				}
+				s, ok := b.(string)
+				if !ok {
+					s = fmt.Sprint(b)
+				}
+				if s != "" {
+					return s
+				}
+			}
+			return "UNBOUNDED"
+		}
+		start, end := bound("start"), bound("end")
+		return "[" + start + ", " + end + ")", true
+	}
+	return "", false
+}
+
 // rangeKind is GoogleSQL's TYPE_RANGE, 30 in go-googlesql's TypeKind
 // (TypeKindTypeRange), which zsqltypes does not name.
 const rangeKind zsqltypes.TypeKind = 30
