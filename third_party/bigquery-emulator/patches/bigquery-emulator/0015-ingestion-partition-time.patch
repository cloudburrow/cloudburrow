--- a/internal/contentdata/repository.go
+++ b/internal/contentdata/repository.go
@@ -131,6 +131,19 @@
 		return err
 	}
 	query := fmt.Sprintf("CREATE TABLE `%s` (%s)", tablePath, strings.Join(fields, ","))
+	if tp := table.TimePartitioning; tp != nil && tp.Field == "" {
+		// CloudBurrow patch (cloudburrow/cloudburrow#1277): an
+		// ingestion-time partitioned table is made as CREATE TABLE ...
+		// PARTITION BY ingestion time would make it, so the engine keeps
+		// each row's _PARTITIONTIME (googlesqlite patch 0028).
+		unit := strings.ToUpper(tp.Type)
+		switch unit {
+		case "HOUR", "MONTH", "YEAR":
+		default:
+			unit = "DAY"
+		}
+		query += " PARTITION BY TIMESTAMP_TRUNC(_PARTITIONTIME, " + unit + ")"
+	}
 	if _, err := tx.Tx().ExecContext(ctx, query); err != nil {
 		return fmt.Errorf("failed to create table %s: %w", query, err)
 	}
--- a/server/handler.go
+++ b/server/handler.go
@@ -1859,6 +1859,12 @@
 	}
 	fields := make([]*bigqueryv2.TableFieldSchema, 0, len(spec.Columns))
 	for _, column := range spec.Columns {
+		if strings.EqualFold(column.Name, "_PARTITIONTIME") || strings.EqualFold(column.Name, "_PARTITIONDATE") {
+			// CloudBurrow patch (cloudburrow/cloudburrow#1277): the
+			// pseudo-columns of an ingestion-time partitioned table are
+			// not in its schema.
+			continue
+		}
 		field := types.TableFieldSchemaFromColumnType(column.Name, column.Type)
