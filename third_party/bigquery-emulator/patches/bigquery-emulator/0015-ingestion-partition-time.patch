+++ b/server/ingestion_partition_test.go
@@ -0,0 +1,107 @@
+package server_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"cloud.google.com/go/bigquery"
+	"google.golang.org/api/iterator"
+	"google.golang.org/api/option"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestIngestionPartitionTime is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1277): a table made by tables.insert with
+// timePartitioning and no field kept no row's ingestion time, so
+// _PARTITIONTIME read the time of the query; and the pseudo-columns of a
+// table made by CREATE TABLE ... PARTITION BY _PARTITIONDATE are not in
+// its schema.
+func TestIngestionPartitionTime(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(types.NewProject("test", types.NewDataset("ds")))); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	client, err := bigquery.NewClient(ctx, "test", option.WithEndpoint(testServer.URL), option.WithoutAuthentication())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	ds := client.Dataset("ds")
+	run := func(q string) {
+		t.Helper()
+		job, err := client.Query(q).Run(ctx)
+		if err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		if status, err := job.Wait(ctx); err != nil || status.Err() != nil {
+			t.Fatalf("%s: %v, %v", q, err, status.Err())
+		}
+	}
+	count := func(q string) int64 {
+		t.Helper()
+		it, err := client.Query(q).Read(ctx)
+		if err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		var row []bigquery.Value
+		if err := it.Next(&row); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		return row[0].(int64)
+	}
+
+	ing := ds.Table("ing")
+	if err := ing.Create(ctx, &bigquery.TableMetadata{
+		Schema:           bigquery.Schema{{Name: "id", Type: bigquery.IntegerFieldType}},
+		TimePartitioning: &bigquery.TimePartitioning{Type: bigquery.DayPartitioningType},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	type row struct {
+		ID int64 `bigquery:"id"`
+	}
+	if err := ing.Inserter().Put(ctx, []row{{1}, {2}}); err != nil {
+		t.Fatal(err)
+	}
+	run("INSERT INTO ds.ing (_PARTITIONTIME, id) VALUES (TIMESTAMP '2024-01-01', 3)")
+	if n := count("SELECT COUNT(*) FROM ds.ing WHERE _PARTITIONTIME = TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(), DAY) AND _PARTITIONDATE = CURRENT_DATE()"); n != 2 {
+		t.Errorf("rows of today: %d, want 2", n)
+	}
+	if n := count("SELECT COUNT(*) FROM ds.ing WHERE _PARTITIONTIME = TIMESTAMP('2024-01-01')"); n != 1 {
+		t.Errorf("rows of 2024-01-01: %d, want 1", n)
+	}
+	it := ing.Read(ctx)
+	for {
+		var vals []bigquery.Value
+		if err := it.Next(&vals); err == iterator.Done {
+			break
+		} else if err != nil {
+			t.Fatal(err)
+		}
+		if len(vals) != 1 {
+			t.Errorf("tabledata.list row %v, want only id", vals)
+		}
+	}
+
+	run("CREATE TABLE ds.ddl (id INT64) PARTITION BY _PARTITIONDATE")
+	md, err := ds.Table("ddl").Metadata(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(md.Schema) != 1 || md.Schema[0].Name != "id" {
+		t.Errorf("schema of ddl: %v, want only id", md.Schema)
+	}
+}
