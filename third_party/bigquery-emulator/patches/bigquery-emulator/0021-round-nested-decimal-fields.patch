+// roundingModeOf is the mode a value written to f rounds by: its
+// roundingMode, else the table's defaultRoundingMode, else
+// ROUND_HALF_AWAY_FROM_ZERO.
+func roundingModeOf(f *bigqueryv2.TableFieldSchema, tableMode string) string {
+	mode := f.RoundingMode
+	if mode == "" || mode == "ROUNDING_MODE_UNSPECIFIED" {
+		mode = tableMode
+	}
+	if mode != "ROUND_HALF_EVEN" {
+		mode = "ROUND_HALF_AWAY_FROM_ZERO"
+	}
+	return mode
+}
+
+// decimalSpec is googlesqlite_round_decimal_nested's spec: a leaf (N set)
+// is a parameterized NUMERIC or BIGNUMERIC, F a RECORD's fields that hold
+// one; an ARRAY's elements take the spec of the ARRAY. CloudBurrow patch
+// (cloudburrow/cloudburrow#1409).
+type decimalSpec struct {
+	N string                  `json:"n,omitempty"`
+	P int64                   `json:"p,omitempty"`
+	S int64                   `json:"s,omitempty"`
+	M string                  `json:"m,omitempty"`
+	F map[string]*decimalSpec `json:"f,omitempty"`
+}
+
+// nestedDecimalSpec is the spec of f, named path, or nil when it holds no
+// parameterized NUMERIC or BIGNUMERIC. CloudBurrow patch
+// (cloudburrow/cloudburrow#1409).
+func nestedDecimalSpec(f *bigqueryv2.TableFieldSchema, path, tableMode string) *decimalSpec {
+	switch strings.ToUpper(f.Type) {
+	case "NUMERIC", "BIGNUMERIC":
+		if f.Precision <= 0 {
+			return nil
+		}
+		return &decimalSpec{N: path, P: f.Precision, S: f.Scale, M: roundingModeOf(f, tableMode)}
+	case "RECORD", "STRUCT":
+		var fields map[string]*decimalSpec
+		for _, sub := range f.Fields {
+			if s := nestedDecimalSpec(sub, path+"."+sub.Name, tableMode); s != nil {
+				if fields == nil {
+					fields = map[string]*decimalSpec{}
+				}
+				fields[sub.Name] = s
+			}
+		}
+		if fields == nil {
+			return nil
+		}
+		return &decimalSpec{F: fields}
+	}
+	return nil
+}
+
 func triggerName(projectID, datasetID, tableID, column string) string {
 	return "cb_round_" + strings.Join([]string{projectID, datasetID, tableID, column}, "_")
 }
