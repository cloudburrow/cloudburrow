+// creationBound reads a jobs.list bound of creation time, milliseconds
+// since the epoch: -1 when there is none or it is not a number of them.
+// CloudBurrow patch (cloudburrow/cloudburrow#1564).
+func creationBound(s string) int64 {
+	n, err := strconv.ParseInt(s, 10, 64)
+	if s == "" || err != nil || n < 0 {
+		return -1
+	}
+	return n
+}
+
+// msSince is the least creation time in milliseconds a job of this engine
+// has (2001-09-09): one below it was kept in seconds by an engine before
+// patch 0013, or is none. CloudBurrow patch (cloudburrow/cloudburrow#1564).
+const msSince = 1_000_000_000_000
+
+// outOfBounds reports whether the job's creation time, in milliseconds,
+// is outside the request's bounds of creation time (minCreationTime and
+// maxCreationTime, "after or at" and "before or at", as BigQuery reads
+// them). A job with no such time is never out: the front, which times
+// the jobs it sends on, reads the bounds again. CloudBurrow patch
+// (cloudburrow/cloudburrow#1564): jobs.list read every job whatever was
+// asked, so a client, or the front's INFORMATION_SCHEMA.JOBS, asking for
+// the last minute's jobs was answered every one.
+func (r *jobsListRequest) outOfBounds(stats *bigqueryv2.JobStatistics) bool {
+	if stats == nil || stats.CreationTime < msSince {
+		return false
+	}
+	return r.minCreation >= 0 && stats.CreationTime < r.minCreation || r.maxCreation >= 0 && stats.CreationTime > r.maxCreation
+}
