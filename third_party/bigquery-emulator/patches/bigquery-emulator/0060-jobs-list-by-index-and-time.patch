+package metadata
+
+import (
+	"context"
+	"database/sql"
+	"reflect"
+	"testing"
+)
+
+// CloudBurrow regression test (cloudburrow/cloudburrow#1564): the jobs
+// after one, and the jobs named, are read by the job order's keys, as
+// SQLite SQL, and listed as before: in the order they were added, the
+// named ones added before the cursor first, only of their own project,
+// and not once deleted.
+func TestJobsAfterByIndex(t *testing.T) {
+	r, _ := testRepository(t)
+	ctx := context.Background()
+	addJobs(t, r, queryJob(r, "a", 1), queryJob(r, "b", 1), queryJob(r, "c 'quoted\"", 1), queryJob(r, "d", 1))
+	inTx(t, r, func(ctx context.Context, tx *sql.Tx) error {
+		other := NewProject(r, "q", nil, nil)
+		if err := other.Insert(ctx, tx); err != nil {
+			return err
+		}
+		j := queryJob(r, "e", 1)
+		j.ProjectID = "q"
+		return other.AddJob(ctx, tx, j)
+	})
+	project, err := r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ids := func(after string, named ...string) []string {
+		t.Helper()
+		jobs, err := project.JobsAfter(ctx, after, named)
+		if err != nil {
+			t.Fatalf("JobsAfter(%q, %q): %v", after, named, err)
+		}
+		var out []string
+		for _, j := range jobs {
+			out = append(out, j.ID)
+		}
+		return out
+	}
+	for _, c := range []struct {
+		after string
+		named []string
+		want  []string
+	}{
+		{"", nil, []string{"a", "b", "c 'quoted\"", "d"}},
+		{"b", nil, []string{"c 'quoted\"", "d"}},
+		{"d", nil, nil},
+		{"missing", nil, []string{"a", "b", "c 'quoted\"", "d"}},
+		{"b", []string{"b", "a", "d", "missing"}, []string{"b", "a", "c 'quoted\"", "d"}},
+		{"d", []string{"a"}, []string{"a"}},
+		{"e", nil, []string{"a", "b", "c 'quoted\"", "d"}}, // project q's
+	} {
+		if got := ids(c.after, c.named...); !reflect.DeepEqual(got, c.want) {
+			t.Errorf("JobsAfter(%q, %q) = %q, want %q", c.after, c.named, got, c.want)
+		}
+	}
+	inTx(t, r, func(ctx context.Context, tx *sql.Tx) error { return project.DeleteJob(ctx, tx, "c 'quoted\"") })
+	if got, want := ids("a", "c 'quoted\""), []string{"b", "d"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("JobsAfter(a) after a deletion = %q, want %q", got, want)
+	}
+}
