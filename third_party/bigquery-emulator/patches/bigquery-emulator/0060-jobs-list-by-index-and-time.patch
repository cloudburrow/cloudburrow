@@ -0,0 +1,35 @@
+package server
+
+import (
+	"testing"
+
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+)
+
+// CloudBurrow regression test (cloudburrow/cloudburrow#1564): jobs.list
+// leaves out a job created outside minCreationTime and maxCreationTime
+// (both inclusive), and lists one with no time in milliseconds.
+func TestJobsListCreationBounds(t *testing.T) {
+	const ms = 1_790_000_000_000
+	r := &jobsListRequest{minCreation: creationBound("1790000000000"), maxCreation: creationBound("1790000000100")}
+	for _, c := range []struct {
+		stats *bigqueryv2.JobStatistics
+		out   bool
+	}{
+		{&bigqueryv2.JobStatistics{CreationTime: ms - 1}, true},
+		{&bigqueryv2.JobStatistics{CreationTime: ms}, false},
+		{&bigqueryv2.JobStatistics{CreationTime: ms + 100}, false},
+		{&bigqueryv2.JobStatistics{CreationTime: ms + 101}, true},
+		{&bigqueryv2.JobStatistics{CreationTime: 1_700_000_000}, false}, // seconds
+		{&bigqueryv2.JobStatistics{}, false},
+		{nil, false},
+	} {
+		if got := r.outOfBounds(c.stats); got != c.out {
+			t.Errorf("outOfBounds(%+v) = %v, want %v", c.stats, got, c.out)
+		}
+	}
+	none := &jobsListRequest{minCreation: creationBound(""), maxCreation: creationBound("x")}
+	if none.outOfBounds(&bigqueryv2.JobStatistics{CreationTime: ms}) {
+		t.Error("a job is out of no bounds")
+	}
+}
