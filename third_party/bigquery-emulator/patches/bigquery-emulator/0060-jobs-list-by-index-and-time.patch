+// jobOrderAfter returns the IDs of the jobs of projectID added after the
+// job after (every job when after is "" or no job of the project), in the
+// order they were added, reading cloudburrow_job_order as SQLite SQL: by
+// its primary key, and by jobOrderIndex, which it makes first. CloudBurrow
+// patch (cloudburrow/cloudburrow#1564).
+func (r *Repository) jobOrderAfter(ctx context.Context, conn *sql.Conn, projectID, after string) ([]string, error) {
+	var order []string
+	err := conn.Raw(func(c interface{}) error {
+		gsqlConn, ok := c.(*googlesqlite.Conn)
+		if !ok {
+			return fmt.Errorf("failed to get *googlesqlite.Conn from %T", c)
+		}
+		if err := r.indexJobOrder(ctx, gsqlConn); err != nil {
+			return err
+		}
+		encProject, err := googlesqlite.EncodeString(projectID)
+		if err != nil {
+			return err
+		}
+		seq := int64(-1) // every job is after none
+		if after != "" {
+			encID, err := googlesqlite.EncodeString(after)
+			if err != nil {
+				return err
+			}
+			rows, err := gsqlConn.QueryRawContext(ctx,
+				"SELECT `seq` FROM `cloudburrow_job_order` WHERE `projectID` = ? AND `id` = ?", encProject, encID)
+			if err != nil {
+				return fmt.Errorf("failed to read the job order: %w", err)
+			}
+			if rows.Next() {
+				if err := rows.Scan(&seq); err != nil {
+					rows.Close()
+					return err
+				}
+			}
+			err = rows.Err()
+			rows.Close()
+			if err != nil {
+				return err
+			}
+		}
+		rows, err := gsqlConn.QueryRawContext(ctx,
+			"SELECT `id` FROM `cloudburrow_job_order` WHERE `projectID` = ? AND `seq` > ? ORDER BY `seq`", encProject, seq)
+		if err != nil {
+			return fmt.Errorf("failed to read the job order: %w", err)
+		}
+		defer rows.Close()
+		for rows.Next() {
+			var v any
+			if err := rows.Scan(&v); err != nil {
+				return err
+			}
+			id, _, err := googlesqlite.DecodeString(v)
+			if err != nil {
+				return fmt.Errorf("failed to decode a job ID of %s: %w", projectID, err)
+			}
+			order = append(order, id)
+		}
+		return rows.Err()
+	})
+	return order, err
+}
+
+// jobOrderIndex is an index of cloudburrow_job_order by project and
+// sequence number, which jobOrderAfter reads the jobs after one by.
+// GoogleSQL makes no index, so it is made as SQLite SQL. CloudBurrow patch
+// (cloudburrow/cloudburrow#1564).
+const jobOrderIndex = "CREATE INDEX IF NOT EXISTS `cloudburrow_job_order_seq` ON `cloudburrow_job_order` (`projectID`, `seq`)"
+
+// indexJobOrder makes jobOrderIndex once. CloudBurrow patch
+// (cloudburrow/cloudburrow#1564).
+func (r *Repository) indexJobOrder(ctx context.Context, c *googlesqlite.Conn) error {
+	r.jobOrderIndexMu.Lock()
+	defer r.jobOrderIndexMu.Unlock()
+	if r.jobOrderIndexed {
+		return nil
+	}
+	rows, err := c.QueryRawContext(ctx, jobOrderIndex)
+	if err != nil {
+		return fmt.Errorf("failed to index the job order: %w", err)
+	}
+	for rows.Next() {
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return fmt.Errorf("failed to index the job order: %w", err)
+	}
+	r.jobOrderIndexed = true
+	return nil
 }
 
