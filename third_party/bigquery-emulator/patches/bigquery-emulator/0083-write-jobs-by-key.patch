@@ -0,0 +1,156 @@
+package metadata
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// CloudBurrow regression test (cloudburrow/cloudburrow#1655): each
+// statement that writes, deletes or finds one job is answered from the
+// primary key's index, not by visiting every row. The GoogleSQL statements
+// they replace each compile their WHERE to a function call per row, which
+// SQLite can only answer with a SCAN of the table.
+func TestJobStatementsUseTheKey(t *testing.T) {
+	r, _ := testRepository(t)
+	addJobs(t, r, queryJob(r, "a", 1))
+	ctx := context.Background()
+	conn, err := r.getConnection(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	for _, stmt := range []string{updateJobByKey, expireResultByKey, deleteJobByKey, deleteJobOrderByKey, jobByKey} {
+		args := make([]any, strings.Count(stmt, "?"))
+		for i := range args {
+			args[i] = "x"
+		}
+		var plan []string
+		err := conn.Raw(func(c interface{}) error {
+			rows, err := c.(*googlesqlite.Conn).QueryRawContext(ctx, "EXPLAIN QUERY PLAN "+stmt, args...)
+			if err != nil {
+				return err
+			}
+			defer rows.Close()
+			cols, _ := rows.Columns()
+			for rows.Next() {
+				vals := make([]any, len(cols))
+				ptrs := make([]any, len(cols))
+				for i := range vals {
+					ptrs[i] = &vals[i]
+				}
+				if err := rows.Scan(ptrs...); err != nil {
+					return err
+				}
+				if s, ok := vals[len(vals)-1].(string); ok {
+					plan = append(plan, s)
+				}
+			}
+			return rows.Err()
+		})
+		if err != nil {
+			t.Fatalf("%s: %v", stmt, err)
+		}
+		got := strings.Join(plan, "; ")
+		if !strings.Contains(got, "SEARCH") || !strings.Contains(got, "(projectID=? AND id=?)") || strings.Contains(got, "SCAN") {
+			t.Errorf("%s: plan %q, want a search of the primary key", stmt, got)
+		}
+	}
+}
+
+// A transaction no connection is bound to (BindTx) is written to as before,
+// with GoogleSQL: the same results as by the key.
+func TestJobWritesOfAnUnboundTransaction(t *testing.T) {
+	r, db := testRepository(t)
+	addJobs(t, r, queryJob(r, "a", 1), queryJob(r, "b", 2))
+	ctx := context.Background()
+	unbound := func(f func(ctx context.Context, tx *sql.Tx) error) {
+		t.Helper()
+		tx, err := db.BeginTx(ctx, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := f(ctx, tx); err != nil {
+			tx.Rollback()
+			t.Fatal(err)
+		}
+		if err := tx.Commit(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	a, err := r.FindJob(ctx, "p", "a")
+	if err != nil || a == nil {
+		t.Fatalf("FindJob(a) = %v, %v", a, err)
+	}
+	unbound(func(ctx context.Context, tx *sql.Tx) error {
+		return a.SetResult(ctx, tx, queryJob(r, "a", 4).response, errors.New("it failed"))
+	})
+	project, err := r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+	unbound(func(ctx context.Context, tx *sql.Tx) error { return project.DeleteJob(ctx, tx, "b") })
+	if got, err := r.FindJob(ctx, "p", "a"); err != nil || got == nil || len(got.response.Rows) != 4 || got.err == nil {
+		t.Errorf("FindJob(a) after SetResult = %v, %v; want 4 rows and its error", got, err)
+	}
+	if got, err := r.FindJob(ctx, "p", "b"); err != nil || got != nil {
+		t.Errorf("FindJob(b) after DeleteJob = %v, %v; want none", got, err)
+	}
+}
+
+// The same in a bound transaction (inTx binds its own), and a job of the
+// same ID in another project is left as it was.
+func TestJobWritesByKey(t *testing.T) {
+	r, _ := testRepository(t)
+	addJobs(t, r, queryJob(r, "a", 1), queryJob(r, "b", 2), queryJob(r, "c", 3))
+	ctx := context.Background()
+	inTx(t, r, func(ctx context.Context, tx *sql.Tx) error {
+		other := NewProject(r, "q", nil, nil)
+		if err := other.Insert(ctx, tx); err != nil {
+			return err
+		}
+		j := queryJob(r, "b", 7)
+		j.ProjectID = "q"
+		return other.AddJob(ctx, tx, j)
+	})
+	a, err := r.FindJob(ctx, "p", "a")
+	if err != nil || a == nil {
+		t.Fatalf("FindJob(a) = %v, %v", a, err)
+	}
+	inTx(t, r, func(ctx context.Context, tx *sql.Tx) error {
+		return a.SetResult(ctx, tx, queryJob(r, "a", 4).response, errors.New("it 'failed'"))
+	})
+	project, err := r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+	inTx(t, r, func(ctx context.Context, tx *sql.Tx) error {
+		for id, want := range map[string]bool{"b": true, "nope": false} {
+			if got, err := r.jobExists(ctx, tx, "p", id); err != nil || got != want {
+				t.Errorf("jobExists(p, %s) = %v, %v; want %v", id, got, err, want)
+			}
+		}
+		return project.DeleteJob(ctx, tx, "b")
+	})
+	if got, err := r.FindJob(ctx, "p", "a"); err != nil || got == nil || len(got.response.Rows) != 4 || got.err == nil || got.err.Error() != "it 'failed'" {
+		t.Errorf("FindJob(a) after SetResult = %v, %v; want 4 rows and its error", got, err)
+	}
+	if got, err := r.FindJob(ctx, "p", "b"); err != nil || got != nil {
+		t.Errorf("FindJob(p, b) after DeleteJob = %v, %v; want none", got, err)
+	}
+	if got, err := r.FindJob(ctx, "q", "b"); err != nil || got == nil || len(got.response.Rows) != 7 {
+		t.Errorf("FindJob(q, b) = %v, %v; want project q's job of 7 rows", got, err)
+	}
+	project, err = r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+	jobs, err := project.Jobs(ctx)
+	if err != nil || len(jobs) != 2 || jobs[0].ID != "a" || jobs[1].ID != "c" {
+		t.Errorf("Jobs() = %v, %v; want a and c, in their order", jobs, err)
+	}
+}
