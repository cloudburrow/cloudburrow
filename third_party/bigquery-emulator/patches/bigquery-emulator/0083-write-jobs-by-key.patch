+package metadata
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1655): a job is written and
+// deleted by its primary key, as SQLite SQL. googlesqlite compiles each
+// GoogleSQL WHERE comparison to a function call, which SQLite cannot answer
+// from the key's index (see findJobRow), so UpdateJob, DeleteJob, jobExists
+// and keepResult's expiry each visited every job the emulator kept, and the
+// order table's every row; the CloudBurrow front deletes each job of its
+// own once it has read it, so every query it made cost a few scans of a
+// table that grows with every job, under the emulator's one request lock.
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"sync"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// txConns maps a transaction to the connection it runs on, for the
+// statements below, which reach SQLite through the connection
+// (googlesqlite.Conn.QueryRawContext) and run in its transaction.
+var txConns sync.Map // *sql.Tx -> *sql.Conn
+
+// BindTx records that tx runs on conn, until UnbindTx; a transaction not
+// bound is written to with GoogleSQL, as before.
+func BindTx(tx *sql.Tx, conn *sql.Conn) { txConns.Store(tx, conn) }
+
+// UnbindTx forgets tx, once it is committed or rolled back.
+func UnbindTx(tx *sql.Tx) { txConns.Delete(tx) }
+
+// rawByKey runs query, SQLite SQL, on tx's connection, with each of strs a
+// STRING argument in googlesqlite's stored encoding, and calls each (if not
+// nil) for every row it returns. ok is false, and nothing is run, when tx
+// is not bound.
+func rawByKey(ctx context.Context, tx *sql.Tx, query string, each func(*sql.Rows) error, strs ...string) (ok bool, err error) {
+	v, bound := txConns.Load(tx)
+	if !bound {
+		return false, nil
+	}
+	args := make([]any, len(strs))
+	for i, s := range strs {
+		enc, err := googlesqlite.EncodeString(s)
+		if err != nil {
+			return true, err
+		}
+		args[i] = enc
+	}
+	return true, v.(*sql.Conn).Raw(func(c interface{}) error {
+		gsqlConn, ok := c.(*googlesqlite.Conn)
+		if !ok {
+			return fmt.Errorf("failed to get *googlesqlite.Conn from %T", c)
+		}
+		rows, err := gsqlConn.QueryRawContext(ctx, query, args...)
+		if err != nil {
+			return err
+		}
+		defer rows.Close()
+		for rows.Next() {
+			if each != nil {
+				if err := each(rows); err != nil {
+					return err
+				}
+			}
+		}
+		return rows.Err()
+	})
+}
+
+// The statements, each keyed by the table's primary key (projectID, id).
+const (
+	updateJobByKey      = "UPDATE `jobs` SET `metadata` = ?, `result` = ?, `error` = ? WHERE `projectID` = ? AND `id` = ?"
+	expireResultByKey   = "UPDATE `jobs` SET `result` = ? WHERE `projectID` = ? AND `id` = ?"
+	deleteJobByKey      = "DELETE FROM `jobs` WHERE `projectID` = ? AND `id` = ?"
+	deleteJobOrderByKey = "DELETE FROM `cloudburrow_job_order` WHERE `projectID` = ? AND `id` = ?"
+	jobByKey            = "SELECT 1 FROM `jobs` WHERE `projectID` = ? AND `id` = ?"
+)
