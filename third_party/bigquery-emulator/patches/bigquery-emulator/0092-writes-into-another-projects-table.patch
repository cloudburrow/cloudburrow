+package server_test
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"cloud.google.com/go/bigquery"
+	"google.golang.org/api/iterator"
+	"google.golang.org/api/option"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestLoadIntoAnotherProjectsTable is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1767): a load job of one project whose
+// destination is a table of another writes that project's table, made on
+// the way when it does not exist; the emulator answered 404 dataset "ds"
+// is not found, looking the dataset up in the job's project. A query job's
+// destination of another project, which it answered "failed to find
+// destination dataset: ds", is written there too.
+func TestLoadIntoAnotherProjectsTable(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(
+		types.NewProject("test"),
+		types.NewProject("other", types.NewDataset("ds")),
+	)); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	client, err := bigquery.NewClient(ctx, "test", option.WithEndpoint(testServer.URL), option.WithoutAuthentication(),
+		option.WithHTTPClient(http.DefaultClient))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	for i, write := range []bigquery.TableWriteDisposition{bigquery.WriteEmpty, bigquery.WriteAppend} {
+		src := bigquery.NewReaderSource(strings.NewReader("x,s\n1,a\n2,b\n"))
+		src.SourceFormat = bigquery.CSV
+		src.SkipLeadingRows = 1
+		src.Schema = bigquery.Schema{{Name: "x", Type: bigquery.IntegerFieldType}, {Name: "s", Type: bigquery.StringFieldType}}
+		l := client.DatasetInProject("other", "ds").Table("t").LoaderFrom(src)
+		l.WriteDisposition = write
+		job, err := l.Run(ctx)
+		if err != nil {
+			t.Fatalf("load %d: %v", i, err)
+		}
+		if job.ProjectID() != "test" {
+			t.Errorf("load %d: the job is in %s, want test", i, job.ProjectID())
+		}
+		status, err := job.Wait(ctx)
+		if err == nil {
+			err = status.Err()
+		}
+		if err != nil {
+			t.Fatalf("load %d into other.ds.t: %v", i, err)
+		}
+	}
+	it, err := client.Query("SELECT COUNT(*), SUM(x) FROM `other.ds.t`").Read(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var row []bigquery.Value
+	if err := it.Next(&row); err != nil && err != iterator.Done {
+		t.Fatal(err)
+	}
+	if len(row) != 2 || row[0] != int64(4) || row[1] != int64(6) {
+		t.Errorf("other.ds.t after two loads = %v, want 4 rows summing to 6", row)
+	}
+	if _, err := client.Dataset("ds").Table("t").Metadata(ctx); err == nil {
+		t.Errorf("the load made test.ds.t too")
+	}
+	q := client.Query("SELECT 5 AS x, 'q' AS s")
+	q.Dst = client.DatasetInProject("other", "ds").Table("q")
+	job, err := q.Run(ctx)
+	if err != nil {
+		t.Fatalf("query into other.ds.q: %v", err)
+	}
+	if status, err := job.Wait(ctx); err != nil || status.Err() != nil {
+		t.Fatalf("query into other.ds.q: %v %v", err, status.Err())
+	}
+	it, err = client.Query("SELECT COUNT(*), SUM(x) FROM `other.ds.q`").Read(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	row = nil
+	if err := it.Next(&row); err != nil {
+		t.Fatal(err)
+	}
+	if len(row) != 2 || row[0] != int64(1) || row[1] != int64(5) {
+		t.Errorf("other.ds.q = %v, want 1 row of 5", row)
+	}
+}
