--- a/server/handler.go
+++ b/server/handler.go
@@ -550,6 +550,8 @@
 				colData := record[i]
 				if colData == "" {
 					rowData[columns[i].Name] = nil
+				} else if colData == cloudburrowEmptyString {
+					rowData[columns[i].Name] = ""
 				} else {
 					rowData[columns[i].Name] = colData
 				}
@@ -3468,3 +3470,8 @@
 	ctx := r.Context()
 	errorResponse(ctx, w, errInternalError(fmt.Sprintf("unexpected request path: %s", html.EscapeString(r.URL.Path))))
 }
+
+// cloudburrowEmptyString is how CloudBurrow's front writes an empty
+// string in the CSV it sends a load as, where an empty value is NULL
+// (CloudBurrow patch 38, cloudburrow/cloudburrow#1457).
+const cloudburrowEmptyString = "\uFDD0cloudburrow:empty-string\uFDD0"
