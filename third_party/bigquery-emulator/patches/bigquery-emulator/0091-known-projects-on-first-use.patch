@@ -0,0 +1,36 @@
+package server
+
+import (
+	"context"
+	"net/http"
+
+	"github.com/goccy/bigquery-emulator/internal/metadata"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1764): the emulator served
+// the projects it was started with alone (--project), and answered every
+// other one 404 "project P is not found". A request that carries
+// KnownProjectHeader names a project its caller (CloudBurrow's front) has
+// found in the instance's Resource Manager: the emulator adds the project
+// on first use, empty, and serves it as the one it started with. Without
+// the header nothing changes. The front sets it, and removes it from its
+// clients' requests.
+const KnownProjectHeader = "X-Cloudburrow-Known-Project"
+
+// projectOnFirstUse is the project the request names: the one the
+// emulator has, else, when the request carries KnownProjectHeader, the
+// project added now. nil when there is neither.
+func projectOnFirstUse(ctx context.Context, server *Server, r *http.Request, projectID string) (*metadata.Project, error) {
+	project, err := server.metaRepo.FindProject(ctx, projectID)
+	if err != nil || project != nil || r.Header.Get(KnownProjectHeader) == "" {
+		return project, err
+	}
+	// Two first requests at once: one adds it, the other's insert fails
+	// on the key, and both read it back.
+	addErr := server.SetProject(projectID)
+	project, err = server.metaRepo.FindProject(ctx, projectID)
+	if err == nil && project == nil && addErr != nil {
+		err = addErr
+	}
+	return project, err
+}
