+++ b/server/cloudburrow_known_projects_test.go
@@ -0,0 +1,96 @@
+package server_test
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestKnownProjectAddedOnFirstUse is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1764): another project than the one the
+// emulator was started with is 404 "project other is not found"; with
+// KnownProjectHeader it is added on first use, and from then on it is
+// served, with or without the header: its datasets, tables and jobs, and a
+// query of the first project's job that reads the other project's table.
+func TestKnownProjectAddedOnFirstUse(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(types.NewProject("test"))); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	do := func(method, path, body string, header bool) (int, string) {
+		t.Helper()
+		var r io.Reader
+		if body != "" {
+			r = bytes.NewReader([]byte(body))
+		}
+		req, _ := http.NewRequestWithContext(ctx, method, testServer.URL+"/bigquery/v2/projects/"+path, r)
+		req.Header.Set("Content-Type", "application/json")
+		if header {
+			req.Header.Set(server.KnownProjectHeader, "1")
+		}
+		resp, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		b, _ := io.ReadAll(resp.Body)
+		return resp.StatusCode, string(b)
+	}
+	if st, b := do(http.MethodGet, "other/datasets", "", false); st != http.StatusNotFound || !strings.Contains(b, "project other is not found") {
+		t.Fatalf("datasets.list of other without the header = %d %s, want 404 project other is not found", st, b)
+	}
+	if st, b := do(http.MethodPost, "other/datasets", `{"datasetReference":{"projectId":"other","datasetId":"ds"}}`, true); st != http.StatusOK {
+		t.Fatalf("datasets.insert in other with the header = %d %s", st, b)
+	}
+	if st, b := do(http.MethodPost, "other/datasets/ds/tables",
+		`{"tableReference":{"projectId":"other","datasetId":"ds","tableId":"t"},"schema":{"fields":[{"name":"x","type":"INTEGER"}]}}`, false); st != http.StatusOK {
+		t.Fatalf("tables.insert in other without the header = %d %s", st, b)
+	}
+	if st, b := do(http.MethodPost, "other/datasets/ds/tables/t/insertAll", `{"rows":[{"json":{"x":"7"}}]}`, false); st != http.StatusOK {
+		t.Fatalf("tabledata.insertAll = %d %s", st, b)
+	}
+	if st, b := do(http.MethodGet, "other/datasets", "", false); st != http.StatusOK || !strings.Contains(b, `"datasetId":"ds"`) {
+		t.Fatalf("datasets.list of other = %d %s, want ds", st, b)
+	}
+	if st, b := do(http.MethodGet, "test/datasets", "", false); st != http.StatusOK || strings.Contains(b, `"datasetId":"ds"`) {
+		t.Fatalf("datasets.list of test = %d %s, want none of other's", st, b)
+	}
+	st, b := do(http.MethodPost, "test/queries", "{\"query\":\"SELECT x FROM `other.ds.t`\",\"useLegacySql\":false}", false)
+	if st != http.StatusOK || !strings.Contains(b, `"v":"7"`) {
+		t.Fatalf("a query of test's reading other.ds.t = %d %s, want the row 7", st, b)
+	}
+	st, b = do(http.MethodPost, "other/queries", `{"query":"SELECT x FROM ds.t","useLegacySql":false}`, false)
+	if st != http.StatusOK || !strings.Contains(b, `"v":"7"`) || !strings.Contains(b, `"projectId":"other"`) {
+		t.Fatalf("a query of other's = %d %s, want the row 7 in a job of other's", st, b)
+	}
+	// Two first uses at once both succeed.
+	done := make(chan int, 2)
+	for i := 0; i < 2; i++ {
+		go func() {
+			st, _ := do(http.MethodGet, "third/datasets", "", true)
+			done <- st
+		}()
+	}
+	for i := 0; i < 2; i++ {
+		if st := <-done; st != http.StatusOK {
+			t.Fatalf("a concurrent first use of third = %d, want 200", st)
+		}
+	}
+}
