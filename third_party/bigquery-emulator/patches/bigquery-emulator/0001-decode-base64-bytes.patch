+package contentdata
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestDecodeBytesValues is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1061, #1075): a BYTES value is base64 in the
+// API, and was stored as the bytes of its base64 text; it is decoded, at
+// the top level, in a REPEATED column and in a RECORD in either form, and
+// bytes that are not UTF-8 (0xff) come through.
+func TestDecodeBytesValues(t *testing.T) {
+	b := &types.Column{Name: "b", Type: types.BYTES}
+	got, err := decodeBytesValues("/w==", b)
+	if g, ok := got.([]byte); err != nil || !ok || !bytes.Equal(g, []byte{0xff}) {
+		t.Errorf("BYTES /w== = %#v, %v, want 0xff", got, err)
+	}
+	rep := &types.Column{Name: "r", Type: types.BYTES, Mode: types.RepeatedMode}
+	got, err = decodeBytesValues([]interface{}{"YQ==", nil}, rep)
+	if l, ok := got.([]interface{}); err != nil || !ok || len(l) != 2 || !bytes.Equal(l[0].([]byte), []byte("a")) || l[1] != nil {
+		t.Errorf("REPEATED BYTES = %#v, %v", got, err)
+	}
+	rec := &types.Column{Name: "s", Type: types.RECORD, Fields: []*types.Column{
+		{Name: "B", Type: types.BYTES}, {Name: "n", Type: types.STRING},
+	}}
+	got, err = decodeBytesValues([]map[string]interface{}{{"B": "Yg=="}, {"n": "Yg=="}}, rec)
+	if l, ok := got.([]map[string]interface{}); err != nil || !ok || !bytes.Equal(l[0]["B"].([]byte), []byte("b")) || l[1]["n"] != "Yg==" {
+		t.Errorf("RECORD (normalized) = %#v, %v", got, err)
+	}
+	got, err = decodeBytesValues(map[string]interface{}{"b": "Yw=="}, rec)
+	if m, ok := got.(map[string]interface{}); err != nil || !ok || !bytes.Equal(m["b"].([]byte), []byte("c")) {
+		t.Errorf("RECORD (map, another case) = %#v, %v", got, err)
+	}
+	if got, err := decodeBytesValues([]byte{1}, b); err != nil || !bytes.Equal(got.([]byte), []byte{1}) {
+		t.Errorf("[]byte = %#v, %v, want it as it is", got, err)
+	}
+	if got, err := decodeBytesValues("x", &types.Column{Type: types.STRING}); err != nil || got != "x" {
+		t.Errorf("STRING = %#v, %v, want it as it is", got, err)
+	}
+	if _, err := decodeBytesValues("not base64!", b); err == nil {
+		t.Error("invalid base64 was accepted")
+	}
+}
