+// decodeBytesValues returns v, a value of column col as AddTableData binds
+// it, with every string in a BYTES position decoded from base64, the form
+// BigQuery's API carries BYTES in. A REPEATED column is a slice of its
+// elements, and a RECORD either a map or, as types.NewTableWithSchema
+// normalizes one, a slice of single-key maps in field order. Anything else,
+// []byte included, is returned as it is. CloudBurrow patch
+// (cloudburrow/cloudburrow#1061, #1075).
+func decodeBytesValues(v interface{}, col *types.Column) (interface{}, error) {
+	if v == nil || col == nil {
+		return v, nil
+	}
+	if col.Mode == types.RepeatedMode {
+		elems, ok := v.([]interface{})
+		if !ok {
+			return v, nil
+		}
+		elem := *col
+		elem.Mode = types.NullableMode
+		out := make([]interface{}, len(elems))
+		for i, e := range elems {
+			d, err := decodeBytesValues(e, &elem)
+			if err != nil {
+				return nil, err
+			}
+			out[i] = d
+		}
+		return out, nil
+	}
+	switch col.Type {
+	case types.BYTES:
+		s, ok := v.(string)
+		if !ok {
+			return v, nil
+		}
+		b, err := base64.StdEncoding.DecodeString(s)
+		if err != nil {
+			return nil, fmt.Errorf("invalid base64 BYTES value: %w", err)
+		}
+		return b, nil
+	case types.RECORD, types.STRUCT:
+		field := func(name string) *types.Column {
+			for _, f := range col.Fields {
+				if strings.EqualFold(f.Name, name) {
+					return f
+				}
+			}
+			return nil
+		}
+		switch m := v.(type) {
+		case map[string]interface{}:
+			out := make(map[string]interface{}, len(m))
+			for k, fv := range m {
+				d, err := decodeBytesValues(fv, field(k))
+				if err != nil {
+					return nil, err
+				}
+				out[k] = d
+			}
+			return out, nil
+		case []map[string]interface{}:
+			out := make([]map[string]interface{}, len(m))
+			for i, kv := range m {
+				d, err := decodeBytesValues(kv, &types.Column{Type: types.RECORD, Fields: col.Fields})
+				if err != nil {
+					return nil, err
+				}
+				out[i] = d.(map[string]interface{})
+			}
+			return out, nil
+		}
+	}
+	return v, nil
+}
