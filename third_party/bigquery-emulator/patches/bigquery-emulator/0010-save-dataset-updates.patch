--- a/internal/metadata/dataset.go
+++ b/internal/metadata/dataset.go
@@ -100,6 +100,11 @@
 	d.content = newContent
 }
 
+// Save writes the dataset's metadata, as it is now, to the repository.
+func (d *Dataset) Save(ctx context.Context, tx *sql.Tx) error {
+	return d.repo.UpdateDataset(ctx, tx, d)
+}
