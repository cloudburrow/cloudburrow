 }
@@ -1037,10 +1040,34 @@
 
 func (h *datasetsUpdateHandler) Handle(ctx context.Context, r *datasetsUpdateRequest) (*bigqueryv2.Dataset, error) {
 	r.dataset.UpdateContent(r.newDataset)
+	if err := saveDataset(ctx, r.server, r.project, r.dataset); err != nil {
+		return nil, err
+	}
 	newContent := *r.dataset.Content()
 	return &newContent, nil
 }
 
+// saveDataset writes dataset's metadata, as changed, to the metadata
+// store, which every request reads its project and datasets from.
+func saveDataset(ctx context.Context, server *Server, project *metadata.Project, dataset *metadata.Dataset) error {
+	conn, err := server.connMgr.Connection(ctx, project.ID, dataset.ID)
+	if err != nil {
+		return fmt.Errorf("failed to get connection: %w", err)
+	}
+	tx, err := conn.Begin(ctx)
+	if err != nil {
+		return fmt.Errorf("failed to start transaction: %w", err)
+	}
+	defer tx.RollbackIfNotCommitted()
+	if err := dataset.Save(ctx, tx.Tx()); err != nil {
+		return fmt.Errorf("failed to update dataset: %w", err)
+	}
+	if err := tx.Commit(); err != nil {
+		return fmt.Errorf("failed to commit dataset update: %w", err)
+	}
+	return nil
+}
