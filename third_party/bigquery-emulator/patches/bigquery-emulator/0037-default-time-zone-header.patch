+			ctx := withServer(r.Context(), s)
+			// CloudBurrow patch (cloudburrow/cloudburrow#1456): the
+			// project's default_time_zone, which CloudBurrow's front sends
+			// with a query, is the default time zone of the engine's time
+			// functions, casts and literals for that request.
+			if zone := r.Header.Get(DefaultTimeZoneHeader); zone != "" {
+				ctx = googlesqlite.WithDefaultTimeZone(ctx, zone)
+			}
+			next.ServeHTTP(w, r.WithContext(ctx))
 		})
 	}
 }
 
