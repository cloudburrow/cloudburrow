+
+// formatRangeCells renders a RANGE cell, or a REPEATED RANGE's cells, as
+// BigQuery's REST API does (cloudburrow/cloudburrow#1111): "[start, end)",
+// each bound UNBOUNDED or the element's REST form; a TIMESTAMP as int64
+// microseconds since the epoch and a DATETIME with a "T", which is what the
+// official clients parse (cloud.google.com/go/bigquery convertRangeValue).
+func formatRangeCells(fl *bigqueryv2.TableFieldSchema, v interface{}) interface{} {
+	if items, ok := v.([]*TableCell); ok {
+		out := make([]*TableCell, 0, len(items))
+		for _, it := range items {
+			if it == nil || it.V == nil {
+				out = append(out, it)
+				continue
+			}
+			out = append(out, &TableCell{V: formatRangeCells(fl, it.V)})
+		}
+		return out
+	}
+	raw, ok := v.(string)
+	if !ok || fl.RangeElementType == nil || len(raw) < 2 || raw[0] != '[' || raw[len(raw)-1] != ')' {
+		return v
+	}
+	parts := strings.Split(raw[1:len(raw)-1], ", ")
+	if len(parts) != 2 {
+		return v
+	}
+	for i, p := range parts {
+		if p == "UNBOUNDED" {
+			continue
+		}
+		switch fl.RangeElementType.Type {
+		case "TIMESTAMP":
+			t, err := googlesqlite.TimeFromTimestampValue(p)
+			if err != nil {
+				return v
+			}
+			parts[i] = fmt.Sprint(t.UnixMicro())
+		case "DATETIME":
+			parts[i] = strings.Replace(p, " ", "T", 1)
+		}
+	}
+	return "[" + parts[0] + ", " + parts[1] + ")"
 }
