--- a/types/types.go
+++ b/types/types.go
@@ -324,6 +324,10 @@
 	}
 	return ""
 }
+
+// rangeKind is GoogleSQL's TYPE_RANGE, 30 in go-googlesql's TypeKind
+// (TypeKindTypeRange), which zsqltypes does not name.
+const rangeKind zsqltypes.TypeKind = 30
 
 // TableFieldSchemaFromColumnType walks a googlesqlite.ColumnType (the
 // driver-level type descriptor) and produces a BigQuery v2 schema. It
@@ -339,11 +343,23 @@
 	case zsqltypes.ARRAY:
 		elem := TableFieldSchemaFromColumnType("", t.ElementType)
 		return &bigqueryv2.TableFieldSchema{
-			Name:   name,
-			Type:   elem.Type,
-			Fields: elem.Fields,
-			Mode:   string(RepeatedMode),
+			Name:             name,
+			Type:             elem.Type,
+			Fields:           elem.Fields,
+			RangeElementType: elem.RangeElementType,
+			Mode:             string(RepeatedMode),
 		}
+	case rangeKind:
+		// RANGE<T> (cloudburrow/cloudburrow#1111): BigQuery's schema
+		// gives the type RANGE and the element type as rangeElementType;
+		// without them a client cannot read the value.
+		elem := TableFieldSchemaFromColumnType("", t.ElementType)
+		return &bigqueryv2.TableFieldSchema{
+			Name:             name,
+			Type:             "RANGE",
+			RangeElementType: &bigqueryv2.TableFieldSchemaRangeElementType{Type: elem.Type},
+			Mode:             string(NullableMode),
+		}
 	case zsqltypes.STRUCT:
 		fields := make([]*bigqueryv2.TableFieldSchema, 0, len(t.FieldTypes))
 		for _, f := range t.FieldTypes {
--- a/internal/types/types.go
+++ b/internal/types/types.go
@@ -2,6 +2,7 @@
 
 import (
 	"fmt"
+	"strings"
 	"time"
 
 	"github.com/apache/arrow-go/v18/arrow/array"
@@ -226,7 +227,9 @@
 	for _, row := range rows {
 		cells := make([]*TableCell, 0, len(row.F))
 		for colIdx, cell := range row.F {
-			if schema.Fields[colIdx].Type == "TIMESTAMP" && cell.V != nil {
