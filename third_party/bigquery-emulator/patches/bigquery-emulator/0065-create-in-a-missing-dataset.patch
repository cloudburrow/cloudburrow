+// datasetOfCreateMissing is the error of a CREATE of a table in a
+// dataset that does not exist, addTableMetadata's (CloudBurrow patch,
+// cloudburrow/cloudburrow#1584).
+type datasetOfCreateMissing struct{ dataset string }
+
+func (e *datasetOfCreateMissing) Error() string {
+	return fmt.Sprintf("dataset %s is not found", e.dataset)
+}
+
+// dropTablesOfMissingDatasets drops, in tx, each table cat adds whose
+// dataset does not exist, and takes it out of cat, so that a CREATE
+// that fails leaves nothing: the engine makes the table before
+// syncCatalog finds its dataset missing, and the table, committed,
+// failed the same statement run again ("table `p_nods_x` already
+// exists"). It returns a *datasetOfCreateMissing when it dropped any
+// (CloudBurrow patch, cloudburrow/cloudburrow#1584).
+func dropTablesOfMissingDatasets(ctx context.Context, server *Server, tx *connection.Tx, cat *googlesqlite.ChangedCatalog) error {
+	var (
+		missing string
+		kept    []*googlesqlite.TableSpec
+	)
+	for _, spec := range cat.Table.Added {
+		if spec.IsTemp || len(spec.NamePath) != 3 {
+			kept = append(kept, spec)
+			continue
+		}
+		project, err := server.metaRepo.FindProject(ctx, spec.NamePath[0])
+		if err != nil || project == nil || project.Dataset(spec.NamePath[1]) != nil {
+			kept = append(kept, spec)
+			continue
+		}
+		if err := server.contentRepo.DeleteTables(ctx, tx, spec.NamePath[0], spec.NamePath[1], []contentdata.TableDeletion{{ID: spec.NamePath[2], IsView: spec.IsView}}); err != nil {
+			return err
+		}
+		if missing == "" {
+			missing = spec.NamePath[1]
+		}
+	}
+	if missing == "" {
+		return nil
+	}
+	cat.Table.Added = kept
+	return &datasetOfCreateMissing{dataset: missing}
+}
+
 func addTableMetadata(ctx context.Context, server *Server, spec *googlesqlite.TableSpec) error {
 	if len(spec.NamePath) != 3 {
 		return fmt.Errorf("unexpected table name path: %v", spec.NamePath)
