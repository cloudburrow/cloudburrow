@@ -130,6 +130,13 @@
 	if err != nil {
 		return err
 	}
+	if tp := table.TimePartitioning; tp != nil && tp.Field != "" || table.RangePartitioning != nil {
+		// CloudBurrow patch (cloudburrow/cloudburrow#1273): a table
+		// partitioned by a column or an integer range has the
+		// pseudo-column that marks the rows of its streaming buffer
