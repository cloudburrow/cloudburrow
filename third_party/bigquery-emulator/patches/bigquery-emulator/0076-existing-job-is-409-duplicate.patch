+
+// duplicateJob is BigQuery's answer to an insert of a job ID the project
+// has: 409 duplicate, "Already Exists: Job project:LOCATION.id".
+// CloudBurrow patch (cloudburrow/cloudburrow#1622).
+func duplicateJob(projectID, location, jobID string) *ServerError {
+	if location == "" {
+		location = "US"
+	}
+	return errDuplicate(fmt.Sprintf("Already Exists: Job %s:%s.%s", projectID, location, jobID))
+}
+
+// duplicateJobOr is duplicateJob when err is AddJob's for a job the
+// project has, else orElse of err. CloudBurrow patch (#1622).
+func duplicateJobOr(err error, projectID, location string, orElse func(string) *ServerError) *ServerError {
+	var dup *metadata.DuplicatedJobError
+	if errors.As(err, &dup) {
+		return duplicateJob(projectID, location, dup.ID)
+	}
+	return orElse(err.Error())
 }
 
