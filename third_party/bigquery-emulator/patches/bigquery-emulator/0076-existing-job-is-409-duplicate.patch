diff --git a/server/duplicate_job_test.go b/server/duplicate_job_test.go
new file mode 100644
--- /dev/null
+++ b/server/duplicate_job_test.go
@@ -0,0 +1,92 @@
+package server_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestInsertOfAnExistingJobIs409 is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1622): a jobs.insert of a job ID the project
+// has ran the query again and then failed 400 jobInternalError "failed to
+// add job: job ... is already created", so a client's retry of an insert
+// whose answer it missed failed, and a DML statement ran twice before the
+// rollback. BigQuery answers 409 duplicate and runs nothing.
+func TestInsertOfAnExistingJobIs409(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	project := types.NewProject("test", types.NewDataset("ds", types.NewTable("t", []*types.Column{types.NewColumn("a", types.INT64)}, nil)))
+	if err := bqServer.Load(server.StructSource(project)); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	base := testServer.URL + "/bigquery/v2/projects/test"
+	insert := func(sql string) (int, string, string) {
+		t.Helper()
+		b, _ := json.Marshal(map[string]any{
+			"jobReference":  map[string]any{"projectId": "test", "jobId": "retried", "location": "EU"},
+			"configuration": map[string]any{"query": map[string]any{"query": sql, "useLegacySql": false}},
+		})
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, base+"/jobs", bytes.NewReader(b))
+		req.Header.Set("Content-Type", "application/json")
+		resp, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		var got struct {
+			Error struct {
+				Message string `json:"message"`
+				Errors  []struct {
+					Reason string `json:"reason"`
+				} `json:"errors"`
+			} `json:"error"`
+		}
+		_ = json.NewDecoder(resp.Body).Decode(&got)
+		reason := ""
+		if len(got.Error.Errors) > 0 {
+			reason = got.Error.Errors[0].Reason
+		}
+		return resp.StatusCode, reason, got.Error.Message
+	}
+	if status, _, msg := insert("INSERT INTO ds.t (a) VALUES (1)"); status != http.StatusOK {
+		t.Fatalf("first insert: %d %s", status, msg)
+	}
+	status, reason, msg := insert("INSERT INTO ds.t (a) VALUES (1)")
+	if want := "Already Exists: Job test:EU.retried"; status != http.StatusConflict || reason != "duplicate" || msg != want {
+		t.Errorf("second insert of the job: %d %s %q, want 409 duplicate %q", status, reason, msg, want)
+	}
+	// The second insert ran nothing: the table has the one row.
+	b, _ := json.Marshal(map[string]any{"query": "SELECT COUNT(*) AS n FROM ds.t", "useLegacySql": false})
+	req, _ := http.NewRequestWithContext(ctx, http.MethodPost, base+"/queries", bytes.NewReader(b))
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	var rows struct {
+		Rows []struct {
+			F []struct {
+				V any `json:"v"`
+			} `json:"f"`
+		} `json:"rows"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&rows); err != nil || len(rows.Rows) != 1 || rows.Rows[0].F[0].V != "1" {
+		t.Errorf("rows of ds.t after the second insert: %+v (%v), want 1", rows, err)
+	}
+}
