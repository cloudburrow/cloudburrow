+// fieldCollate is the COLLATE clause of field, a STRING with a collation,
+// or "". CloudBurrow patch (cloudburrow/cloudburrow#1516): the engine
+// compares a STRING inside a STRUCT or an ARRAY by it (googlesqlite patch
+// 0061).
+func fieldCollate(field *bigqueryv2.TableFieldSchema) string {
+	if field.Collation == "" || !strings.EqualFold(field.Type, "STRING") {
+		return ""
+	}
+	return " COLLATE '" + strings.ReplaceAll(field.Collation, "'", "") + "'"
+}
