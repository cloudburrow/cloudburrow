+package server
+
+import (
+	"strings"
+
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// setFieldCollation writes fc, the engine's collation of the STRINGs
+// inside a STRUCT or an ARRAY column, into field, its TableFieldSchema:
+// a REPEATED field's collation is its element's, a RECORD's fields'
+// their own. CloudBurrow patch (cloudburrow/cloudburrow#1516).
+func setFieldCollation(field *bigqueryv2.TableFieldSchema, fc *googlesqlite.FieldCollation) {
+	if field == nil || fc == nil {
+		return
+	}
+	if strings.EqualFold(field.Mode, "REPEATED") {
+		if fc = fc.Element; fc == nil {
+			return
+		}
+	}
+	if strings.EqualFold(field.Type, "RECORD") || strings.EqualFold(field.Type, "STRUCT") {
+		for i, sub := range field.Fields {
+			if i < len(fc.Fields) {
+				setFieldCollation(sub, fc.Fields[i])
+			}
+		}
+		return
+	}
+	if strings.EqualFold(field.Type, "STRING") {
+		field.Collation = fc.Collation
+	}
+}
