+package server_test
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"cloud.google.com/go/bigquery"
+	"google.golang.org/api/option"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestNestedCollatedFields is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1516): a RECORD's STRING field and a REPEATED
+// STRING that tables.insert gives the collation 'und:ci' compare
+// case-insensitively, and a CREATE TABLE's nested collations read back
+// from tables.get. Before the patch the engine's table had no nested
+// collation and tables.get read none.
+func TestNestedCollatedFields(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(types.NewProject("test", types.NewDataset("ds")))); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	client, err := bigquery.NewClient(ctx, "test", option.WithEndpoint(testServer.URL), option.WithoutAuthentication())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	if err := client.Dataset("ds").Table("n").Create(ctx, &bigquery.TableMetadata{Schema: bigquery.Schema{
+		{Name: "r", Type: bigquery.RecordFieldType, Schema: bigquery.Schema{
+			{Name: "a", Type: bigquery.StringFieldType, Collation: "und:ci"},
+			{Name: "b", Type: bigquery.StringFieldType},
+		}},
+		{Name: "tags", Type: bigquery.StringFieldType, Repeated: true, Collation: "und:ci"},
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	run := func(q string) {
+		t.Helper()
+		job, err := client.Query(q).Run(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if status, err := job.Wait(ctx); err != nil || status.Err() != nil {
+			t.Fatalf("%s: %v, %v", q, err, status.Err())
+		}
+	}
+	run("INSERT INTO ds.n (r, tags) VALUES (STRUCT('Abc', 'Abc'), ['Abc'])")
+	for q, want := range map[string]int64{
+		"SELECT COUNT(*) FROM ds.n WHERE r.a = 'aBC'":           1,
+		"SELECT COUNT(*) FROM ds.n WHERE r.b = 'aBC'":           0,
+		"SELECT COUNT(*) FROM ds.n WHERE 'aBC' IN UNNEST(tags)": 1,
+	} {
+		it, err := client.Query(q).Read(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var row []bigquery.Value
+		if err := it.Next(&row); err != nil {
+			t.Fatal(err)
+		}
+		if len(row) != 1 || row[0] != want {
+			t.Errorf("%s = %v, want %d", q, row, want)
+		}
+	}
+	// A CREATE TABLE's nested collations read back from tables.get.
+	run("CREATE TABLE ds.d (st STRUCT<a STRING, b STRING COLLATE ''>, arr ARRAY<STRING>, sa ARRAY<STRUCT<x STRING>>) DEFAULT COLLATE 'und:ci'")
+	md, err := client.Dataset("ds").Table("d").Metadata(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got []string
+	var walk func(prefix string, s bigquery.Schema)
+	walk = func(prefix string, s bigquery.Schema) {
+		for _, f := range s {
+			if f.Type == bigquery.RecordFieldType {
+				walk(prefix+f.Name+".", f.Schema)
+				continue
+			}
+			got = append(got, prefix+f.Name+"="+f.Collation)
+		}
+	}
+	walk("", md.Schema)
+	if want := "st.a=und:ci st.b= arr=und:ci sa.x=und:ci"; strings.Join(got, " ") != want {
+		t.Errorf("DDL table's collations %q, want %q", strings.Join(got, " "), want)
+	}
+}
