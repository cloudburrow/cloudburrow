--- /dev/null
+++ b/server/cloudburrow_names_project.go
@@ -0,0 +1,17 @@
+package server
+
+import bigqueryv2 "google.golang.org/api/bigquery/v2"
+
+// namesProject is the project a query's names without a project are read
+// in: its default dataset's project when it has one, the job's otherwise.
+// BigQuery's defaultDataset "specifies the default datasetId and
+// projectId to assume for any unqualified table names in the query"
+// (https://cloud.google.com/bigquery/docs/reference/rest/v2/Job#jobconfigurationquery).
+// The engine reads a name of two parts in this project (googlesqlite
+// patch 0095). CloudBurrow patch (cloudburrow/cloudburrow#1784).
+func namesProject(jobProject string, defaultDataset *bigqueryv2.DatasetReference) string {
+	if defaultDataset != nil && defaultDataset.ProjectId != "" {
+		return defaultDataset.ProjectId
+	}
+	return jobProject
+}
--- /dev/null
+++ b/server/cloudburrow_names_project_test.go
@@ -0,0 +1,25 @@
+package server
+
+import (
+	"testing"
+
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+)
+
+// TestNamesProject is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1784): a query's names without a project are
+// read in its default dataset's project, the job's when it has none.
+func TestNamesProject(t *testing.T) {
+	for _, tc := range []struct {
+		ds   *bigqueryv2.DatasetReference
+		want string
+	}{
+		{nil, "job"},
+		{&bigqueryv2.DatasetReference{DatasetId: "ds"}, "job"},
+		{&bigqueryv2.DatasetReference{ProjectId: "other", DatasetId: "ds"}, "other"},
+	} {
+		if got := namesProject("job", tc.ds); got != tc.want {
+			t.Errorf("namesProject(job, %+v) = %q, want %q", tc.ds, got, tc.want)
+		}
+	}
+}
