+	// CloudBurrow patch (cloudburrow/cloudburrow#1814): a parameter of a
+	// type no Go value has (a DATETIME's time.Time was a TIMESTAMP, the
+	// others' strings STRINGs) is bound as a value of its own type, so in
+	// the select list it has the type BigQuery gives it.
+	case "BYTES", "NUMERIC", "BIGNUMERIC", "DECIMAL", "BIGDECIMAL",
+		"DATE", "TIME", "DATETIME", "GEOGRAPHY", "JSON", "INTERVAL":
+		return googlesqlite.TypedParameter{Type: upper, Value: s}
 	}
 	return value
