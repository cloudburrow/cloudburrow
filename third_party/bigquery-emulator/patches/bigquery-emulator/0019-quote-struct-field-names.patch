--- a/internal/contentdata/repository.go
+++ b/internal/contentdata/repository.go
@@ -200,7 +200,10 @@
 	if field.Type == "RECORD" {
 		types := make([]string, 0, len(field.Fields))
 		for _, f := range field.Fields {
-			types = append(types, fmt.Sprintf("%s %s", f.Name, r.encodeSchemaField(f)))
+			// CloudBurrow patch (cloudburrow/cloudburrow#1373): the field's
+			// name quoted, as a column's is, so a flexible name ("in ner")
+			// or a keyword makes the table.
+			types = append(types, fmt.Sprintf("`%s` %s", f.Name, r.encodeSchemaField(f)))
 		}
 		elem = fmt.Sprintf("STRUCT<%s>", strings.Join(types, ","))
 	} else {
