-// jobExists reports whether the jobs table has the job.
+// loadJobKeys reads which jobs the jobs table holds, once, into jobKeys.
+// CloudBurrow patch (cloudburrow/cloudburrow#1103).
+func (r *Repository) loadJobKeys(ctx context.Context, tx *sql.Tx) error {
+	rows, err := tx.QueryContext(ctx, "SELECT projectID, id FROM jobs")
+	if err != nil {
+		return fmt.Errorf("failed to read the jobs: %w", err)
+	}
+	defer rows.Close()
+	for rows.Next() {
+		var k jobKey
+		if err := rows.Scan(&k.projectID, &k.jobID); err != nil {
+			return err
+		}
+		r.jobKeys[k] = struct{}{}
+	}
+	return rows.Err()
+}
+
+func (r *Repository) setJobKey(projectID, jobID string, present bool) {
+	r.jobKeysMu.Lock()
+	defer r.jobKeysMu.Unlock()
+	if present {
+		r.jobKeys[jobKey{projectID, jobID}] = struct{}{}
+	} else {
+		delete(r.jobKeys, jobKey{projectID, jobID})
+	}
+}
+
