--- /dev/null
+++ b/cmd/bigquery-emulator/cloudburrow_pprof.go
@@ -0,0 +1,46 @@
+package main
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1655): the Go runtime's
+// profiles (net/http/pprof) when BIGQUERY_EMULATOR_DEBUG_PPROF names a
+// loopback address, as CloudBurrow's own processes serve them under
+// CLOUDBURROW_DEBUG_PPROF (#1609); the name differs because the supervisor
+// that runs the emulator reads that one and takes its address. Off by
+// default: with the variable unset nothing listens. In a pod, read them with
+// `kubectl port-forward`, which reaches the pod's loopback.
+
+import (
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/pprof"
+	"os"
+	"time"
+)
+
+const cloudburrowPprofEnv = "BIGQUERY_EMULATOR_DEBUG_PPROF"
+
+func init() {
+	addr := os.Getenv(cloudburrowPprofEnv)
+	if addr == "" {
+		return
+	}
+	host, _, err := net.SplitHostPort(addr)
+	if ip := net.ParseIP(host); err != nil || ip == nil || !ip.IsLoopback() {
+		fmt.Fprintf(os.Stderr, "[bigquery-emulator] %s=%q: the address must be a loopback IP, such as 127.0.0.1:6060\n", cloudburrowPprofEnv, addr)
+		return
+	}
+	ln, err := net.Listen("tcp", addr)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "[bigquery-emulator] %s: %v\n", cloudburrowPprofEnv, err)
+		return
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/debug/pprof/", pprof.Index)
+	mux.HandleFunc("/debug/pprof/cmdline", pprof.Cmdline)
+	mux.HandleFunc("/debug/pprof/profile", pprof.Profile)
+	mux.HandleFunc("/debug/pprof/symbol", pprof.Symbol)
+	mux.HandleFunc("/debug/pprof/trace", pprof.Trace)
+	srv := &http.Server{Handler: mux, ReadHeaderTimeout: 10 * time.Second}
+	go func() { _ = srv.Serve(ln) }()
+	fmt.Fprintf(os.Stderr, "[bigquery-emulator] serving pprof on http://%s/debug/pprof/ (%s)\n", ln.Addr(), cloudburrowPprofEnv)
+}
