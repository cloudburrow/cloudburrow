diff --git a/internal/contentdata/repository.go b/internal/contentdata/repository.go
--- a/internal/contentdata/repository.go
+++ b/internal/contentdata/repository.go
@@ -732,6 +732,14 @@
 			// it as a JSON string literal (double-encoded). PARSE_JSON turns
 			// the bound JSON text into a proper JSON value.
 			placeholders = append(placeholders, "PARSE_JSON(?)")
+		} else if col.Type == types.GEOGRAPHY && col.Mode != types.RepeatedMode {
+			// CloudBurrow patch (cloudburrow/cloudburrow#1547): a
+			// GEOGRAPHY value is bound as its text (WKT, or GeoJSON:
+			// tabledata.insertAll, JSON and CSV loads), which the engine
+			// stored as a STRING, so a geography function of the column
+			// failed "expected GEOGRAPHY, got value.StringValue".
+			// ST_GEOGFROM reads either into a geography.
+			placeholders = append(placeholders, "ST_GEOGFROM(CAST(? AS STRING))")
 		} else if col.Type == types.RANGE && col.Mode != types.RepeatedMode {
 			// CloudBurrow patch (cloudburrow/cloudburrow#1492): a RANGE
