+package contentdata
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestNestedGeographyWKT is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1138): a GEOGRAPHY given as WKT text inside a
+// RECORD or a REPEATED column was stored as given (POINT (1 2)); only a
+// top-level one was written in BigQuery's form (POINT(1 2)).
+func TestNestedGeographyWKT(t *testing.T) {
+	rec := &types.Column{Name: "r", Type: types.RECORD, Fields: []*types.Column{{Name: "g", Type: types.GEOGRAPHY}}}
+	got, err := decodeBytesValues(map[string]interface{}{"g": "POINT (1 2)"}, rec)
+	if err != nil || !reflect.DeepEqual(got, map[string]interface{}{"g": "POINT(1 2)"}) {
+		t.Errorf("RECORD: %v, %v", got, err)
+	}
+	rep := &types.Column{Name: "a", Type: types.GEOGRAPHY, Mode: types.RepeatedMode}
+	got, err = decodeBytesValues([]interface{}{"POINT (1 2)", "POINT EMPTY"}, rep)
+	if err != nil || !reflect.DeepEqual(got, []interface{}{"POINT(1 2)", "GEOMETRYCOLLECTION EMPTY"}) {
+		t.Errorf("REPEATED: %v, %v", got, err)
+	}
+	rr := &types.Column{Name: "rr", Type: types.RECORD, Mode: types.RepeatedMode, Fields: rec.Fields}
+	got, err = decodeBytesValues([]interface{}{map[string]interface{}{"g": "LINESTRING (0 0, 1 1)"}}, rr)
+	if err != nil || !reflect.DeepEqual(got, []interface{}{map[string]interface{}{"g": "LINESTRING(0 0, 1 1)"}}) {
+		t.Errorf("REPEATED RECORD: %v, %v", got, err)
+	}
+}
