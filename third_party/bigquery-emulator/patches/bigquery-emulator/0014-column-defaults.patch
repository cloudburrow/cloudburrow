+			fmt.Fprintf(&key, "%d,", i)
+			cols = append(cols, col)
+		}
+		if key.String() != runKey || len(cols) == 0 {
+			if err := flush(); err != nil {
+				return err
+			}
+			runKey, runColumns = key.String(), cols
+		}
+		if len(cols) == 0 {
+			// A row that gives no column, of a table whose every column
+			// has a default.
+			tablePath, err := r.tablePath(projectID, datasetID, table.ID)
+			if err != nil {
+				return err
+			}
+			if _, err := tx.Tx().ExecContext(ctx, fmt.Sprintf("INSERT `%s` (`%s`) VALUES (DEFAULT)",
+				tablePath, escapeIdent(allColumns[0].Name))); err != nil {
+				return err
+			}
+			continue
+		}
+		run = append(run, data)
+	}
+	return flush()
+}
 
