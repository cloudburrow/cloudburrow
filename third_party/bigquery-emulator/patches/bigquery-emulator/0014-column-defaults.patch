+package server_test
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"cloud.google.com/go/bigquery"
+	"google.golang.org/api/iterator"
+	"google.golang.org/api/option"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestColumnDefaults is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1340): a column made by tables.insert with a
+// defaultValueExpression read back NULL from an INSERT that left it out,
+// and tabledata.insertAll never applied a default; a CREATE TABLE
+// column's DEFAULT was applied by the engine but tables.get had no
+// defaultValueExpression for it.
+func TestColumnDefaults(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(types.NewProject("test", types.NewDataset("ds")))); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	client, err := bigquery.NewClient(ctx, "test", option.WithEndpoint(testServer.URL), option.WithoutAuthentication())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	ds := client.Dataset("ds")
+	run := func(q string) {
+		t.Helper()
+		job, err := client.Query(q).Run(ctx)
+		if err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		if status, err := job.Wait(ctx); err != nil || status.Err() != nil {
+			t.Fatalf("%s: %v, %v", q, err, status.Err())
+		}
+	}
+	read := func(table string) []string {
+		t.Helper()
+		it, err := client.Query("SELECT id, s FROM ds." + table + " ORDER BY id").Read(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var out []string
+		for {
+			var row []bigquery.Value
+			if err := it.Next(&row); err == iterator.Done {
+				break
+			} else if err != nil {
+				t.Fatal(err)
+			}
+			out = append(out, fmt.Sprint(row))
+		}
+		return out
+	}
+
+	api := ds.Table("api")
+	if err := api.Create(ctx, &bigquery.TableMetadata{Schema: bigquery.Schema{
+		{Name: "id", Type: bigquery.IntegerFieldType},
+		{Name: "s", Type: bigquery.StringFieldType, DefaultValueExpression: "'dflt'"},
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	run("INSERT INTO ds.api (id) VALUES (1)")
+	if err := api.Inserter().Put(ctx, []*bigquery.ValuesSaver{
+		{Schema: bigquery.Schema{{Name: "id", Type: bigquery.IntegerFieldType}}, Row: []bigquery.Value{2}},
+		{Schema: bigquery.Schema{{Name: "id", Type: bigquery.IntegerFieldType}, {Name: "s", Type: bigquery.StringFieldType}},
+			Row: []bigquery.Value{3, nil}},
+		{Schema: bigquery.Schema{{Name: "id", Type: bigquery.IntegerFieldType}}, Row: []bigquery.Value{4}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := fmt.Sprint(read("api")), "[[1 dflt] [2 dflt] [3 <nil>] [4 dflt]]"; got != want {
+		t.Errorf("tables.insert table: rows %s, want %s", got, want)
+	}
+
+	run("CREATE TABLE ds.ddl (id INT64, s STRING DEFAULT 'x')")
+	md, err := ds.Table("ddl").Metadata(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(md.Schema) != 2 || md.Schema[1].DefaultValueExpression != "'x'" || md.Schema[0].DefaultValueExpression != "" {
+		t.Errorf("CREATE TABLE schema defaults: %+v %+v, want s's 'x'", md.Schema[0], md.Schema[1])
+	}
+	run("INSERT INTO ds.ddl (id) VALUES (1)")
+	if got, want := fmt.Sprint(read("ddl")), "[[1 x]]"; got != want {
+		t.Errorf("CREATE TABLE table: rows %s, want %s", got, want)
+	}
+}
