--- /dev/null
+++ b/server/struct_json_field_test.go
@@ -0,0 +1,79 @@
+package server_test
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"cloud.google.com/go/bigquery"
+	"google.golang.org/api/option"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestStructJSONFieldInsertAll is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1783): tabledata.insertAll of a RECORD with a
+// JSON field (or an ARRAY<STRUCT<JSON>>) stored the field as a JSON
+// string, so JSON_VALUE(s.d, '$.x') was NULL and the row read back as
+// quoted text; an insertAll into a REPEATED JSON column failed 500
+// ("Value has type JSON which cannot be inserted into column aj").
+func TestStructJSONFieldInsertAll(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(types.NewProject("test", types.NewDataset("ds")))); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	client, err := bigquery.NewClient(ctx, "test", option.WithEndpoint(testServer.URL), option.WithoutAuthentication())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	tb := client.Dataset("ds").Table("t")
+	schema := bigquery.Schema{
+		{Name: "j", Type: bigquery.JSONFieldType},
+		{Name: "s", Type: bigquery.RecordFieldType, Schema: bigquery.Schema{{Name: "n", Type: bigquery.StringFieldType}, {Name: "d", Type: bigquery.JSONFieldType}}},
+		{Name: "a", Type: bigquery.RecordFieldType, Repeated: true, Schema: bigquery.Schema{{Name: "d", Type: bigquery.JSONFieldType}}},
+		{Name: "aj", Type: bigquery.JSONFieldType, Repeated: true},
+	}
+	if err := tb.Create(ctx, &bigquery.TableMetadata{Schema: schema}); err != nil {
+		t.Fatal(err)
+	}
+	if err := tb.Inserter().Put(ctx, &bigquery.ValuesSaver{Schema: schema, Row: []bigquery.Value{`{"x":{"y":"z"}}`,
+		[]bigquery.Value{"a", `{"x":{"y":"z"}}`}, []bigquery.Value{[]bigquery.Value{`{"x":1}`}}, []bigquery.Value{`{"x":2}`, `3`}}}); err != nil {
+		t.Fatalf("insertAll: %v", err)
+	}
+	for _, tc := range []struct{ q, want string }{
+		{"SELECT JSON_VALUE(j, '$.x.y') FROM ds.t", "[z]"},
+		{"SELECT JSON_VALUE(s.d, '$.x.y') FROM ds.t", "[z]"},
+		{"SELECT TO_JSON_STRING(s.d) FROM ds.t", `[{"x":{"y":"z"}}]`},
+		{"SELECT JSON_VALUE(a[OFFSET(0)].d, '$.x') FROM ds.t", "[1]"},
+		{"SELECT JSON_VALUE(aj[OFFSET(0)], '$.x') FROM ds.t", "[2]"},
+		{"SELECT TO_JSON_STRING(aj) FROM ds.t", `[[{"x":2},3]]`},
+		{"SELECT s FROM ds.t", `[[a {"x":{"y":"z"}}]]`},
+	} {
+		it, err := client.Query(tc.q).Read(ctx)
+		if err != nil {
+			t.Errorf("%s: %v", tc.q, err)
+			continue
+		}
+		var row []bigquery.Value
+		if err := it.Next(&row); err != nil {
+			t.Errorf("%s: %v", tc.q, err)
+			continue
+		}
+		if got := fmt.Sprint(row); got != tc.want {
+			t.Errorf("%s = %s, want %s", tc.q, got, tc.want)
+		}
+	}
+}
