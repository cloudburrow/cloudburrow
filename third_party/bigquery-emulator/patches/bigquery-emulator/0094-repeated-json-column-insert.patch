+++ b/internal/contentdata/repository.go
@@ -754,7 +754,7 @@
 		if err := validateIdent("column", col.Name); err != nil {
 			return err
 		}
-		if col.Type == types.JSON {
+		if col.Type == types.JSON && col.Mode != types.RepeatedMode {
 			// A JSON column cannot take a raw bound string: SQLite would store
 			// it as a JSON string literal (double-encoded). PARSE_JSON turns
 			// the bound JSON text into a proper JSON value.
@@ -815,6 +815,32 @@
 				continue
 			}
 
+			if column.Type == types.JSON && column.Mode == types.RepeatedMode {
+				// CloudBurrow patch (cloudburrow/cloudburrow#1783): a
+				// REPEATED JSON column took PARSE_JSON(?) too, which the
+				// engine refuses ("Value has type JSON which cannot be
+				// inserted into column aj, which has type ARRAY<JSON>"), so
+				// every insertAll of one failed 500. The array is bound as
+				// it is, each element JSON text (or a value, marshaled),
+				// which the engine reads as JSON (googlesqlite patch 0093).
+				elems, ok := value.([]interface{})
+				if !ok {
+					return fmt.Errorf("column %s: a REPEATED JSON value is an array, got %T", column.Name, value)
+				}
+				texts := make([]interface{}, len(elems))
+				for i, e := range elems {
+					if e == nil {
+						continue
+					}
+					jsonText, err := jsonColumnText(e)
+					if err != nil {
+						return fmt.Errorf("failed to encode JSON value for column %s: %w", column.Name, err)
+					}
+					texts[i] = jsonText
+				}
+				values = append(values, texts)
+				continue
+			}
