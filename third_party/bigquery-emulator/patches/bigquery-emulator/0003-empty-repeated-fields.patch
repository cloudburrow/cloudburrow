new file mode 100644
index 0000000..fd5196c
--- /dev/null
+++ b/types/repeated_empty_test.go
@@ -0,0 +1,55 @@
+package types
+
+import (
+	"reflect"
+	"testing"
+
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+)
+
+// TestRepeatedFieldGivenNullIsAnEmptyArray is a CloudBurrow regression
+// test (cloudburrow/cloudburrow#1124): a REPEATED field given as null was
+// refused ("invalid value type <nil> for ARRAY column"), and one a RECORD
+// left out was NULL, where BigQuery writes an empty array. (A REPEATED
+// column a row leaves out is written so by AddTableData:
+// server/repeated_empty_test.go.)
+func TestRepeatedFieldGivenNullIsAnEmptyArray(t *testing.T) {
+	table := &bigqueryv2.Table{
+		TableReference: &bigqueryv2.TableReference{TableId: "t"},
+		Schema: &bigqueryv2.TableSchema{
+			Fields: []*bigqueryv2.TableFieldSchema{
+				{Name: "id", Type: "INTEGER"},
+				{Name: "tags", Type: "STRING", Mode: "REPEATED"},
+				{Name: "rec", Type: "RECORD", Fields: []*bigqueryv2.TableFieldSchema{
+					{Name: "n", Type: "INTEGER"},
+					{Name: "xs", Type: "INTEGER", Mode: "REPEATED"},
+				}},
+			},
+		},
+	}
+	got, err := NewTableWithSchema(table, Data{
+		{"id": 1},
+		{"id": 2, "tags": nil, "rec": map[string]interface{}{"n": 3}},
+		{"id": 3, "tags": []interface{}{"a"}, "rec": map[string]interface{}{"n": 4, "xs": nil}},
+		{"id": 4, "rec": nil},
+	})
+	if err != nil {
+		t.Fatalf("NewTableWithSchema: %v", err)
+	}
+	empty := []interface{}{}
+	wantTags := []interface{}{nil, empty, []interface{}{"a"}, nil}
+	for i, row := range got.Data {
+		if !reflect.DeepEqual(row["tags"], wantTags[i]) {
+			t.Errorf("row %d: tags = %#v, want %#v", i, row["tags"], wantTags[i])
+		}
+	}
+	for i, n := range []int{1, 2} {
+		rec, ok := got.Data[n]["rec"].([]map[string]interface{})
+		if !ok || len(rec) != 2 || !reflect.DeepEqual(rec[1]["xs"], empty) {
+			t.Errorf("row %d: rec = %#v, want xs an empty array", i+1, got.Data[n]["rec"])
+		}
+	}
+	if got.Data[3]["rec"] != nil {
+		t.Errorf("row 3: rec = %#v, want NULL", got.Data[3]["rec"])
+	}
+}
