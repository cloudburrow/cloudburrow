CloudBurrow Authors.

diff --git a/internal/contentdata/repository.go b/internal/contentdata/repository.go
index df6b00d..ee5377c 100644
--- a/internal/contentdata/repository.go
+++ b/internal/contentdata/repository.go
@@ -629,6 +629,13 @@ func (r *Repository) AddTableData(ctx context.Context, tx *connection.Tx, projec
 		for _, column := range columns {
 			value, found := data[column.Name]
 			if !found || value == nil {
+				// CloudBurrow patch (cloudburrow/cloudburrow#1124): in
+				// BigQuery a stored array is never NULL; a REPEATED column
+				// a row leaves out (or gives as null) is an empty array.
+				if column.Mode == types.RepeatedMode {
+					values = append(values, []interface{}{})
+					continue
+				}
 				values = append(values, nil)
 				continue
 			}
diff --git a/server/repeated_empty_test.go b/server/repeated_empty_test.go
new file mode 100644
index 0000000..9041e41
--- /dev/null
+++ b/server/repeated_empty_test.go
@@ -0,0 +1,83 @@
+package server_test
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"cloud.google.com/go/bigquery"
+	"google.golang.org/api/iterator"
+	"google.golang.org/api/option"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestRepeatedColumnLeftOutIsAnEmptyArray is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1124): a REPEATED column a streamed row or a
+// load's record left out was stored NULL, where in BigQuery "each array is
+// written as an empty array".
+func TestRepeatedColumnLeftOutIsAnEmptyArray(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(types.NewProject("test", types.NewDataset("ds")))); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	client, err := bigquery.NewClient(ctx, "test", option.WithEndpoint(testServer.URL), option.WithoutAuthentication())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	schema := bigquery.Schema{
+		{Name: "id", Type: bigquery.IntegerFieldType},
+		{Name: "tags", Type: bigquery.StringFieldType, Repeated: true},
+	}
+	table := client.Dataset("ds").Table("t")
+	if err := table.Create(ctx, &bigquery.TableMetadata{Schema: schema}); err != nil {
+		t.Fatal(err)
+	}
+	if err := table.Inserter().Put(ctx, []*bigquery.ValuesSaver{
+		{Schema: bigquery.Schema{schema[0]}, InsertID: "1", Row: []bigquery.Value{int64(1)}},
+		{Schema: schema, InsertID: "2", Row: []bigquery.Value{int64(2), []bigquery.Value{"a", "b"}}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	src := bigquery.NewReaderSource(strings.NewReader("{\"id\":3}\n"))
+	src.SourceFormat = bigquery.JSON
+	job, err := table.LoaderFrom(src).Run(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if status, err := job.Wait(ctx); err != nil || status.Err() != nil {
+		t.Fatalf("load: %v, %v", err, status)
+	}
+	it, err := client.Query("SELECT id, tags IS NULL, ARRAY_LENGTH(tags), ARRAY_TO_STRING(IFNULL(tags, ['NULL']), ',') FROM ds.t ORDER BY id").Read(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := [][]bigquery.Value{{int64(1), false, int64(0), ""}, {int64(2), false, int64(2), "a,b"}, {int64(3), false, int64(0), ""}}
+	for i := 0; ; i++ {
+		var row []bigquery.Value
+		if err := it.Next(&row); err == iterator.Done {
+			if i != len(want) {
+				t.Errorf("%d rows, want %d", i, len(want))
+			}
+			break
+		} else if err != nil {
+			t.Fatal(err)
+		}
+		if i >= len(want) || len(row) != 4 || row[0] != want[i][0] || row[1] != want[i][1] || row[2] != want[i][2] || row[3] != want[i][3] {
+			t.Errorf("row %d = %v, want %v", i, row, want[min(i, len(want)-1)])
+		}
+	}
+}
