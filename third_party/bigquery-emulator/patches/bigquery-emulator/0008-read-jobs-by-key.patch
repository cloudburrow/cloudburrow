+package metadata
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"testing"
+)
+
+// CloudBurrow regression test (cloudburrow/cloudburrow#1103): a job is read
+// by its primary key, as SQLite SQL, and still found as it was: its
+// metadata, result and error, only in its own project, and not at all
+// once deleted.
+func TestFindJobByKey(t *testing.T) {
+	r, _ := testRepository(t)
+	ctx := context.Background()
+	failed := queryJob(r, "failed", 0)
+	failed.err = errors.New("it 'failed'")
+	addJobs(t, r, queryJob(r, "a", 3), queryJob(r, "a2", 4), queryJob(r, "ä 'quoted\"", 2), failed)
+	// The same ID in another project.
+	inTx(t, r, func(ctx context.Context, tx *sql.Tx) error {
+		other := NewProject(r, "q", nil, nil)
+		if err := other.Insert(ctx, tx); err != nil {
+			return err
+		}
+		j := queryJob(r, "a", 7)
+		j.ProjectID = "q"
+		return other.AddJob(ctx, tx, j)
+	})
+
+	for id, rows := range map[string]int{"a": 3, "a2": 4, "ä 'quoted\"": 2} {
+		job, err := r.FindJob(ctx, "p", id)
+		if err != nil || job == nil {
+			t.Fatalf("FindJob(p, %q) = %v, %v", id, job, err)
+		}
+		if job.ID != id || len(job.response.Rows) != rows || job.content.JobReference.JobId != id {
+			t.Errorf("FindJob(p, %q): job %q, %d rows, metadata %q; want %d rows", id, job.ID, len(job.response.Rows), job.content.JobReference.JobId, rows)
+		}
+		metas, err := r.findJobsMetadata(ctx, "p", []string{id})
+		if err != nil || len(metas) != 1 || metas[0].content.JobReference.JobId != id || metas[0].response != nil {
+			t.Errorf("findJobsMetadata(p, %q) = %v, %v; want the job without its result", id, metas, err)
+		}
+	}
+	if job, err := r.FindJob(ctx, "q", "a"); err != nil || job == nil || len(job.response.Rows) != 7 {
+		t.Errorf("FindJob(q, a) = %v, %v; want project q's job of 7 rows", job, err)
+	}
+	if job, err := r.FindJob(ctx, "p", "failed"); err != nil || job == nil || job.err == nil || job.err.Error() != "it 'failed'" {
+		t.Errorf("FindJob(p, failed) = %v, %v; want its error", job, err)
+	}
+	for _, key := range [][2]string{{"p", "missing"}, {"q", "a2"}, {"r", "a"}, {"p", "A"}} {
+		if job, err := r.FindJob(ctx, key[0], key[1]); err != nil || job != nil {
+			t.Errorf("FindJob(%s, %s) = %v, %v; want none", key[0], key[1], job, err)
+		}
+		if metas, err := r.findJobsMetadata(ctx, key[0], []string{key[1]}); err != nil || len(metas) != 0 {
+			t.Errorf("findJobsMetadata(%s, %s) = %v, %v; want none", key[0], key[1], metas, err)
+		}
+	}
+
+	project, err := r.FindProject(ctx, "p")
+	if err != nil {
+		t.Fatal(err)
+	}
+	inTx(t, r, func(ctx context.Context, tx *sql.Tx) error { return project.DeleteJob(ctx, tx, "a") })
+	if job, err := r.FindJob(ctx, "p", "a"); err != nil || job != nil {
+		t.Errorf("FindJob(p, a) after its deletion = %v, %v; want none", job, err)
+	}
+}
