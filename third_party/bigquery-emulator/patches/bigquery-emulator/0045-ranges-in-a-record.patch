+// hasNestedRange reports whether fl, a RECORD, holds a RANGE field at any
+// depth (cloudburrow/cloudburrow#1456).
+func hasNestedRange(fl *bigqueryv2.TableFieldSchema) bool {
+	for _, sub := range fl.Fields {
+		if sub == nil {
+			continue
+		}
+		if sub.Type == "RANGE" || (sub.Type == "RECORD" || sub.Type == "STRUCT") && hasNestedRange(sub) {
+			return true
+		}
+	}
+	return false
+}
+
+// formatNestedRanges writes the RANGE values inside v, a RECORD cell of fl
+// (or a REPEATED RECORD's cells), in the REST form formatRangeCells gives a
+// top-level one (cloudburrow/cloudburrow#1456): Format rewrote only
+// top-level and REPEATED RANGE values, so a TIMESTAMP RANGE in a RECORD read
+// back as GoogleSQL text, which the official clients cannot parse.
+func formatNestedRanges(fl *bigqueryv2.TableFieldSchema, v interface{}) interface{} {
+	switch x := v.(type) {
+	case []*TableCell:
+		out := make([]*TableCell, 0, len(x))
+		for _, it := range x {
+			if it == nil || it.V == nil {
+				out = append(out, it)
+				continue
+			}
+			out = append(out, &TableCell{V: formatNestedRanges(fl, it.V)})
+		}
+		return out
+	case TableRow:
+		return formatNestedRow(fl, &x)
+	case *TableRow:
+		if x == nil {
+			return v
+		}
+		r := formatNestedRow(fl, x)
+		return &r
+	}
+	return v
 }
+
+func formatNestedRow(fl *bigqueryv2.TableFieldSchema, row *TableRow) TableRow {
+	cells := make([]*TableCell, 0, len(row.F))
+	for i, cell := range row.F {
+		if i >= len(fl.Fields) || cell == nil || cell.V == nil || fl.Fields[i] == nil {
+			cells = append(cells, cell)
+			continue
+		}
+		switch sub := fl.Fields[i]; {
+		case sub.Type == "RANGE":
+			cells = append(cells, &TableCell{V: formatRangeCells(sub, cell.V)})
+		case (sub.Type == "RECORD" || sub.Type == "STRUCT") && hasNestedRange(sub):
+			cells = append(cells, &TableCell{V: formatNestedRanges(sub, cell.V)})
+		default:
+			cells = append(cells, cell)
+		}
+	}
+	return TableRow{F: cells}
+}
