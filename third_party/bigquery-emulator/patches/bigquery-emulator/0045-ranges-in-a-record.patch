+package types
+
+import (
+	"testing"
+
+	bigqueryv2 "google.golang.org/api/bigquery/v2"
+)
+
+// A RANGE in a RECORD, and in a REPEATED RECORD in a RECORD, reads back in
+// BigQuery's REST form, as a top-level one does (cloudburrow/cloudburrow#1456).
+func TestFormatRangeInARecord(t *testing.T) {
+	ts := &bigqueryv2.TableFieldSchema{Name: "r", Type: "RANGE",
+		RangeElementType: &bigqueryv2.TableFieldSchemaRangeElementType{Type: "TIMESTAMP"}}
+	dt := &bigqueryv2.TableFieldSchema{Name: "d", Type: "RANGE",
+		RangeElementType: &bigqueryv2.TableFieldSchemaRangeElementType{Type: "DATETIME"}}
+	inner := &bigqueryv2.TableFieldSchema{Name: "in", Type: "RECORD", Mode: "REPEATED", Fields: []*bigqueryv2.TableFieldSchema{dt}}
+	schema := &bigqueryv2.TableSchema{Fields: []*bigqueryv2.TableFieldSchema{{Name: "s", Type: "RECORD",
+		Fields: []*bigqueryv2.TableFieldSchema{{Name: "a", Type: "STRING"}, ts, inner}}}}
+	rows := []*TableRow{{F: []*TableCell{{V: TableRow{F: []*TableCell{
+		{V: "x"},
+		{V: "[2020-01-01 00:00:00+00, UNBOUNDED)"},
+		{V: []*TableCell{{V: TableRow{F: []*TableCell{{V: "[2020-01-01 10:00:00, 2020-01-02 00:00:00)"}}}}}},
+	}}}}}}
+	got := Format(schema, rows, true)[0].F[0].V.(TableRow)
+	if v := got.F[0].V; v != "x" {
+		t.Errorf("STRING field = %v", v)
+	}
+	if v := got.F[1].V; v != "[1577836800000000, UNBOUNDED)" {
+		t.Errorf("TIMESTAMP RANGE field = %v", v)
+	}
+	in := got.F[2].V.([]*TableCell)[0].V.(TableRow)
+	if v := in.F[0].V; v != "[2020-01-01T10:00:00, 2020-01-02T00:00:00)" {
+		t.Errorf("DATETIME RANGE in a REPEATED RECORD = %v", v)
+	}
+}
