--- a/server/handler.go
+++ b/server/handler.go
@@ -1897,7 +1897,12 @@
 	}
 	job.Kind = "bigquery#job"
 	job.Configuration.JobType = "QUERY"
-	job.Configuration.Query.Priority = "INTERACTIVE"
+	// CloudBurrow patch (cloudburrow/cloudburrow#2105): a query job keeps
+	// the priority it was inserted with, BATCH or INTERACTIVE (the
+	// default), as BigQuery reports it in configuration.query.priority.
+	if job.Configuration.Query.Priority != "BATCH" {
+		job.Configuration.Query.Priority = "INTERACTIVE"
+	}
 	job.SelfLink = fmt.Sprintf(
 		"http://%s/bigquery/v2/projects/%s/jobs/%s",
 		r.server.httpServer.Addr,
