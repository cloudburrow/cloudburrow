+package server_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"cloud.google.com/go/bigquery"
+	"google.golang.org/api/option"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestResourceTimesAreMilliseconds is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1310): a table's creationTime and
+// lastModifiedTime, and a job's statistics.creationTime, startTime and
+// endTime, were given in seconds since the epoch, where BigQuery gives
+// milliseconds, so the Go client read them as January 1970; a dataset had
+// none at all.
+func TestResourceTimesAreMilliseconds(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(types.NewProject("test",
+		types.NewDataset("loaded", types.NewTable("t0", []*types.Column{types.NewColumn("id", types.INT64)}, nil))))); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	client, err := bigquery.NewClient(ctx, "test", option.WithEndpoint(testServer.URL), option.WithoutAuthentication())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	near := func(what string, got time.Time) {
+		t.Helper()
+		if d := time.Since(got); d < -time.Minute || d > time.Minute {
+			t.Errorf("%s = %v, want within a minute of now", what, got)
+		}
+	}
+
+	ds := client.Dataset("ds")
+	if err := ds.Create(ctx, &bigquery.DatasetMetadata{}); err != nil {
+		t.Fatal(err)
+	}
+	dmd, err := ds.Metadata(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	near("dataset CreationTime", dmd.CreationTime)
+	near("dataset LastModifiedTime", dmd.LastModifiedTime)
+
+	table := ds.Table("t")
+	if err := table.Create(ctx, &bigquery.TableMetadata{Schema: bigquery.Schema{{Name: "id", Type: bigquery.IntegerFieldType}}}); err != nil {
+		t.Fatal(err)
+	}
+	tmd, err := table.Metadata(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	near("table CreationTime", tmd.CreationTime)
+	near("table LastModifiedTime", tmd.LastModifiedTime)
+
+	lmd, err := client.Dataset("loaded").Table("t0").Metadata(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	near("loaded table CreationTime", lmd.CreationTime)
+
+	job, err := client.Query("SELECT 1").Run(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if status, err := job.Wait(ctx); err != nil || status.Err() != nil {
+		t.Fatalf("query: %v, %v", err, status)
+	}
+	got, err := client.JobFromID(ctx, job.ID())
+	if err != nil {
+		t.Fatal(err)
+	}
+	stats := got.LastStatus().Statistics
+	near("job CreationTime", stats.CreationTime)
+	near("job StartTime", stats.StartTime)
+	near("job EndTime", stats.EndTime)
+}
