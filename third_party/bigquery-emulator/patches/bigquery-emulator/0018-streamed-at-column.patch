--- a/internal/contentdata/repository.go
+++ b/internal/contentdata/repository.go
@@ -137,6 +137,11 @@
 		// (googlesqlite patch 0029).
 		fields = append(fields, "`_PARTITION_BUFFERED` BOOL")
 	}
+	// CloudBurrow patch (cloudburrow/cloudburrow#1370): every table has
+	// the pseudo-column of the time a row was streamed (googlesqlite patch
+	// 0030), which DML reads to refuse a row streamed in the last 30
+	// minutes.
+	fields = append(fields, "`_PARTITION_STREAMED` TIMESTAMP")
 	query := fmt.Sprintf("CREATE TABLE `%s` (%s)", tablePath, strings.Join(fields, ","))
 	if tp := table.TimePartitioning; tp != nil && tp.Field == "" {
