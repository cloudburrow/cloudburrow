+)
+
+// TestResultReadFromItsTable is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1662): the emulator kept every query job's rows
+// as JSON in its jobs table (patch 0002), up to 256 MiB, even when the
+// front had them written to a table of their own, and that copy was most
+// of the emulator's temporary file. A jobs.insert with ResultInTableHeader
+// now keeps the result without its rows, and jobs.getQueryResults reads
+// them from the destination table. Its answers, page by page, and the
+// job's jobs.get are the same as those of the same job inserted without the
+// header, which keeps the JSON copy; and once the table is deleted, it is
+// 404 notFound, where the copy would still answer.
+func TestResultReadFromItsTable(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	project := types.NewProject("test",
+		types.NewDataset("ds", types.NewTable("t", []*types.Column{types.NewColumn("a", types.INT64), types.NewColumn("b", types.STRING)}, types.Data{
+			{"a": int64(2), "b": "two"}, {"a": int64(1), "b": nil}, {"a": int64(3), "b": "three"},
+		})),
+		types.NewDataset("results"),
+	)
+	if err := bqServer.Load(server.StructSource(project)); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	base := testServer.URL + "/bigquery/v2/projects/test"
+	do := func(method, path string, body any, header bool) (int, []byte) {
+		t.Helper()
+		var r io.Reader
+		if body != nil {
+			b, _ := json.Marshal(body)
+			r = bytes.NewReader(b)
+		}
+		req, _ := http.NewRequestWithContext(ctx, method, base+path, r)
+		req.Header.Set("Content-Type", "application/json")
+		if header {
+			req.Header.Set(server.ResultInTableHeader, "1")
+		}
+		resp, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		b, _ := io.ReadAll(resp.Body)
+		return resp.StatusCode, b
+	}
+	insert := func(id, sql string, header bool) {
+		t.Helper()
+		status, b := do(http.MethodPost, "/jobs", map[string]any{
+			"jobReference": map[string]any{"projectId": "test", "jobId": id},
+			"configuration": map[string]any{"query": map[string]any{
+				"query": sql, "useLegacySql": false,
+				"destinationTable": map[string]any{"projectId": "test", "datasetId": "results", "tableId": id},
+			}},
+		}, header)
+		if status != http.StatusOK {
+			t.Fatalf("jobs.insert %s: %d %s", id, status, b)
+		}
+	}
+	// same is an answer of job id with its ID made the other's.
+	same := func(b []byte, id string) string {
+		return strings.ReplaceAll(string(b), id, "JOB")
+	}
+	queries := []string{
+		"SELECT * FROM ds.t",
+		"SELECT * FROM ds.t ORDER BY a DESC",
+		"SELECT a, b FROM ds.t WHERE a > 100",
+		"SELECT x, x * 1.5 AS f, CAST(x AS STRING) AS s, x > 100 AS big FROM UNNEST(GENERATE_ARRAY(1, 250)) AS x",
+		`SELECT 1 AS i, CAST('inf' AS FLOAT64) AS inf, CAST('nan' AS FLOAT64) AS nan, 1e300 AS huge, 0.1 + 0.2 AS sum, -0.5 AS neg,
+			NUMERIC '1.25' AS n, BIGNUMERIC '123456789012345678901234567890.5' AS bn, b'\x00\xff' AS byt, 'héllo' AS s, CAST(NULL AS STRING) AS nul,
+			DATE '2026-11-17' AS d, DATETIME '2026-11-17 10:11:12.123456' AS dt, TIME '10:11:12.5' AS tm,
+			TIMESTAMP '2026-11-17 10:11:12.123456 UTC' AS ts, ST_GEOGPOINT(1.5, 2.5) AS g, JSON '{"a":[1,2],"b":null}' AS j,
+			INTERVAL 5 DAY AS iv, [1, 2, 3] AS arr, ARRAY<STRING>[] AS empty, STRUCT(1 AS x, 'y' AS y, [TIMESTAMP '2026-01-01 00:00:00 UTC'] AS z) AS st,
+			[STRUCT(1 AS x, [2.5] AS y), STRUCT(2 AS x, ARRAY<FLOAT64>[] AS y)] AS arrst, RANGE(DATE '2026-01-01', DATE '2026-02-01') AS rg,
+			ST_GEOGFROMTEXT('POLYGON((0 0, 1 0, 1 1, 0 0))') AS poly, TIMESTAMP '2026-11-17 10:11:12 UTC' AS ts0`,
+		// A FLOAT64 -0, which a table holds as 0: the job keeps its copy.
+		"SELECT -0.0 AS negzero, [1.0, -0.0] AS arr",
+		// A column named as a pseudo-column is, which a SELECT * of a
+		// table leaves out: the job keeps its copy.
+		"SELECT a, TIMESTAMP '2024-01-02 00:00:00 UTC' AS _PARTITIONTIME, DATE '2024-01-02' AS _PARTITIONDATE FROM ds.t",
+	}
+	// keepsCopy are the queries whose jobs keep their copy.
+	keepsCopy := map[int]bool{5: true, 6: true}
+	pages := []string{
+		"", "?maxResults=0", "?maxResults=1", "?maxResults=2", "?maxResults=2&pageToken=2", "?startIndex=1", "?startIndex=1&maxResults=100",
+		"?pageToken=248", "?startIndex=999", "?formatOptions.useInt64Timestamp=true", "?maxResults=3&formatOptions.useInt64Timestamp=true",
+	}
+	for i, sql := range queries {
+		copied, read := fmt.Sprintf("copied_%d", i), fmt.Sprintf("read_%d", i)
+		insert(copied, sql, false)
+		insert(read, sql, true)
+		for _, page := range pages {
+			s1, b1 := do(http.MethodGet, "/queries/"+copied+page, nil, false)
+			s2, b2 := do(http.MethodGet, "/queries/"+read+page, nil, false)
+			if s1 != http.StatusOK || s1 != s2 || same(b1, copied) != same(b2, read) {
+				t.Errorf("query %d, jobs.getQueryResults%s:\nfrom the JSON copy %d %s\nfrom the table     %d %s", i, page, s1, b1, s2, b2)
+			}
+		}
+		_, j1 := do(http.MethodGet, "/jobs/"+copied, nil, false)
+		_, j2 := do(http.MethodGet, "/jobs/"+read, nil, false)
+		if a, b := jobWithoutTimes(t, j1), jobWithoutTimes(t, j2); same([]byte(a), copied) != same([]byte(b), read) {
+			t.Errorf("query %d, jobs.get:\nwith the JSON copy %s\nwithout it         %s", i, a, b)
+		}
+	}
+	// The rows are the table's: deleting it leaves the job's result 404,
+	// where a job with its copy still answers.
+	for i := range queries {
+		for _, id := range []string{fmt.Sprintf("copied_%d", i), fmt.Sprintf("read_%d", i)} {
+			if status, b := do(http.MethodDelete, "/datasets/results/tables/"+id, nil, false); status/100 != 2 {
+				t.Fatalf("tables.delete %s: %d %s", id, status, b)
+			}
+		}
+		if status, b := do(http.MethodGet, fmt.Sprintf("/queries/copied_%d", i), nil, false); status != http.StatusOK {
+			t.Errorf("query %d: jobs.getQueryResults of the job with the JSON copy, its table deleted: %d %s, want 200", i, status, b)
+		}
+		read := fmt.Sprintf("read_%d", i)
+		status, b := do(http.MethodGet, "/queries/"+read, nil, false)
+		if keepsCopy[i] {
+			if status != http.StatusOK {
+				t.Errorf("query %d: jobs.getQueryResults of a job that keeps its copy, its table deleted: %d %s, want 200 from its copy", i, status, b)
+			}
+			continue
+		}
+		var e struct {
+			Error struct {
+				Message string `json:"message"`
+				Errors  []struct {
+					Reason string `json:"reason"`
+				} `json:"errors"`
+			} `json:"error"`
+		}
+		_ = json.Unmarshal(b, &e)
+		if want := "Not found: Table test:results." + read; status != http.StatusNotFound || len(e.Error.Errors) == 0 || e.Error.Errors[0].Reason != "notFound" || e.Error.Message != want {
+			t.Errorf("query %d: jobs.getQueryResults of the job read from its table, the table deleted: %d %s, want 404 notFound %q", i, status, b, want)
+		}
+	}
+	// Without the header, a job that appends to a table it did not make
+	// keeps its copy, as the table holds other rows.
+	insert("appended", "SELECT 7 AS a, 'seven' AS b", false)
+	status, b := do(http.MethodPost, "/jobs", map[string]any{
+		"jobReference": map[string]any{"projectId": "test", "jobId": "appended_again"},
+		"configuration": map[string]any{"query": map[string]any{
+			"query": "SELECT 8 AS a, 'eight' AS b", "useLegacySql": false, "writeDisposition": "WRITE_APPEND",
+			"destinationTable": map[string]any{"projectId": "test", "datasetId": "results", "tableId": "appended"},
+		}},
+	}, true)
+	if status != http.StatusOK {
+		t.Fatalf("jobs.insert appended_again: %d %s", status, b)
+	}
+	if status, b := do(http.MethodGet, "/queries/appended_again", nil, false); status != http.StatusOK || !strings.Contains(string(b), `"totalRows":"1"`) || !strings.Contains(string(b), "eight") || strings.Contains(string(b), "seven") {
+		t.Errorf("jobs.getQueryResults of a job that appended to a table it did not make: %d %s, want its one row", status, b)
+	}
+}
+
+// jobWithoutTimes is a jobs.get answer without its times, which differ
+// between two jobs.
+func jobWithoutTimes(t *testing.T, b []byte) string {
+	t.Helper()
+	var job map[string]any
+	if err := json.Unmarshal(b, &job); err != nil {
+		t.Fatalf("jobs.get: %s", b)
+	}
+	if st, ok := job["statistics"].(map[string]any); ok {
+		for _, k := range []string{"creationTime", "startTime", "endTime"} {
+			delete(st, k)
+		}
+	}
+	out, _ := json.Marshal(job)
+	return string(out)
+}
