@@ -0,0 +1,109 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"regexp"
+	"strings"
+
+	"github.com/goccy/bigquery-emulator/internal/metadata"
+	internaltypes "github.com/goccy/bigquery-emulator/internal/types"
+)
+
+// ResultInTableHeader, on a jobs.insert of a query that names a
+// destination table the job makes, asks that the job's rows be read back
+// from that table at jobs.getQueryResults, not kept a second time as JSON
+// in the jobs table (patch 0002, up to 256 MiB). The job's schema, row
+// count and statistics are kept as before. CloudBurrow's front sets it on
+// the jobs whose results it has written to its hidden dataset, which no
+// one else writes to; it removes the header from its clients' requests.
+// CloudBurrow patch (cloudburrow/cloudburrow#1662).
+const ResultInTableHeader = "X-Cloudburrow-Result-In-Table"
+
+// resultTableGone is the error of jobs.getQueryResults of a job whose
+// rows were read from a table that has since been deleted.
+// CloudBurrow patch (cloudburrow/cloudburrow#1662).
+type resultTableGone struct {
+	projectID, datasetID, tableID string
+}
+
+func (e *resultTableGone) Error() string {
+	return fmt.Sprintf("Not found: Table %s:%s.%s", e.projectID, e.datasetID, e.tableID)
+}
+
+// rowsFromTable is kept, a job's result kept without its rows, with the
+// rows of the table that holds them (kept.CloudBurrowRowsIn), in the
+// table's order, as tabledata.list reads them. They are passed through
+// JSON as patch 0002 kept them, so the answer is the one the JSON copy
+// gave. CloudBurrow patch (cloudburrow/cloudburrow#1662).
+func rowsFromTable(ctx context.Context, server *Server, project *metadata.Project, kept *internaltypes.QueryResponse) (*internaltypes.QueryResponse, error) {
+	ref := kept.CloudBurrowRowsIn
+	gone := &resultTableGone{projectID: project.ID, datasetID: ref.DatasetId, tableID: ref.TableId}
+	exists := func() bool {
+		ds := project.Dataset(ref.DatasetId)
+		return ds != nil && ds.Table(ref.TableId) != nil
+	}
+	if !exists() {
+		return nil, gone
+	}
+	conn, err := server.connMgr.Connection(ctx, project.ID, ref.DatasetId)
+	if err != nil {
+		return nil, fmt.Errorf("failed to get connection: %w", err)
+	}
+	tx, err := conn.Begin(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to start transaction: %w", err)
+	}
+	defer tx.RollbackIfNotCommitted()
+	res, err := server.contentRepo.Query(ctx, tx, project.ID, ref.DatasetId, fmt.Sprintf("SELECT * FROM `%s`", ref.TableId), nil)
+	if err != nil {
+		if !exists() {
+			return nil, gone
+		}
+		return nil, fmt.Errorf("failed to read the result of the job from table %s.%s: %w", ref.DatasetId, ref.TableId, err)
+	}
+	b, err := json.Marshal(res.Rows)
+	if err != nil {
+		return nil, fmt.Errorf("failed to encode the result rows: %w", err)
+	}
+	var rows []*internaltypes.TableRow
+	if err := json.Unmarshal(b, &rows); err != nil {
+		return nil, fmt.Errorf("failed to decode the result rows: %w", err)
+	}
+	out := *kept
+	out.Rows = rows
+	out.CloudBurrowRowsIn = nil
+	return &out, nil
+}
+
+// readsBackWhole reports whether a SELECT * of the table a query's result
+// was written to gives back that result: not when a column's name begins
+// with an underscore, as a pseudo-column's does (_PARTITIONTIME,
+// _PARTITIONDATE, ...), which the engine leaves out of a SELECT *, nor
+// when a row holds a FLOAT64 -0, which the engine writes to a table as 0.
+// Such a result keeps its JSON copy, so jobs.getQueryResults answers it
+// as before. CloudBurrow patch (cloudburrow/cloudburrow#1662).
+func readsBackWhole(response *internaltypes.QueryResponse) bool {
+	if response.Schema == nil {
+		return false
+	}
+	for _, f := range response.Schema.Fields {
+		if strings.HasPrefix(f.Name, "_") {
+			return false
+		}
+	}
+	return !hasNegativeZero(response.Rows)
+}
+
+// negativeZero matches a FLOAT64 -0 in a result's rows as JSON.
+var negativeZero = regexp.MustCompile(`"-0(\.0*)?([eE][-+]?[0-9]+)?"`)
+
+// hasNegativeZero reports whether rows hold a FLOAT64 -0 (or a STRING
+// that reads as one), which the engine writes to a table as 0: such a
+// result keeps its JSON copy, so jobs.getQueryResults answers it as before.
+// CloudBurrow patch (cloudburrow/cloudburrow#1662).
+func hasNegativeZero(rows []*internaltypes.TableRow) bool {
+	b, err := json.Marshal(rows)
+	return err != nil || negativeZero.Match(b)
+}
