--- a/server/server.go
+++ b/server/server.go
@@ -225,7 +225,14 @@
 		Handler:      s.Handler,
 		Addr:         httpAddr,
 		WriteTimeout: 5 * time.Minute,
-		ReadTimeout:  15 * time.Second,
+		// CloudBurrow patch (cloudburrow/cloudburrow#1192): 15 s for a
+		// request's headers and for an idle connection, as ReadTimeout gave
+		// them, but no clock on the body, which ReadTimeout gave 15 s in
+		// all: a load's data is read as the load runs, and a large upload
+		// whose bytes took longer to arrive failed "failed to read csv: ...
+		// i/o timeout". WriteTimeout still bounds the whole request.
+		ReadHeaderTimeout: 15 * time.Second,
+		IdleTimeout:       15 * time.Second,
 	}
 	s.httpServer = httpServer
 
