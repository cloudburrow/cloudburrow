--- a/internal/contentdata/repository.go
+++ b/internal/contentdata/repository.go
@@ -285,7 +285,10 @@
 		})
 	}
 	if err := rows.Err(); err != nil {
-		return nil, fmt.Errorf("failed to scan rows: %w", err)
+		// The error a query fails with as it runs (ERROR(), a division by
+		// zero, a bad cast) is the query's own, as BigQuery reports it:
+		// no "failed to scan rows: " before it.
+		return nil, err
 	}
 	logger.Logger(ctx).Debug("query result", zap.Any("rows", result))
 	return &internaltypes.QueryResponse{
