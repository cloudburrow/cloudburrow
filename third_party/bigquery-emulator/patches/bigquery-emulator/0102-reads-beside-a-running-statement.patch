+package metadata
+
+import "context"
+
+// Reads beside a running statement (CloudBurrow patch,
+// cloudburrow/cloudburrow#1823; server/cloudburrow_concurrent_reads.go).
+// A request that only reads runs without the emulator's write lock, beside
+// the writer. Its transactions are not the writer's: the reads of a
+// dataset's tables that use the connection of the newest open transaction
+// (readChildRows) must neither take a reader's connection nor read on the
+// writer's, which holds what it has not committed. So a transaction begun
+// by a request without the write lock is not tracked (BindTx), and that
+// request's reads, a lazy dataset's among them, run on a connection of
+// their own.
+
+// ReadAccess is a read request's hold on the write lock: WritesLocked
+// reports whether it has taken it, to write.
+type ReadAccess interface {
+	WritesLocked() bool
+}
+
+type readAccessKey struct{}
+
+// WithReadAccess is ctx of a read request.
+func WithReadAccess(ctx context.Context, a ReadAccess) context.Context {
+	return context.WithValue(ctx, readAccessKey{}, a)
+}
+
+func readAccessOf(ctx context.Context) ReadAccess {
+	a, _ := ctx.Value(readAccessKey{}).(ReadAccess)
+	return a
+}
+
+// unlocked reports whether a is a read request's that has not taken the
+// write lock.
+func unlocked(a ReadAccess) bool {
+	return a != nil && !a.WritesLocked()
+}
+
+// ReadsUnlocked reports whether ctx is a read request's that has not taken
+// the write lock.
+func ReadsUnlocked(ctx context.Context) bool {
+	return unlocked(readAccessOf(ctx))
+}
+
+// lazyContext is the context of a lazy dataset's reads: its request's.
+func (d *Dataset) lazyContext() context.Context {
+	if d.access == nil {
+		return context.Background()
+	}
+	return WithReadAccess(context.Background(), d.access)
+}
