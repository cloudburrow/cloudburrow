+
+// TestReadsBesideARunningStatement is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1823): the emulator answered one request at a
+// time, so while a slow query ran, a jobs.list, another query and an
+// INFORMATION_SCHEMA read all waited for its end; BigQuery runs them side
+// by side. Now a read runs beside it, and writes, which stay one at a
+// time, are all kept: concurrent INSERTs and queries each answer, and
+// every row and every job is there after.
+func TestReadsBesideARunningStatement(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	project := types.NewProject("test", types.NewDataset("ds"))
+	if err := bqServer.Load(server.StructSource(project)); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	base := testServer.URL + "/bigquery/v2/projects/test"
+	do := func(method, path string, body any) (int, []byte, error) {
+		var r io.Reader
+		if body != nil {
+			b, _ := json.Marshal(body)
+			r = bytes.NewReader(b)
+		}
+		req, _ := http.NewRequestWithContext(ctx, method, base+path, r)
+		req.Header.Set("Content-Type", "application/json")
+		resp, err := http.DefaultClient.Do(req)
+		if err != nil {
+			return 0, nil, err
+		}
+		defer resp.Body.Close()
+		b, err := io.ReadAll(resp.Body)
+		return resp.StatusCode, b, err
+	}
+	query := func(sql string) (int, []byte, error) {
+		return do(http.MethodPost, "/queries", map[string]any{"query": sql, "useLegacySql": false})
+	}
+	if code, b, err := query("CREATE TABLE ds.t (n INT64)"); err != nil || code != http.StatusOK {
+		t.Fatalf("CREATE TABLE: %d %s %v", code, b, err)
+	}
+
+	// A query long enough to measure the others against: about a second
+	// or more, alone.
+	slow := "SELECT COUNT(*) FROM UNNEST(GENERATE_ARRAY(1, 300)) a, UNNEST(GENERATE_ARRAY(1, 300)) b, UNNEST(GENERATE_ARRAY(1, 300)) c"
+	start := time.Now()
+	if code, b, err := query(slow); err != nil || code != http.StatusOK {
+		t.Fatalf("slow query: %d %s %v", code, b, err)
+	}
+	alone := time.Since(start)
+	if alone < 500*time.Millisecond {
+		t.Skipf("the slow query took %v alone, too short to measure by", alone)
+	}
+
+	slowDone := make(chan time.Time, 1)
+	go func() {
+		_, _, _ = query(slow)
+		slowDone <- time.Now()
+	}()
+	time.Sleep(alone / 5)
+	reads := []struct {
+		name string
+		run  func() (int, []byte, error)
+	}{
+		{"jobs.list", func() (int, []byte, error) { return do(http.MethodGet, "/jobs", nil) }},
+		{"tables.list", func() (int, []byte, error) { return do(http.MethodGet, "/datasets/ds/tables", nil) }},
+		{"a query", func() (int, []byte, error) { return query("SELECT 1") }},
+		{"a query of a table", func() (int, []byte, error) { return query("SELECT COUNT(*) FROM ds.t") }},
+		{"jobs.insert of a query", func() (int, []byte, error) {
+			return do(http.MethodPost, "/jobs", map[string]any{"jobReference": map[string]any{"projectId": "test"}, "configuration": map[string]any{"query": map[string]any{"query": "SELECT 2", "useLegacySql": false}}})
+		}},
+	}
+	for _, read := range reads {
+		code, b, err := read.run()
+		if err != nil || code != http.StatusOK {
+			t.Fatalf("%s beside the slow query: %d %s %v", read.name, code, b, err)
+		}
+		select {
+		case <-slowDone:
+			t.Fatalf("%s answered only once the slow query (%v alone) had ended", read.name, alone)
+		default:
+		}
+	}
+	<-slowDone
+
+	// Writes and reads at once: each answers, and all are kept.
+	const writers, readers = 8, 8
+	var wg sync.WaitGroup
+	errs := make(chan error, writers+readers)
+	for i := 0; i < writers; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			if code, b, err := query(fmt.Sprintf("INSERT INTO ds.t (n) VALUES (%d)", i)); err != nil || code != http.StatusOK {
+				errs <- fmt.Errorf("INSERT %d: %d %s %v", i, code, b, err)
+			}
+		}(i)
+	}
+	for i := 0; i < readers; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			if code, b, err := query(fmt.Sprintf("SELECT %d, COUNT(*) FROM ds.t", i)); err != nil || code != http.StatusOK {
+				errs <- fmt.Errorf("SELECT %d: %d %s %v", i, code, b, err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		t.Error(err)
+	}
+	code, b, err := query("SELECT COUNT(*) AS n, SUM(n) AS s FROM ds.t")
+	if err != nil || code != http.StatusOK {
+		t.Fatalf("count: %d %s %v", code, b, err)
+	}
+	var got struct {
+		Rows []struct {
+			F []struct {
+				V string `json:"v"`
+			} `json:"f"`
+		} `json:"rows"`
+	}
+	if err := json.Unmarshal(b, &got); err != nil || len(got.Rows) != 1 || got.Rows[0].F[0].V != fmt.Sprint(writers) || got.Rows[0].F[1].V != fmt.Sprint(writers*(writers-1)/2) {
+		t.Errorf("rows the concurrent INSERTs wrote: %s, want %d rows", b, writers)
+	}
+	code, b, err = do(http.MethodGet, "/jobs?maxResults=1000", nil)
+	if err != nil || code != http.StatusOK {
+		t.Fatalf("jobs.list: %d %s %v", code, b, err)
+	}
+	var list struct {
+		Jobs []json.RawMessage `json:"jobs"`
+	}
+	// CREATE, the slow query twice, the three reads that are queries, the
+	// writers and readers, and the count.
+	if want := 1 + 2 + 3 + writers + readers + 1; json.Unmarshal(b, &list) != nil || len(list.Jobs) != want {
+		t.Errorf("jobs.list: %d jobs, want %d", len(list.Jobs), want)
+	}
+}
