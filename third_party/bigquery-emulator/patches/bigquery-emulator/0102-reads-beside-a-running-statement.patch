@@ -0,0 +1,340 @@
+package server
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+
+	"github.com/gorilla/mux"
+
+	"github.com/goccy/bigquery-emulator/internal/connection"
+	"github.com/goccy/bigquery-emulator/internal/metadata"
+)
+
+// Reads beside a running statement (CloudBurrow patch,
+// cloudburrow/cloudburrow#1823).
+//
+// BigQuery runs jobs side by side: a query, a jobs.list or an
+// INFORMATION_SCHEMA.JOBS query answers while another job runs. The
+// emulator answered one request at a time (sequentialAccessMiddleware), so
+// everything waited for a slow statement, and a job could not be seen
+// RUNNING. With a file database in WAL mode (cloudburrowFilePragmas) a
+// reader reads a snapshot of the last commit and neither waits for the
+// writer nor holds it up, so here:
+//
+//   - a request that writes holds the write lock for the whole request, as
+//     every request did: writes stay one at a time, each transaction sees
+//     every write committed before it and never meets another writer's
+//     commit in its middle;
+//   - a request that only reads (readRequest: the GET methods, and a
+//     jobs.query or query jobs.insert of one SELECT statement) holds no lock
+//     while it reads. A query's job record, and a jobs.insert's
+//     destination table, are written after its statement, in a transaction
+//     of their own under the write lock (lockWrites), as a write request's
+//     are: the statement only read, so what it read is what it answers.
+//
+// An in-memory database (MemoryStorage) is one connection's shared cache,
+// where a reader and a writer of a table do not wait for each other but
+// fail, so every request on it holds the write lock, as before.
+
+// cloudburrowFilePragmas are the PRAGMAs of a file database: those of
+// TempStorage (cloudburrow_auto_vacuum.go), then WAL mode, so that reads
+// run beside the writer.
+const cloudburrowFilePragmas = cloudburrowTempPragmas + "&_pragma=journal_mode(wal)"
+
+// engineAccess is the emulator's write lock.
+type engineAccess struct {
+	writes sync.Mutex
+	// concurrentReads is whether reads run without the lock (a file
+	// database in WAL mode).
+	concurrentReads bool
+}
+
+type readAccessKey struct{}
+
+// readAccess is the state of a read request: whether it took the write
+// lock (lockWrites).
+type readAccess struct {
+	access *engineAccess
+	mu     sync.Mutex
+	locked bool
+}
+
+// lockWrites takes the write lock for the rest of a read request, before
+// it writes; in a write request, which holds it already, it does nothing.
+// The caller begins its writing transaction after it.
+func lockWrites(ctx context.Context) {
+	ra, ok := ctx.Value(readAccessKey{}).(*readAccess)
+	if !ok {
+		return
+	}
+	ra.mu.Lock()
+	defer ra.mu.Unlock()
+	if !ra.locked {
+		ra.access.writes.Lock()
+		ra.locked = true
+	}
+}
+
+// readsConcurrently reports whether ctx's request runs without the write
+// lock, so that a statement it ran only read and its writes come after it,
+// in a transaction of their own (lockWrites).
+func readsConcurrently(ctx context.Context) bool {
+	_, ok := ctx.Value(readAccessKey{}).(*readAccess)
+	return ok
+}
+
+// writesAfterRead ends read, the transaction a read request's statement
+// ran in, takes the write lock, and begins the transaction its writes go
+// in.
+func writesAfterRead(ctx context.Context, s *Server, read *connection.Tx, projectID, datasetID string) (*connection.Tx, error) {
+	if err := read.Commit(); err != nil {
+		return nil, err
+	}
+	lockWrites(ctx)
+	conn, err := s.connMgr.Connection(ctx, projectID, datasetID)
+	if err != nil {
+		return nil, err
+	}
+	return conn.Begin(ctx)
+}
+
+// WritesLocked reports whether the request took the write lock
+// (metadata.ReadAccess).
+func (ra *readAccess) WritesLocked() bool {
+	ra.mu.Lock()
+	defer ra.mu.Unlock()
+	return ra.locked
+}
+
+func (ra *readAccess) release() {
+	ra.mu.Lock()
+	defer ra.mu.Unlock()
+	if ra.locked {
+		ra.access.writes.Unlock()
+		ra.locked = false
+	}
+}
+
+// engineAccessMiddleware replaces sequentialAccessMiddleware: a write
+// request holds the write lock, a read request does not (above).
+func engineAccessMiddleware(access *engineAccess) func(http.Handler) http.Handler {
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if !access.concurrentReads || !readRequest(r) {
+				access.writes.Lock()
+				defer access.writes.Unlock()
+				next.ServeHTTP(w, r)
+				return
+			}
+			ra := &readAccess{access: access}
+			defer ra.release()
+			ctx := metadata.WithReadAccess(context.WithValue(r.Context(), readAccessKey{}, ra), ra)
+			next.ServeHTTP(w, r.WithContext(ctx))
+		})
+	}
+}
+
+// maxReadBody is the largest request body readRequest reads to tell a
+// query; a larger one is a write request.
+const maxReadBody = 1 << 20
+
+// readRequest reports whether r only reads: a GET method of a resource,
+// or a jobs.query, or a query jobs.insert, of one SELECT statement in
+// GoogleSQL. Anything else, and a body it cannot read (compressed, or
+// larger than maxReadBody), writes.
+func readRequest(r *http.Request) bool {
+	route := mux.CurrentRoute(r)
+	if route == nil {
+		return false
+	}
+	switch route.GetHandler().(type) {
+	case *datasetsGetHandler, *datasetsListHandler,
+		*jobsGetHandler, *jobsGetQueryResultsHandler, *jobsListHandler,
+		*modelsGetHandler, *modelsListHandler,
+		*projectsGetServiceAccountHandler, *projectsListHandler,
+		*routinesGetHandler, *routinesListHandler,
+		*rowAccessPoliciesListHandler,
+		*tabledataListHandler, *tablesGetHandler, *tablesListHandler:
+		return r.Method == http.MethodGet
+	case *jobsQueryHandler, *jobsInsertHandler:
+	default:
+		return false
+	}
+	if r.Method != http.MethodPost || r.Header.Get("Content-Encoding") != "" || r.Body == nil {
+		return false
+	}
+	if r.ContentLength > maxReadBody {
+		return false
+	}
+	body, err := io.ReadAll(io.LimitReader(r.Body, maxReadBody+1))
+	r.Body.Close()
+	r.Body = io.NopCloser(bytes.NewReader(body))
+	if err != nil || len(body) > maxReadBody {
+		return false
+	}
+	if _, ok := route.GetHandler().(*jobsQueryHandler); ok {
+		var q struct {
+			Query        string `json:"query"`
+			UseLegacySQL *bool  `json:"useLegacySql"`
+		}
+		if json.Unmarshal(body, &q) != nil {
+			return false
+		}
+		return (q.UseLegacySQL == nil || !*q.UseLegacySQL) && selectStatement(q.Query)
+	}
+	var job struct {
+		Configuration *struct {
+			Query *struct {
+				Query        string `json:"query"`
+				UseLegacySQL *bool  `json:"useLegacySql"`
+			} `json:"query"`
+			Load    json.RawMessage `json:"load"`
+			Copy    json.RawMessage `json:"copy"`
+			Extract json.RawMessage `json:"extract"`
+		} `json:"configuration"`
+	}
+	if json.Unmarshal(body, &job) != nil || job.Configuration == nil || job.Configuration.Query == nil {
+		return false
+	}
+	c := job.Configuration
+	if len(c.Load) != 0 || len(c.Copy) != 0 || len(c.Extract) != 0 {
+		return false
+	}
+	return (c.Query.UseLegacySQL == nil || !*c.Query.UseLegacySQL) && selectStatement(c.Query.Query)
+}
+
+// selectStatement reports whether query is one query statement: SELECT,
+// WITH, or a parenthesized query, and nothing after it but a semicolon,
+// spaces and comments. It reads the tokens GoogleSQL's lexical structure
+// has (https://cloud.google.com/bigquery/docs/reference/standard-sql/lexical):
+// comments (#, -- and /* */), quoted strings, bytes and identifiers, raw
+// or not, and triple-quoted ones; anything it does not understand is not
+// a query. A query statement writes nothing: DML, DDL and scripts begin
+// with other words.
+func selectStatement(query string) bool {
+	first := ""
+	ended := false
+	for i := 0; i < len(query); {
+		c := query[i]
+		switch {
+		case c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v':
+			i++
+			continue
+		case c == '#' || (c == '-' && strings.HasPrefix(query[i:], "--")):
+			j := strings.IndexByte(query[i:], '\n')
+			if j < 0 {
+				i = len(query)
+			} else {
+				i += j + 1
+			}
+			continue
+		case c == '/' && strings.HasPrefix(query[i:], "/*"):
+			j := strings.Index(query[i+2:], "*/")
+			if j < 0 {
+				return false
+			}
+			i += 2 + j + 2
+			continue
+		}
+		if ended {
+			return false // a second statement
+		}
+		switch {
+		case c == ';':
+			ended = true
+			i++
+		case c == '\'' || c == '"' || c == '`':
+			n, ok := quotedLength(query[i:], false)
+			if !ok {
+				return false
+			}
+			if first == "" {
+				return false
+			}
+			i += n
+		case isWordByte(c):
+			j := i
+			for j < len(query) && isWordByte(query[j]) {
+				j++
+			}
+			word := query[i:j]
+			if j < len(query) && (query[j] == '\'' || query[j] == '"') && len(word) <= 2 && strings.ContainsAny(strings.ToLower(word), "rb") && strings.Trim(strings.ToLower(word), "rb") == "" {
+				n, ok := quotedLength(query[j:], strings.ContainsAny(word, "rR"))
+				if !ok {
+					return false
+				}
+				if first == "" {
+					return false
+				}
+				i = j + n
+				continue
+			}
+			if first == "" {
+				first = strings.ToUpper(word)
+				if first != "SELECT" && first != "WITH" {
+					return false
+				}
+			}
+			i = j
+		case c == '(':
+			if first == "" {
+				first = "("
+			}
+			i++
+		default:
+			if first == "" {
+				return false
+			}
+			i++
+		}
+	}
+	if first == "(" {
+		return parenthesizedSelect(query)
+	}
+	return first == "SELECT" || first == "WITH"
+}
+
+// parenthesizedSelect reports whether a query that begins with "(" has
+// SELECT or WITH as its first word, as a parenthesized query does.
+func parenthesizedSelect(query string) bool {
+	q := strings.TrimLeft(query, " \t\n\r\f\v(")
+	for _, w := range []string{"SELECT", "WITH"} {
+		if len(q) > len(w) && strings.EqualFold(q[:len(w)], w) && !isWordByte(q[len(w)]) {
+			return true
+		}
+	}
+	return false
+}
+
+func isWordByte(c byte) bool {
+	return c == '_' || c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= 0x80
+}
+
+// quotedLength is the length of the quoted string, bytes or identifier s
+// begins with (single, double or back quotes, triple-quoted or not), with
+// backslash escapes unless raw.
+func quotedLength(s string, raw bool) (int, bool) {
+	q := s[0]
+	delim := string(q)
+	if q != '`' && strings.HasPrefix(s, strings.Repeat(string(q), 3)) {
+		delim = strings.Repeat(string(q), 3)
+	}
+	for i := len(delim); i < len(s); i++ {
+		switch {
+		case s[i] == '\\' && q != '`' && !raw:
+			i++
+		case s[i] == '\\' && q == '`':
+			i++
+		case strings.HasPrefix(s[i:], delim):
+			return i + len(delim), true
+		case s[i] == '\n' && len(delim) == 1:
+			return 0, false
+		}
+	}
+	return 0, false
+}
