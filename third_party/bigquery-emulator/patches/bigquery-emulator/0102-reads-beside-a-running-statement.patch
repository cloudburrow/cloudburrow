+package server
+
+import "testing"
+
+// TestSelectStatement is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1823): only one query statement runs without
+// the write lock; DML, DDL, scripts and anything unclear take it.
+func TestSelectStatement(t *testing.T) {
+	for q, want := range map[string]bool{
+		"SELECT 1":             true,
+		"  select * from t;  ": true,
+		"-- c\n# d\n/* e */ WITH a AS (SELECT 1) SELECT * FROM a": true,
+		"(SELECT 1) UNION ALL (SELECT 2)":                         true,
+		"SELECT ';' AS s, \"a;b\", `x;y` , '''x;\n'''":            true,
+		"SELECT 1 -- ; INSERT":                                    true,
+		"SELECT 1; SELECT 2":                                      false,
+		"SELECT 1; INSERT INTO t VALUES (1)":                      false,
+		"INSERT INTO t SELECT 1":                                  false,
+		"CREATE TABLE t AS SELECT 1":                              false,
+		"DECLARE x INT64; SELECT x":                               false,
+		"BEGIN SELECT 1; END":                                     false,
+		"CREATE TEMP FUNCTION f() AS (1); SELECT f()":             false,
+		"EXPORT DATA OPTIONS(uri='x') AS SELECT 1":                false,
+		"SELECT 'unterminated":                                    false,
+		"SELECT 1 /* unterminated":                                false,
+		"":                                                        false,
+		"(INSERT INTO t VALUES (1))":                              false,
+	} {
+		if got := selectStatement(q); got != want {
+			t.Errorf("selectStatement(%q) = %v, want %v", q, got, want)
+		}
+	}
+}
