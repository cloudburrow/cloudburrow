diff --git a/server/cloudburrow_stream_columns_test.go b/server/cloudburrow_stream_columns_test.go
new file mode 100644
index 0000000..d907c0b
--- /dev/null
+++ b/server/cloudburrow_stream_columns_test.go
@@ -0,0 +1,140 @@
+package server_test
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"cloud.google.com/go/bigquery"
+	"google.golang.org/api/iterator"
+	"google.golang.org/api/option"
+
+	"github.com/goccy/bigquery-emulator/server"
+	"github.com/goccy/bigquery-emulator/types"
+)
+
+// TestInsertAllGivesStreamColumns is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1624): tabledata.insertAll gives each row the
+// pseudo-columns its X-Cloudburrow-Stream-Columns header names, one value
+// for every row or one per row, so the CloudBurrow front streams into a
+// table with no scratch table. Without the patch the rows' columns stay
+// NULL.
+func TestInsertAllGivesStreamColumns(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	bqServer, err := server.New(server.TempStorage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := bqServer.Load(server.StructSource(types.NewProject("test", types.NewDataset("ds")))); err != nil {
+		t.Fatal(err)
+	}
+	testServer := bqServer.TestServer()
+	defer func() {
+		testServer.Close()
+		bqServer.Stop(ctx)
+	}()
+	client, err := bigquery.NewClient(ctx, "test", option.WithEndpoint(testServer.URL), option.WithoutAuthentication())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	schema := bigquery.Schema{
+		{Name: "id", Type: bigquery.IntegerFieldType},
+		{Name: "d", Type: bigquery.DateFieldType},
+		{Name: "s", Type: bigquery.StringFieldType, DefaultValueExpression: "'dflt'"},
+	}
+	for name, md := range map[string]*bigquery.TableMetadata{
+		"plain":     {Schema: schema},
+		"ingestion": {Schema: schema, TimePartitioning: &bigquery.TimePartitioning{Type: bigquery.DayPartitioningType}},
+		"column":    {Schema: schema, TimePartitioning: &bigquery.TimePartitioning{Type: bigquery.DayPartitioningType, Field: "d"}},
+	} {
+		if err := client.Dataset("ds").Table(name).Create(ctx, md); err != nil {
+			t.Fatal(name, err)
+		}
+	}
+	insert := func(table, header, rows string) (int, string) {
+		t.Helper()
+		req, err := http.NewRequestWithContext(ctx, http.MethodPost,
+			testServer.URL+"/bigquery/v2/projects/test/datasets/ds/tables/"+table+"/insertAll",
+			strings.NewReader(`{"rows":[`+rows+`]}`))
+		if err != nil {
+			t.Fatal(err)
+		}
+		req.Header.Set("Content-Type", "application/json")
+		if header != "" {
+			req.Header.Set("X-Cloudburrow-Stream-Columns", header)
+		}
+		res, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer res.Body.Close()
+		b, _ := io.ReadAll(res.Body)
+		return res.StatusCode, string(b)
+	}
+	read := func(q string) []string {
+		t.Helper()
+		it, err := client.Query(q).Read(ctx)
+		if err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		var out []string
+		for {
+			var row []bigquery.Value
+			if err := it.Next(&row); err == iterator.Done {
+				return out
+			} else if err != nil {
+				t.Fatal(err)
+			}
+			out = append(out, fmt.Sprint(row))
+		}
+	}
+	rows := `{"json":{"id":1,"d":"2026-10-18"}},{"json":{"id":2,"d":"2026-10-18","s":"x"}},{"json":{"id":3,"nope":1}},{"json":{"id":4,"d":"2001-01-01"}}`
+
+	if code, body := insert("plain", `{"_PARTITION_STREAMED":"2026-10-18T05:06:07.123456Z"}`, rows); code != http.StatusOK || !strings.Contains(body, "nope") {
+		t.Fatalf("plain: %d %s", code, body)
+	}
+	if got, want := strings.Join(read("SELECT id, s, FORMAT_TIMESTAMP('%FT%H:%M:%E6S', _PARTITION_STREAMED) FROM ds.plain ORDER BY id"), " "),
+		"[1 dflt 2026-10-18T05:06:07.123456] [2 x 2026-10-18T05:06:07.123456] [4 dflt 2026-10-18T05:06:07.123456]"; got != want {
+		t.Errorf("plain: %s, want %s", got, want)
+	}
+
+	if code, body := insert("ingestion", `{"_PARTITION_STREAMED":"2026-10-18T05:06:07Z","_PARTITIONTIME":null,"_PARTITIONDATE":null}`, rows); code != http.StatusOK {
+		t.Fatalf("ingestion: %d %s", code, body)
+	}
+	if got, want := strings.Join(read("SELECT id, _PARTITIONTIME IS NULL, _PARTITIONDATE IS NULL, _PARTITION_STREAMED IS NOT NULL FROM ds.ingestion ORDER BY id"), " "),
+		"[1 true true true] [2 true true true] [4 true true true]"; got != want {
+		t.Errorf("ingestion: %s, want %s", got, want)
+	}
+
+	// One value per row of the request, the refused row's too.
+	if code, body := insert("column", `{"_PARTITION_STREAMED":"2026-10-18T05:06:07Z","_PARTITION_BUFFERED":[false,false,false,true]}`, rows); code != http.StatusOK {
+		t.Fatalf("column: %d %s", code, body)
+	}
+	if got, want := strings.Join(read("SELECT id, s, _PARTITION_BUFFERED FROM ds.column ORDER BY id"), " "),
+		"[1 dflt false] [2 x false] [4 dflt true]"; got != want {
+		t.Errorf("column: %s, want %s", got, want)
+	}
+
+	// Without the header, nothing is given.
+	if code, body := insert("plain", "", `{"json":{"id":5}}`); code != http.StatusOK {
+		t.Fatalf("plain without the header: %d %s", code, body)
+	}
+	if got := read("SELECT _PARTITION_STREAMED IS NULL FROM ds.plain WHERE id = 5"); len(got) != 1 || got[0] != "[true]" {
+		t.Errorf("plain without the header: %v", got)
+	}
+
+	for _, bad := range []string{`{"_PARTITION_STREAMED":"yesterday"}`, `{"id":1}`, `{"_PARTITION_BUFFERED":[true]}`, `not json`} {
+		if code, body := insert("plain", bad, `{"json":{"id":6}},{"json":{"id":7}}`); code != http.StatusBadRequest {
+			t.Errorf("header %s: %d %s, want 400", bad, code, body)
+		}
+	}
+	if got := read("SELECT COUNT(*) FROM ds.plain WHERE id > 5"); len(got) != 1 || got[0] != "[0]" {
+		t.Errorf("rows of refused requests: %v", got)
+	}
+}
