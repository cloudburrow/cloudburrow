new file mode 100644
index 0000000..fb41b36
--- /dev/null
+++ b/internal/contentdata/cloudburrow_stream_columns.go
@@ -0,0 +1,159 @@
+package contentdata
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1624): tabledata.insertAll
+// writes the pseudo-columns of a streamed row itself.
+//
+// The CloudBurrow front gives each streamed row its stream time
+// (_PARTITION_STREAMED), and a row of a partitioned table its place in the
+// streaming buffer (_PARTITIONTIME and _PARTITIONDATE NULL, or
+// _PARTITION_BUFFERED). It streamed the rows into a scratch table and
+// moved them with INSERT ... SELECT, and the DROP of the scratch table
+// rebuilt the engine's whole catalog, which grows with every table: a
+// 10-row insert took 110 ms in a project of 150 datasets of three tables.
+// The front now names the values in the request's X-Cloudburrow-Stream-Columns
+// header, and the rows' INSERT gives them.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+)
+
+// StreamColumnsHeader is the request header of tabledata.insertAll that
+// names the pseudo-columns of its rows: a JSON object of each name to its
+// value, or to an array of one value per row of the request.
+const StreamColumnsHeader = "X-Cloudburrow-Stream-Columns"
+
+// streamColumnTypes are the pseudo-columns the header may name, and their
+// types.
+var streamColumnTypes = map[string]string{
+	"_PARTITION_STREAMED": "TIMESTAMP",
+	"_PARTITIONTIME":      "TIMESTAMP",
+	"_PARTITIONDATE":      "DATE",
+	"_PARTITION_BUFFERED": "BOOL",
+}
+
+// StreamColumns are the pseudo-columns AddTableData gives each row: their
+// names, and for each row the SQL literal of each.
+type StreamColumns struct {
+	Names  []string
+	Values [][]string
+}
+
+// ParseStreamColumns reads the header's value for a request of rows rows.
+func ParseStreamColumns(header string, rows int) (*StreamColumns, error) {
+	var raw map[string]json.RawMessage
+	if err := json.Unmarshal([]byte(header), &raw); err != nil {
+		return nil, fmt.Errorf("%s: %w", StreamColumnsHeader, err)
+	}
+	sc := &StreamColumns{Values: make([][]string, rows)}
+	for name := range raw {
+		if _, ok := streamColumnTypes[name]; !ok {
+			return nil, fmt.Errorf("%s: %q is not a pseudo-column it gives", StreamColumnsHeader, name)
+		}
+		sc.Names = append(sc.Names, name)
+	}
+	sort.Strings(sc.Names)
+	for _, name := range sc.Names {
+		typ := streamColumnTypes[name]
+		v := raw[name]
+		var each []json.RawMessage
+		if strings.HasPrefix(strings.TrimSpace(string(v)), "[") {
+			if err := json.Unmarshal(v, &each); err != nil {
+				return nil, fmt.Errorf("%s: %s: %w", StreamColumnsHeader, name, err)
+			}
+			if len(each) != rows {
+				return nil, fmt.Errorf("%s: %s has %d values for %d rows", StreamColumnsHeader, name, len(each), rows)
+			}
+		}
+		one := ""
+		if each == nil {
+			lit, err := streamLiteral(typ, v)
+			if err != nil {
+				return nil, fmt.Errorf("%s: %s: %w", StreamColumnsHeader, name, err)
+			}
+			one = lit
+		}
+		for i := range sc.Values {
+			lit := one
+			if each != nil {
+				var err error
+				if lit, err = streamLiteral(typ, each[i]); err != nil {
+					return nil, fmt.Errorf("%s: %s: %w", StreamColumnsHeader, name, err)
+				}
+			}
+			sc.Values[i] = append(sc.Values[i], lit)
+		}
+	}
+	return sc, nil
+}
+
+// streamLiteral is the SQL literal of v, a JSON value of type typ.
+func streamLiteral(typ string, v json.RawMessage) (string, error) {
+	if s := strings.TrimSpace(string(v)); s == "null" || s == "" {
+		return "CAST(NULL AS " + typ + ")", nil
+	}
+	switch typ {
+	case "BOOL":
+		var b bool
+		if err := json.Unmarshal(v, &b); err != nil {
+			return "", err
+		}
+		if b {
+			return "TRUE", nil
+		}
+		return "FALSE", nil
+	case "TIMESTAMP":
+		var s string
+		if err := json.Unmarshal(v, &s); err != nil {
+			return "", err
+		}
+		t, err := time.Parse(time.RFC3339Nano, s)
+		if err != nil {
+			return "", err
+		}
+		return "TIMESTAMP '" + t.UTC().Format("2006-01-02 15:04:05.000000") + "+00'", nil
+	case "DATE":
+		var s string
+		if err := json.Unmarshal(v, &s); err != nil {
+			return "", err
+		}
+		d, err := time.Parse("2006-01-02", s)
+		if err != nil {
+			return "", err
+		}
+		return "DATE '" + d.Format("2006-01-02") + "'", nil
+	}
+	return "", fmt.Errorf("type %s", typ)
+}
+
+// Keep returns the columns of the rows kept, by their indexes.
+func (sc *StreamColumns) Keep(kept []int) *StreamColumns {
+	if sc == nil {
+		return nil
+	}
+	out := &StreamColumns{Names: sc.Names, Values: make([][]string, len(kept))}
+	for i, k := range kept {
+		out.Values[i] = sc.Values[k]
+	}
+	return out
+}
+
+type streamColumnsKey struct{}
+
+// WithStreamColumns returns ctx with the columns AddTableData gives its
+// rows, one set of values per row of the table it is given.
+func WithStreamColumns(ctx context.Context, sc *StreamColumns) context.Context {
+	if sc == nil || len(sc.Names) == 0 {
+		return ctx
+	}
+	return context.WithValue(ctx, streamColumnsKey{}, sc)
+}
+
+func streamColumnsFrom(ctx context.Context) *StreamColumns {
+	sc, _ := ctx.Value(streamColumnsKey{}).(*StreamColumns)
+	return sc
+}
