--- a/internal/change_history.go
+++ b/internal/change_history.go
@@ -80,7 +80,12 @@
 	cs := &TableSpec{NamePath: path, CreateMode: googlesql.ResolvedCreateStatementEnums_CreateModeCreateDefault,
 		CreatedAt: spec.CreatedAt, UpdatedAt: spec.UpdatedAt}
 	for _, c := range spec.Columns {
-		if isIngestionPseudoColumn(c.Name) {
+		// CloudBurrow patch (cloudburrow/cloudburrow#1458): an
+		// ingestion-time partitioned table's change table keeps each
+		// change's _PARTITIONTIME, a pseudo-column of it too, so that a
+		// reader knows the partition of a change and a past time's rows
+		// their partitions.
+		if isIngestionPseudoColumn(c.Name) && !strings.EqualFold(c.Name, "_PARTITIONTIME") {
 			continue
 		}
 		cs.Columns = append(cs.Columns, &ColumnSpec{Name: c.Name, Type: c.Type})
--- /dev/null
+++ b/change_history_partition_time_test.go
@@ -0,0 +1,68 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestChangeHistoryPartitionTime is CloudBurrow's regression test of its
+// patch 0050 (cloudburrow/cloudburrow#1458): the change table of an
+// ingestion-time partitioned table keeps each change's _PARTITIONTIME, a
+// pseudo-column that SELECT * leaves out, through INSERT, UPDATE and
+// DELETE; a table that is not ingestion-time partitioned has none.
+func TestChangeHistoryPartitionTime(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	exec("CREATE TABLE `p.d.ing` (id INT64) PARTITION BY _PARTITIONDATE")
+	exec("INSERT INTO `p.d.ing` (_PARTITIONTIME, id) VALUES (TIMESTAMP '2024-01-01', 1), (TIMESTAMP '2024-01-02', 2)")
+	exec("UPDATE `p.d.ing` SET id = 3 WHERE id = 2")
+	exec("DELETE `p.d.ing` WHERE id = 1")
+
+	rows, err := db.QueryContext(ctx, "SELECT * FROM `p.d.ing$changes` WHERE _CHANGE_TYPE != 'START'")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cols, _ := rows.Columns()
+	rows.Close()
+	if strings.Join(cols, ",") != "id,_CHANGE_TYPE,_CHANGE_TIMESTAMP,_CHANGE_IS_FOR_UPDATE" {
+		t.Errorf("SELECT * of the change table: %v, want _PARTITIONTIME left out", cols)
+	}
+	rows, err = db.QueryContext(ctx, "SELECT id, _CHANGE_TYPE, FORMAT_TIMESTAMP('%F', _PARTITIONTIME) FROM `p.d.ing$changes` "+
+		"WHERE _CHANGE_TYPE != 'START' ORDER BY rowid")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got []string
+	for rows.Next() {
+		var id, typ, day string
+		if err := rows.Scan(&id, &typ, &day); err != nil {
+			t.Fatal(err)
+		}
+		got = append(got, id+" "+typ+" "+day)
+	}
+	rows.Close()
+	want := "1 INSERT 2024-01-01; 2 INSERT 2024-01-02; 2 DELETE 2024-01-02; 3 UPDATE 2024-01-02; 1 DELETE 2024-01-01"
+	if strings.Join(got, "; ") != want {
+		t.Errorf("changes = %q, want %q", strings.Join(got, "; "), want)
+	}
+
+	exec("CREATE TABLE `p.d.plain` (id INT64)")
+	if _, err := db.QueryContext(ctx, "SELECT _PARTITIONTIME FROM `p.d.plain$changes`"); err == nil {
+		t.Error("_PARTITIONTIME of the change table of a table not partitioned by ingestion time: no error")
+	}
+}
