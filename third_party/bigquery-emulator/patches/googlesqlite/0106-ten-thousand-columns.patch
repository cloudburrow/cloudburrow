+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestTenThousandColumnLimit is CloudBurrow's regression test of its patch
+// 0106 (cloudburrow/cloudburrow#2012): a query result, CREATE TABLE,
+// CREATE TABLE ... AS SELECT and CREATE VIEW of 10,000 columns, nested
+// ones counted, are taken; of 10,001 each is refused before anything is
+// made.
+func TestTenThousandColumnLimit(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	list := func(n int, def bool) string {
+		parts := make([]string, n)
+		for i := range parts {
+			if def {
+				parts[i] = fmt.Sprintf("c%d INT64", i)
+			} else {
+				parts[i] = fmt.Sprintf("%d AS c%d", i, i)
+			}
+		}
+		return strings.Join(parts, ", ")
+	}
+	ok := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%.60s...: %v", q, err)
+		}
+	}
+	refused := func(q string) {
+		t.Helper()
+		_, err := db.ExecContext(ctx, q)
+		if err == nil || !strings.Contains(err.Error(), "can have up to 10000 columns") {
+			t.Errorf("%.60s...: %v, want the 10,000-column error", q, err)
+		}
+	}
+	ok("CREATE TABLE `p.d.t10000` (" + list(10000, true) + ")")
+	ok("CREATE TABLE `p.d.a10000` AS SELECT " + list(10000, false))
+	ok("CREATE VIEW `p.d.v10000` AS SELECT " + list(10000, false))
+	ok("SELECT " + list(10000, false))
+	ok("SELECT * FROM `p.d.t10000`")
+	refused("CREATE TABLE `p.d.t10001` (" + list(10001, true) + ")")
+	refused("CREATE TABLE `p.d.n10001` (" + list(9999, true) + ", r STRUCT<x INT64>)")
+	refused("CREATE TABLE `p.d.ar10001` (" + list(9999, true) + ", r ARRAY<STRUCT<x INT64>>)")
+	refused("CREATE TABLE `p.d.a10001` AS SELECT " + list(10001, false))
+	refused("CREATE VIEW `p.d.v10001` AS SELECT " + list(10001, false))
+	refused("SELECT " + list(10001, false))
+	refused("SELECT *, 1 AS extra FROM `p.d.t10000`")
+	refused("SELECT t FROM `p.d.t10000` AS t")
+	for _, name := range []string{"t10001", "n10001", "ar10001", "a10001", "v10001"} {
+		if _, err := db.ExecContext(ctx, "SELECT 1 FROM `p.d."+name+"`"); err == nil {
+			t.Errorf("the refused %s was made", name)
+		}
+	}
+	ok("CREATE TABLE `p.d.arr` (" + list(9999, true) + ", r ARRAY<INT64>)")
+}
