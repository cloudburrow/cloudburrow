+package internal
+
+import "fmt"
+
+// CloudBurrow patch (cloudburrow/cloudburrow#2012): BigQuery's "Maximum
+// number of columns": "Each table, query result, or view definition can
+// have up to 10,000 columns. This includes nested and repeated columns."
+// (https://docs.cloud.google.com/bigquery/quotas). The engine's SQLite
+// holds 32,767 columns (go-sqlite3-wasm patch 0105), so the analyzer
+// refuses a query, CREATE TABLE, CREATE TABLE ... AS SELECT or CREATE VIEW
+// of more before anything runs or is made. A RECORD's subfields count, at
+// every depth, as an ARRAY of STRUCT's do; the column of the time a row was
+// streamed the engine adds to a table (streamedAtColumn) does not.
+const maxColumns = 10000
+
+// typeColumns is the columns a column of type t holds besides itself: a
+// STRUCT's fields and theirs, an ARRAY's element's.
+func typeColumns(t *Type) int {
+	if t == nil {
+		return 0
+	}
+	n := typeColumns(t.ElementType)
+	for _, f := range t.FieldTypes {
+		n += 1 + typeColumns(f.Type)
+	}
+	return n
+}
+
+// countColumns counts cols as the limit does.
+func countColumns(cols []*ColumnSpec) int {
+	n := 0
+	for _, c := range cols {
+		if c.Name == streamedAtColumn {
+			continue
+		}
+		n += 1 + typeColumns(c.Type)
+	}
+	return n
+}
+
+// columnLimitError is the error of a statement whose what (a query result,
+// a table, a view) has cols, or nil. BigQuery's documentation gives no
+// message for it; the reason the front answers is invalidQuery.
+func columnLimitError(what string, cols []*ColumnSpec) error {
+	if n := countColumns(cols); n > maxColumns {
+		return fmt.Errorf("Too many columns: the %s has %d columns, including nested and repeated columns; "+
+			"a table, query result, or view definition can have up to %d columns", what, n, maxColumns)
+	}
+	return nil
+}
