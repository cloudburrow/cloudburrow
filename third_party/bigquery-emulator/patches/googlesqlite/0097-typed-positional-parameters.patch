+// declarePositionalParameterTypes declares the type of each positional
+// arg, in order, when there are at least as many args as the statement
+// has `?` and every arg's type is known, and reports whether it did.
+// CloudBurrow patch (cloudburrow/cloudburrow#1814).
+func (a *Analyzer) declarePositionalParameterTypes(args []driver.NamedValue, positional int) (bool, error) {
+	if err := a.opt.ClearPositionalQueryParameters(); err != nil {
+		return false, err
+	}
+	if positional == 0 || len(args) < positional {
+		return false, nil
+	}
+	typs := make([]googlesql.Googlesql_TypeNode, 0, positional)
+	for _, v := range args[:positional] {
+		if v.Name != "" {
+			return false, nil
+		}
+		typ, ok := positionalParameterType(v.Value)
+		if !ok {
+			return false, nil
+		}
+		typs = append(typs, typ)
+	}
+	if err := a.opt.SetAllowUndeclaredParameters(false); err != nil {
+		return false, err
+	}
+	for _, typ := range typs {
+		if err := a.opt.AddPositionalQueryParameter(typ); err != nil {
+			_ = undeclaredPositional(a.opt)
+			return false, err
+		}
+	}
+	return true, nil
+}
+
+// positionalParameterType is the type of a positional arg that is a
+// scalar of a known type. An ARRAY, a STRUCT (googleSQLTypeForValue's
+// STRING for a struct is not its type) or a NULL is not declared, so the
+// analyzer infers its type from its context, as it did.
+// CloudBurrow patch (cloudburrow/cloudburrow#1814).
+func positionalParameterType(v any) (googlesql.Googlesql_TypeNode, bool) {
+	switch x := v.(type) {
+	case nil:
+		return nil, false
+	case string:
+		if decoded, err := DecodeValue(x); err == nil {
+			switch decoded.(type) {
+			case nil, *value.ArrayValue, *value.StructValue, *value.RangeValue:
+				return nil, false
+			}
+		}
+	case bool, int, int8, int16, int32, int64, uint, uint8, uint16, uint32, uint64, float32, float64, []byte:
+	default:
+		return nil, false
+	}
+	return googleSQLTypeForValue(v)
+}
+
+// undeclaredPositional clears the declared positional parameters and
+// allows undeclared parameters again, as the shared options are between
+// statements. CloudBurrow patch (cloudburrow/cloudburrow#1814).
+func undeclaredPositional(opt *googlesql.AnalyzerOptions) error {
+	if err := opt.ClearPositionalQueryParameters(); err != nil {
+		return err
+	}
+	return opt.SetAllowUndeclaredParameters(true)
+}
