+package value
+
+import (
+	"encoding/base64"
+	"fmt"
+	"math/big"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// TypedParameter is a query argument given as BigQuery's REST API gives a
+// query parameter: the name of its GoogleSQL type and its value's text
+// (https://cloud.google.com/bigquery/docs/reference/rest/v2/QueryParameter).
+// A Go string, []byte or time.Time cannot say whether it is a NUMERIC, a
+// BYTES, a DATE, a TIME, a DATETIME, a GEOGRAPHY, a JSON or an INTERVAL; a
+// TypedParameter binds a value of its own type, so a parameter in the
+// select list has the type BigQuery gives it.
+//
+// CloudBurrow patch (cloudburrow/cloudburrow#1814).
+type TypedParameter struct {
+	// Type is the GoogleSQL type name: STRING, INT64, FLOAT64, BOOL,
+	// BYTES, NUMERIC, BIGNUMERIC, DATE, TIME, DATETIME, TIMESTAMP,
+	// GEOGRAPHY, JSON or INTERVAL (and the legacy names INTEGER, FLOAT,
+	// BOOLEAN, DECIMAL and BIGDECIMAL).
+	Type string
+	// Value is the value's text: BYTES base64-encoded, the others in
+	// their canonical text form.
+	Value string
+}
+
+// value is the parameter's value of its own type.
+func (p TypedParameter) value() (Value, error) {
+	s := p.Value
+	switch strings.ToUpper(p.Type) {
+	case "STRING":
+		return StringValue(s), nil
+	case "INT64", "INTEGER", "INT":
+		n, err := strconv.ParseInt(strings.TrimSpace(s), 10, 64)
+		if err != nil {
+			return nil, fmt.Errorf("invalid INT64 parameter value %q", s)
+		}
+		return IntValue(n), nil
+	case "FLOAT64", "FLOAT", "DOUBLE":
+		f, err := strconv.ParseFloat(strings.TrimSpace(s), 64)
+		if err != nil {
+			return nil, fmt.Errorf("invalid FLOAT64 parameter value %q", s)
+		}
+		return FloatValue(f), nil
+	case "BOOL", "BOOLEAN":
+		b, err := strconv.ParseBool(strings.TrimSpace(s))
+		if err != nil {
+			return nil, fmt.Errorf("invalid BOOL parameter value %q", s)
+		}
+		return BoolValue(b), nil
+	case "BYTES":
+		b, err := base64.StdEncoding.DecodeString(s)
+		if err != nil {
+			return nil, fmt.Errorf("invalid BYTES parameter value %q: not base64", s)
+		}
+		return BytesValue(b), nil
+	case "NUMERIC", "DECIMAL", "BIGNUMERIC", "BIGDECIMAL":
+		r, ok := new(big.Rat).SetString(strings.TrimSpace(s))
+		if !ok {
+			return nil, fmt.Errorf("invalid %s parameter value %q", strings.ToUpper(p.Type), s)
+		}
+		isBig := strings.HasPrefix(strings.ToUpper(p.Type), "BIG")
+		return &NumericValue{Rat: r, IsBigNumeric: isBig}, nil
+	case "DATE":
+		t, err := parseDate(s)
+		if err != nil {
+			return nil, fmt.Errorf("invalid DATE parameter value %q", s)
+		}
+		return DateValue(t), nil
+	case "TIME":
+		t, err := parseTime(s)
+		if err != nil {
+			return nil, fmt.Errorf("invalid TIME parameter value %q", s)
+		}
+		return TimeValue(t), nil
+	case "DATETIME":
+		t, err := parseDatetime(s)
+		if err != nil {
+			return nil, fmt.Errorf("invalid DATETIME parameter value %q", s)
+		}
+		return DatetimeValue(t), nil
+	case "TIMESTAMP":
+		t, err := parseTimestamp(s, time.UTC)
+		if err != nil {
+			return nil, fmt.Errorf("invalid TIMESTAMP parameter value %q", s)
+		}
+		return TimestampValue(t.UTC()), nil
+	case "GEOGRAPHY":
+		return GeographyFromWKT(s)
+	case "JSON":
+		return JsonValue(s), nil
+	case "INTERVAL":
+		return parseInterval(s)
+	}
+	return nil, fmt.Errorf("unsupported parameter type %q", p.Type)
+}
