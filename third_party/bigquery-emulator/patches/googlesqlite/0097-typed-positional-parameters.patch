@@ -0,0 +1,116 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"testing"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// TestBarePositionalParameter is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1814): a positional parameter alone in the
+// select list was an undeclared INT64, so `SELECT ? AS a` with a STRING
+// failed ("strconv.ParseInt ... invalid syntax") and a FLOAT64 or BOOL was
+// truncated. A positional or named parameter has its arg's type, and a
+// TypedParameter's type is the one it names.
+func TestBarePositionalParameter(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=bare_positional_parameter")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	typed := func(typ, v string) googlesqlite.TypedParameter {
+		return googlesqlite.TypedParameter{Type: typ, Value: v}
+	}
+	for _, tc := range []struct {
+		arg      any
+		wantType string
+		want     string
+	}{
+		{"hello", "STRING", "hello"},
+		{int64(42), "INT64", "42"},
+		{3.5, "DOUBLE", "3.5"},
+		{true, "BOOL", "true"},
+		{[]byte("hi"), "BYTES", "aGk="},
+		{typed("STRING", "hello"), "STRING", "hello"},
+		{typed("INT64", "42"), "INT64", "42"},
+		{typed("FLOAT64", "3.5"), "DOUBLE", "3.5"},
+		{typed("BOOL", "true"), "BOOL", "true"},
+		{typed("BYTES", "aGk="), "BYTES", "aGk="},
+		{typed("NUMERIC", "1.25"), "NUMERIC", "1.25"},
+		{typed("BIGNUMERIC", "1.5"), "BIGNUMERIC", "1.5"},
+		{typed("DATE", "2024-01-02"), "DATE", "2024-01-02"},
+		{typed("TIME", "03:04:05.123456"), "TIME", "03:04:05.123456"},
+		{typed("DATETIME", "2024-01-02 03:04:05.123456"), "DATETIME", "2024-01-02T03:04:05.123456"},
+		{typed("TIMESTAMP", "2024-01-02 03:04:05.123456+00:00"), "TIMESTAMP", ""},
+		{typed("GEOGRAPHY", "POINT(1 2)"), "GEOGRAPHY", "POINT(1 2)"},
+		{typed("JSON", `{"a":1}`), "JSON", `{"a":1}`},
+		{typed("INTERVAL", "1-2 3 4:5:6"), "INTERVAL", "1-2 3 4:5:6"},
+	} {
+		for _, q := range []struct {
+			sql string
+			arg any
+		}{
+			{"SELECT ? AS a", tc.arg},
+			{"SELECT @p AS a", sql.Named("p", tc.arg)},
+		} {
+			rows, err := db.QueryContext(ctx, q.sql, q.arg)
+			if err != nil {
+				t.Errorf("%s with %#v: %v", q.sql, tc.arg, err)
+				continue
+			}
+			cts, err := rows.ColumnTypes()
+			if err != nil {
+				t.Fatal(err)
+			}
+			var typ struct{ Name string }
+			if err := json.Unmarshal([]byte(cts[0].DatabaseTypeName()), &typ); err != nil {
+				t.Fatalf("column type %q: %v", cts[0].DatabaseTypeName(), err)
+			}
+			if typ.Name != tc.wantType {
+				t.Errorf("%s with %#v: column type %s, want %s", q.sql, tc.arg, typ.Name, tc.wantType)
+			}
+			if !rows.Next() {
+				t.Errorf("%s with %#v: no row: %v", q.sql, tc.arg, rows.Err())
+				rows.Close()
+				continue
+			}
+			var got sql.NullString
+			if err := rows.Scan(&got); err != nil {
+				t.Errorf("%s with %#v: scan: %v", q.sql, tc.arg, err)
+			} else if tc.want != "" && got.String != tc.want {
+				t.Errorf("%s with %#v = %q, want %q", q.sql, tc.arg, got.String, tc.want)
+			}
+			rows.Close()
+		}
+	}
+
+	// Several of them, in their order; then a statement whose `?` takes
+	// its type from its context, and one with a NULL arg, still analyzed
+	// with undeclared parameters.
+	var (
+		s string
+		f float64
+		n int64
+	)
+	if err := db.QueryRowContext(ctx, "SELECT ? AS a, ? AS b, ? AS c", "x", 2.5, int64(7)).Scan(&s, &f, &n); err != nil {
+		t.Fatalf("three positional parameters: %v", err)
+	}
+	if s != "x" || f != 2.5 || n != 7 {
+		t.Errorf("three positional parameters = %q, %v, %v", s, f, n)
+	}
+	if err := db.QueryRowContext(ctx, "SELECT CONCAT(?, 'b')", "a").Scan(&s); err != nil || s != "ab" {
+		t.Errorf("CONCAT(?, 'b') = %q, %v", s, err)
+	}
+	var null sql.NullInt64
+	if err := db.QueryRowContext(ctx, "SELECT ? AS a", nil).Scan(&null); err != nil || null.Valid {
+		t.Errorf("SELECT ? with NULL = %v, %v", null, err)
+	}
+	if err := db.QueryRowContext(ctx, "SELECT 1 + ?", int64(1)).Scan(&n); err != nil || n != 2 {
+		t.Errorf("SELECT 1 + ? = %v, %v", n, err)
+	}
+}
