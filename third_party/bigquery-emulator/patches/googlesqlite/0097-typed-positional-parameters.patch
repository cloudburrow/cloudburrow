+package googlesqlite
+
+import "github.com/goccy/googlesqlite/internal/value"
+
+// TypedParameter is a query argument of the GoogleSQL type it names, given
+// as its text, as BigQuery's REST API gives a query parameter: a NUMERIC,
+// BIGNUMERIC, BYTES (base64), DATE, TIME, DATETIME, GEOGRAPHY (WKT), JSON
+// or INTERVAL bound as one is a value of that type, where a Go string is a
+// STRING. CloudBurrow patch (cloudburrow/cloudburrow#1814).
+type TypedParameter = value.TypedParameter
