diff --git a/interval_sign_test.go b/interval_sign_test.go
new file mode 100644
index 0000000..af8fbca
--- /dev/null
+++ b/interval_sign_test.go
@@ -0,0 +1,51 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+)
+
+// TestIntervalSignAndSubSecondParts is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1126): a negative interval of less than an hour
+// was written (and so stored and read back) without its sign, and
+// INTERVAL n MILLISECOND or MICROSECOND failed "unexpected interval part".
+func TestIntervalSignAndSubSecondParts(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=interval_sign")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, tc := range []struct{ expr, want string }{
+		{"INTERVAL -1 SECOND", "0-0 0 -0:0:1"},
+		{"INTERVAL -61 SECOND", "0-0 0 -0:1:1"},
+		{"INTERVAL -90 MINUTE", "0-0 0 -1:30:0"},
+		{"MAKE_INTERVAL(second => -1)", "0-0 0 -0:0:1"},
+		{"INTERVAL -1 MONTH", "-0-1 0 0:0:0"},
+		{"INTERVAL -13 MONTH", "-1-1 0 0:0:0"},
+		{"INTERVAL -5 DAY", "0-0 -5 0:0:0"},
+		{"INTERVAL 1500 MILLISECOND", "0-0 0 0:0:1.5"},
+		{"INTERVAL -2 MICROSECOND", "0-0 0 -0:0:0.000002"},
+	} {
+		var got string
+		if err := db.QueryRowContext(ctx, "SELECT CAST("+tc.expr+" AS STRING)").Scan(&got); err != nil {
+			t.Errorf("CAST(%s AS STRING): %v", tc.expr, err)
+			continue
+		}
+		if got != tc.want {
+			t.Errorf("CAST(%s AS STRING) = %q, want %q", tc.expr, got, tc.want)
+		}
+	}
+	// Stored and read back, the value keeps its sign.
+	if _, err := db.ExecContext(ctx, "CREATE TABLE iv (v INTERVAL)"); err != nil {
+		t.Fatalf("CREATE TABLE: %v", err)
+	}
+	if _, err := db.ExecContext(ctx, "INSERT INTO iv (v) VALUES (INTERVAL -1 SECOND), (INTERVAL -1 MONTH)"); err != nil {
+		t.Fatalf("INSERT: %v", err)
+	}
+	var n int64
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM iv WHERE STARTS_WITH(CAST(v AS STRING), '-') OR STRPOS(CAST(v AS STRING), ' -') > 0").Scan(&n); err != nil || n != 2 {
+		t.Errorf("negative intervals read back: %d, %v, want 2", n, err)
+	}
+}
