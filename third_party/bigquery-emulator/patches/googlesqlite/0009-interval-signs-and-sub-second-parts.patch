diff --git a/internal/functions/interval/interval.go b/internal/functions/interval/interval.go
index 7c06790..5025292 100644
--- a/internal/functions/interval/interval.go
+++ b/internal/functions/interval/interval.go
@@ -26,6 +26,13 @@ func INTERVAL(v int64, part string) (value.Value, error) {
 		return &value.IntervalValue{IntervalValue: &intervalvalue.IntervalValue{Minutes: v32}}, nil
 	case "SECOND":
 		return &value.IntervalValue{IntervalValue: &intervalvalue.IntervalValue{Seconds: v32}}, nil
+	// CloudBurrow patch (cloudburrow/cloudburrow#1126): MILLISECOND and
+	// MICROSECOND, which BigQuery's INTERVAL takes, were "unexpected
+	// interval part"; whole seconds go to Seconds.
+	case "MILLISECOND":
+		return &value.IntervalValue{IntervalValue: &intervalvalue.IntervalValue{Seconds: int32(v / 1000), SubSecondNanos: int32(v%1000) * 1_000_000}}, nil
+	case "MICROSECOND":
+		return &value.IntervalValue{IntervalValue: &intervalvalue.IntervalValue{Seconds: int32(v / 1_000_000), SubSecondNanos: int32(v%1_000_000) * 1000}}, nil
 	case "NANOSECOND":
 		return &value.IntervalValue{IntervalValue: &intervalvalue.IntervalValue{SubSecondNanos: v32}}, nil
 	}
diff --git a/internal/intervalvalue/intervalvalue.go b/internal/intervalvalue/intervalvalue.go
index e22ed99..19b9a72 100644
--- a/internal/intervalvalue/intervalvalue.go
+++ b/internal/intervalvalue/intervalvalue.go
@@ -27,6 +27,7 @@ import (
 	"bytes"
 	"fmt"
 	"strconv"
+	"strings"
 	"time"
 )
 
@@ -69,9 +70,21 @@ func (iv *IntervalValue) String() string {
 	if !iv.IsCanonical() {
 		src = iv.Canonicalize()
 	}
-	out := fmt.Sprintf("%d-%d %d %d:%d:%d", src.Years, int32abs(src.Months), src.Days, src.Hours, int32abs(src.Minutes), int32abs(src.Seconds))
+	// CloudBurrow patch (cloudburrow/cloudburrow#1126): the sign of the
+	// Y-M part and of the H:M:S part is written before each part, as the
+	// canonical format has it, also when its first field is 0: -1 month is
+	// -0-1 and -1 second -0:0:1 (v0.3.1 wrote 0-1 and 0:0:1, and the value
+	// read back from storage was positive).
+	ymSign, timeSign := "", ""
+	if src.Years < 0 || src.Months < 0 {
+		ymSign = "-"
+	}
+	if src.Hours < 0 || src.Minutes < 0 || src.Seconds < 0 || src.SubSecondNanos < 0 {
+		timeSign = "-"
+	}
+	out := fmt.Sprintf("%s%d-%d %d %s%d:%d:%d", ymSign, int32abs(src.Years), int32abs(src.Months), src.Days, timeSign, int32abs(src.Hours), int32abs(src.Minutes), int32abs(src.Seconds))
 	if src.SubSecondNanos != 0 {
-		mantStr := fmt.Sprintf("%09d", src.SubSecondNanos)
+		mantStr := fmt.Sprintf("%09d", int32abs(src.SubSecondNanos))
 		for len(mantStr) > 0 && mantStr[len(mantStr)-1:] == "0" {
 			mantStr = mantStr[0 : len(mantStr)-1]
 		}
@@ -107,7 +120,17 @@ var canonicalParts = []intervalPart{yearsPart, monthsPart, daysPart, hoursPart,
 // ParseInterval parses an interval in canonical string format and returns the IntervalValue it represents.
 func ParseInterval(value string) (*IntervalValue, error) {
 	iVal := &IntervalValue{}
+	// CloudBurrow patch (cloudburrow/cloudburrow#1126): a part's sign is
+	// read from its text, so -0-1 and -0:0:1 are negative although their
+	// first field is 0.
+	var ymNegative, timeNegative bool
 	for _, part := range canonicalParts {
+		switch part {
+		case yearsPart:
+			ymNegative = strings.HasPrefix(trimPrefix(part, value), "-")
+		case hoursPart:
+			timeNegative = strings.HasPrefix(trimPrefix(part, value), "-")
+		}
 		remaining, v, err := getPartValue(part, value)
 		if err != nil {
 			return nil, err
@@ -117,7 +140,7 @@ func ParseInterval(value string) (*IntervalValue, error) {
 			iVal.Years = v
 		case monthsPart:
 			iVal.Months = v
-			if iVal.Years < 0 {
+			if ymNegative {
 				iVal.Months = -v
 			}
 		case daysPart:
@@ -126,17 +149,17 @@ func ParseInterval(value string) (*IntervalValue, error) {
 			iVal.Hours = v
 		case minutesPart:
 			iVal.Minutes = v
-			if iVal.Hours < 0 {
+			if timeNegative {
 				iVal.Minutes = -v
 			}
 		case secondsPart:
 			iVal.Seconds = v
-			if iVal.Hours < 0 {
+			if timeNegative {
 				iVal.Seconds = -v
 			}
 		case subsecsPart:
 			iVal.SubSecondNanos = v
-			if iVal.Hours < 0 {
+			if timeNegative {
 				iVal.SubSecondNanos = -v
 			}
 		default:
