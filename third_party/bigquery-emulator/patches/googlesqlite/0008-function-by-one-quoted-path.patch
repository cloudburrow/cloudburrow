index 0000000..9fc76b8
--- /dev/null
+++ b/function_by_quoted_path_test.go
@@ -0,0 +1,36 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"testing"
+)
+
+// TestFunctionByOneQuotedPath is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1122): a function named by one quoted path,
+// `proj-1.one.fn`(x), as a table may be, was "Function not found".
+func TestFunctionByOneQuotedPath(t *testing.T) {
+	conn := functionPathsConn(t, ":memory:?_test=function_by_one_quoted_path")
+	ctx := context.Background()
+	for _, tc := range []struct {
+		query string
+		want  int64
+	}{
+		{"SELECT `proj-1.one.fn`(3)", 4},
+		{"SELECT `one.fn`(3)", 4},
+		{"SELECT `proj-1.two.fn`(3)", 5},
+		{"SELECT `two.fn`(3) + `proj-1`.one.fn(1)", 7},
+	} {
+		var got int64
+		if err := conn.QueryRowContext(ctx, tc.query).Scan(&got); err != nil {
+			t.Errorf("%s: %v", tc.query, err)
+			continue
+		}
+		if got != tc.want {
+			t.Errorf("%s = %d, want %d", tc.query, got, tc.want)
+		}
+	}
+	var x int64
+	if err := conn.QueryRowContext(ctx, "SELECT x FROM `proj-1.one.tf`(2)").Scan(&x); err != nil || x != 102 {
+		t.Errorf("SELECT x FROM `proj-1.one.tf`(2) = %d, %v, want 102", x, err)
+	}
+}
