+)
+
+// TestChangeHistoryKeptRecords is CloudBurrow's regression test of its
+// patch 0090 (cloudburrow/cloudburrow#1458): a change record the change
+// table lets go of (a write's trigger after seven days, or a DELETE of the
+// change table, as CloudBurrow's front lets go of what is older than a
+// dataset's time travel window) is moved to the table's kept table with
+// its values, a pending one's from its row in the table, the START row
+// aside; the kept table survives a reopening, is made for a change table
+// saved without one, goes with DROP TABLE and starts empty on CREATE OR
+// REPLACE TABLE.
+func TestChangeHistoryKeptRecords(t *testing.T) {
+	ctx := context.Background()
+	defer googlesqlite.SetClockOffset(googlesqlite.ClockOffset())
+	path := filepath.Join(t.TempDir(), "kept.db")
+	// The engine keeps a catalog by data source name: each open names
+	// the file another way, as a restarted engine starts a new catalog.
+	opened := 0
+	open := func() *sql.DB {
+		t.Helper()
+		opened++
+		db, err := sql.Open("googlesqlite", fmt.Sprintf("file:%s?_pragma=busy_timeout(%d)", path, 5000+opened))
+		if err != nil {
+			t.Fatal(err)
+		}
+		db.SetMaxOpenConns(1)
+		return db
+	}
+	db := open()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	kept := func() string {
+		t.Helper()
+		var got sql.NullString
+		if err := db.QueryRowContext(ctx, "SELECT STRING_AGG(FORMAT('%s:%d:%s', _CHANGE_TYPE, id, IF(d IS NULL, 'null', CAST(d AS STRING))), ',' ORDER BY id, _CHANGE_TYPE) FROM `p.d.t$kept$changes`").Scan(&got); err != nil {
+			t.Fatal(err)
+		}
+		return got.String
+	}
+	exec("CREATE TABLE `p.d.t` (id INT64, d DATE)")
+	exec("INSERT INTO `p.d.t` (id, d) VALUES (1, DATE '2025-01-01'), (2, DATE '2025-01-02')")
+	exec("DELETE `p.d.t` WHERE id = 2")
+	if got := kept(); got != "" {
+		t.Errorf("kept records before seven days: %q, want none", got)
+	}
+	googlesqlite.SetClockOffset(googlesqlite.ClockOffset() + 8*24*time.Hour)
+	exec("INSERT INTO `p.d.t` (id, d) VALUES (3, DATE '2025-01-03')")
+	// Row 1's INSERT (pending, its values the row's), row 2's INSERT
+	// (settled by its DELETE) and DELETE; not the START row.
+	if got := kept(); got != "INSERT:1:2025-01-01,DELETE:2:2025-01-02,INSERT:2:2025-01-02" {
+		t.Errorf("kept records after seven days: %q", got)
+	}
+	var n int
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM `p.d.t$changes` WHERE _CHANGE_TYPE != 'START'").Scan(&n); err != nil || n != 1 {
+		t.Errorf("records left in the change table: %d (%v), want 1", n, err)
+	}
+	// A DELETE of the change table (the front's window) keeps them too.
+	exec("DELETE FROM `p.d.t$changes` WHERE TRUE")
+	if got := kept(); got != "INSERT:1:2025-01-01,DELETE:2:2025-01-02,INSERT:2:2025-01-02,INSERT:3:2025-01-03" {
+		t.Errorf("kept records after the change table's delete: %q", got)
+	}
+	db.Close()
+
+	// A reopening keeps them; a change table saved without a kept table
+	// (made before the patch) gets one.
+	db = open()
+	exec("CREATE TABLE `p.d.u` (id INT64)")
+	db.Close()
+	raw, err := sql.Open("googlesqlite_sqlite3", "file:"+path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, q := range []string{
+		"DROP TRIGGER `p_d_u$changes$keep`",
+		"DROP TABLE `p_d_u$kept$changes`",
+		"DELETE FROM googlesqlite_catalog WHERE name = 'p_d_u$kept$changes'",
+	} {
+		if _, err := raw.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	raw.Close()
+	db = open()
+	defer db.Close()
+	if got := kept(); got != "INSERT:1:2025-01-01,DELETE:2:2025-01-02,INSERT:2:2025-01-02,INSERT:3:2025-01-03" {
+		t.Errorf("kept records after a reopening: %q", got)
+	}
+	exec("INSERT INTO `p.d.u` (id) VALUES (7)")
+	exec("DELETE FROM `p.d.u$changes` WHERE TRUE")
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM `p.d.u$kept$changes` WHERE id = 7").Scan(&n); err != nil || n != 1 {
+		t.Errorf("kept records of an older change table: %d (%v), want 1", n, err)
+	}
+
+	exec("CREATE OR REPLACE TABLE `p.d.t` (id INT64, d DATE)")
+	if got := kept(); got != "" {
+		t.Errorf("kept records after CREATE OR REPLACE TABLE: %q, want none", got)
+	}
+	exec("DROP TABLE `p.d.t`")
+	if _, err := db.QueryContext(ctx, "SELECT * FROM `p.d.t$kept$changes`"); err == nil {
+		t.Error("the kept table of a dropped table is still there")
+	}
+}
