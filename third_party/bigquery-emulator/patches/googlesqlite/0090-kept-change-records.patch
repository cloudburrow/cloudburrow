@@ -0,0 +1,219 @@
+package internal
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// Kept change records (CloudBurrow patch, cloudburrow/cloudburrow#1458).
+//
+// A table's change table (patch 0036) keeps seven days of changes: each
+// write's trigger deletes the older ones, and CloudBurrow's front lets go
+// of what is older than a dataset's time travel window. But BigQuery's
+// INFORMATION_SCHEMA.PARTITIONS.last_modified_time is "the most recent
+// time that data was written to the partition", and TABLE_STORAGE's
+// active and long-term bytes hang on whether a partition went 90 days
+// unmodified (https://cloud.google.com/bigquery/docs/information-schema-partitions,
+// https://cloud.google.com/bigquery/pricing#storage), so a reader needs a
+// partition's last write however long ago it was. Every change record a
+// change table lets go of (a START row aside) is now moved, with its
+// values (a pending record's from its row in the table, patch 0074), to
+// the table's kept table: the change table's columns, named the table's
+// last path element with keptTableSuffix, a change table to every reader
+// (no wildcard or INFORMATION_SCHEMA lists it, it has no change table of
+// its own). A BEFORE DELETE trigger on the change table moves them, so
+// every way a record goes (the triggers' seven days, the front's window)
+// keeps it; the kept table is in the database, so it survives a restart.
+// The engine does not know a table's partitioning: CloudBurrow's front,
+// which does, reads a partition's last write from the change table and the
+// kept table together, and compacts the kept table to the latest record of
+// each partition. DROP TABLE drops it with the change table, and a table
+// made again (CREATE OR REPLACE TABLE) starts an empty one. A change table
+// made before this patch gets its kept table, and the trigger, at the
+// catalog's first sync (migrateKeptTables); what it let go of before then
+// is gone.
+
+// keptTableSuffix ends the last path element of a kept table; it ends with
+// changeTableSuffix, so a kept table is a change table to isChangeTableName.
+const keptTableSuffix = "$kept" + changeTableSuffix
+
+// keptTableName is the SQLite name of the kept table of the change table
+// named change.
+func keptTableName(change string) string {
+	return strings.TrimSuffix(change, changeTableSuffix) + keptTableSuffix
+}
+
+func isKeptTableName(name string) bool { return strings.HasSuffix(name, keptTableSuffix) }
+
+// keptTableSpec is the catalog spec of the kept table of the change table
+// of spec cs.
+func keptTableSpec(cs *TableSpec) *TableSpec {
+	ks := *cs
+	ks.NamePath = append([]string{}, cs.NamePath...)
+	last := len(ks.NamePath) - 1
+	ks.NamePath[last] = strings.TrimSuffix(ks.NamePath[last], changeTableSuffix) + keptTableSuffix
+	ks.Columns = append([]*ColumnSpec{}, cs.Columns...)
+	return &ks
+}
+
+// sqliteColumns returns the SQLite columns of table, in order, with their
+// declared types.
+func sqliteColumns(ctx context.Context, conn *Conn, table string) ([]string, map[string]string, error) {
+	rows, err := conn.QueryContext(ctx, "SELECT name, type FROM pragma_table_info(@t)", sql.Named("t", table))
+	if err != nil {
+		return nil, nil, err
+	}
+	defer rows.Close()
+	var order []string
+	types := map[string]string{}
+	for rows.Next() {
+		var name, typ string
+		if err := rows.Scan(&name, &typ); err != nil {
+			return nil, nil, err
+		}
+		order = append(order, name)
+		types[name] = typ
+	}
+	return order, types, rows.Err()
+}
+
+// makeKeptTable makes, in SQLite, the kept table of the change table named
+// change (when it has none) and the trigger that moves each record the
+// change table lets go of into it. fresh drops a kept table already there
+// first.
+func makeKeptTable(ctx context.Context, conn *Conn, change string, fresh bool) error {
+	kept := keptTableName(change)
+	base := strings.TrimSuffix(change, changeTableSuffix)
+	order, types, err := sqliteColumns(ctx, conn, change)
+	if err != nil || len(order) == 0 {
+		return err
+	}
+	_, inBase, err := sqliteColumns(ctx, conn, base)
+	if err != nil {
+		return err
+	}
+	_, pending := types[changePendingColumn]
+	var defs, cols, vals []string
+	for _, c := range order {
+		if c == changePendingColumn {
+			continue
+		}
+		q := "`" + c + "`"
+		defs = append(defs, strings.TrimSpace(q+" "+types[c]))
+		cols = append(cols, q)
+		v := "OLD." + q
+		if _, ok := inBase[c]; ok && pending && !isChangeColumn(c) && !strings.HasPrefix(c, "googlesqlite_") {
+			// A pending record's values are its row's in the table.
+			v = fmt.Sprintf("CASE WHEN OLD.`%s` IS NULL THEN OLD.%s ELSE (SELECT %s FROM `%s` WHERE rowid = OLD.`%s`) END",
+				changePendingColumn, q, q, base, changeRowidColumn)
+		}
+		vals = append(vals, v)
+	}
+	when := "OLD.`_CHANGE_TYPE` IS NOT " + encodedLiteral(value.StringValue(changeStartType))
+	if pending {
+		// A pending record whose row is gone (the trigger of a DELETE that
+		// let it go fires after the row went) is left out: the DELETE's
+		// own record is the later write of the row's partition.
+		when += fmt.Sprintf(" AND (OLD.`%s` IS NULL OR EXISTS (SELECT 1 FROM `%s` WHERE rowid = OLD.`%s`))",
+			changePendingColumn, base, changeRowidColumn)
+	}
+	var stmts []string
+	if fresh {
+		stmts = append(stmts, fmt.Sprintf("DROP TABLE IF EXISTS `%s`", kept))
+	}
+	stmts = append(stmts,
+		fmt.Sprintf("CREATE TABLE IF NOT EXISTS `%s` (%s)", kept, strings.Join(defs, ",")),
+		fmt.Sprintf("DROP TRIGGER IF EXISTS `%s$keep`", change),
+		fmt.Sprintf("CREATE TRIGGER `%s$keep` BEFORE DELETE ON `%s` FOR EACH ROW WHEN %s BEGIN INSERT INTO `%s` (%s) VALUES (%s); END",
+			change, change, when, kept, strings.Join(cols, ","), strings.Join(vals, ",")),
+	)
+	for _, s := range stmts {
+		if _, err := conn.ExecContext(ctx, s); err != nil {
+			return fmt.Errorf("kept changes of %s: %w", base, err)
+		}
+	}
+	return nil
+}
+
+// addKeptTable makes the kept table of the change table of spec cs, just
+// made (fresh: a new history) or found in SQLite, and puts it in the
+// catalog.
+func addKeptTable(ctx context.Context, conn *Conn, catalog *Catalog, cs *TableSpec, fresh bool) error {
+	change := cs.TableName()
+	if err := makeKeptTable(ctx, conn, change, fresh); err != nil {
+		return err
+	}
+	ks := keptTableSpec(cs)
+	if _, exists := catalog.tableMap[ks.TableName()]; exists {
+		if !fresh {
+			return nil
+		}
+		if err := catalog.DeleteTableSpec(ctx, conn, ks.TableName()); err != nil {
+			return err
+		}
+	}
+	return catalog.AddNewTableSpec(ctx, conn, ks)
+}
+
+// migrateKeptTables gives every change table of the catalog made before
+// this patch its kept table (in SQLite and in the catalog) and trigger.
+func migrateKeptTables(ctx context.Context, conn *Conn) error {
+	rows, err := conn.QueryContext(ctx, "SELECT name, spec FROM googlesqlite_catalog WHERE kind = @kind AND name LIKE @suffix",
+		sql.Named("kind", string(TableSpecKind)), sql.Named("suffix", "%"+changeTableSuffix))
+	if err != nil {
+		return err
+	}
+	specs := map[string]*TableSpec{}
+	var changes []string
+	for rows.Next() {
+		var name, encoded string
+		if err := rows.Scan(&name, &encoded); err != nil {
+			rows.Close()
+			return err
+		}
+		var spec TableSpec
+		if err := json.Unmarshal([]byte(encoded), &spec); err != nil || !isChangeTableName(name) {
+			continue
+		}
+		specs[name] = &spec
+		if !isKeptTableName(name) {
+			changes = append(changes, name)
+		}
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		return err
+	}
+	rows.Close()
+	for _, change := range changes {
+		kept := keptTableName(change)
+		if _, ok := specs[kept]; ok {
+			continue
+		}
+		if order, _, err := sqliteColumns(ctx, conn, change); err != nil || len(order) == 0 {
+			if err != nil {
+				return err
+			}
+			continue // no SQLite table of the name
+		}
+		if err := makeKeptTable(ctx, conn, change, false); err != nil {
+			return err
+		}
+		encoded, err := json.Marshal(keptTableSpec(specs[change]))
+		if err != nil {
+			return err
+		}
+		now := time.Now()
+		if _, err := conn.ExecContext(ctx, upsertCatalogQuery, sql.Named("name", kept), sql.Named("kind", string(TableSpecKind)),
+			sql.Named("spec", string(encoded)), sql.Named("updatedAt", now), sql.Named("createdAt", now)); err != nil {
+			return fmt.Errorf("kept changes of %s: %w", change, err)
+		}
+	}
+	return nil
+}
