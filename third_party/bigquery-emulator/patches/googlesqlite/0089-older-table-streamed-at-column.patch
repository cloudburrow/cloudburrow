--- /dev/null
+++ b/internal/streamed_at_migrate.go
@@ -0,0 +1,105 @@
+package internal
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/goccy/go-googlesql"
+)
+
+// The stream time of a table made before the engine had it (CloudBurrow
+// patch, cloudburrow/cloudburrow#1458).
+//
+// Patch 0030 gave a table made by tables.insert or by CREATE TABLE with a
+// column list the pseudo-column _PARTITION_STREAMED, the time CloudBurrow's
+// front streamed a row, which DML reads to refuse a row streamed "within
+// the last 30 minutes" (https://cloud.google.com/bigquery/docs/data-manipulation-language);
+// patch 0056 gave it to CREATE TABLE ... AS SELECT and patch 0088 to
+// CREATE TABLE IF NOT EXISTS. A table made before those patches, saved in
+// an instance's state, had none, so the rows streamed to it were held from
+// DML only while in the streaming buffer. The catalog's first sync now
+// gives every such table the column, NULL on the rows it has (their stream
+// times were never recorded), so the rows streamed to it from then on are
+// held as BigQuery holds them. A temporary table (tabledata.insertAll
+// cannot stream to one), a view, a change table and CloudBurrow's own
+// tables (a query's results) get none, as before.
+
+// migrateStreamedAtColumn adds _PARTITION_STREAMED to every table of the
+// catalog made without it (above), in SQLite and in the catalog; the
+// catalog's updatedAt is left as it is, so a table's last change is not
+// moved.
+func migrateStreamedAtColumn(ctx context.Context, conn *Conn) error {
+	rows, err := conn.QueryContext(ctx,
+		"SELECT name, spec FROM googlesqlite_catalog WHERE kind = @kind AND instr(spec, @col) = 0",
+		sql.Named("kind", string(TableSpecKind)), sql.Named("col", `"`+streamedAtColumn+`"`))
+	if err != nil {
+		return err
+	}
+	type old struct {
+		name string
+		spec *TableSpec
+	}
+	var olds []old
+	for rows.Next() {
+		var name, encoded string
+		if err := rows.Scan(&name, &encoded); err != nil {
+			rows.Close()
+			return err
+		}
+		var spec TableSpec
+		if err := json.Unmarshal([]byte(encoded), &spec); err != nil || !streamedAtMigratable(name, &spec) {
+			continue
+		}
+		olds = append(olds, old{name, &spec})
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		return err
+	}
+	rows.Close()
+	for _, o := range olds {
+		var have, has int
+		if err := conn.QueryRowContext(ctx, "SELECT COUNT(*), COUNT(CASE WHEN name = @c COLLATE NOCASE THEN 1 END) FROM pragma_table_info(@t)",
+			sql.Named("t", o.name), sql.Named("c", streamedAtColumn)).Scan(&have, &has); err != nil {
+			return err
+		}
+		if have == 0 {
+			continue // no SQLite table of the name
+		}
+		col := &ColumnSpec{Name: streamedAtColumn, Type: &Type{Kind: int(googlesql.TypeKindTypeTimestamp)}}
+		if has == 0 {
+			if _, err := conn.ExecContext(ctx, fmt.Sprintf("ALTER TABLE `%s` ADD COLUMN %s", o.name, col.SQLiteSchema())); err != nil {
+				return fmt.Errorf("table %s: %w", o.name, err)
+			}
+		}
+		o.spec.Columns = append(o.spec.Columns, col)
+		encoded, err := json.Marshal(o.spec)
+		if err != nil {
+			return err
+		}
+		if _, err := conn.ExecContext(ctx, "UPDATE googlesqlite_catalog SET spec = @spec WHERE name = @name",
+			sql.Named("spec", string(encoded)), sql.Named("name", o.name)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// streamedAtMigratable reports whether the table name of spec is one the
+// migration gives the column (above).
+func streamedAtMigratable(name string, spec *TableSpec) bool {
+	if spec.IsTemp || spec.IsView || len(spec.NamePath) < 3 || isChangeTableName(name) ||
+		strings.HasPrefix(spec.NamePath[len(spec.NamePath)-1], "googlesqlite_") ||
+		strings.HasPrefix(spec.NamePath[len(spec.NamePath)-2], "_cloudburrow") {
+		return false
+	}
+	for _, c := range spec.Columns {
+		if strings.EqualFold(c.Name, streamedAtColumn) {
+			return false
+		}
+	}
+	return true
+}
