+++ b/streamed_at_migrate_test.go
@@ -0,0 +1,84 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestStreamedAtColumnOfAnOlderTable is CloudBurrow's regression test of
+// its patch 0089 (cloudburrow/cloudburrow#1458): a table saved without the
+// pseudo-column _PARTITION_STREAMED (made before patches 0030, 0056 and
+// 0088) gets it when the database is next opened, NULL on the rows it
+// has, left out of SELECT *, and an INSERT may give it; its history goes
+// on.
+func TestStreamedAtColumnOfAnOlderTable(t *testing.T) {
+	ctx := context.Background()
+	open := func(dsn string) *sql.DB {
+		t.Helper()
+		db, err := sql.Open("googlesqlite", dsn)
+		if err != nil {
+			t.Fatal(err)
+		}
+		db.SetMaxOpenConns(1)
+		return db
+	}
+	exec := func(db *sql.DB, q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	path := filepath.Join(t.TempDir(), "old.db")
+	db := open("file:" + path)
+	exec(db, "CREATE TABLE `p.d.old` (id INT64, s STRING)")
+	exec(db, "INSERT INTO `p.d.old` (id, s) VALUES (1, 'a')")
+	db.Close()
+	// The table as a state saved before the patches had it: no column in
+	// SQLite (its tables are named by their paths joined with _) or in
+	// the catalog's spec, whose last column it is.
+	raw, err := sql.Open("googlesqlite_sqlite3", "file:"+path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, q := range []string{
+		"ALTER TABLE `p_d_old` DROP COLUMN `_PARTITION_STREAMED`",
+		`UPDATE googlesqlite_catalog SET spec = json_remove(spec, '$.columns[#-1]') WHERE name = 'p_d_old' AND json_extract(spec, '$.columns[#-1].name') = '_PARTITION_STREAMED'`,
+	} {
+		if _, err := raw.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	var n int
+	if err := raw.QueryRowContext(ctx, "SELECT COUNT(*) FROM pragma_table_info('p_d_old') WHERE name = '_PARTITION_STREAMED'").Scan(&n); err != nil || n != 0 {
+		t.Fatalf("the aged table still has the column (%d, %v)", n, err)
+	}
+	raw.Close()
+
+	db = open("file:" + path + "?_pragma=busy_timeout(5000)")
+	defer db.Close()
+	exec(db, "INSERT INTO `p.d.old` (id, s, _PARTITION_STREAMED) VALUES (2, 'b', TIMESTAMP '2026-01-01 00:00:00+00')")
+	rows, err := db.QueryContext(ctx, "SELECT * FROM `p.d.old`")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cols, _ := rows.Columns()
+	rows.Close()
+	if strings.Join(cols, ",") != "id,s" {
+		t.Errorf("SELECT * columns = %v, want [id s]", cols)
+	}
+	var got string
+	if err := db.QueryRowContext(ctx, "SELECT STRING_AGG(FORMAT('%d:%s', id, IF(_PARTITION_STREAMED IS NULL, 'null', CAST(_PARTITION_STREAMED AS STRING))), ',' ORDER BY id) FROM `p.d.old`").Scan(&got); err != nil {
+		t.Fatal(err)
+	}
+	if got != "1:null,2:2026-01-01 00:00:00+00" {
+		t.Errorf("_PARTITION_STREAMED by id = %s, want 1:null,2:2026-01-01 00:00:00+00", got)
+	}
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM `p.d.old$changes` WHERE _CHANGE_TYPE = 'INSERT'").Scan(&n); err != nil || n != 2 {
+		t.Errorf("INSERTs in the history after the migration: %d (%v), want 2", n, err)
+	}
+}
