+// encodeElement is EncodeValue for an element of an ARRAY or a field of a
+// STRUCT, whose encodings are then written as JSON, which has no infinity:
+// an infinite FLOAT64 there goes in the envelope, as a NaN does anywhere.
+// CloudBurrow patch (cloudburrow/cloudburrow#1061, #1077): json.Marshal
+// refused it, "json: unsupported value: +Inf".
+func encodeElement(v Value) (any, error) {
+	if f, ok := v.(FloatValue); ok && math.IsInf(float64(f), 0) {
+		layout, err := valueLayoutFromValue(f)
+		if err != nil {
+			return nil, err
+		}
+		b, err := json.Marshal(layout)
+		if err != nil {
+			return nil, err
+		}
+		return base64.StdEncoding.EncodeToString(b), nil
+	}
+	return EncodeValue(v)
+}
