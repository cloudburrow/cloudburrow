--- /dev/null
+++ b/nan_test.go
@@ -0,0 +1,100 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"math"
+	"testing"
+)
+
+// TestNaNIsKept is a CloudBurrow regression test (cloudburrow/cloudburrow#1061,
+// #1066): SQLite turns a NaN it is bound, or that a function returns, into
+// NULL, so every NaN read back NULL. BigQuery's FLOAT64 includes NaN.
+func TestNaNIsKept(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=nan")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	nan := func(q string, args ...any) {
+		t.Helper()
+		var f sql.NullFloat64
+		if err := db.QueryRowContext(ctx, q, args...).Scan(&f); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		if !f.Valid || !math.IsNaN(f.Float64) {
+			t.Errorf("%s = %v, want NaN", q, f)
+		}
+	}
+	truth := func(q string) {
+		t.Helper()
+		var b sql.NullBool
+		if err := db.QueryRowContext(ctx, q).Scan(&b); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		if !b.Valid || !b.Bool {
+			t.Errorf("%s = %v, want true", q, b)
+		}
+	}
+	nan("SELECT IEEE_DIVIDE(0, 0)")
+	nan("SELECT CAST('NaN' AS FLOAT64)")
+	nan("SELECT CAST(x AS FLOAT64) FROM UNNEST(['nan']) AS x")
+	nan("SELECT @p", sql.Named("p", math.NaN()))
+	nan("SELECT IEEE_DIVIDE(0, 0) + 1")
+	truth("SELECT IS_NAN(IEEE_DIVIDE(0, 0))")
+	truth("SELECT IS_INF(IEEE_DIVIDE(1, 0))")
+	truth("SELECT IEEE_DIVIDE(0, 0) IS NOT NULL")
+	for _, q := range []string{
+		"CREATE TABLE t (id INT64, f FLOAT64)",
+		"INSERT INTO t (id, f) VALUES (1, IEEE_DIVIDE(0, 0))",
+		"INSERT INTO t (id, f) SELECT 2, CAST(x AS FLOAT64) FROM UNNEST(['nan']) AS x",
+		"INSERT INTO t (id, f) VALUES (4, 1.5), (5, IEEE_DIVIDE(1, 0))",
+	} {
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	if _, err := db.ExecContext(ctx, "INSERT INTO t (id, f) VALUES (3, @p)", sql.Named("p", math.NaN())); err != nil {
+		t.Fatalf("INSERT a NaN parameter: %v", err)
+	}
+	for _, id := range []int{1, 2, 3} {
+		nan("SELECT f FROM t WHERE id = @id", sql.Named("id", id))
+	}
+	var n int64
+	if err := db.QueryRowContext(ctx, "SELECT COUNTIF(IS_NAN(f)) FROM t").Scan(&n); err != nil || n != 3 {
+		t.Errorf("COUNTIF(IS_NAN(f)) = %d, %v, want 3", n, err)
+	}
+	nan("SELECT SUM(f) FROM t")
+	var f float64
+	if err := db.QueryRowContext(ctx, "SELECT f FROM t WHERE id = 4").Scan(&f); err != nil || f != 1.5 {
+		t.Errorf("f of 4 = %v, %v, want 1.5", f, err)
+	}
+	if err := db.QueryRowContext(ctx, "SELECT f FROM t WHERE id = 5").Scan(&f); err != nil || !math.IsInf(f, 1) {
+		t.Errorf("f of 5 = %v, %v, want +Inf", f, err)
+	}
+
+	// An infinity or a NaN inside an ARRAY or a STRUCT (#1077): the
+	// composite's encoding is JSON, which has neither.
+	for _, q := range []string{
+		"SELECT ARRAY_LENGTH([CAST('inf' AS FLOAT64), IEEE_DIVIDE(0, 0), IEEE_DIVIDE(-1, 0)])",
+		"SELECT IF(IS_INF(STRUCT(IEEE_DIVIDE(1, 0) AS x).x), 1, 0)",
+	} {
+		var n int64
+		if err := db.QueryRowContext(ctx, q).Scan(&n); err != nil || n < 1 {
+			t.Errorf("%s = %d, %v", q, n, err)
+		}
+	}
+	for _, q := range []string{
+		"CREATE TABLE c (id INT64, a ARRAY<FLOAT64>, s STRUCT<x FLOAT64>)",
+		"INSERT INTO c (id, a, s) SELECT 4, [CAST('inf' AS FLOAT64), IEEE_DIVIDE(0, 0), 1.5], STRUCT(IEEE_DIVIDE(-1, 0) AS x)",
+	} {
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	var inf, nanElem, neg bool
+	if err := db.QueryRowContext(ctx, "SELECT IS_INF(a[OFFSET(0)]) AND a[OFFSET(0)] > 0, IS_NAN(a[OFFSET(1)]), IS_INF(s.x) AND s.x < 0 FROM c WHERE id = 4").Scan(&inf, &nanElem, &neg); err != nil || !inf || !nanElem || !neg {
+		t.Errorf("the composites read back +Inf %v, NaN %v, -Inf %v (%v)", inf, nanElem, neg, err)
+	}
+}
