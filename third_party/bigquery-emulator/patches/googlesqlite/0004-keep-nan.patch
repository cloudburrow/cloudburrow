+// nanResult is the value a function returns for a NaN. CloudBurrow patch
+// (cloudburrow/cloudburrow#1061, #1066): sqlite3_result_double makes a NaN
+// NULL, so a NaN is returned as the envelope value.EncodeValue writes for
+// one, which every reader decodes as a FLOAT64 NaN.
+var nanResult = func() string {
+	v, err := value.EncodeValue(value.FloatValue(math.NaN()))
+	if err != nil {
+		panic(err)
+	}
+	return v.(string)
+}()
+
+func applyFloatResult(ctx sqlite3.Context, f float64) {
+	if math.IsNaN(f) {
+		ctx.ResultText(nanResult)
+		return
+	}
+	ctx.ResultFloat(f)
+}
