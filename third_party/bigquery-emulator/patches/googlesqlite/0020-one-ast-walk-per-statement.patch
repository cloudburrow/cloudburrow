+// walks of the tree per statement (the parameter mode twice, the `?`
+// count or the @names, the literal casts, the wildcard tables), each
+// node of each walk several calls into the WebAssembly engine; for an
+// INSERT ... VALUES of a few thousand rows they were about 40% of the
+// statement's time. collectStmtASTFacts gathers all of it in one walk.
+type stmtASTFacts struct {
+	// positional is the number of `?` parameters.
+	positional int
+	// hasNamed reports any @name parameter; named holds the distinct
+	// non-empty names, lowercased, in the order they first appear.
+	hasNamed bool
+	named    []string
+	// castErr is the first CAST(<string literal> AS <numeric type>)
+	// whose literal would fail at runtime. googlesql's analyzer does
+	// not fold such casts at analysis time; rejecting them here
+	// produces the "Could not cast literal" message users expect, and
+	// matches the historical googlesql behavior.
+	castErr error
+	// wildcardTables are the paths of the table references whose last
+	// segment ends with `*` (e.g. `project.dataset.table_*`).
+	wildcardTables [][]string
