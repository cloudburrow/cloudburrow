+package googlesqlite_test
+
+import (
+	"database/sql"
+	"fmt"
+	"strings"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+func insertValuesStmt(table string, from, n int) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "INSERT INTO %s (i, f, s) VALUES ", table)
+	for k := from; k < from+n; k++ {
+		if k > from {
+			b.WriteString(", ")
+		}
+		fmt.Fprintf(&b, "(%d, %d.5, 'row-%d-abcdefghij')", k, k, k)
+	}
+	return b.String()
+}
+
+// BenchmarkInsertValues inserts 2,000-row INSERT ... VALUES statements, the
+// batches the CloudBurrow front sends for a load (#1070).
+func BenchmarkInsertValues(b *testing.B) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=bench_insert_values")
+	if err != nil {
+		b.Fatal(err)
+	}
+	defer db.Close()
+	if _, err := db.Exec("CREATE TABLE t (i INT64, f FLOAT64, s STRING)"); err != nil {
+		b.Fatal(err)
+	}
+	const rows = 2000
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		if _, err := db.Exec(insertValuesStmt("t", i*rows, rows)); err != nil {
+			b.Fatal(err)
+		}
+	}
+	b.ReportMetric(float64(rows*b.N)/b.Elapsed().Seconds(), "rows/s")
+}
+
+// TestStatementASTFacts holds what Analyze reads off each statement's parse
+// tree, now gathered in one walk (#1070): the parameter mode, the `?` each
+// statement of a script takes, the @names, and the literal casts. The
+// expectations are the unpatched engine's.
+func TestStatementASTFacts(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=statement_ast_facts")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err := db.Exec("CREATE TABLE t (i INT64, s STRING)"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec("INSERT INTO t (i, s) VALUES (?, ?); INSERT INTO t (i, s) VALUES (?, 'b')", 1, "a", 2); err != nil {
+		t.Fatalf("positional parameters across two statements: %v", err)
+	}
+	if _, err := db.Exec("INSERT INTO t (i, s) VALUES (@n, @S), (@N + 1, @s)", sql.Named("n", 3), sql.Named("s", "c")); err != nil {
+		t.Fatalf("named parameters: %v", err)
+	}
+	var got []string
+	rows, err := db.Query("SELECT FORMAT('%d:%s', i, s) FROM t ORDER BY i")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for rows.Next() {
+		var v string
+		if err := rows.Scan(&v); err != nil {
+			t.Fatal(err)
+		}
+		got = append(got, v)
+	}
+	rows.Close()
+	if want := "1:a 2:b 3:c 4:c"; strings.Join(got, " ") != want {
+		t.Errorf("rows = %q, want %q", strings.Join(got, " "), want)
+	}
+	// applyMixedParameterRewrite names each `?` before the walk.
+	if _, err := db.Exec("SELECT @a, ?", sql.Named("a", 1), 2); err != nil {
+		t.Errorf("named and positional together: %v", err)
+	}
+	if _, err := db.Exec("SELECT 1; SELECT CAST('x' AS INT64)"); err == nil || !strings.Contains(err.Error(), `Could not cast literal "x" to type INT64 [at 1:19]`) {
+		t.Errorf("literal cast: err = %v", err)
+	}
+	if _, err := db.Exec("SELECT SAFE_CAST('x' AS INT64), CAST('7' AS INT64)"); err != nil {
+		t.Errorf("castable literals: %v", err)
+	}
+}
