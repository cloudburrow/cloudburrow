--- a/internal/catalog.go
+++ b/internal/catalog.go
@@ -38,14 +38,38 @@
   @updatedAt,
   @createdAt
 ) ON CONFLICT(name) DO UPDATE SET
+  kind = @kind,
   spec = @spec,
   updatedAt = @updatedAt
 `
 	deleteCatalogQuery = `
 DELETE FROM googlesqlite_catalog WHERE name = @name
 `
+	// CloudBurrow patch (cloudburrow/cloudburrow#1186): a function's and
+	// a table function's rows were keyed by their bare path, as a table's
+	// is, so a table named as a function of its dataset overwrote the
+	// function's row (keeping its kind), and the next catalog load read
+	// the table's spec as a function's and panicked. Rows a catalog of
+	// before the patch saved are moved to the kind-qualified keys.
+	migrateCatalogKeysQuery = `
+UPDATE googlesqlite_catalog SET name = kind || ':' || name
+WHERE kind IN ('function', 'tvf') AND name NOT LIKE kind || ':%'
+`
 )
 
+// catalogKey is the googlesqlite_catalog row name of a spec of kind
+// stored under name: tables and views (one namespace in BigQuery) keep
+// the bare path, functions and table functions take a kind prefix, so a
+// table and a function of one name are two rows. CloudBurrow patch
+// (cloudburrow/cloudburrow#1186).
+func catalogKey(kind catalogSpecKind, name string) string {
+	switch kind {
+	case FunctionSpecKind, TVFSpecKind:
+		return string(kind) + ":" + name
+	}
+	return name
+}
