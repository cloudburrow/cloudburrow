--- /dev/null
+++ b/table_function_same_name_test.go
@@ -0,0 +1,72 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+)
+
+// TestTableAndFunctionOfOneName is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1186): tables and functions are separate
+// namespaces, so a table named as a function is made beside it, both
+// answer, and a later DROP of anything neither panics nor loses the
+// table functions; dropping the one leaves the other.
+func TestTableAndFunctionOfOneName(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=table_function_same_name")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	one := func(q string, want int64) {
+		t.Helper()
+		var got int64
+		if err := db.QueryRowContext(ctx, q).Scan(&got); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		if got != want {
+			t.Fatalf("%s = %d, want %d", q, got, want)
+		}
+	}
+	exec("CREATE FUNCTION twice(x INT64) RETURNS INT64 AS (x * 2)")
+	exec("CREATE TABLE FUNCTION tf(n INT64) AS (SELECT n AS v)")
+	exec("CREATE TABLE twice (n INT64)")
+	exec("INSERT INTO twice (n) VALUES (7)")
+	one("SELECT twice(3)", 6)
+	one("SELECT n FROM twice", 7)
+
+	exec("CREATE TABLE t (a INT64)")
+	exec("DROP TABLE t")
+	one("SELECT v FROM tf(4)", 4)
+	one("SELECT twice(5)", 10)
+	one("SELECT n FROM twice", 7)
+
+	exec("DROP TABLE twice")
+	one("SELECT twice(6)", 12)
+	one("SELECT v FROM tf(8)", 8)
+	if err := db.QueryRowContext(ctx, "SELECT n FROM twice").Scan(new(int64)); err == nil || !strings.Contains(err.Error(), "not found") {
+		t.Fatalf("a dropped table answered %v", err)
+	}
+
+	exec("CREATE TABLE twice (n INT64)")
+	exec("INSERT INTO twice (n) VALUES (9)")
+	exec("DROP FUNCTION twice")
+	one("SELECT n FROM twice", 9)
+	one("SELECT v FROM tf(1)", 1)
+	if err := db.QueryRowContext(ctx, "SELECT twice(1)").Scan(new(int64)); err == nil || !strings.Contains(err.Error(), "not found") {
+		t.Fatalf("a dropped function answered %v", err)
+	}
+
+	// A table function of the table's name too.
+	exec("CREATE TABLE FUNCTION twice(n INT64) AS (SELECT n * 2 AS v)")
+	one("SELECT v FROM twice(5)", 10)
+	exec("DROP TABLE FUNCTION twice")
+	one("SELECT n FROM twice", 9)
+}
