--- /dev/null
+++ b/streaming_buffer_mark_test.go
@@ -0,0 +1,60 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestStreamingBufferMark is CloudBurrow's regression test of its patch
+// 0029 (cloudburrow/cloudburrow#1273): a table partitioned by a column or
+// an integer range has the pseudo-column _PARTITION_BUFFERED, which
+// SELECT * leaves out, an INSERT may give and a query names; a table that
+// is not partitioned has none.
+func TestStreamingBufferMark(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	exec(`CREATE TABLE by_day (d DATE, id INT64) PARTITION BY d`)
+	exec(`CREATE TABLE by_range (n INT64) PARTITION BY RANGE_BUCKET(n, GENERATE_ARRAY(0, 100, 10))`)
+	exec(`CREATE TABLE plain (id INT64)`)
+	exec(`INSERT INTO by_day (d, id) VALUES (DATE '2024-01-01', 1)`)
+	exec(`INSERT INTO by_day (d, id, _PARTITION_BUFFERED) VALUES (DATE '2024-01-01', 2, TRUE)`)
+	exec(`INSERT INTO by_range (n, _PARTITION_BUFFERED) SELECT 5, TRUE`)
+
+	rows, err := db.QueryContext(ctx, `SELECT * FROM by_day`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cols, _ := rows.Columns()
+	rows.Close()
+	if strings.Join(cols, ",") != "d,id" {
+		t.Errorf("SELECT * columns = %v, want [d id]", cols)
+	}
+	var id, n int64
+	if err := db.QueryRowContext(ctx, `SELECT id FROM by_day WHERE _PARTITION_BUFFERED`).Scan(&id); err != nil || id != 2 {
+		t.Errorf("buffered row: id %d (%v), want 2", id, err)
+	}
+	exec(`UPDATE by_day SET _PARTITION_BUFFERED = NULL WHERE _PARTITION_BUFFERED`)
+	if err := db.QueryRowContext(ctx, `SELECT COUNT(*) FROM by_day WHERE _PARTITION_BUFFERED IS NULL`).Scan(&n); err != nil || n != 2 {
+		t.Errorf("after the flush: %d unbuffered rows (%v), want 2", n, err)
+	}
+	if err := db.QueryRowContext(ctx, `SELECT COUNT(*) FROM by_range WHERE _PARTITION_BUFFERED`).Scan(&n); err != nil || n != 1 {
+		t.Errorf("by_range: %d buffered rows (%v), want 1", n, err)
+	}
+	if _, err := db.QueryContext(ctx, `SELECT _PARTITION_BUFFERED FROM plain`); err == nil {
+		t.Error("_PARTITION_BUFFERED of a table that is not partitioned: no error")
+	}
+}
