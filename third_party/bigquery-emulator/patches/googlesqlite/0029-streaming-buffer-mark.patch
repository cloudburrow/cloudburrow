-	return strings.EqualFold(name, "_PARTITIONTIME") || strings.EqualFold(name, "_PARTITIONDATE")
+	return strings.EqualFold(name, "_PARTITIONTIME") || strings.EqualFold(name, "_PARTITIONDATE") ||
+		strings.EqualFold(name, streamingBufferColumn)
 }
 
+// streamingBufferColumn is the pseudo-column a table partitioned by a
+// column or an integer range gets: TRUE on a row in the table's
+// streaming buffer, NULL on any other (CloudBurrow patch,
+// cloudburrow/cloudburrow#1273). BigQuery reserves the prefix _PARTITION
+// for its own column names, so no table's column can be named so.
+const streamingBufferColumn = "_PARTITION_BUFFERED"
