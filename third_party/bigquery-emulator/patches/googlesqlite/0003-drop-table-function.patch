+// TVFSpec returns the table function stored under name. CloudBurrow patch
+// (cloudburrow/cloudburrow#1061), for DROP TABLE FUNCTION.
+func (c *Catalog) TVFSpec(name string) (*TVFSpec, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	spec, exists := c.tvfMap[name]
