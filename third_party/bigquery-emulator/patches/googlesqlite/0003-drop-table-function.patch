+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+)
+
+// TestDropTableFunction is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1061): DROP TABLE FUNCTION takes a table
+// function out, so a call of it fails and a CREATE TABLE FUNCTION of the
+// name makes it again with its new body; IF EXISTS of one that is not
+// there does nothing, and without IF EXISTS it fails.
+func TestDropTableFunction(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=drop_tvf")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	call := func(want int64) {
+		t.Helper()
+		var y int64
+		if err := db.QueryRowContext(ctx, "SELECT y FROM tf(1)").Scan(&y); err != nil {
+			t.Fatalf("SELECT FROM tf(1): %v", err)
+		}
+		if y != want {
+			t.Fatalf("tf(1) = %d, want %d", y, want)
+		}
+	}
+	exec("CREATE TABLE FUNCTION tf(x INT64) AS (SELECT x + 1 AS y)")
+	call(2)
+	exec("DROP TABLE FUNCTION tf")
+	if err := db.QueryRowContext(ctx, "SELECT y FROM tf(1)").Scan(new(int64)); err == nil || !strings.Contains(err.Error(), "not found") {
+		t.Fatalf("a dropped table function answered %v", err)
+	}
+	exec("CREATE TABLE FUNCTION tf(x INT64) AS (SELECT x + 2 AS y)")
+	call(3)
+	exec("DROP TABLE FUNCTION IF EXISTS tf")
+	exec("DROP TABLE FUNCTION IF EXISTS tf")
+	if _, err := db.ExecContext(ctx, "DROP TABLE FUNCTION tf"); err == nil {
+		t.Fatal("DROP TABLE FUNCTION of one that is not there succeeded")
+	}
+}
