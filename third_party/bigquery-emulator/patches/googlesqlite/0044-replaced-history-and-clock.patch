+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// TestChangeHistoryReplace is CloudBurrow's regression test of its patch
+// 0044 (cloudburrow/cloudburrow#1466): CREATE OR REPLACE TABLE keeps the
+// history of the table it replaces, its rows as they were before the
+// replace, and records the rows it replaced as deleted; and the engine's
+// clock (CURRENT_TIMESTAMP() and the change times) reads the offset
+// SetClockOffset sets.
+func TestChangeHistoryReplace(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	micros := func() int64 {
+		t.Helper()
+		var n int64
+		if err := db.QueryRowContext(ctx, "SELECT MAX(googlesqlite_change_micros) FROM `p.d.t$changes`").Scan(&n); err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	strs := func(q string) string {
+		t.Helper()
+		rows, err := db.QueryContext(ctx, q)
+		if err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		defer rows.Close()
+		var out []string
+		for rows.Next() {
+			var a, b sql.NullString
+			if err := rows.Scan(&a, &b); err != nil {
+				t.Fatal(err)
+			}
+			out = append(out, a.String+"="+b.String)
+		}
+		return strings.Join(out, " ")
+	}
+	asOf := func(at int64) string {
+		t.Helper()
+		return strs(fmt.Sprintf("SELECT CAST(id AS STRING), v FROM (SELECT id, v, _CHANGE_TYPE AS k, ROW_NUMBER() OVER (PARTITION BY googlesqlite_change_rowid ORDER BY rowid DESC) AS n "+
+			"FROM `p.d.t$changes` WHERE _CHANGE_TYPE != 'START' AND googlesqlite_change_micros <= %d) WHERE n = 1 AND k != 'DELETE' ORDER BY id", at))
+	}
+	exec("CREATE TABLE `p.d.t` (id INT64, v STRING, gone INT64)")
+	var start int64
+	if err := db.QueryRowContext(ctx, "SELECT googlesqlite_change_micros FROM `p.d.t$changes` WHERE _CHANGE_TYPE = 'START'").Scan(&start); err != nil {
+		t.Fatal(err)
+	}
+	exec("INSERT INTO `p.d.t` VALUES (1, 'a', 10), (2, 'b', 20)")
+	exec("UPDATE `p.d.t` SET v = 'c' WHERE id = 1")
+	before := micros()
+	time.Sleep(2 * time.Millisecond)
+	exec("CREATE OR REPLACE TABLE `p.d.t` AS SELECT 3 AS id, 'd' AS v")
+	after := micros()
+	if got := asOf(before); got != "1=c 2=b" {
+		t.Errorf("as of before the replace: %q, want %q", got, "1=c 2=b")
+	}
+	if got := asOf(after); got != "3=d" {
+		t.Errorf("as of after the replace: %q, want %q", got, "3=d")
+	}
+	var n int64
+	var first int64
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*), MIN(googlesqlite_change_micros) FROM `p.d.t$changes` WHERE _CHANGE_TYPE = 'START'").Scan(&n, &first); err != nil || n != 1 || first != start {
+		t.Errorf("START rows: %d at %d (%v), want 1 at %d", n, first, err, start)
+	}
+	if got := strs(fmt.Sprintf("SELECT CAST(id AS STRING), v FROM `p.d.t$changes` WHERE _CHANGE_TYPE = 'DELETE' AND googlesqlite_change_micros = %d ORDER BY id", after)); got != "1=c 2=b" {
+		t.Errorf("the replace's deletes: %q", got)
+	}
+	if got := strs("SELECT _CHANGE_TYPE, CAST(COUNT(*) AS STRING) FROM `p.d.t$changes` GROUP BY 1 ORDER BY 1"); got != "DELETE=3 INSERT=3 START=1 UPDATE=1" {
+		t.Errorf("changes by type: %q", got)
+	}
+	// A second replace keeps the whole history still.
+	exec("CREATE OR REPLACE TABLE `p.d.t` (id INT64, v STRING)")
+	if got := asOf(before); got != "1=c 2=b" {
+		t.Errorf("as of before the first replace, after two: %q", got)
+	}
+	if got := asOf(micros()); got != "" {
+		t.Errorf("after the second replace: %q", got)
+	}
+
+	googlesqlite.SetClockOffset(48 * time.Hour)
+	defer googlesqlite.SetClockOffset(0)
+	var ahead float64
+	if err := db.QueryRowContext(ctx, "SELECT TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), TIMESTAMP_MICROS("+fmt.Sprint(time.Now().UnixMicro())+"), SECOND)").Scan(&ahead); err != nil {
+		t.Fatal(err)
+	}
+	if ahead < 48*3600-60 || ahead > 48*3600+60 {
+		t.Errorf("CURRENT_TIMESTAMP() is %v s ahead, want 48 h", ahead)
+	}
+	exec("INSERT INTO `p.d.t` VALUES (9, 'z')")
+	if d := time.Duration(micros()-time.Now().UnixMicro()) * time.Microsecond; d < 47*time.Hour {
+		t.Errorf("a change's time is %v ahead, want 48 h", d)
+	}
+}
