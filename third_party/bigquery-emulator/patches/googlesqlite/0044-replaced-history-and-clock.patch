+package googlesqlite
+
+import (
+	"time"
+
+	"github.com/goccy/googlesqlite/internal/clock"
+)
+
+// SetClockOffset sets how far the engine's clock (CURRENT_TIMESTAMP(),
+// CURRENT_DATE(), CURRENT_DATETIME(), CURRENT_TIME() and the times of a
+// table's change history) reads ahead of the system's (CloudBurrow patch,
+// cloudburrow/cloudburrow#1466): CloudBurrow's front advances its own
+// clock in tests, and the engine's follows.
+func SetClockOffset(d time.Duration) { clock.SetOffset(d) }
+
+// ClockOffset is the offset SetClockOffset set.
+func ClockOffset() time.Duration { return clock.Offset() }
