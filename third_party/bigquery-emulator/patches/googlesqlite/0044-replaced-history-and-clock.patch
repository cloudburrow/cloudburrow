+package internal
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	googlesql "github.com/goccy/go-googlesql"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// The history of a replaced table (CloudBurrow patch,
+// cloudburrow/cloudburrow#1466).
+//
+// BigQuery keeps the contents a CREATE OR REPLACE TABLE replaces: "the
+// data that is replaced or removed can be recovered through the time
+// travel window" (https://cloud.google.com/bigquery/docs/time-travel).
+// Patch 0036 started the change table over, so FOR SYSTEM_TIME AS OF a
+// time before the replace, APPENDS and CHANGES had nothing to read. Now
+// the change table of the table replaced is kept (keepReplacedHistory)
+// and carried into the new one (carryReplacedHistory): its changes, with
+// the values of each column the new table has of the same name and type
+// (a column it does not have is left out: CHANGES and APPENDS read "the
+// table's current schema"), its START row in place of the new one, and a
+// DELETE, at the time of the replace, of each row the replaced table
+// still had, as a WRITE_TRUNCATE records the rows it replaces. The rowids
+// of the replaced table's rows are moved below every rowid (shift), so
+// that no row of the new table is taken for one of the old.
+
+// replacedHistory is the change table of a table CREATE OR REPLACE TABLE
+// replaces, renamed to table.
+type replacedHistory struct {
+	table   string
+	columns []*ColumnSpec // the change table's columns but its own three
+}
+
+// replacedSuffix ends the name of a replaced table's change table while
+// the new one is made.
+const replacedSuffix = "$replaced"
+
+// keepReplacedHistory renames the change table of the table spec, a
+// CREATE OR REPLACE TABLE, replaces (change), and returns it; nil when
+// spec replaces none.
+func keepReplacedHistory(ctx context.Context, conn *Conn, catalog *Catalog, spec *TableSpec, change string) (*replacedHistory, error) {
+	if spec.CreateMode != googlesql.ResolvedCreateStatementEnums_CreateModeCreateOrReplace {
+		return nil, nil
+	}
+	old, ok := catalog.tableMap[change]
+	if !ok {
+		return nil, nil
+	}
+	var one int
+	if err := conn.QueryRowContext(ctx, "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", change).Scan(&one); err != nil {
+		return nil, nil
+	}
+	rep := &replacedHistory{table: change + replacedSuffix}
+	for _, c := range old.Columns {
+		if !strings.HasPrefix(c.Name, "_CHANGE_") {
+			rep.columns = append(rep.columns, c)
+		}
+	}
+	for _, s := range []string{
+		fmt.Sprintf("DROP TABLE IF EXISTS `%s`", rep.table),
+		fmt.Sprintf("DROP INDEX IF EXISTS `%s$time`", change),
+		fmt.Sprintf("DROP INDEX IF EXISTS `%s$row`", change),
+		fmt.Sprintf("ALTER TABLE `%s` RENAME TO `%s`", change, rep.table),
+	} {
+		if _, err := conn.ExecContext(ctx, s); err != nil {
+			return nil, fmt.Errorf("history of the table %s replaces: %w", spec.TableName(), err)
+		}
+	}
+	return rep, nil
+}
+
+// carryReplacedHistory carries rep into cs, the new change table, just
+// made (above), and drops rep.
+func carryReplacedHistory(ctx context.Context, conn *Conn, cs *TableSpec, rep *replacedHistory) error {
+	change := cs.TableName()
+	var common []string
+	for _, c := range cs.Columns {
+		if strings.HasPrefix(c.Name, "_CHANGE_") {
+			continue
+		}
+		for _, o := range rep.columns {
+			if o.Name == c.Name && o.SQLiteSchema() == c.SQLiteSchema() {
+				common = append(common, "`"+c.Name+"`")
+				break
+			}
+		}
+	}
+	list := strings.Join(common, ",")
+	if len(common) > 0 {
+		list += ","
+	}
+	var shift int64
+	if err := conn.QueryRowContext(ctx, fmt.Sprintf("SELECT 2 * (COALESCE(MAX(ABS(`%s`)), 0) + 1) FROM `%s`", changeRowidColumn, rep.table)).Scan(&shift); err != nil {
+		return err
+	}
+	start, del, no := encodedLiteral(value.StringValue(changeStartType)), encodedLiteral(value.StringValue("DELETE")),
+		encodedLiteral(value.BoolValue(false))
+	target := fmt.Sprintf("INSERT INTO `%s` (%s`_CHANGE_TYPE`,`_CHANGE_TIMESTAMP`,`_CHANGE_IS_FOR_UPDATE`,`%s`,`%s`)",
+		change, list, changeMicrosColumn, changeRowidColumn)
+	for _, s := range []string{
+		// The history starts when the replaced table's did.
+		fmt.Sprintf("DELETE FROM `%s` WHERE `_CHANGE_TYPE` = %s AND EXISTS (SELECT 1 FROM `%s` WHERE `_CHANGE_TYPE` = %s)",
+			change, start, rep.table, start),
+		fmt.Sprintf("%s SELECT %s`_CHANGE_TYPE`,`_CHANGE_TIMESTAMP`,`_CHANGE_IS_FOR_UPDATE`,`%s`,`%s` - %d FROM `%s` ORDER BY rowid",
+			target, list, changeMicrosColumn, changeRowidColumn, shift, rep.table),
+		// The rows the replaced table still had are deleted by the replace.
+		fmt.Sprintf("%s SELECT %s%s, googlesqlite_change_timestamp(), %s, googlesqlite_change_micros(), `%s` - %d FROM "+
+			"(SELECT *, ROW_NUMBER() OVER (PARTITION BY `%s` ORDER BY rowid DESC) AS googlesqlite_last FROM `%s` WHERE `_CHANGE_TYPE` != %s) "+
+			"WHERE googlesqlite_last = 1 AND `_CHANGE_TYPE` != %s ORDER BY `%s`",
+			target, list, del, no, changeRowidColumn, shift, changeRowidColumn, rep.table, start, del, changeRowidColumn),
+		fmt.Sprintf("DROP TABLE `%s`", rep.table),
+	} {
+		if _, err := conn.ExecContext(ctx, s); err != nil {
+			return err
+		}
+	}
+	return nil
+}
