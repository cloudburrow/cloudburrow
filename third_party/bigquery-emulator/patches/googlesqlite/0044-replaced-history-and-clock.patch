@@ -0,0 +1,22 @@
+// Package clock is the engine's clock (CloudBurrow patch,
+// cloudburrow/cloudburrow#1466): the time now, moved forward by the
+// offset CloudBurrow's front sets when its own clock is advanced, so that
+// CURRENT_TIMESTAMP() and the change history's times (change_history.go)
+// read the front's clock.
+package clock
+
+import (
+	"sync/atomic"
+	"time"
+)
+
+var offset atomic.Int64
+
+// SetOffset sets how far the clock reads ahead of the system's.
+func SetOffset(d time.Duration) { offset.Store(int64(d)) }
+
+// Offset is how far the clock reads ahead of the system's.
+func Offset() time.Duration { return time.Duration(offset.Load()) }
+
+// Now is the time now by the clock.
+func Now() time.Time { return time.Now().Add(Offset()) }
