+}
+
+// isChangeColumn reports whether name is one of the columns a change
+// table adds to its table's (changeTableSpec), as column names are
+// compared, without case (CloudBurrow patch, cloudburrow/cloudburrow#1522).
+func isChangeColumn(name string) bool {
+	switch strings.ToUpper(name) {
+	case "_CHANGE_TYPE", "_CHANGE_TIMESTAMP", "_CHANGE_IS_FOR_UPDATE":
+		return true
+	}
+	return false
 }
 
