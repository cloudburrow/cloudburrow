--- /dev/null
+++ b/change_history_change_names_test.go
@@ -0,0 +1,60 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestChangeHistoryChangeNames is CloudBurrow's regression test of its
+// patch 0063 (cloudburrow/cloudburrow#1522): a table with a column whose
+// name starts _CHANGE_ but is not one of the change table's own
+// (_CHANGE_TYPE, _CHANGE_TIMESTAMP, _CHANGE_IS_FOR_UPDATE) keeps its
+// history, the column among it, through a CREATE OR REPLACE too; one with
+// a column of a change column's name keeps none.
+func TestChangeHistoryChangeNames(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	count := func(q string) int64 {
+		t.Helper()
+		var n int64
+		if err := db.QueryRowContext(ctx, q).Scan(&n); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		return n
+	}
+	exec("CREATE TABLE `p.d.t` (id INT64, _CHANGE_NOTE STRING)")
+	exec("INSERT INTO `p.d.t` VALUES (1, 'a'), (2, 'b')")
+	exec("UPDATE `p.d.t` SET _CHANGE_NOTE = 'c' WHERE id = 2")
+	if n := count("SELECT COUNT(*) FROM `p.d.t$changes` WHERE _CHANGE_TYPE != 'START'"); n != 4 {
+		t.Errorf("changes of a table with a column _CHANGE_NOTE: %d, want 4", n)
+	}
+	if n := count("SELECT COUNT(*) FROM `p.d.t$changes` WHERE _CHANGE_TYPE = 'UPDATE' AND _CHANGE_NOTE = 'c'"); n != 1 {
+		t.Errorf("the UPDATE's _CHANGE_NOTE: %d rows of 'c', want 1", n)
+	}
+	exec("CREATE OR REPLACE TABLE `p.d.t` (id INT64, _CHANGE_NOTE STRING)")
+	exec("INSERT INTO `p.d.t` VALUES (3, 'd')")
+	if n := count("SELECT COUNT(*) FROM `p.d.t$changes` WHERE _CHANGE_NOTE = 'd'"); n != 1 {
+		t.Errorf("after CREATE OR REPLACE, changes of _CHANGE_NOTE 'd': %d, want 1", n)
+	}
+	if n := count("SELECT COUNT(*) FROM `p.d.t$changes` WHERE _CHANGE_NOTE = 'a'"); n == 0 {
+		t.Errorf("after CREATE OR REPLACE, the replaced table's history of _CHANGE_NOTE was not carried")
+	}
+	exec("CREATE TABLE `p.d.u` (id INT64, _change_is_for_update BOOL)")
+	if _, err := db.ExecContext(ctx, "SELECT COUNT(*) FROM `p.d.u$changes`"); err == nil {
+		t.Errorf("a table with a column _change_is_for_update has a change table")
+	}
+}
