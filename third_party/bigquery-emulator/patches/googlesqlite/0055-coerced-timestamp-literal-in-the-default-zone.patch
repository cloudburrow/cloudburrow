+++ b/internal/coerced_timestamp_literal.go
@@ -0,0 +1,96 @@
+package internal
+
+import (
+	"context"
+	"regexp"
+	"strings"
+	"time"
+
+	googlesql "github.com/goccy/go-googlesql"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1456): a string literal the
+// analyzer coerces to a TIMESTAMP (ts > '2020-01-01 00:00:00', a TIMESTAMP
+// column compared with a string, an INSERT of a string into one) is read in
+// the query's default time zone (WithDefaultTimeZone), as BigQuery reads a
+// TIMESTAMP with no zone ("if no time zone is specified, the default time
+// zone is used"). Patch 0047 gave the zone to TIMESTAMP literals and casts
+// written in the text; a coerced string is typed only by the analyzer,
+// whose own zone is UTC (go-googlesql can build no other), so it folded
+// the string to a TIMESTAMP in UTC. The formatter now finds such a
+// literal by its text in the query (its parse location): a quoted string
+// with no zone, whose wall time the literal holds in UTC, and writes the
+// TIMESTAMP of that wall time in the zone.
+
+type queryTextKey struct{}
+
+// withQueryText gives ctx the text the statement was analyzed from.
+func withQueryText(ctx context.Context, query string) context.Context {
+	return context.WithValue(ctx, queryTextKey{}, query)
+}
+
+func queryText(ctx context.Context) string {
+	q, _ := ctx.Value(queryTextKey{}).(string)
+	return q
+}
+
+// naiveTimestampString is the text of a TIMESTAMP with no zone: a date,
+// with or without a time.
+var naiveTimestampString = regexp.MustCompile(`^\d{4}-\d{1,2}-\d{1,2}([ Tt]\d{1,2}:\d{1,2}(:\d{1,2}(\.\d{1,9})?)?)?$`)
+
+// zonedCoercedTimestamp returns the literal n written in ctx's default
+// zone when it is a string coerced to a TIMESTAMP (above); ok is false
+// for any other literal.
+func zonedCoercedTimestamp(ctx context.Context, n *googlesql.ResolvedLiteral) (string, bool) {
+	zone := DefaultTimeZone(ctx)
+	query := queryText(ctx)
+	if zone == "" || query == "" || n == nil {
+		return "", false
+	}
+	v, err := n.Value()
+	if err != nil || v == nil {
+		return "", false
+	}
+	if kind, err := v.TypeKind(); err != nil || kind != googlesql.TypeKindTypeTimestamp {
+		return "", false
+	}
+	if null, err := v.IsNull(); err != nil || null {
+		return "", false
+	}
+	loc, err := n.GetParseLocationOrNULL()
+	if err != nil || loc == nil {
+		return "", false
+	}
+	text, err := loc.GetTextFrom(query)
+	if err != nil {
+		return "", false
+	}
+	text = strings.TrimSpace(text)
+	if len(text) < 2 || (text[0] != '\'' && text[0] != '"') || text[len(text)-1] != text[0] {
+		return "", false
+	}
+	if !naiveTimestampString.MatchString(strings.TrimSpace(text[1 : len(text)-1])) {
+		return "", false
+	}
+	z, err := value.ToLocation(zone)
+	if err != nil {
+		return "", false
+	}
+	got, err := valueFromGoogleSQLValue(*v)
+	if err != nil {
+		return "", false
+	}
+	ts, ok := got.(value.TimestampValue)
+	if !ok {
+		return "", false
+	}
+	w := time.Time(ts).UTC()
+	zoned := time.Date(w.Year(), w.Month(), w.Day(), w.Hour(), w.Minute(), w.Second(), w.Nanosecond(), z)
+	lit, err := literalFromValue(value.TimestampValue(zoned))
+	if err != nil {
+		return "", false
+	}
+	return lit, true
+}
