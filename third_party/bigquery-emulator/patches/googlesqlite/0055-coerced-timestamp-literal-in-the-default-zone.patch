+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// A string literal the analyzer coerces to a TIMESTAMP is read in the
+// query's default time zone; one with a zone, and a query with no default
+// zone, read as before (cloudburrow/cloudburrow#1456).
+func TestCoercedTimestampLiteralInTheDefaultZone(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=coerced_timestamp_literal")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	for _, q := range []string{
+		"CREATE TABLE t (ts TIMESTAMP)",
+		"INSERT INTO t VALUES (TIMESTAMP '2020-01-01 03:00:00+00')",
+	} {
+		if _, err := db.Exec(q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	count := func(ctx context.Context, where string) int64 {
+		t.Helper()
+		var n int64
+		if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM t WHERE "+where).Scan(&n); err != nil {
+			t.Fatalf("%s: %v", where, err)
+		}
+		return n
+	}
+	ny := googlesqlite.WithDefaultTimeZone(context.Background(), "America/New_York")
+	for _, c := range []struct {
+		ctx   context.Context
+		where string
+		want  int64
+	}{
+		{ny, "ts = '2019-12-31 22:00:00'", 1},
+		{ny, "ts > '2020-01-01 00:00:00'", 0},
+		{ny, "ts < '2020-01-01'", 1},
+		{ny, "ts = \"2019-12-31T22:00:00\"", 1},
+		{ny, "ts = '2020-01-01 03:00:00+00'", 1},
+		{ny, "ts = TIMESTAMP '2019-12-31 22:00:00'", 1},
+		{context.Background(), "ts > '2020-01-01 00:00:00'", 1},
+		{context.Background(), "ts = '2020-01-01 03:00:00'", 1},
+	} {
+		if got := count(c.ctx, c.where); got != c.want {
+			t.Errorf("%s (zoned %v): %d rows, want %d", c.where, c.ctx == ny, got, c.want)
+		}
+	}
+}
