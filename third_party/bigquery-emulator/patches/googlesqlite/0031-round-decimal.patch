+++ b/internal/round_decimal.go
@@ -0,0 +1,74 @@
+package internal
+
+import (
+	"fmt"
+	"math/big"
+	"strings"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// roundDecimal is googlesqlite_round_decimal(v, precision, scale, mode):
+// the NUMERIC or BIGNUMERIC v, as googlesqlite stores it, rounded to scale
+// digits after the point by mode (ROUND_HALF_EVEN, else
+// ROUND_HALF_AWAY_FROM_ZERO), and refused with an OUT_OF_RANGE error when
+// it then has more than precision digits. It is what a write to a
+// parameterized NUMERIC(P, S) or BIGNUMERIC(P, S) column stores
+// (https://cloud.google.com/bigquery/docs/reference/standard-sql/data-types#parameterized_decimal_type):
+// the emulator calls it from the column's triggers. CloudBurrow patch
+// (cloudburrow/cloudburrow#1401).
+func roundDecimal(v any, precision, scale int64, mode string, column string) (any, error) {
+	if v == nil {
+		return nil, nil
+	}
+	decoded, err := value.DecodeValue(v)
+	if err != nil || decoded == nil {
+		return v, err
+	}
+	nv, ok := decoded.(*value.NumericValue)
+	if !ok {
+		return v, nil
+	}
+	rounded := RoundRat(nv.Rat, scale, mode)
+	typ := "NUMERIC"
+	if nv.IsBigNumeric {
+		typ = "BIGNUMERIC"
+	}
+	if !RatFits(rounded, precision, scale) {
+		return nil, fmt.Errorf("OUT_OF_RANGE: Value %s is out of range for column %s of type %s(%d, %d)",
+			nv.Rat.FloatString(int(scale)), column, typ, precision, scale)
+	}
+	return value.EncodeValue(&value.NumericValue{Rat: rounded, IsBigNumeric: nv.IsBigNumeric})
+}
+
+func pow10(n int64) *big.Int { return new(big.Int).Exp(big.NewInt(10), big.NewInt(n), nil) }
+
+// RoundRat rounds r to scale digits after the point: halves away from zero,
+// or to even under ROUND_HALF_EVEN. CloudBurrow patch (#1401).
+func RoundRat(r *big.Rat, scale int64, mode string) *big.Rat {
+	m := new(big.Rat).Mul(r, new(big.Rat).SetInt(pow10(scale)))
+	neg := m.Sign() < 0
+	abs := new(big.Rat).Abs(m)
+	q, rem := new(big.Int).QuoRem(abs.Num(), abs.Denom(), new(big.Int))
+	// Compare twice the remainder with the denominator.
+	cmp := new(big.Int).Mul(rem, big.NewInt(2)).Cmp(abs.Denom())
+	switch {
+	case cmp > 0:
+		q.Add(q, big.NewInt(1))
+	case cmp == 0:
+		if !strings.EqualFold(mode, "ROUND_HALF_EVEN") || q.Bit(0) == 1 {
+			q.Add(q, big.NewInt(1))
+		}
+	}
+	if neg {
+		q.Neg(q)
+	}
+	return new(big.Rat).SetFrac(q, pow10(scale))
+}
+
+// RatFits is whether r, with at most scale digits after the point, has at
+// most precision digits in all. CloudBurrow patch (#1401).
+func RatFits(r *big.Rat, precision, scale int64) bool {
+	m := new(big.Rat).Mul(r, new(big.Rat).SetInt(pow10(scale)))
+	return new(big.Int).Abs(m.Num()).Cmp(pow10(precision)) < 0
+}
