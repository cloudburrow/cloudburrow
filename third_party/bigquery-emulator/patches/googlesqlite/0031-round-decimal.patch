+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// TestRoundDecimal is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1401): googlesqlite_round_decimal, called from a
+// trigger made by a RawSQLitePrefix statement, rounds a value written to a
+// NUMERIC column to its scale by the rounding mode, on INSERT and UPDATE,
+// and refuses one with more digits than its precision.
+func TestRoundDecimal(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=round_decimal")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	exec := func(q string) error { _, err := db.ExecContext(ctx, q); return err }
+	for _, q := range []string{
+		"CREATE TABLE `p.d.t` (id INT64, a NUMERIC, e NUMERIC)",
+		googlesqlite.RawSQLitePrefix + "CREATE TRIGGER `r_a` AFTER INSERT ON `p_d_t` FOR EACH ROW WHEN NEW.`a` IS NOT NULL BEGIN " +
+			"UPDATE `p_d_t` SET `a` = googlesqlite_round_decimal(NEW.`a`, 2, 0, 'ROUND_HALF_AWAY_FROM_ZERO', 'a') WHERE rowid = NEW.rowid; END",
+		googlesqlite.RawSQLitePrefix + "CREATE TRIGGER `r_e` AFTER INSERT ON `p_d_t` FOR EACH ROW WHEN NEW.`e` IS NOT NULL BEGIN " +
+			"UPDATE `p_d_t` SET `e` = googlesqlite_round_decimal(NEW.`e`, 3, 1, 'ROUND_HALF_EVEN', 'e') WHERE rowid = NEW.rowid; END",
+		googlesqlite.RawSQLitePrefix + "CREATE TRIGGER `u_a` AFTER UPDATE OF `a` ON `p_d_t` FOR EACH ROW WHEN NEW.`a` IS NOT NULL BEGIN " +
+			"UPDATE `p_d_t` SET `a` = googlesqlite_round_decimal(NEW.`a`, 2, 0, 'ROUND_HALF_AWAY_FROM_ZERO', 'a') WHERE rowid = NEW.rowid; END",
+		"INSERT INTO `p.d.t` (id, a, e) VALUES (1, 2.5, 0.25), (2, -3.5, 0.35), (3, NULL, -0.25)",
+		"UPDATE `p.d.t` SET a = 4.5 WHERE id = 3",
+	} {
+		if err := exec(q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	rows, err := db.QueryContext(ctx, "SELECT CAST(a AS STRING), CAST(e AS STRING) FROM `p.d.t` ORDER BY id")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got []string
+	for rows.Next() {
+		var a, e sql.NullString
+		if err := rows.Scan(&a, &e); err != nil {
+			t.Fatal(err)
+		}
+		got = append(got, a.String+" "+e.String)
+	}
+	rows.Close()
+	if want := "3 0.2,-4 0.4,5 -0.2"; strings.Join(got, ",") != want {
+		t.Errorf("rows %q, want %q", strings.Join(got, ","), want)
+	}
+	err = exec("INSERT INTO `p.d.t` (id, a) VALUES (4, 99.5)")
+	if err == nil || !strings.Contains(err.Error(), "OUT_OF_RANGE") {
+		t.Errorf("99.5 into NUMERIC(2, 0): %v, want OUT_OF_RANGE", err)
+	}
+	var n int
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM `p.d.t`").Scan(&n); err != nil || n != 3 {
+		t.Errorf("rows after the refused insert: %d, %v; want 3", n, err)
+	}
+}
