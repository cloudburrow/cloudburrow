--- /dev/null
+++ b/clock_times_test.go
@@ -0,0 +1,52 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+	"time"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// TestCatalogTimesReadTheEngineClock is CloudBurrow's regression test of
+// its patch 0051 (cloudburrow/cloudburrow#1487): a table's creation time,
+// which INFORMATION_SCHEMA.TABLES reports, and the year a CAST ... FORMAT
+// without one defaults to were the system clock's, where every other time
+// the engine reports reads the offset SetClockOffset sets; and Now is
+// that clock.
+func TestCatalogTimesReadTheEngineClock(t *testing.T) {
+	googlesqlite.SetClockOffset(400 * 24 * time.Hour)
+	defer googlesqlite.SetClockOffset(0)
+	if d := time.Until(googlesqlite.Now()); d < 399*24*time.Hour {
+		t.Fatalf("Now is %v ahead, want 400 days", d)
+	}
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	if _, err := db.ExecContext(ctx, "CREATE TABLE `ds.t` (id INT64)"); err != nil {
+		t.Fatal(err)
+	}
+	var created string
+	if err := db.QueryRowContext(ctx, "SELECT creation_time FROM ds.INFORMATION_SCHEMA.TABLES WHERE table_name = 't'").Scan(&created); err != nil {
+		t.Fatal(err)
+	}
+	at, err := time.Parse("2006-01-02 15:04:05.999999 MST", created)
+	if err != nil {
+		t.Fatalf("creation_time %q: %v", created, err)
+	}
+	if d := time.Until(at); d < 399*24*time.Hour {
+		t.Errorf("creation_time %s is %v ahead, want 400 days", created, d)
+	}
+	var year int64
+	if err := db.QueryRowContext(ctx, "SELECT EXTRACT(YEAR FROM CAST('03-04' AS DATE FORMAT 'MM-DD'))").Scan(&year); err != nil {
+		t.Fatal(err)
+	}
+	if want := int64(googlesqlite.Now().Year()); year != want {
+		t.Errorf("CAST('03-04' AS DATE FORMAT 'MM-DD') is in %d, want %d", year, want)
+	}
+}
