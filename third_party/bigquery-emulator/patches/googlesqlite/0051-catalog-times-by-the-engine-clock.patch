--- a/clock.go
+++ b/clock.go
@@ -15,3 +15,9 @@
 
 // ClockOffset is the offset SetClockOffset set.
 func ClockOffset() time.Duration { return clock.Offset() }
+
+// Now is the time now by the engine's clock (CloudBurrow patch,
+// cloudburrow/cloudburrow#1487): the emulator stamps the times it reports
+// (a dataset's, table's or job's) by it, so that they read the front's
+// clock too.
+func Now() time.Time { return clock.Now() }
