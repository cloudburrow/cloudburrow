+package internal
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1516): the collation of a
+// STRING inside a STRUCT or an ARRAY.
+//
+// BigQuery assigns a collation to "A STRING field in a STRUCT" and "A
+// STRING element in an ARRAY", and a table's DEFAULT COLLATE to each of
+// them that names none
+// (https://cloud.google.com/bigquery/docs/reference/standard-sql/collation-concepts#collate_define).
+// The analyzer resolves a nested COLLATE (FEATURE_CREATE_TABLE_FIELD_
+// ANNOTATIONS, analyzer.go) into the column definition's annotations,
+// whose child_list holds a STRUCT's fields and an ARRAY's element. A
+// CREATE TABLE records them in ColumnSpec.FieldCollation, and the
+// catalog gives the column an annotation map of the same shape, so the
+// analyzer propagates the collation to a field access (st.a), an UNNEST's
+// element and an array subscript, and the comparisons, GROUP BY and
+// ORDER BY over them compare case-folded (collation.go).
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"sync"
+
+	"github.com/goccy/go-googlesql"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// FieldCollation is the collation of a STRING inside a STRUCT or an
+// ARRAY: Collation a STRING's, Fields a STRUCT's fields in order (nil for
+// a field without), Element an ARRAY's element.
+type FieldCollation struct {
+	Collation string            `json:"collation,omitempty"`
+	Fields    []*FieldCollation `json:"fields,omitempty"`
+	Element   *FieldCollation   `json:"element,omitempty"`
+}
+
+// fieldCollationOf returns the collation of the STRINGs inside typ, a
+// STRUCT or an ARRAY, from annotations (a column definition's, which may
+// be nil) and else defaultCollation, or nil when none has one. A STRING
+// whose COLLATE is the empty string keeps the default off, as a column's does.
+func fieldCollationOf(typ googlesql.Googlesql_TypeNode, annotations *googlesql.ResolvedColumnAnnotations, defaultCollation string) *FieldCollation {
+	if typ == nil {
+		return nil
+	}
+	var children []*googlesql.ResolvedColumnAnnotations
+	if annotations != nil {
+		children, _ = annotations.ChildList()
+	}
+	child := func(i int) *googlesql.ResolvedColumnAnnotations {
+		if i < len(children) {
+			return children[i]
+		}
+		return nil
+	}
+	switch {
+	case m1(typ.IsString()):
+		c := defaultCollation
+		if annotations != nil {
+			if expr, _ := annotations.CollationName(); expr != nil {
+				c = literalString(expr)
+			}
+		}
+		if c == "" {
+			return nil
+		}
+		return &FieldCollation{Collation: c}
+	case m1(typ.IsStruct()):
+		st, err := typ.AsStruct()
+		if err != nil || st == nil {
+			return nil
+		}
+		fields, _ := st.Fields()
+		out, any := &FieldCollation{Fields: make([]*FieldCollation, len(fields))}, false
+		for i, f := range fields {
+			if out.Fields[i] = fieldCollationOf(f.Type_, child(i), defaultCollation); out.Fields[i] != nil {
+				any = true
+			}
+		}
+		if !any {
+			return nil
+		}
+		return out
+	case m1(typ.IsArray()):
+		at, err := typ.AsArray()
+		if err != nil || at == nil {
+			return nil
+		}
+		elem, _ := at.ElementType()
+		if e := fieldCollationOf(elem, child(0), defaultCollation); e != nil {
+			return &FieldCollation{Element: e}
+		}
+	}
+	return nil
+}
+
+// nestedCollations keeps the annotation map of each nested collation a
+// column is given, owned by the type factory, for the process.
+var nestedCollations = struct {
+	sync.Mutex
+	am map[string]*googlesql.AnnotationMap
+}{am: map[string]*googlesql.AnnotationMap{}}
+
+// nestedCollationMap returns the annotation map of fc on typ, of typ's
+// shape (a struct map for a STRUCT, an array map for an ARRAY), or nil.
+func nestedCollationMap(fc *FieldCollation, typ googlesql.Googlesql_TypeNode) *googlesql.AnnotationMap {
+	shape, err := typ.DebugString(false)
+	if err != nil {
+		return nil
+	}
+	key, err := json.Marshal(fc)
+	if err != nil {
+		return nil
+	}
+	nestedCollations.Lock()
+	defer nestedCollations.Unlock()
+	if am, ok := nestedCollations.am[shape+"\x00"+string(key)]; ok {
+		return am
+	}
+	ca, err := googlesql.NewCollationAnnotation()
+	if err != nil {
+		return nil
+	}
+	id, err := ca.Id()
+	if err != nil {
+		return nil
+	}
+	proto, err := googlesql.NewAnnotationMapProto()
+	if err != nil {
+		return nil
+	}
+	if !fillCollationProto(proto, typ, fc, int64(id)) {
+		return nil
+	}
+	am, err := tf().DeserializeAnnotationMap(proto)
+	if err != nil || am == nil {
+		return nil
+	}
+	if ok, err := am.HasCompatibleStructure(typ); err != nil || !ok {
+		return nil
+	}
+	nestedCollations.am[shape+"\x00"+string(key)] = am
+	return am
+}
+
+// fillCollationProto writes fc on typ into proto, a field of a STRUCT and
+// the element of an ARRAY at every depth, so the map has typ's shape.
+func fillCollationProto(proto *googlesql.AnnotationMapProto, typ googlesql.Googlesql_TypeNode, fc *FieldCollation, id int64) bool {
+	switch {
+	case m1(typ.IsStruct()):
+		st, err := typ.AsStruct()
+		if err != nil || st == nil {
+			return false
+		}
+		fields, _ := st.Fields()
+		for i, f := range fields {
+			sub, err := proto.AddStructFields()
+			if err != nil {
+				return false
+			}
+			var sfc *FieldCollation
+			if fc != nil && i < len(fc.Fields) {
+				sfc = fc.Fields[i]
+			}
+			if !fillCollationProto(sub, f.Type_, sfc, id) {
+				return false
+			}
+		}
+	case m1(typ.IsArray()):
+		at, err := typ.AsArray()
+		if err != nil || at == nil {
+			return false
+		}
+		elem, err := at.ElementType()
+		if err != nil || elem == nil {
+			return false
+		}
+		sub, err := proto.MutableArrayElement()
+		if err != nil {
+			return false
+		}
+		var efc *FieldCollation
+		if fc != nil {
+			efc = fc.Element
+		}
+		return fillCollationProto(sub, elem, efc, id)
+	case fc != nil && fc.Collation != "" && m1(typ.IsString()):
+		ap, err := proto.AddAnnotations()
+		if err != nil || ap.SetId(id) != nil {
+			return false
+		}
+		v, err := ap.MutableValue()
+		if err != nil {
+			return false
+		}
+		sv, err := googlesql.NewSimpleValueString(fc.Collation)
+		if err != nil || sv.Serialize(v) != nil {
+			return false
+		}
+	}
+	return true
+}
+
+// hasCI reports whether c, an operation's collation, is und:ci or holds
+// und:ci for a field or an element.
+func hasCI(c *googlesql.ResolvedCollation) bool {
+	if c == nil {
+		return false
+	}
+	if isCI(c) {
+		return true
+	}
+	children, _ := c.ChildList()
+	for _, child := range children {
+		if hasCI(child) {
+			return true
+		}
+	}
+	return false
+}
+
+// collationTreeOf returns the und:ci collations c, an operation's
+// collation, gives the STRINGs inside typ, or nil when it gives none: a
+// STRUCT's fields and an ARRAY's element by c's children, and an ARRAY's
+// elements by c itself when it is a STRING's (IN UNNEST).
+func collationTreeOf(typ googlesql.Googlesql_TypeNode, c *googlesql.ResolvedCollation) *FieldCollation {
+	if typ == nil || c == nil {
+		return nil
+	}
+	children, _ := c.ChildList()
+	switch {
+	case m1(typ.IsString()):
+		if isCI(c) {
+			return &FieldCollation{Collation: ciCollation}
+		}
+	case m1(typ.IsStruct()):
+		st, err := typ.AsStruct()
+		if err != nil || st == nil {
+			return nil
+		}
+		fields, _ := st.Fields()
+		if len(children) != len(fields) {
+			return nil
+		}
+		out, any := &FieldCollation{Fields: make([]*FieldCollation, len(fields))}, false
+		for i, f := range fields {
+			if out.Fields[i] = collationTreeOf(f.Type_, children[i]); out.Fields[i] != nil {
+				any = true
+			}
+		}
+		if any {
+			return out
+		}
+	case m1(typ.IsArray()):
+		at, err := typ.AsArray()
+		if err != nil || at == nil {
+			return nil
+		}
+		elem, _ := at.ElementType()
+		ec := c
+		if len(children) == 1 {
+			ec = children[0]
+		}
+		if e := collationTreeOf(elem, ec); e != nil {
+			return &FieldCollation{Element: e}
+		}
+	}
+	return nil
+}
+
+// foldNestedSQL returns arg, a STRUCT or ARRAY expression, with each
+// STRING inside it that fc collates und:ci case-folded, or arg when fc is
+// nil.
+func foldNestedSQL(arg string, fc *FieldCollation) string {
+	if fc == nil {
+		return arg
+	}
+	spec, err := json.Marshal(fc)
+	if err != nil {
+		return arg
+	}
+	return "googlesqlite_fold_collation(" + arg + ", '" + strings.ReplaceAll(string(spec), "'", "''") + "')"
+}
+
+func init() {
+	normalFuncs = append(normalFuncs, &funcInfo{Name: "fold_collation", BindFunc: bindFoldCollation})
+}
+
+// bindFoldCollation is googlesqlite_fold_collation(v, spec): v with each
+// STRING inside it that spec, a FieldCollation's JSON, collates und:ci
+// lower-cased.
+func bindFoldCollation(args ...value.Value) (value.Value, error) {
+	if len(args) != 2 {
+		return nil, fmt.Errorf("fold_collation: got %d arguments, want 2", len(args))
+	}
+	if args[0] == nil || args[1] == nil {
+		return args[0], nil
+	}
+	spec, err := args[1].ToString()
+	if err != nil {
+		return nil, err
+	}
+	var fc FieldCollation
+	if err := json.Unmarshal([]byte(spec), &fc); err != nil {
+		return nil, err
+	}
+	return foldValue(args[0], &fc)
+}
+
+func foldValue(v value.Value, fc *FieldCollation) (value.Value, error) {
+	if v == nil || fc == nil {
+		return v, nil
+	}
+	switch tv := v.(type) {
+	case value.StringValue:
+		if strings.EqualFold(fc.Collation, ciCollation) {
+			return value.StringValue(strings.ToLower(string(tv))), nil
+		}
+	case *value.ArrayValue:
+		if fc.Element == nil {
+			return v, nil
+		}
+		out := &value.ArrayValue{Values: make([]value.Value, len(tv.Values))}
+		for i, e := range tv.Values {
+			f, err := foldValue(e, fc.Element)
+			if err != nil {
+				return nil, err
+			}
+			out.Values[i] = f
+		}
+		return out, nil
+	case *value.StructValue:
+		out := &value.StructValue{Keys: tv.Keys, Values: make([]value.Value, len(tv.Values)), M: map[string]value.Value{}}
+		for i, e := range tv.Values {
+			var sub *FieldCollation
+			if i < len(fc.Fields) {
+				sub = fc.Fields[i]
+			}
+			f, err := foldValue(e, sub)
+			if err != nil {
+				return nil, err
+			}
+			out.Values[i] = f
+			if i < len(tv.Keys) {
+				out.M[tv.Keys[i]] = f
+			}
+		}
+		return out, nil
+	}
+	return v, nil
+}
