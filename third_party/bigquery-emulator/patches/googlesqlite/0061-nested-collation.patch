+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"testing"
+)
+
+// TestNestedCollationUndCI is CloudBurrow patch 61's regression test
+// (cloudburrow/cloudburrow#1516): a STRING inside a STRUCT or an ARRAY
+// with the collation 'und:ci', by its COLLATE or the table's DEFAULT
+// COLLATE, compares case-insensitively through a field access, UNNEST,
+// IN UNNEST, a subscript, GROUP BY, COUNT(DISTINCT) and a STRUCT
+// comparison, as BigQuery's collation reference documents; a field whose
+// COLLATE is the empty string keeps the default off. Before the patch
+// the CREATE TABLE failed "GOOGLESQL_RET_CHECK failure ... annotations
+// != nullptr".
+func TestNestedCollationUndCI(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=nested_collation_und_ci")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, q := range []string{
+		"CREATE TABLE `p.d.t` (st STRUCT<a STRING COLLATE 'und:ci', b STRING>, arr ARRAY<STRING COLLATE 'und:ci'>, n INT64)",
+		"INSERT INTO `p.d.t` (st, arr, n) VALUES (STRUCT('Abc', 'Abc'), ['Abc', 'x'], 1)",
+		"CREATE TABLE `p.d.u` (st STRUCT<a STRING, b STRING COLLATE ''>, arr ARRAY<STRING>, sa ARRAY<STRUCT<x STRING>>) DEFAULT COLLATE 'und:ci'",
+		"INSERT INTO `p.d.u` VALUES (STRUCT('Abc', 'Abc'), ['Abc'], [STRUCT('Abc')]), (STRUCT('aBC', 'aBC'), ['aBC'], [STRUCT('aBC')])",
+	} {
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	for _, tc := range []struct{ q, want string }{
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE st.a = 'ABC'", "1"},
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE st.b = 'ABC'", "0"},
+		{"SELECT COUNT(*) FROM `p.d.t`, UNNEST(arr) e WHERE e = 'ABC'", "1"},
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE 'ABC' IN UNNEST(arr)", "1"},
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE arr[OFFSET(0)] = 'ABC'", "1"},
+		{"SELECT COUNT(*) FROM `p.d.u` WHERE st.a = 'ABC'", "2"},
+		{"SELECT COUNT(*) FROM `p.d.u` WHERE st.b = 'ABC'", "0"},
+		{"SELECT COUNT(*) FROM `p.d.u`, UNNEST(arr) e WHERE e = 'ABC'", "2"},
+		{"SELECT COUNT(*) FROM `p.d.u`, UNNEST(sa) e WHERE e.x = 'ABC'", "2"},
+		{"SELECT COUNT(*) FROM (SELECT st.a FROM `p.d.u` GROUP BY st.a)", "1"},
+		{"SELECT COUNT(DISTINCT st.a) FROM `p.d.u`", "1"},
+		{"SELECT COUNT(*) FROM `p.d.u` WHERE st = STRUCT('ABC' AS a, 'Abc' AS b)", "1"},
+		{"SELECT COUNT(*) FROM `p.d.u` WHERE st.a IN ('abc')", "2"},
+		{"SELECT COUNT(*) FROM `p.d.u` WHERE st != STRUCT('ABC' AS a, 'Abc' AS b)", "1"},
+		{"SELECT COUNT(*) FROM `p.d.u` WHERE st IN (STRUCT('ABC' AS a, 'Abc' AS b))", "1"},
+		{"SELECT COUNT(*) FROM `p.d.u` WHERE CASE st WHEN STRUCT('ABC' AS a, 'Abc' AS b) THEN TRUE ELSE FALSE END", "1"},
+		{"SELECT st.a FROM `p.d.t`", "Abc"},
+	} {
+		var v any
+		if err := db.QueryRowContext(ctx, tc.q).Scan(&v); err != nil {
+			t.Errorf("%s: %v", tc.q, err)
+			continue
+		}
+		if got := fmt.Sprint(v); got != tc.want {
+			t.Errorf("%s = %s, want %s", tc.q, got, tc.want)
+		}
+	}
+}
