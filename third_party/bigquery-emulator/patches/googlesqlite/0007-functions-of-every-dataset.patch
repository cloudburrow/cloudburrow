+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// functionPathsConn opens a connection whose name path is
+// [proj-1, two], as the BigQuery emulator sets it for a query with the
+// default dataset `two`, with SQL functions in the datasets one and two.
+func functionPathsConn(t *testing.T, dsn string) *sql.Conn {
+	t.Helper()
+	db, err := sql.Open("googlesqlite", dsn)
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	t.Cleanup(func() { db.Close() })
+	ctx := context.Background()
+	conn, err := db.Conn(ctx)
+	if err != nil {
+		t.Fatalf("Conn: %v", err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	withRawConn(t, conn, func(c *googlesqlite.Conn) {
+		c.SetMaxNamePath(3)
+		if err := c.SetNamePath([]string{"proj-1"}); err != nil {
+			t.Fatalf("SetNamePath: %v", err)
+		}
+	})
+	for _, q := range []string{
+		"CREATE FUNCTION one.fn(x INT64) AS (x + 1)",
+		"CREATE FUNCTION two.fn(x INT64) AS (x + 2)",
+		"CREATE FUNCTION two.other(x INT64) AS (x * 10)",
+		"CREATE TABLE FUNCTION one.tf(n INT64) AS SELECT n + 100 AS x",
+	} {
+		if _, err := conn.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	withRawConn(t, conn, func(c *googlesqlite.Conn) {
+		if err := c.SetNamePath([]string{"proj-1", "two"}); err != nil {
+			t.Fatalf("SetNamePath: %v", err)
+		}
+	})
+	return conn
+}
+
+// TestFunctionOfAnotherDataset is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1107, #1123): with a default dataset, a call of
+// another dataset's SQL function failed "no such column: proj", the
+// engine having inlined only the default dataset's functions.
+func TestFunctionOfAnotherDataset(t *testing.T) {
+	conn := functionPathsConn(t, ":memory:?_test=function_of_another_dataset")
+	ctx := context.Background()
+	for _, tc := range []struct {
+		query string
+		want  int64
+	}{
+		{"SELECT one.fn(1)", 2},
+		{"SELECT one.fn(1) + two.fn(1) + other(1)", 15},
+		{"SELECT `proj-1`.one.fn(5)", 6},
+	} {
+		var got int64
+		if err := conn.QueryRowContext(ctx, tc.query).Scan(&got); err != nil {
+			t.Errorf("%s: %v", tc.query, err)
+			continue
+		}
+		if got != tc.want {
+			t.Errorf("%s = %d, want %d", tc.query, got, tc.want)
+		}
+	}
+	// A table function of another dataset is inlined the same way.
+	var x int64
+	if err := conn.QueryRowContext(ctx, "SELECT x FROM one.tf(1)").Scan(&x); err != nil || x != 101 {
+		t.Errorf("SELECT x FROM one.tf(1) = %d, %v, want 101", x, err)
+	}
+	// A script and DDL go through the same inlining.
+	if _, err := conn.ExecContext(ctx, "CREATE TABLE t AS SELECT one.fn(1) AS a"); err != nil {
+		t.Fatalf("CREATE TABLE AS SELECT one.fn(1): %v", err)
+	}
+	if _, err := conn.ExecContext(ctx, "CREATE VIEW v AS SELECT one.fn(a) AS b FROM t"); err != nil {
+		t.Fatalf("CREATE VIEW AS SELECT one.fn(a): %v", err)
+	}
+	var got int64
+	if err := conn.QueryRowContext(ctx, "SELECT b FROM v").Scan(&got); err != nil || got != 3 {
+		t.Errorf("SELECT b FROM v = %d, %v, want 3", got, err)
+	}
+	if err := conn.QueryRowContext(ctx, "DECLARE x INT64 DEFAULT one.fn(1); SELECT one.fn(x)").Scan(&got); err != nil || got != 3 {
+		t.Errorf("script = %d, %v, want 3", got, err)
+	}
+}
