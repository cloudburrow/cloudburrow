+package internal
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+// The change table's update flag (CloudBurrow patch,
+// cloudburrow/cloudburrow#1548).
+//
+// Patch 0036 named the change table's flag of a DELETE that is half of an
+// UPDATE _CHANGE_IS_FOR_UPDATE, a name BigQuery does not reserve: it
+// reserves only the prefixes _CHANGE_TYPE, _CHANGE_TIMESTAMP and
+// _CHANGE_SEQUENCE_NUMBER (https://cloud.google.com/bigquery/docs/schemas,
+// "Column names", read 2026-10-17), so a table may have a column of that
+// name, and patch 0063 gave such a table no history. The flag is now
+// changeForUpdateColumn, a name under the reserved prefix _CHANGE_TYPE,
+// which no BigQuery table has, and a column _CHANGE_IS_FOR_UPDATE is the
+// table's own. A change table made before keeps its history: the catalog's
+// first sync renames its flag (migrateChangeForUpdateColumn).
+
+// changeForUpdateColumn is the change table's column that marks the
+// DELETE of an UPDATE's old row.
+const changeForUpdateColumn = "_CHANGE_TYPE_FOR_UPDATE"
+
+// oldChangeForUpdateColumn is changeForUpdateColumn's name before patch
+// 0065.
+const oldChangeForUpdateColumn = "_CHANGE_IS_FOR_UPDATE"
+
+// migrateChangeForUpdateColumn renames the flag of every change table
+// made before patch 0065, in SQLite (which renames it in the table's
+// triggers too) and in the catalog. A change table of that time with a
+// column _CHANGE_IS_FOR_UPDATE has no other of the name (patch 0063 gave a
+// table with one no change table), and none has changeForUpdateColumn.
+func migrateChangeForUpdateColumn(ctx context.Context, conn *Conn) error {
+	rows, err := conn.QueryContext(ctx,
+		"SELECT name, spec FROM googlesqlite_catalog WHERE kind = @kind AND name LIKE @suffix AND instr(spec, @old) > 0",
+		sql.Named("kind", string(TableSpecKind)), sql.Named("suffix", "%"+changeTableSuffix),
+		sql.Named("old", `"`+oldChangeForUpdateColumn+`"`))
+	if err != nil {
+		return err
+	}
+	type old struct {
+		name string
+		spec *TableSpec
+	}
+	var olds []old
+	for rows.Next() {
+		var name, encoded string
+		if err := rows.Scan(&name, &encoded); err != nil {
+			rows.Close()
+			return err
+		}
+		var spec TableSpec
+		if err := json.Unmarshal([]byte(encoded), &spec); err != nil || !isChangeTableName(name) {
+			continue
+		}
+		flag := -1
+		for i, c := range spec.Columns {
+			switch {
+			case strings.EqualFold(c.Name, changeForUpdateColumn):
+				flag = -2
+			case flag == -1 && c.Name == oldChangeForUpdateColumn:
+				flag = i
+			}
+		}
+		if flag < 0 {
+			continue
+		}
+		spec.Columns[flag].Name = changeForUpdateColumn
+		olds = append(olds, old{name, &spec})
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		return err
+	}
+	rows.Close()
+	for _, o := range olds {
+		var n int
+		if err := conn.QueryRowContext(ctx, "SELECT COUNT(*) FROM pragma_table_info(@t) WHERE name = @c",
+			sql.Named("t", o.name), sql.Named("c", oldChangeForUpdateColumn)).Scan(&n); err != nil {
+			return err
+		}
+		if n > 0 {
+			if _, err := conn.ExecContext(ctx, fmt.Sprintf("ALTER TABLE `%s` RENAME COLUMN `%s` TO `%s`",
+				o.name, oldChangeForUpdateColumn, changeForUpdateColumn)); err != nil {
+				return fmt.Errorf("change table %s: %w", o.name, err)
+			}
+		}
+		encoded, err := json.Marshal(o.spec)
+		if err != nil {
+			return err
+		}
+		if _, err := conn.ExecContext(ctx, "UPDATE googlesqlite_catalog SET spec = @spec WHERE name = @name",
+			sql.Named("spec", string(encoded)), sql.Named("name", o.name)); err != nil {
+			return err
+		}
+	}
+	return nil
+}
