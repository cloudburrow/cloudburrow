@@ -0,0 +1,94 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"path/filepath"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestChangeHistoryUpdateFlag is CloudBurrow's regression test of its
+// patch 0065 (cloudburrow/cloudburrow#1548): a table with a column of
+// its own named _CHANGE_IS_FOR_UPDATE, a name BigQuery does not reserve,
+// keeps its history, the column's values among it, beside the change
+// table's flag, _CHANGE_TYPE_FOR_UPDATE; and a change table made before
+// the patch, its flag named _CHANGE_IS_FOR_UPDATE, has it renamed when
+// the database is opened, and keeps its history.
+func TestChangeHistoryUpdateFlag(t *testing.T) {
+	ctx := context.Background()
+	open := func(dsn string) *sql.DB {
+		t.Helper()
+		db, err := sql.Open("googlesqlite", dsn)
+		if err != nil {
+			t.Fatal(err)
+		}
+		db.SetMaxOpenConns(1)
+		return db
+	}
+	exec := func(db *sql.DB, q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	count := func(db *sql.DB, q string) int64 {
+		t.Helper()
+		var n int64
+		if err := db.QueryRowContext(ctx, q).Scan(&n); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		return n
+	}
+
+	db := open(":memory:")
+	exec(db, "CREATE TABLE `p.d.t` (id INT64, _CHANGE_IS_FOR_UPDATE BOOL)")
+	exec(db, "INSERT INTO `p.d.t` VALUES (1, TRUE), (2, FALSE)")
+	exec(db, "UPDATE `p.d.t` SET id = 3 WHERE id = 2")
+	if n := count(db, "SELECT COUNT(*) FROM `p.d.t$changes` WHERE _CHANGE_TYPE != 'START'"); n != 4 {
+		t.Errorf("changes of a table with a column _CHANGE_IS_FOR_UPDATE: %d, want 4", n)
+	}
+	if n := count(db, "SELECT COUNT(*) FROM `p.d.t$changes` WHERE _CHANGE_TYPE = 'DELETE' AND _CHANGE_TYPE_FOR_UPDATE AND id = 2 AND NOT _CHANGE_IS_FOR_UPDATE"); n != 1 {
+		t.Errorf("the UPDATE's DELETE of the old row with the table's own _CHANGE_IS_FOR_UPDATE: %d rows, want 1", n)
+	}
+	if n := count(db, "SELECT COUNT(*) FROM `p.d.t$changes` WHERE _CHANGE_TYPE = 'INSERT' AND _CHANGE_IS_FOR_UPDATE AND NOT _CHANGE_TYPE_FOR_UPDATE"); n != 1 {
+		t.Errorf("the INSERT of the row whose _CHANGE_IS_FOR_UPDATE is TRUE: %d rows, want 1", n)
+	}
+	exec(db, "CREATE OR REPLACE TABLE `p.d.t` (id INT64, _CHANGE_IS_FOR_UPDATE BOOL)")
+	if n := count(db, "SELECT COUNT(*) FROM `p.d.t$changes` WHERE _CHANGE_IS_FOR_UPDATE AND _CHANGE_TYPE = 'DELETE'"); n != 1 {
+		t.Errorf("after CREATE OR REPLACE, the replace's DELETE of the row whose _CHANGE_IS_FOR_UPDATE was TRUE: %d, want 1", n)
+	}
+	db.Close()
+
+	// A change table of before the patch: made now, its flag renamed back
+	// in SQLite (its tables are named by their paths joined with _) and in
+	// the catalog.
+	path := filepath.Join(t.TempDir(), "old.db")
+	db = open("file:" + path)
+	exec(db, "CREATE TABLE `p.d.old` (id INT64, v STRING)")
+	exec(db, "INSERT INTO `p.d.old` VALUES (1, 'a')")
+	db.Close()
+	raw, err := sql.Open("googlesqlite_sqlite3", "file:"+path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, q := range []string{
+		"ALTER TABLE `p_d_old$changes` RENAME COLUMN `_CHANGE_TYPE_FOR_UPDATE` TO `_CHANGE_IS_FOR_UPDATE`",
+		`UPDATE googlesqlite_catalog SET spec = replace(spec, '"_CHANGE_TYPE_FOR_UPDATE"', '"_CHANGE_IS_FOR_UPDATE"') WHERE name = 'p_d_old$changes'`,
+	} {
+		if _, err := raw.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	raw.Close()
+	db = open("file:" + path + "?_pragma=busy_timeout(5000)")
+	defer db.Close()
+	exec(db, "UPDATE `p.d.old` SET v = 'b' WHERE id = 1")
+	if n := count(db, "SELECT COUNT(*) FROM `p.d.old$changes` WHERE _CHANGE_TYPE = 'DELETE' AND _CHANGE_TYPE_FOR_UPDATE AND v = 'a'"); n != 1 {
+		t.Errorf("an old change table's UPDATE, after the rename: %d DELETEs for the update, want 1", n)
+	}
+	if n := count(db, "SELECT COUNT(*) FROM `p.d.old$changes` WHERE _CHANGE_TYPE IN ('INSERT', 'UPDATE')"); n != 2 {
+		t.Errorf("an old change table's INSERT and UPDATE: %d, want 2", n)
+	}
+}
