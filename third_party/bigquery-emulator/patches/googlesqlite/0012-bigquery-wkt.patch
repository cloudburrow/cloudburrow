diff --git a/internal/value/value_geography_wkt.go b/internal/value/value_geography_wkt.go
new file mode 100644
index 0000000..d85e160
--- /dev/null
+++ b/internal/value/value_geography_wkt.go
@@ -0,0 +1,28 @@
+package value
+
+import (
+	"regexp"
+	"strings"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1119): BigQuery writes a
+// GEOGRAPHY's WKT with no space between a geometry's type and its
+// parenthesis, POINT(1 2), LINESTRING(1 2, 3 4), POLYGON((0 0, ...)),
+// GEOMETRYCOLLECTION(POINT(0 0), LINESTRING(1 2, 2 1)), and every empty
+// geography as GEOMETRYCOLLECTION EMPTY (ST_GEOGFROMTEXT('POINT EMPTY')
+// reads GEOMETRYCOLLECTION EMPTY): every example in
+// https://cloud.google.com/bigquery/docs/reference/standard-sql/geography_functions.
+// googlesqlite v0.3.1 wrote POINT (1 2), so a client comparing a
+// geography's text with BigQuery's (or with what it sent) saw another
+// string. The engine reads either form.
+
+var wktTypeParen = regexp.MustCompile(`\b(POINT|LINESTRING|POLYGON|MULTIPOINT|MULTILINESTRING|MULTIPOLYGON|GEOMETRYCOLLECTION) \(`)
+
+// bigQueryWKT is wkt, as the engine's geography types write it, in
+// BigQuery's form.
+func bigQueryWKT(wkt string) string {
+	if strings.HasSuffix(wkt, " EMPTY") && !strings.Contains(wkt, "(") {
+		return "GEOMETRYCOLLECTION EMPTY"
+	}
+	return wktTypeParen.ReplaceAllString(wkt, "$1(")
+}
