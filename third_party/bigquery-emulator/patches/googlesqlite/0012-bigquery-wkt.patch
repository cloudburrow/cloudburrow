CloudBurrow patch 12 to github.com/goccy/googlesqlite v0.3.1
(cloudburrow/cloudburrow#1061; the bug: #1119).

The bug: a GEOGRAPHY was written POINT (1 2), with a space before the
parenthesis, where BigQuery writes POINT(1 2), LINESTRING(1 2, 3 4),
GEOMETRYCOLLECTION(POINT(0 0), LINESTRING(1 2, 2 1)); and an empty one as
POINT EMPTY (or GEOMETRYCOLLECTION (), which the engine could not read
back), where BigQuery writes GEOMETRYCOLLECTION EMPTY
(ST_GEOGFROMTEXT('POINT EMPTY') reads GEOMETRYCOLLECTION EMPTY): every
example in BigQuery's geography functions reference. The patch writes
BigQuery's form wherever a GEOGRAPHY's WKT is written (ST_ASTEXT, a
result's value, a stored value); the parser reads either.
geography_wkt_test.go fails without the patch and passes with it; the
module's own geography tests that expected the old form are updated.

Licence: a modification of goccy/googlesqlite, which is under the MIT
License, Copyright (c) 2026 Masaaki Goshima
(third_party/bigquery-emulator/licenses/googlesqlite.LICENSE). This patch is
offered under the same MIT License, Copyright (c) 2026 The CloudBurrow
Authors.

diff --git a/geography_wkt_test.go b/geography_wkt_test.go
new file mode 100644
index 0000000..099ad2e
--- /dev/null
+++ b/geography_wkt_test.go
@@ -0,0 +1,54 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+)
+
+// TestGeographyWKTAsBigQueryWritesIt is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1119): a GEOGRAPHY read back as POINT (1 2),
+// where BigQuery writes POINT(1 2), and an empty one as POINT EMPTY where
+// BigQuery writes GEOMETRYCOLLECTION EMPTY.
+func TestGeographyWKTAsBigQueryWritesIt(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=geography_wkt")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, tc := range []struct{ expr, want string }{
+		{"ST_GEOGPOINT(1, 2)", "POINT(1 2)"},
+		{"ST_GEOGFROMTEXT('POINT(1 2)')", "POINT(1 2)"},
+		{"ST_GEOGFROMTEXT('POINT (1 2)')", "POINT(1 2)"},
+		{"ST_GEOGFROMTEXT('LINESTRING(1 2, 3 4)')", "LINESTRING(1 2, 3 4)"},
+		{"ST_GEOGFROMTEXT('MULTIPOINT(0 1, 4 3)')", "MULTIPOINT(0 1, 4 3)"},
+		{"ST_GEOGFROMTEXT('GEOMETRYCOLLECTION(POINT(0 0), LINESTRING(1 2, 2 1))')", "GEOMETRYCOLLECTION(POINT(0 0), LINESTRING(1 2, 2 1))"},
+		{"ST_GEOGFROMTEXT('POINT EMPTY')", "GEOMETRYCOLLECTION EMPTY"},
+		{"ST_GEOGFROMTEXT('GEOMETRYCOLLECTION EMPTY')", "GEOMETRYCOLLECTION EMPTY"},
+	} {
+		var got string
+		if err := db.QueryRowContext(ctx, "SELECT ST_ASTEXT("+tc.expr+")").Scan(&got); err != nil {
+			t.Errorf("ST_ASTEXT(%s): %v", tc.expr, err)
+			continue
+		}
+		if got != tc.want {
+			t.Errorf("ST_ASTEXT(%s) = %q, want %q", tc.expr, got, tc.want)
+		}
+	}
+	// A polygon's rings keep their parentheses.
+	var got string
+	if err := db.QueryRowContext(ctx, "SELECT ST_ASTEXT(ST_GEOGFROMTEXT('POLYGON((0 0, 1 0, 1 1, 0 0))'))").Scan(&got); err != nil || len(got) < 9 || got[:9] != "POLYGON((" {
+		t.Errorf("ST_ASTEXT(POLYGON) = %q, %v, want POLYGON((...))", got, err)
+	}
+	// Stored and read back, the text is the same.
+	if _, err := db.ExecContext(ctx, "CREATE TABLE g (v GEOGRAPHY)"); err != nil {
+		t.Fatalf("CREATE TABLE: %v", err)
+	}
+	if _, err := db.ExecContext(ctx, "INSERT INTO g (v) VALUES (ST_GEOGPOINT(1, 2))"); err != nil {
+		t.Fatalf("INSERT: %v", err)
+	}
+	if err := db.QueryRowContext(ctx, "SELECT ST_ASTEXT(v) FROM g").Scan(&got); err != nil || got != "POINT(1 2)" {
+		t.Errorf("stored: %q, %v, want POINT(1 2)", got, err)
+	}
+}
