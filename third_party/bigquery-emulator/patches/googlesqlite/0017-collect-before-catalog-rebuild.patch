 func (c *Catalog) resetCatalog(tables []*TableSpec, functions []*FunctionSpec, tvfs []*TVFSpec) error {
+	// CloudBurrow patch (cloudburrow/cloudburrow#1057): the catalogs an
+	// earlier rebuild retired, each with every builtin function, are freed
+	// in the engine's WebAssembly memory only by their finalizers, which
+	// run after a Go collection, and the emulator's heap is mostly that
+	// memory, so a collection waits for it to double: under DDL the
+	// retired catalogs piled up and the memory grew at each DROP. Collect
+	// first, so their finalizers free them, and that memory is reused for
+	// the new catalog.
+	runtime.GC()
 	c.catalog = newSimpleCatalog(catalogName)
 	if c.catalog == nil {
 		return fmt.Errorf("failed to create catalog")
