+package internal
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// decimalSpec is where, in a STRUCT or ARRAY column's value, the
+// parameterized NUMERIC and BIGNUMERIC fields are: a leaf (Name set) is one
+// such field, its precision, scale and rounding mode; else Fields names the
+// STRUCT fields that hold one. An ARRAY's elements take the spec of the
+// ARRAY itself (BigQuery has no ARRAY of ARRAY). CloudBurrow patch
+// (cloudburrow/cloudburrow#1409).
+type decimalSpec struct {
+	Name      string                  `json:"n,omitempty"`
+	Precision int64                   `json:"p,omitempty"`
+	Scale     int64                   `json:"s,omitempty"`
+	Mode      string                  `json:"m,omitempty"`
+	Fields    map[string]*decimalSpec `json:"f,omitempty"`
+}
+
+// roundDecimalNested is googlesqlite_round_decimal_nested(v, spec): v, a
+// STRUCT, an ARRAY or an ARRAY of STRUCT as googlesqlite stores it, with
+// each parameterized NUMERIC or BIGNUMERIC value spec (a decimalSpec in
+// JSON) names, at any depth, rounded as googlesqlite_round_decimal rounds a
+// top-level column's, and refused OUT_OF_RANGE as it refuses one. BigQuery
+// rounds a STRUCT's field and an ARRAY's element by the field's
+// roundingMode (https://cloud.google.com/bigquery/docs/schemas#rounding_mode);
+// the emulator calls it from the column's triggers. v is returned as it is
+// when nothing in it changes. CloudBurrow patch
+// (cloudburrow/cloudburrow#1409).
+func roundDecimalNested(v any, spec string) (any, error) {
+	if v == nil {
+		return nil, nil
+	}
+	var s decimalSpec
+	if err := json.Unmarshal([]byte(spec), &s); err != nil {
+		return nil, fmt.Errorf("googlesqlite_round_decimal_nested: spec %q: %w", spec, err)
+	}
+	decoded, err := value.DecodeValue(v)
+	if err != nil || decoded == nil {
+		return v, err
+	}
+	out, changed, err := roundIn(decoded, &s)
+	if err != nil || !changed {
+		return v, err
+	}
+	return value.EncodeValue(out)
+}
+
+// roundIn rounds what s names in v, and reports whether it changed it.
+func roundIn(v value.Value, s *decimalSpec) (value.Value, bool, error) {
+	if v == nil || s == nil {
+		return v, false, nil
+	}
+	if sv, ok := v.(*value.SafeValue); ok {
+		return roundIn(sv.Value, s)
+	}
+	switch vv := v.(type) {
+	case *value.ArrayValue:
+		changed := false
+		out := &value.ArrayValue{Values: make([]value.Value, len(vv.Values))}
+		for i, e := range vv.Values {
+			r, c, err := roundIn(e, s)
+			if err != nil {
+				return nil, false, err
+			}
+			out.Values[i], changed = r, changed || c
+		}
+		return out, changed, nil
+	case *value.StructValue:
+		if len(s.Fields) == 0 {
+			return v, false, nil
+		}
+		changed := false
+		out := &value.StructValue{Keys: vv.Keys, Values: make([]value.Value, len(vv.Values)), M: map[string]value.Value{}}
+		for i, e := range vv.Values {
+			r := e
+			if i < len(vv.Keys) {
+				if fs := fieldSpec(s.Fields, vv.Keys[i]); fs != nil {
+					var c bool
+					var err error
+					if r, c, err = roundIn(e, fs); err != nil {
+						return nil, false, err
+					}
+					changed = changed || c
+				}
+				out.M[vv.Keys[i]] = r
+			}
+			out.Values[i] = r
+		}
+		return out, changed, nil
+	case *value.NumericValue:
+		if s.Name == "" {
+			return v, false, nil
+		}
+		rounded := RoundRat(vv.Rat, s.Scale, s.Mode)
+		typ := "NUMERIC"
+		if vv.IsBigNumeric {
+			typ = "BIGNUMERIC"
+		}
+		if !RatFits(rounded, s.Precision, s.Scale) {
+			return nil, false, fmt.Errorf("OUT_OF_RANGE: Value %s is out of range for column %s of type %s(%d, %d)",
+				vv.Rat.FloatString(int(s.Scale)), s.Name, typ, s.Precision, s.Scale)
+		}
+		if rounded.Cmp(vv.Rat) == 0 {
+			return v, false, nil
+		}
+		return &value.NumericValue{Rat: rounded, IsBigNumeric: vv.IsBigNumeric}, true, nil
+	}
+	return v, false, nil
+}
+
+// fieldSpec is the spec of the STRUCT field key: BigQuery's field names
+// are case-insensitive.
+func fieldSpec(fields map[string]*decimalSpec, key string) *decimalSpec {
+	if s, ok := fields[key]; ok {
+		return s
+	}
+	for k, s := range fields {
+		if strings.EqualFold(k, key) {
+			return s
+		}
+	}
+	return nil
+}
