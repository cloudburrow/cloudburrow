+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// TestRoundDecimalNested is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1409): googlesqlite_round_decimal_nested, called
+// from a trigger, rounds the NUMERIC field of a STRUCT column, the elements
+// of an ARRAY<NUMERIC> column and a field of an ARRAY<STRUCT> column to
+// their scales by their rounding modes, and refuses a value with more
+// digits than its precision.
+func TestRoundDecimalNested(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=round_decimal_nested")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	exec := func(q string) error { _, err := db.ExecContext(ctx, q); return err }
+	trigger := func(col, spec string) string {
+		return googlesqlite.RawSQLitePrefix + "CREATE TRIGGER `r_" + col + "` AFTER INSERT ON `p_d_t` FOR EACH ROW WHEN NEW.`" + col +
+			"` IS NOT NULL BEGIN UPDATE `p_d_t` SET `" + col + "` = googlesqlite_round_decimal_nested(NEW.`" + col + "`, '" + spec +
+			"') WHERE rowid = NEW.rowid; END"
+	}
+	for _, q := range []string{
+		"CREATE TABLE `p.d.t` (id INT64, s STRUCT<a NUMERIC, b STRING>, r ARRAY<NUMERIC>, x ARRAY<STRUCT<e NUMERIC>>)",
+		trigger("s", `{"f":{"a":{"n":"s.a","p":2,"m":"ROUND_HALF_AWAY_FROM_ZERO"}}}`),
+		trigger("r", `{"n":"r","p":3,"s":1,"m":"ROUND_HALF_EVEN"}`),
+		trigger("x", `{"f":{"e":{"n":"x.e","p":2,"m":"ROUND_HALF_EVEN"}}}`),
+		"INSERT INTO `p.d.t` (id, s, r, x) VALUES (1, STRUCT(NUMERIC '2.5' AS a, 'k' AS b), [NUMERIC '0.25', 0.35], [STRUCT(NUMERIC '2.5' AS e), STRUCT(3.5 AS e)])",
+		"INSERT INTO `p.d.t` (id, s, r, x) VALUES (2, STRUCT(NUMERIC '-3.5' AS a, 'l' AS b), [], NULL)",
+	} {
+		if err := exec(q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	rows, err := db.QueryContext(ctx, "SELECT TO_JSON_STRING(STRUCT(s, r, x)) FROM `p.d.t` ORDER BY id")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got []string
+	for rows.Next() {
+		var s string
+		if err := rows.Scan(&s); err != nil {
+			t.Fatal(err)
+		}
+		got = append(got, s)
+	}
+	rows.Close()
+	want := `{"s":{"a":3,"b":"k"},"r":["0.2","0.4"],"x":[{"e":2},{"e":4}]}` + "\n" +
+		`{"s":{"a":-4,"b":"l"},"r":[],"x":null}`
+	if strings.Join(got, "\n") != want {
+		t.Errorf("rows\n%s\nwant\n%s", strings.Join(got, "\n"), want)
+	}
+	for _, q := range []string{
+		"INSERT INTO `p.d.t` (id, s) VALUES (3, STRUCT(NUMERIC '99.5' AS a, 'm' AS b))",
+		"INSERT INTO `p.d.t` (id, r) VALUES (3, [NUMERIC '1', 99.95])",
+		"INSERT INTO `p.d.t` (id, x) VALUES (3, [STRUCT(NUMERIC '1' AS e), STRUCT(99.5 AS e)])",
+	} {
+		if err := exec(q); err == nil || !strings.Contains(err.Error(), "OUT_OF_RANGE") {
+			t.Errorf("%s: %v, want OUT_OF_RANGE", q, err)
+		}
+	}
+}
