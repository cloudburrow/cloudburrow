 }
 
+// EncodeElement is encodeElement for callers outside this package that write
+// a value's encoding into JSON. CloudBurrow patch
+// (cloudburrow/cloudburrow#1204): googlesqlite_decode_array, which UNNEST
+// reads through json_each, wrote each element's EncodeValue into JSON, and an
+// infinite FLOAT64 failed "json: unsupported value: +Inf".
+func EncodeElement(v Value) (any, error) {
+	return encodeElement(v)
+}
