--- /dev/null
+++ b/inf_unnest_test.go
@@ -0,0 +1,57 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"math"
+	"testing"
+)
+
+// TestUnnestInfinity is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1204): UNNEST of an array holding an infinite
+// FLOAT64 failed "json: unsupported value: +Inf", because the array was
+// re-encoded as JSON, which has no infinity, on its way to json_each.
+// BigQuery returns the infinities.
+func TestUnnestInfinity(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=unnest_inf")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, tc := range []struct {
+		q    string
+		want []float64
+	}{
+		{"SELECT x FROM UNNEST([CAST('inf' AS FLOAT64)]) AS x", []float64{math.Inf(1)}},
+		{"SELECT x FROM UNNEST([CAST('-inf' AS FLOAT64), 1.5, IEEE_DIVIDE(1, 0)]) AS x WITH OFFSET o ORDER BY o", []float64{math.Inf(-1), 1.5, math.Inf(1)}},
+		{"SELECT x FROM UNNEST([CAST('inf' AS FLOAT64), 2.0]) AS x WHERE x > 3", []float64{math.Inf(1)}},
+		{"SELECT MAX(x) FROM UNNEST([CAST('inf' AS FLOAT64), 2.0]) AS x", []float64{math.Inf(1)}},
+		{"SELECT s.f FROM UNNEST([STRUCT(CAST('-inf' AS FLOAT64) AS f)]) AS s", []float64{math.Inf(-1)}},
+	} {
+		rows, err := db.QueryContext(ctx, tc.q)
+		if err != nil {
+			t.Fatalf("%s: %v", tc.q, err)
+		}
+		var got []float64
+		for rows.Next() {
+			var f float64
+			if err := rows.Scan(&f); err != nil {
+				t.Fatalf("%s: Scan: %v", tc.q, err)
+			}
+			got = append(got, f)
+		}
+		if err := rows.Err(); err != nil {
+			t.Fatalf("%s: %v", tc.q, err)
+		}
+		rows.Close()
+		if len(got) != len(tc.want) {
+			t.Fatalf("%s = %v, want %v", tc.q, got, tc.want)
+		}
+		for i := range got {
+			if got[i] != tc.want[i] {
+				t.Errorf("%s = %v, want %v", tc.q, got, tc.want)
+			}
+		}
+	}
+}
