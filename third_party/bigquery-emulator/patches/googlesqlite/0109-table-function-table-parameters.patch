+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+// TestTableFunctionTableParameters is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#2120): a table function's TABLE<...> parameter
+// takes a table or a subquery with those columns among others, in any
+// order, coerced to the declared types; a column of a type that does not
+// coerce, or one missing, fails the call; an ANY TABLE parameter takes a
+// table of any columns, and the body is analyzed for the call's own.
+func TestTableFunctionTableParameters(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=tvf_table_parameters")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, q := range []string{
+		"CREATE TABLE years (name STRING, year INT64)",
+		"INSERT INTO years VALUES ('a', 2019), ('b', 2021), ('c', 2023)",
+		"CREATE TABLE syears (year STRING)",
+		"CREATE TABLE FUNCTION tf(t1 TABLE<year INT64>, y INT64) AS (SELECT * FROM t1 WHERE year > y)",
+		"CREATE TABLE FUNCTION tfloat(t1 TABLE<year FLOAT64>) AS (SELECT year / 2 AS half FROM t1)",
+		"CREATE TABLE FUNCTION t2(t TABLE<name STRING>, t1 TABLE<year INT64>) AS (SELECT name FROM t UNION ALL SELECT CAST(year AS STRING) FROM t1)",
+		"CREATE TABLE FUNCTION tany(t1 ANY TABLE) AS (SELECT * FROM t1)",
+		"CREATE TABLE FUNCTION tany2(t1 ANY TABLE, y INT64) AS (SELECT name FROM t1 WHERE year > y)",
+		// A table parameter given on to another table function, as a
+		// clean room's linked dataset gives a query template's.
+		"CREATE TABLE FUNCTION fwd(t1 TABLE<year INT64>, y INT64) AS (SELECT * FROM tf(TABLE t1, y))",
+		"CREATE TABLE FUNCTION fwdany(t1 ANY TABLE) AS (SELECT * FROM tany(TABLE t1))",
+	} {
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	read := func(q string) (string, error) {
+		rows, err := db.QueryContext(ctx, q)
+		if err != nil {
+			return "", err
+		}
+		defer rows.Close()
+		cols, _ := rows.Columns()
+		var out []string
+		for rows.Next() {
+			vals := make([]any, len(cols))
+			ptrs := make([]any, len(cols))
+			for i := range vals {
+				ptrs[i] = &vals[i]
+			}
+			if err := rows.Scan(ptrs...); err != nil {
+				return "", err
+			}
+			out = append(out, strings.TrimSpace(fmt.Sprintln(vals...)))
+		}
+		return strings.Join(cols, ",") + ": " + strings.Join(out, "; "), rows.Err()
+	}
+	for q, want := range map[string]string{
+		"SELECT * FROM tf(TABLE years, 2020)":                                               "year: 2021; 2023",
+		"SELECT * FROM tf((SELECT year FROM years WHERE name != 'c'), 2020)":                "year: 2021",
+		"SELECT * FROM tfloat(TABLE years) ORDER BY half":                                   "half: 1009.5; 1010.5; 1011.5",
