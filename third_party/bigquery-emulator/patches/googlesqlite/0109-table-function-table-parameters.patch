+package internal
+
+// CloudBurrow patch (cloudburrow/cloudburrow#2120): table parameters of a
+// table function. BigQuery: a table function's parameter may be a table,
+// TABLE<column type, ...>, which "accepts an input table containing a
+// superset of those columns in any order", or ANY TABLE, a table of any
+// columns; a call gives it as TABLE dataset.table or a subquery
+// (https://docs.cloud.google.com/bigquery/docs/table-functions#table_parameters).
+//
+// The analyzer resolves a TABLE<...> parameter as a relation argument of
+// the function's signature, and a reference to it in the body as a
+// ResolvedRelationArgumentScan, formatted as a subquery of its columns
+// FROM @name; a call's table argument is formatted as a subquery of the
+// parameter's columns, by their names (the analyzer has matched and
+// coerced them), and put in @name's place. A function with an ANY TABLE
+// or ANY TYPE parameter is a templated SQL function: the analyzer
+// resolves its body at each call, and the formatter analyzes it again for
+// the call's own argument types (a CREATE TEMP TABLE FUNCTION of them)
+// to format it.
+
+import (
+	"context"
+	"fmt"
+	"regexp"
+	"strings"
+
+	googlesql "github.com/goccy/go-googlesql"
+)
+
+// RelationArgumentScanNode is a table parameter read in a function's body.
+type RelationArgumentScanNode struct {
+	node *googlesql.ResolvedRelationArgumentScan
+}
+
+func (n *RelationArgumentScanNode) FormatSQL(ctx context.Context) (string, error) {
+	if n == nil || n.node == nil {
+		return "", nil
+	}
+	name, err := n.node.Name()
+	if err != nil {
+		return "", err
+	}
+	columns := []string{}
+	for _, col := range m1(n.node.ColumnList()) {
+		columns = append(columns, fmt.Sprintf("`%s` AS `%s`", m1(col.Name()), uniqueColumnName(ctx, col)))
+	}
+	if len(columns) == 0 {
+		columns = append(columns, "NULL")
+	}
+	return fmt.Sprintf("(SELECT %s FROM @%s)", strings.Join(columns, ","), name), nil
+}
+
+// templatedSignature reports whether a function's signature has an ANY
+// TABLE or ANY TYPE parameter.
+func templatedSignature(sig *googlesql.FunctionSignature) bool {
+	if sig == nil {
+		return false
+	}
+	for _, arg := range m1(sig.Arguments()) {
+		if m1(arg.IsTemplated()) && !(m1(arg.IsRelation()) && relationHasSchema(arg)) {
+			return true
+		}
+	}
+	return false
+}
+
+// relationHasSchema reports whether a relation parameter is TABLE<...>.
+func relationHasSchema(arg *googlesql.FunctionArgumentType) bool {
+	opts, err := arg.Options()
+	if err != nil || opts == nil {
+		return false
+	}
+	return m1(opts.HasRelationInputSchema())
+}
+
+// tvfArgumentRef is an argument's place in a function body: @name, not
+// part of @@name (a system variable) nor of a longer name.
+var tvfArgumentRef = regexp.MustCompile(`@@?[A-Za-z_][A-Za-z0-9_]*`)
+
+// substituteTVFArguments puts each argument's SQL in its @name's place in
+// body, in one pass, so that an argument whose name begins another's
+// (t and t1) is not put in the other's place.
+func substituteTVFArguments(body string, args []*NameWithType, values []string) string {
+	byName := map[string]string{}
+	for i, arg := range args {
+		if i >= len(values) {
+			break
+		}
+		byName[arg.Name] = values[i]
+	}
+	return tvfArgumentRef.ReplaceAllStringFunc(body, func(ref string) string {
+		if strings.HasPrefix(ref, "@@") {
+			return ref
+		}
+		if v, ok := byName[ref[1:]]; ok {
+			return v
+		}
+		return ref
+	})
+}
+
+// formatRelationArgument is a call's table argument (scan) as a subquery
+// of the parameter's columns by their names: param's declared columns,
+// or, for ANY TABLE, every column of the argument.
+func formatRelationArgument(ctx context.Context, arg *googlesql.ResolvedFunctionArgument, scan googlesql.ResolvedScanNode, param *NameWithType) (string, error) {
+	input, err := newNode(scan).FormatSQL(ctx)
+	if err != nil {
+		return "", fmt.Errorf("failed to format TVF table argument: %w", err)
+	}
+	cols := m1(arg.ArgumentColumnList())
+	if len(cols) == 0 {
+		cols = m1(scan.MutableColumnList())
+	}
+	var projections []string
+	if param != nil && param.Type != nil && len(param.Type.RelationColumns) > 0 {
+		for _, want := range param.Type.RelationColumns {
+			var found *googlesql.ResolvedColumn
+			for _, col := range cols {
+				if strings.EqualFold(m1(col.Name()), want.Name) {
+					found = col
+					break
+				}
+			}
+			if found == nil {
+				return "", fmt.Errorf("Required column %q not found in table passed as argument %s", want.Name, param.Name)
+			}
+			projections = append(projections, fmt.Sprintf("`%s` AS `%s`", uniqueColumnName(ctx, found), want.Name))
+		}
+	} else {
+		for _, col := range cols {
+			projections = append(projections, fmt.Sprintf("`%s` AS `%s`", uniqueColumnName(ctx, col), m1(col.Name())))
+		}
+	}
+	from, err := formatInput(input)
+	if err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("(SELECT %s %s)", strings.Join(projections, ","), from), nil
+}
+
+// templatedTVFHandle is the catalog's handle of a templated function: a
+// templated SQL table function of spec's signature and body.
+func templatedTVFHandle(storageName string, spec *TVFSpec, argTypes []*googlesql.FunctionArgumentType) (*googlesql.TableValuedFunction, error) {
+	result, err := googlesql.NewFunctionArgumentType5(googlesql.SignatureArgumentKindArgTypeRelation, m1(googlesql.NewFunctionArgumentTypeOptions()), -1)
+	if err != nil {
+		return nil, err
+	}
+	sig, err := googlesql.NewFunctionSignature3(result, argTypes, 0)
+	if err != nil {
+		return nil, fmt.Errorf("failed to build TVF signature: %w", err)
+	}
+	names := make([]string, 0, len(spec.Args))
+	for _, arg := range spec.Args {
+		names = append(names, arg.Name)
+	}
+	loc, err := googlesql.NewParseResumeLocationFromString(spec.Code)
+	if err != nil {
+		return nil, err
+	}
+	tvf, err := googlesql.NewTemplatedSQLTVF([]string{storageName}, sig, names, loc, nil)
+	if err != nil {
+		return nil, fmt.Errorf("failed to build TVF handle: %w", err)
+	}
+	return tvf.TableValuedFunction, nil
+}
+
+// instantiateTemplatedTVF is a templated function (spec) for one call's
+// arguments: its body analyzed with each parameter of the type the call
+// gives it, as a TVFSpec with that body.
+func instantiateTemplatedTVF(ctx context.Context, spec *TVFSpec, args []*googlesql.ResolvedFunctionArgument) (*TVFSpec, error) {
+	a := analyzerFromContext(ctx)
+	if a == nil || a.catalog == nil {
+		return nil, fmt.Errorf("TVF %s: no analyzer to instantiate it", spec.TVFName())
+	}
+	decls := make([]string, 0, len(spec.Args))
+	for i, param := range spec.Args {
+		var arg *googlesql.ResolvedFunctionArgument
+		if i < len(args) {
+			arg = args[i]
+		}
+		decl, err := concreteArgumentType(param, arg)
+		if err != nil {
+			return nil, fmt.Errorf("TVF %s: %w", spec.TVFName(), err)
+		}
+		decls = append(decls, fmt.Sprintf("`%s` %s", param.Name, decl))
+	}
+	text := fmt.Sprintf("CREATE TEMP TABLE FUNCTION __googlesqlite_tvf__(%s) AS (%s)", strings.Join(decls, ", "), spec.Code)
+	out, err := googlesql.AnalyzeStatement(text, a.opt, a.catalog.catalog, tf())
+	if err != nil {
+		return nil, fmt.Errorf("TVF %s: %w", spec.TVFName(), err)
+	}
+	stmt, ok := m1(out.ResolvedStatement()).(*googlesql.ResolvedCreateTableFunctionStmt)
+	if !ok {
+		return nil, fmt.Errorf("TVF %s: its body did not analyze as a table function", spec.TVFName())
+	}
+	concrete, err := newTVFSpec(ctx, a.namePath, stmt)
+	if err != nil {
+		return nil, err
+	}
+	if concrete.Templated {
+		return nil, fmt.Errorf("TVF %s: its arguments' types could not be told", spec.TVFName())
+	}
+	// The parameters' names as the function declares them.
+	for i := range concrete.Args {
+		if i < len(spec.Args) {
+			concrete.Args[i].Name = spec.Args[i].Name
+		}
+	}
+	return concrete, nil
+}
+
+// concreteArgumentType is the type a call gives a parameter, as SQL.
+func concreteArgumentType(param *NameWithType, arg *googlesql.ResolvedFunctionArgument) (string, error) {
+	if param.Type != nil && param.Type.IsRelation {
+		if arg == nil {
+			return "", fmt.Errorf("no table for parameter %s", param.Name)
+		}
+		cols := m1(arg.ArgumentColumnList())
+		if len(cols) == 0 {
+			if scan, _ := arg.Scan(); scan != nil {
+				cols = m1(scan.MutableColumnList())
+			}
+		}
+		fields := make([]string, 0, len(cols))
+		for _, col := range cols {
+			fields = append(fields, fmt.Sprintf("`%s` %s", m1(col.Name()), newType(m1(col.Type())).FormatType()))
+		}
+		return fmt.Sprintf("TABLE<%s>", strings.Join(fields, ", ")), nil
+	}
+	if param.Type != nil && param.Type.SignatureKind == googlesql.SignatureArgumentKindArgTypeFixed {
+		return param.Type.FormatType(), nil
+	}
+	if arg != nil {
+		if expr, _ := arg.Expr(); expr != nil {
+			return newType(m1(expr.Type())).FormatType(), nil
+		}
+	}
+	return "", fmt.Errorf("no type for parameter %s", param.Name)
+}
