@@ -0,0 +1,38 @@
+package value
+
+import (
+	"math"
+	"testing"
+)
+
+// TestIntValueComparesWithFloatAsFloat is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1235): an INT64 compared with a FLOAT64 truncated
+// the float to an int64, so 2 = 2.5 was true, and +Inf became MinInt64 on
+// amd64 and MaxInt64 on arm64, which made MAX over [+Inf, 2] return 2 on
+// amd64.
+func TestIntValueComparesWithFloatAsFloat(t *testing.T) {
+	inf, ninf := FloatValue(math.Inf(1)), FloatValue(math.Inf(-1))
+	cases := []struct {
+		name string
+		got  func() (bool, error)
+		want bool
+	}{
+		{"2 = 2.5", func() (bool, error) { return IntValue(2).EQ(FloatValue(2.5)) }, false},
+		{"2 = 2.0", func() (bool, error) { return IntValue(2).EQ(FloatValue(2.0)) }, true},
+		{"2 < 2.5", func() (bool, error) { return IntValue(2).LT(FloatValue(2.5)) }, true},
+		{"2 >= 2.5", func() (bool, error) { return IntValue(2).GTE(FloatValue(2.5)) }, false},
+		{"3 > 2.5", func() (bool, error) { return IntValue(3).GT(FloatValue(2.5)) }, true},
+		{"2 > +Inf", func() (bool, error) { return IntValue(2).GT(inf) }, false},
+		{"2 < +Inf", func() (bool, error) { return IntValue(2).LT(inf) }, true},
+		{"2 > -Inf", func() (bool, error) { return IntValue(2).GT(ninf) }, true},
+		{"2 <= -Inf", func() (bool, error) { return IntValue(2).LTE(ninf) }, false},
+		{"2 = NaN", func() (bool, error) { return IntValue(2).EQ(FloatValue(math.NaN())) }, false},
+		{"2 = 2 (int)", func() (bool, error) { return IntValue(2).EQ(IntValue(2)) }, true},
+	}
+	for _, c := range cases {
+		got, err := c.got()
+		if err != nil || got != c.want {
+			t.Errorf("%s = %v, %v; want %v", c.name, got, err, c.want)
+		}
+	}
+}
