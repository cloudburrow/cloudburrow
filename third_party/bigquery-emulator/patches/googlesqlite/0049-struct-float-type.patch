--- a/internal/value/encoder.go
+++ b/internal/value/encoder.go
@@ -6,6 +6,7 @@
 	"math"
 	"reflect"
 	"strconv"
+	"strings"
 	"time"
 
 	"github.com/goccy/go-json"
@@ -64,6 +65,18 @@
 		}
 		return base64.StdEncoding.EncodeToString(b), nil
 	}
+	// CloudBurrow patch (cloudburrow/cloudburrow#1484): json.Marshal writes
+	// a whole FLOAT64 as an integer (3.0 as 3), which DecodeValue, and
+	// SQLite's json_each under UNNEST, read back as an INT64, so a FLOAT64
+	// field of a STRUCT or element of an ARRAY lost its type: s.x / 2 was an
+	// integer quotient and s.x * 0.5 was 0. It is written with a fraction.
+	if f, ok := v.(FloatValue); ok && !math.IsNaN(float64(f)) {
+		s := strconv.FormatFloat(float64(f), 'g', -1, 64)
+		if !strings.ContainsAny(s, ".eE") {
+			s += ".0"
+		}
+		return json.Number(s), nil
+	}
 	return EncodeValue(v)
 }
 
