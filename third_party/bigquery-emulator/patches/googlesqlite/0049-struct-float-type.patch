+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestStructFloatKeepsType is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1484): a whole FLOAT64 (3.0) in a STRUCT field
+// or an ARRAY element was encoded as the JSON integer 3 and read back as an
+// INT64, so s.x / 2 was 1, s.x * 0.5 was 0 and s.x + 0.5 was 3. It keeps
+// FLOAT64 for a literal, a column, CAST, an expression, a nested STRUCT,
+// ARRAY<STRUCT> (by UNNEST and by OFFSET), ARRAY<FLOAT64>, a subquery's
+// STRUCT and a stored STRUCT column, and an INT64 field stays INT64.
+func TestStructFloatKeepsType(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=struct_float")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	for _, q := range []string{
+		"CREATE TABLE `p.d.t` (f FLOAT64, i INT64, s STRUCT<x FLOAT64, n INT64>, a ARRAY<FLOAT64>)",
+		"INSERT INTO `p.d.t` (f, i, s, a) VALUES (3.0, 3, STRUCT(3.0 AS x, 3 AS n), [3.0, 4.0])",
+	} {
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	for _, tc := range []struct{ q, want string }{
+		{"SELECT TO_JSON_STRING(s.x / 2) FROM (SELECT STRUCT(CAST(3 AS FLOAT64) AS x) AS s)", "1.5"},
+		{"SELECT TO_JSON_STRING(s.x / 2) FROM (SELECT STRUCT(3.0 AS x) AS s)", "1.5"},
+		{"SELECT TO_JSON_STRING(s.x / 2) FROM (SELECT STRUCT(f AS x) AS s FROM `p.d.t`)", "1.5"},
+		{"SELECT TO_JSON_STRING(s.x / 2) FROM (SELECT STRUCT(f * 1 AS x) AS s FROM `p.d.t`)", "1.5"},
+		{"SELECT TO_JSON_STRING(s.x / 2) FROM (SELECT STRUCT(CAST(i AS FLOAT64) AS x) AS s FROM `p.d.t`)", "1.5"},
+		{"SELECT TO_JSON_STRING(s.x * 0.5) FROM (SELECT STRUCT(CAST(i AS FLOAT64) AS x) AS s FROM `p.d.t`)", "1.5"},
+		{"SELECT TO_JSON_STRING(s.x + 0.5) FROM (SELECT STRUCT(CAST(i AS FLOAT64) AS x) AS s FROM `p.d.t`)", "3.5"},
+		{"SELECT TO_JSON_STRING(s.x - 0.5) FROM (SELECT STRUCT(CAST(i AS FLOAT64) AS x) AS s FROM `p.d.t`)", "2.5"},
+		{"SELECT TO_JSON_STRING(IEEE_DIVIDE(s.x, 2)) FROM (SELECT STRUCT(CAST(i AS FLOAT64) AS x) AS s FROM `p.d.t`)", "1.5"},
+		{"SELECT TO_JSON_STRING(s.y.x / 2) FROM (SELECT STRUCT(STRUCT(CAST(i AS FLOAT64) AS x) AS y) AS s FROM `p.d.t`)", "1.5"},
+		{"SELECT TO_JSON_STRING(e.x / 2) FROM (SELECT [STRUCT(CAST(i AS FLOAT64) AS x)] AS a FROM `p.d.t`), UNNEST(a) e", "1.5"},
+		{"SELECT TO_JSON_STRING(a[OFFSET(0)].x / 2) FROM (SELECT [STRUCT(CAST(i AS FLOAT64) AS x)] AS a FROM `p.d.t`)", "1.5"},
+		{"SELECT TO_JSON_STRING((SELECT AS STRUCT CAST(i AS FLOAT64) AS x).x / 2) FROM `p.d.t`", "1.5"},
+		{"SELECT TO_JSON_STRING(s.x * 0.5) FROM `p.d.t`", "1.5"},
+		{"SELECT TO_JSON_STRING(e * 0.5) FROM `p.d.t`, UNNEST(a) e ORDER BY e LIMIT 1", "1.5"},
+		{"SELECT TO_JSON_STRING(a[OFFSET(1)] / 8) FROM `p.d.t`", "0.5"},
+		{"SELECT TO_JSON_STRING(s.n + 1) FROM `p.d.t`", "4"},
+		{"SELECT TO_JSON_STRING(DIV(s.n, 2)) FROM `p.d.t`", "1"},
+		{"SELECT TO_JSON_STRING(s.n / 2) FROM `p.d.t`", "1.5"},
+	} {
+		var got sql.NullString
+		if err := db.QueryRowContext(ctx, tc.q).Scan(&got); err != nil {
+			t.Errorf("%s: %v", tc.q, err)
+			continue
+		}
+		if got.String != tc.want {
+			t.Errorf("%s = %s, want %s", tc.q, got.String, tc.want)
+		}
+	}
+}
