-	v2, err := v.ToInt64()
+	v2, err := v.ToFloat64()
 	if err != nil {
 		return nil, err
 	}
 	if v2 == 0 {
 		return nil, fmt.Errorf("zero divided error ( %d / 0 )", iv)
 	}
-	return IntValue(int64(iv) / v2), nil
+	// CloudBurrow patch (cloudburrow/cloudburrow#1484): BigQuery's / (and
+	// SAFE_DIVIDE) of INT64s is FLOAT64, never an integer quotient
+	// (https://cloud.google.com/bigquery/docs/reference/standard-sql/operators#arithmetic_operators).
+	// The analyzer casts INT64 operands to FLOAT64, so an IntValue reaches
+	// here only from a FLOAT64 whose type was lost.
+	return FloatValue(float64(iv) / v2), nil
