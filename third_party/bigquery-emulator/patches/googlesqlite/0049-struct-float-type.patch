+// TestIntValueFloatArithmetic is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1484): INT64 with a FLOAT64 operand is FLOAT64,
+// not the float truncated to an INT64, and / is FLOAT64.
+func TestIntValueFloatArithmetic(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		op   func() (value.Value, error)
+		want value.Value
+	}{
+		{"add", func() (value.Value, error) { return value.IntValue(3).Add(value.FloatValue(0.5)) }, value.FloatValue(3.5)},
+		{"sub", func() (value.Value, error) { return value.IntValue(3).Sub(value.FloatValue(0.5)) }, value.FloatValue(2.5)},
+		{"mul", func() (value.Value, error) { return value.IntValue(3).Mul(value.FloatValue(0.5)) }, value.FloatValue(1.5)},
+		{"div", func() (value.Value, error) { return value.IntValue(3).Div(value.IntValue(2)) }, value.FloatValue(1.5)},
+		{"div float", func() (value.Value, error) { return value.IntValue(3).Div(value.FloatValue(0.5)) }, value.FloatValue(6)},
+		{"add int", func() (value.Value, error) { return value.IntValue(3).Add(value.IntValue(1)) }, value.IntValue(4)},
+	} {
+		got, err := tc.op()
+		if err != nil {
+			t.Fatalf("%s: %v", tc.name, err)
+		}
+		if got != tc.want {
+			t.Errorf("%s = %v (%T), want %v (%T)", tc.name, got, got, tc.want, tc.want)
+		}
+	}
+}
