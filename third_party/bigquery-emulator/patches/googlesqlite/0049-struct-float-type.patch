+// TestEncodeWholeFloatInStruct is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1484): a whole FLOAT64 in a STRUCT or an ARRAY
+// decodes back as FLOAT64, not INT64.
+func TestEncodeWholeFloatInStruct(t *testing.T) {
+	for _, v := range []value.Value{
+		&value.StructValue{Keys: []string{"x", "n"}, Values: []value.Value{value.FloatValue(3), value.IntValue(3)},
+			M: map[string]value.Value{"x": value.FloatValue(3), "n": value.IntValue(3)}},
+		&value.ArrayValue{Values: []value.Value{value.FloatValue(-2), value.FloatValue(1e21), value.FloatValue(0.5)}},
+	} {
+		enc, err := value.EncodeValue(v)
+		if err != nil {
+			t.Fatal(err)
+		}
+		dec, err := value.DecodeValue(enc)
+		if err != nil {
+			t.Fatal(err)
+		}
+		switch d := dec.(type) {
+		case *value.StructValue:
+			if _, ok := d.Values[0].(value.FloatValue); !ok {
+				t.Errorf("struct field x decoded as %T, want FloatValue", d.Values[0])
+			}
+			if _, ok := d.Values[1].(value.IntValue); !ok {
+				t.Errorf("struct field n decoded as %T, want IntValue", d.Values[1])
+			}
+		case *value.ArrayValue:
+			for i, e := range d.Values {
+				if _, ok := e.(value.FloatValue); !ok {
+					t.Errorf("array element %d decoded as %T, want FloatValue", i, e)
+				}
+			}
+		}
+	}
+}
