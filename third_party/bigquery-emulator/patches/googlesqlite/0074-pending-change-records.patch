+package internal
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+)
+
+// Pending change records (CloudBurrow patch, cloudburrow/cloudburrow#1597).
+//
+// Patch 0036 wrote every row a table was given twice: once to the table
+// and once, with all its values, to the table's change table. BigQuery's
+// APPENDS and time travel read any table's history within its time travel
+// window, and CHANGES a table's with enable_change_history
+// (https://cloud.google.com/bigquery/docs/reference/standard-sql/time-series-functions,
+// https://cloud.google.com/bigquery/docs/time-travel), so every table keeps
+// a history; but the values of a row inserted, or of the new row of an
+// UPDATE, are the row's in the table for as long as it is not changed
+// again. The record of an INSERT or an UPDATE is now pending: the change
+// table keeps its type, time and row identity, and changePendingColumn 1,
+// but no values. The change that next touches the row (an UPDATE, a
+// DELETE, MERGE, TRUNCATE TABLE, a WRITE_TRUNCATE), whose trigger has the
+// row's old values, settles it first: writes those values into the
+// pending record and clears the mark. So a pending record's values are
+// always its row's in the table, and a reader of a change table settles
+// the pending ones from the table before it reads (SettleChangesNamedIn);
+// as does CREATE OR REPLACE TABLE before it drops the table it replaces.
+// A table whose history is never read keeps no second copy of its rows,
+// only one small record of each change; a DELETE or an UPDATE copies the
+// old rows, as before. A change table made before this patch has no
+// changePendingColumn and keeps every record's values, as it did.
+
+// changePendingColumn is the change table's SQLite column that marks a
+// record whose values are its row's in the table; the catalog does not
+// name it.
+const changePendingColumn = "googlesqlite_change_pending"
+
+// settlePendingChange is the trigger statement that writes the old values
+// of the row a trigger fires on, of the columns cols, into its pending
+// record in change.
+func settlePendingChange(change string, cols []string) string {
+	sets := make([]string, 0, len(cols)+1)
+	for _, c := range cols {
+		sets = append(sets, c+" = OLD."+c)
+	}
+	sets = append(sets, "`"+changePendingColumn+"` = NULL")
+	return fmt.Sprintf("UPDATE `%s` SET %s WHERE `%s` = OLD.rowid AND `%s` IS NOT NULL",
+		change, strings.Join(sets, ", "), changeRowidColumn, changePendingColumn)
+}
+
+// settlePendingChanges writes into each pending record of the change table
+// change the values of its row in the table, and clears its mark. A change
+// table without pending records, or without the column, is left as it is.
+func settlePendingChanges(ctx context.Context, conn *Conn, change string) error {
+	if !isChangeTableName(change) {
+		return nil
+	}
+	base := strings.TrimSuffix(change, changeTableSuffix)
+	columns := func(table string) (map[string]bool, []string, error) {
+		rows, err := conn.QueryContext(ctx, "SELECT name FROM pragma_table_info(@t)", sql.Named("t", table))
+		if err != nil {
+			return nil, nil, err
+		}
+		defer rows.Close()
+		set := map[string]bool{}
+		var order []string
+		for rows.Next() {
+			var name string
+			if err := rows.Scan(&name); err != nil {
+				return nil, nil, err
+			}
+			set[name] = true
+			order = append(order, name)
+		}
+		return set, order, rows.Err()
+	}
+	have, order, err := columns(change)
+	if err != nil || !have[changePendingColumn] {
+		return err
+	}
+	var pending int
+	if err := conn.QueryRowContext(ctx, fmt.Sprintf("SELECT EXISTS (SELECT 1 FROM `%s` WHERE `%s` IS NOT NULL)",
+		change, changePendingColumn)).Scan(&pending); err != nil || pending == 0 {
+		return err
+	}
+	inBase, _, err := columns(base)
+	if err != nil {
+		return err
+	}
+	var cols []string
+	for _, c := range order {
+		if isChangeColumn(c) || strings.HasPrefix(c, "googlesqlite_") || !inBase[c] {
+			continue
+		}
+		cols = append(cols, "`"+c+"`")
+	}
+	set := "`" + changePendingColumn + "` = NULL"
+	if len(inBase) > 0 && len(cols) > 0 {
+		list := strings.Join(cols, ",")
+		set = fmt.Sprintf("(%s) = (SELECT %s FROM `%s` WHERE `%s`.rowid = `%s`.`%s`), %s",
+			list, list, base, base, change, changeRowidColumn, set)
+	}
+	if _, err := conn.ExecContext(ctx, fmt.Sprintf("UPDATE `%s` SET %s WHERE `%s` IS NOT NULL", change, set, changePendingColumn)); err != nil {
+		return fmt.Errorf("change history of %s: %w", base, err)
+	}
+	return nil
+}
+
+// SettleChangesNamedIn settles the pending records (above) of each change
+// table query may name, a statement about to run: each whose table id
+// (the last element of its path, which a SQLite name joins with "_") is
+// one query names with changeTableSuffix.
+func SettleChangesNamedIn(ctx context.Context, conn *Conn, query string) error {
+	ids := changeTableIDs(query)
+	if len(ids) == 0 {
+		return nil
+	}
+	rows, err := conn.QueryContext(ctx, "SELECT name FROM sqlite_master WHERE type = 'table' AND name LIKE @suffix",
+		sql.Named("suffix", "%"+changeTableSuffix))
+	if err != nil {
+		return err
+	}
+	var named []string
+	for rows.Next() {
+		var name string
+		if err := rows.Scan(&name); err != nil {
+			rows.Close()
+			return err
+		}
+		for _, id := range ids {
+			if name == id || strings.HasSuffix(name, "_"+id) || strings.HasSuffix(name, "."+id) {
+				named = append(named, name)
+				break
+			}
+		}
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		return err
+	}
+	rows.Close()
+	for _, name := range named {
+		if err := settlePendingChanges(ctx, conn, name); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// changeTableIDs returns the table ids query names with changeTableSuffix,
+// each with the suffix: the letters, digits, underscores, hyphens and
+// other than ASCII characters (BigQuery's table ids take Unicode letters)
+// before each.
+func changeTableIDs(query string) []string {
+	var ids []string
+	for rest := query; ; {
+		i := strings.Index(rest, changeTableSuffix)
+		if i < 0 {
+			return ids
+		}
+		j := i
+		for j > 0 {
+			c := rest[j-1]
+			if c == '_' || c == '-' || c >= 0x80 || c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' {
+				j--
+				continue
+			}
+			break
+		}
+		if j < i {
+			ids = append(ids, rest[j:i]+changeTableSuffix)
+		}
+		rest = rest[i+len(changeTableSuffix):]
+	}
+}
