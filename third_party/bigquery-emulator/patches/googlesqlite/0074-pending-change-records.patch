+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// TestChangeHistoryPending is CloudBurrow's regression test of its patch
+// 0074 (cloudburrow/cloudburrow#1597): a row inserted, or the new row of
+// an UPDATE, is not copied into the change table, whose record of it is
+// pending, until the row is changed again (its old values are then
+// written into the record) or the change table is read (its values are
+// then read from the table); the history read is the same.
+func TestChangeHistoryPending(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	exec := func(q string) sql.Result {
+		t.Helper()
+		res, err := db.ExecContext(ctx, q)
+		if err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		return res
+	}
+	// The records that keep no values (the START row keeps no row id),
+	// in SQLite, without settling them
+	// as a read of the change table through GoogleSQL does.
+	bare := func(cond string) int64 {
+		t.Helper()
+		n, err := exec(googlesqlite.RawSQLitePrefix + "UPDATE `p_d_Produce$changes` SET googlesqlite_change_pending = googlesqlite_change_pending " +
+			"WHERE product IS NULL AND inventory IS NULL AND " + cond).RowsAffected()
+		if err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	exec("CREATE TABLE `p.d.Produce` (product STRING, inventory INT64)")
+	exec("INSERT INTO `p.d.Produce` VALUES ('bananas', 20), ('carrots', 30), ('kiwis', 5)")
+	if n := bare("googlesqlite_change_pending = 1"); n != 3 {
+		t.Errorf("after an INSERT of 3 rows: %d records without values, want 3", n)
+	}
+	exec("DELETE `p.d.Produce` WHERE product = 'bananas'")
+	exec("UPDATE `p.d.Produce` SET inventory = inventory - 10 WHERE product = 'carrots'")
+	// kiwis' INSERT and carrots' UPDATE are pending; bananas' INSERT and
+	// carrots' were given their values by the DELETE and the UPDATE.
+	if n := bare("googlesqlite_change_pending = 1"); n != 2 {
+		t.Errorf("after a DELETE and an UPDATE: %d pending records, want 2", n)
+	}
+	if n := bare("googlesqlite_change_pending IS NULL AND googlesqlite_change_rowid IS NOT NULL"); n != 0 {
+		t.Errorf("after a DELETE and an UPDATE: %d settled records without values, want 0", n)
+	}
+	rows, err := db.QueryContext(ctx, "SELECT product, inventory, _CHANGE_TYPE FROM `p.d.Produce$changes` WHERE _CHANGE_TYPE != 'START' ORDER BY rowid")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got []string
+	for rows.Next() {
+		var product, typ string
+		var inventory int64
+		if err := rows.Scan(&product, &inventory, &typ); err != nil {
+			t.Fatal(err)
+		}
+		got = append(got, product+" "+typ+" "+string(rune('0'+inventory/10))+string(rune('0'+inventory%10)))
+	}
+	rows.Close()
+	want := []string{"bananas INSERT 20", "carrots INSERT 30", "kiwis INSERT 05", "bananas DELETE 20", "carrots DELETE 30", "carrots UPDATE 20"}
+	if len(got) != len(want) {
+		t.Fatalf("history %v, want %v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("history %v, want %v", got, want)
+			break
+		}
+	}
+	if n := bare("googlesqlite_change_pending = 1"); n != 0 {
+		t.Errorf("after a read of the change table: %d pending records, want 0", n)
+	}
+	// A record a read settled keeps its values when its row changes.
+	exec("UPDATE `p.d.Produce` SET inventory = 6 WHERE product = 'kiwis'")
+	var n int64
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM `p.d.Produce$changes` WHERE product = 'kiwis' AND inventory = 5").Scan(&n); err != nil || n != 2 {
+		t.Errorf("kiwis' INSERT and its update's DELETE: %d (%v), want 2", n, err)
+	}
+}
