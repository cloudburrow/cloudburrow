--- a/internal/encoder.go
+++ b/internal/encoder.go
@@ -436,6 +436,43 @@
 // arrayElementType returns the declared element type of an ARRAY type,
 // or nil when t is not an ArrayType handle or the element type cannot
 // be resolved.
+// rangeValueFromText is text, a RANGE's "[start, end)" with each bound
+// UNBOUNDED, NULL or a value of t's element type, as a *value.RangeValue,
+// each bound cast to the element type. CloudBurrow patch
+// (cloudburrow/cloudburrow#1492).
+func rangeValueFromText(t googlesql.Googlesql_TypeNode, text string) (value.Value, error) {
+	rt, err := t.AsRange()
+	if err != nil || rt == nil {
+		return nil, fmt.Errorf("RANGE %q: the type has no element type", text)
+	}
+	elem, err := rt.ElementType()
+	if err != nil || elem == nil {
+		return nil, fmt.Errorf("RANGE %q: the type has no element type", text)
+	}
+	s := strings.TrimSpace(text)
+	inner, ok := strings.CutPrefix(s, "[")
+	if ok {
+		inner, ok = strings.CutSuffix(inner, ")")
+	}
+	parts := strings.Split(inner, ",")
+	if !ok || len(parts) != 2 {
+		return nil, fmt.Errorf("invalid RANGE value %q: want [start, end)", text)
+	}
+	var bounds [2]value.Value
+	for i, p := range parts {
+		p = strings.TrimSpace(p)
+		if strings.EqualFold(p, "UNBOUNDED") || strings.EqualFold(p, "NULL") {
+			continue
+		}
+		b, err := castValueWithSpec(elem, nil, value.StringValue(p))
+		if err != nil {
+			return nil, fmt.Errorf("invalid RANGE value %q: %w", text, err)
+		}
+		bounds[i] = b
+	}
+	return &value.RangeValue{Start: bounds[0], End: bounds[1]}, nil
+}
