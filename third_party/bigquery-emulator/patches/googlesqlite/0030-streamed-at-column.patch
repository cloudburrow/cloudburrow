 func newTableSpecWithQuery(ctx context.Context, namePath *NamePath, query string, stmt *googlesql.ResolvedCreateTableStmt) *TableSpec {
 	now := time.Now()
+	isTemp := resolvedCreateScope(stmt) == googlesql.ResolvedCreateStatementEnums_CreateScopeCreateTemp
+	// CREATE TABLE IF NOT EXISTS may name a table that exists without the
+	// column (made by CREATE TABLE ... AS SELECT), which SQLite then
+	// leaves as it is: the catalog must not have it either.
+	ifNotExists := m1(stmt.CreateMode()) == googlesql.ResolvedCreateStatementEnums_CreateModeCreateIfNotExists
 	return &TableSpec{
-		IsTemp:     resolvedCreateScope(stmt) == googlesql.ResolvedCreateStatementEnums_CreateScopeCreateTemp,
+		IsTemp:     isTemp,
 		NamePath:   namePath.mergePath(m1(stmt.NamePath())),
-		Columns:    newColumnsFromDef(ctx, m1(stmt.ColumnDefinitionList())),
+		Columns:    withStreamedAtColumn(newColumnsFromDef(ctx, m1(stmt.ColumnDefinitionList())), isTemp || ifNotExists),
 		PrimaryKey: newPrimaryKey(m1(stmt.PrimaryKey())),
 		CreateMode: m1(stmt.CreateMode()),
 		Options:    newTableOptionsFromResolved(m1(stmt.OptionList())),
 		UpdatedAt:  now,
 		CreatedAt:  now,
+	}
+}
+
+// withStreamedAtColumn gives a table made by a CREATE TABLE statement with
+// a column list the pseudo-column of the time a row was streamed, as
+// bigquery-emulator patch 0018 gives one made by tables.insert, unless
+// its columns have it already (that patch's own CREATE TABLE), or skip:
+// a temporary table, which tabledata.insertAll cannot stream to, or a
+// CREATE TABLE IF NOT EXISTS (above) (CloudBurrow patch,
+// cloudburrow/cloudburrow#1370).
+func withStreamedAtColumn(columns []*ColumnSpec, skip bool) []*ColumnSpec {
+	if skip {
+		return columns
 	}
+	for _, c := range columns {
+		if strings.EqualFold(c.Name, streamedAtColumn) {
+			return columns
+		}
+	}
+	return append(columns, &ColumnSpec{Name: streamedAtColumn, Type: &Type{Kind: int(googlesql.TypeKindTypeTimestamp)}})
 }
 
