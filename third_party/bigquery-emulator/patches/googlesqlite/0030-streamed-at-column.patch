-		strings.EqualFold(name, streamingBufferColumn)
+		strings.EqualFold(name, streamingBufferColumn) || strings.EqualFold(name, streamedAtColumn)
 }
 
+// streamedAtColumn is the pseudo-column every table made by tables.insert
+// gets: the time a row was streamed by tabledata.insertAll, NULL on any
+// other row, so that DML refuses a row streamed in the last 30 minutes
+// (CloudBurrow patch, cloudburrow/cloudburrow#1370). BigQuery reserves the
+// prefix _PARTITION for its own column names.
+const streamedAtColumn = "_PARTITION_STREAMED"
+
 // streamingBufferColumn is the pseudo-column a table partitioned by a
 // column or an integer range gets: TRUE on a row in the table's
 // streaming buffer, NULL on any other (CloudBurrow patch,
