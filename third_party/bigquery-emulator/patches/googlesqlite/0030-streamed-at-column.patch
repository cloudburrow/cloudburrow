+++ b/streamed_at_column_test.go
@@ -0,0 +1,61 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestStreamedAtColumn is CloudBurrow's regression test of its patch 0030
+// (cloudburrow/cloudburrow#1370): a table column named _PARTITION_STREAMED
+// is a pseudo-column, which SELECT * leaves out, an INSERT may give and a
+// query names.
+func TestStreamedAtColumn(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	exec("CREATE TABLE plain (id INT64, `_PARTITION_STREAMED` TIMESTAMP)")
+	exec(`INSERT INTO plain (id) VALUES (1)`)
+	exec(`INSERT INTO plain (id, _PARTITION_STREAMED) VALUES (2, TIMESTAMP '2026-01-01 00:00:00+00')`)
+	rows, err := db.QueryContext(ctx, `SELECT * FROM plain`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cols, _ := rows.Columns()
+	rows.Close()
+	if strings.Join(cols, ",") != "id" {
+		t.Errorf("SELECT * columns = %v, want [id]", cols)
+	}
+	var id int64
+	if err := db.QueryRowContext(ctx, `SELECT id FROM plain WHERE _PARTITION_STREAMED >= TIMESTAMP '2025-12-31 23:30:00+00'`).Scan(&id); err != nil || id != 2 {
+		t.Errorf("streamed row: id %d (%v), want 2", id, err)
+	}
+	// A CREATE TABLE without the column gets it too, and SELECT * still
+	// leaves it out.
+	exec("CREATE TABLE ddl (id INT64)")
+	exec(`INSERT INTO ddl (id, _PARTITION_STREAMED) VALUES (3, TIMESTAMP '2026-01-01 00:00:00+00')`)
+	rows, err = db.QueryContext(ctx, `SELECT * FROM ddl`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cols, _ = rows.Columns()
+	rows.Close()
+	if strings.Join(cols, ",") != "id" {
+		t.Errorf("CREATE TABLE: SELECT * columns = %v, want [id]", cols)
+	}
+	if err := db.QueryRowContext(ctx, `SELECT id FROM ddl WHERE _PARTITION_STREAMED IS NOT NULL`).Scan(&id); err != nil || id != 3 {
+		t.Errorf("CREATE TABLE streamed row: id %d (%v), want 3", id, err)
+	}
+}
