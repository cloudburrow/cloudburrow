@@ -0,0 +1,115 @@
+package internal
+
+import (
+	googlesql "github.com/goccy/go-googlesql"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1784): names by the project
+// of the statement.
+//
+// BigQuery reads a table, view, function or table function name that
+// gives no project in the project of the query
+// (https://cloud.google.com/bigquery/docs/reference/standard-sql/lexical#table_names),
+// and a name of one part in the default dataset. The catalog held every
+// object of every project in one root catalog, under every suffix of its
+// path ("project.dataset.name", "dataset.name", "name"), the first object
+// made under a name keeping it: so in project B, `dataset.name` named
+// project A's object when A had made it first, and B read A's rows and ran
+// A's function.
+//
+// An object of a project's path (projectScoped) is now registered in the
+// root catalog under its own path alone: as "project.dataset.name" and
+// under the project's sub-catalog, which holds "dataset.name" and the
+// dataset's sub-catalog with "name". A statement of a project is analyzed
+// in lookupCatalog: the project's sub-catalog first, then its default
+// dataset's, then the root catalog, so a two-part name is the project's
+// and a one-part name its default dataset's, and three parts name any
+// project's object. The names without the project the root catalog held
+// are kept in a catalog of their own (Catalog.aliases), which only a
+// statement of no project (a connection with no name path, as
+// googlesqlite's own tests use) reads after the root catalog.
+
+// projectScoped reports whether path names an object of a project:
+// project, dataset and name, as every table, view and routine the
+// emulator makes is (its connections' name path is [project, dataset],
+// with at most three parts).
+func projectScoped(path []string) bool {
+	return len(path) >= 3
+}
+
+// lookupCatalog is the catalog a statement of namePath ([project] or
+// [project, dataset]) is analyzed in; the root catalog when namePath has
+// no project, or the project has no object yet.
+func (c *Catalog) lookupCatalog(namePath []string) googlesql.CatalogNode {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.catalog == nil {
+		return c.catalog
+	}
+	if len(namePath) == 0 {
+		return c.multiCatalog("", c.catalog, c.aliases)
+	}
+	project := c.subCatalogs[c.catalog][namePath[0]]
+	if project == nil {
+		return c.catalog
+	}
+	key := "\x00" + namePath[0]
+	var dataset *googlesql.SimpleCatalog
+	if len(namePath) > 1 {
+		if dataset = c.subCatalogs[project][namePath[1]]; dataset != nil {
+			key += "\x00" + namePath[1]
+		}
+	}
+	list := []*googlesql.SimpleCatalog{project}
+	if dataset != nil {
+		list = append(list, dataset)
+	}
+	return c.multiCatalog(key, append(list, c.catalog)...)
+}
+
+// multiCatalog is the MultiCatalog of list kept by key, made on first
+// use; the root catalog if it cannot be made.
+func (c *Catalog) multiCatalog(key string, list ...*googlesql.SimpleCatalog) googlesql.CatalogNode {
+	if m := c.lookupCatalogs[key]; m != nil {
+		return m
+	}
+	nodes := make([]googlesql.CatalogNode, 0, len(list))
+	for _, cat := range list {
+		if cat != nil {
+			nodes = append(nodes, cat)
+		}
+	}
+	m, err := googlesql.NewMultiCatalogCreate(catalogName, nodes)
+	if err != nil || m == nil {
+		return c.catalog
+	}
+	if c.lookupCatalogs == nil {
+		c.lookupCatalogs = map[string]*googlesql.MultiCatalog{}
+	}
+	c.lookupCatalogs[key] = m
+	return m
+}
+
+// suffixCatalog is the catalog the rest of an object's path is registered
+// in besides cat's sub-catalog (the alias "dataset.name" of
+// "project.dataset.name"): cat itself for a path of no project; for a
+// project's path, the aliases catalog in place of the root catalog, and
+// none below it.
+func (c *Catalog) suffixCatalog(cat *googlesql.SimpleCatalog, scoped bool) *googlesql.SimpleCatalog {
+	switch {
+	case !scoped:
+		return cat
+	case cat == c.catalog:
+		return c.aliases
+	}
+	return nil
+}
+
+// newAliasCatalog is an empty Catalog.aliases.
+func newAliasCatalog() *googlesql.SimpleCatalog {
+	cat, err := googlesql.NewSimpleCatalog(catalogName, tf())
+	if err != nil {
+		return nil
+	}
+	return cat
+}
