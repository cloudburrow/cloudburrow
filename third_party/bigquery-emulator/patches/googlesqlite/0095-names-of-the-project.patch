+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// TestNamesOfTheProject is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1784): two projects with the same dataset and
+// object names. A name without a project (`ds.t`, `ds.f`) named the first
+// project's object, whatever project the statement ran in: project B read
+// A's rows and ran A's function.
+func TestNamesOfTheProject(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=names_of_the_project")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	t.Cleanup(func() { db.Close() })
+	ctx := context.Background()
+	conn, err := db.Conn(ctx)
+	if err != nil {
+		t.Fatalf("Conn: %v", err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	in := func(path ...string) {
+		t.Helper()
+		withRawConn(t, conn, func(c *googlesqlite.Conn) {
+			c.SetMaxNamePath(3)
+			if err := c.SetNamePath(path); err != nil {
+				t.Fatalf("SetNamePath: %v", err)
+			}
+		})
+	}
+	exec := func(q string) {
+		t.Helper()
+		if _, err := conn.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	for _, p := range []struct {
+		project string
+		n       string
+	}{{"proj-a", "1"}, {"proj-b", "2"}} {
+		in(p.project)
+		exec("CREATE TABLE ds.t AS SELECT " + p.n + " AS a")
+		exec("CREATE TABLE ds.s_1 AS SELECT " + p.n + " AS a")
+		exec("CREATE FUNCTION ds.f(x INT64) AS (x + " + p.n + ")")
+		exec("CREATE TABLE FUNCTION ds.tf() AS SELECT " + p.n + " AS a")
+		exec("CREATE VIEW ds.v AS SELECT a * 10 AS a FROM ds.t")
+	}
+	one := func(q string, want int64) {
+		t.Helper()
+		var got int64
+		if err := conn.QueryRowContext(ctx, q).Scan(&got); err != nil {
+			t.Errorf("%s: %v", q, err)
+			return
+		}
+		if got != want {
+			t.Errorf("%s = %d, want %d", q, got, want)
+		}
+	}
+	for _, p := range []struct {
+		path []string
+		n    int64
+	}{
+		{[]string{"proj-a"}, 1}, {[]string{"proj-b"}, 2},
+		{[]string{"proj-a", "ds"}, 1}, {[]string{"proj-b", "ds"}, 2},
+	} {
+		in(p.path...)
+		one("SELECT a FROM ds.t", p.n)
+		one("SELECT a FROM `ds.t`", p.n)
+		one("SELECT ds.f(0)", p.n)
+		one("SELECT a FROM ds.tf()", p.n)
+		one("SELECT a FROM ds.v", p.n*10)
+		one("SELECT SUM(a) FROM `ds.s_*`", p.n)
+		one("SELECT COUNT(*) FROM ds.INFORMATION_SCHEMA.TABLES WHERE table_name = 't'", 1)
+		one("SELECT a FROM `proj-a.ds.t`", 1)
+		one("SELECT a FROM `proj-b`.ds.t", 2)
+		one("SELECT `proj-a`.ds.f(0) * 10 + `proj-b`.ds.f(0)", 12)
+		if len(p.path) == 2 {
+			one("SELECT a FROM t", p.n)
+			one("SELECT f(0)", p.n)
+		}
+	}
+	// A view's and a function's body keep the names of their own project.
+	in("proj-a")
+	exec("CREATE VIEW ds.w AS SELECT ds.f(a) AS a FROM ds.t")
+	in("proj-b")
+	one("SELECT a FROM `proj-a`.ds.w", 2)
+	one("SELECT a FROM ds.v", 20)
+	// A project without the name does not find another project's.
+	in("proj-c")
+	for _, q := range []string{"SELECT a FROM ds.t", "SELECT ds.f(0)", "SELECT a FROM ds.tf()"} {
+		var got int64
+		if err := conn.QueryRowContext(ctx, q).Scan(&got); err == nil {
+			t.Errorf("%s in proj-c = %d, want not found", q, got)
+		}
+	}
+	// And makes its own.
+	exec("CREATE FUNCTION ds.f(x INT64) AS (x + 3)")
+	exec("CREATE TABLE ds.t AS SELECT 3 AS a")
+	one("SELECT ds.f(0) + a FROM ds.t", 6)
+	in("proj-a")
+	one("SELECT ds.f(0) + a FROM ds.t", 2)
+}
