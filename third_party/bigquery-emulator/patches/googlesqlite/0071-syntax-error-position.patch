+
+// locatedSyntaxError is CloudBurrow patch 71 (cloudburrow/cloudburrow#1582):
+// ParseNextScriptStatement reports a syntax error without its position
+// ("Syntax error: Unexpected identifier \"blah\""), where an analysis
+// error ends with it ("[at 1:15]"): the parser options have no error
+// message mode, and ParseScript's error message options fail a RET_CHECK
+// through the WebAssembly bridge. So the statement that failed, at byte
+// pos of input, is read again by AnalyzeNextStatement, whose errors are
+// written in the analyzer's mode, with the position in the whole input;
+// its error is taken when it is the same error with the position after
+// it, else err is kept (a script statement, which only the script parser
+// reads).
+func (a *Analyzer) locatedSyntaxError(input string, pos int32, err error) error {
+	if !strings.HasPrefix(err.Error(), "Syntax error") {
+		return err
+	}
+	loc, _ := googlesql.NewParseResumeLocationFromString(input)
+	if loc == nil || loc.SetBytePosition(pos) != nil {
+		return err
+	}
+	_, located := googlesql.AnalyzeNextStatement(loc, a.opt, a.catalog.catalog, tf())
+	if located == nil || !strings.HasPrefix(located.Error(), err.Error()+" [at ") {
+		return err
+	}
+	return located
 }
 
