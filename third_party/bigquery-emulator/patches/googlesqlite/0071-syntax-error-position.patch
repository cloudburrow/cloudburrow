+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+)
+
+// TestSyntaxErrorPosition is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1582): a syntax error was reported without its
+// position ("Syntax error: Unexpected identifier \"blah\""), where an
+// analysis error ends with it ("[at 1:15]"); BigQuery gives a syntax
+// error's position too. It is the position in the whole query, a later
+// statement's too.
+func TestSyntaxErrorPosition(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=syntax_error_position")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	ctx := context.Background()
+	for _, tc := range []struct{ query, want string }{
+		{"blah blah broken", `Syntax error: Unexpected identifier "blah" [at 1:1]`},
+		{"SELECT 1 FROM", "Syntax error: Unexpected end of statement [at 1:14]"},
+		{"SELECT 1;\nSELECT FROM x", "Syntax error: SELECT list must not be empty [at 2:8]"},
+	} {
+		_, err := db.ExecContext(ctx, tc.query)
+		if err == nil {
+			t.Errorf("%q: no error", tc.query)
+			continue
+		}
+		if !strings.HasSuffix(err.Error(), "failed to parse statement: "+tc.want) {
+			t.Errorf("%q: got %q, want it to end %q", tc.query, err, tc.want)
+		}
+	}
+}
