-	return &TableSpec{
+	spec := &TableSpec{
 		IsTemp:     isTemp,
 		NamePath:   namePath.mergePath(m1(stmt.NamePath())),
 		Columns:    withStreamedAtColumn(newColumnsFromDef(ctx, m1(stmt.ColumnDefinitionList()), tableDefaultCollation(stmt)), isTemp || ifNotExists),
@@ -812,6 +819,8 @@
 		UpdatedAt:  now,
