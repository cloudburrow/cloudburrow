+		if err := conn.QueryRowContext(ctx, "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", a.spec.TableName()).Scan(&one); err != nil {
+			a.spec.Columns = withStreamedAtColumn(a.spec.Columns, false)
+			if a.spec.queryIfNew != "" {
+				a.spec.Query = a.spec.queryIfNew
+			}
+		}
+	}
 	if _, err := conn.ExecContext(ctx, a.spec.SQLiteSchema(), a.args...); err != nil {
 		return fmt.Errorf("failed to exec %s: %w", a.query, err)
 	}
