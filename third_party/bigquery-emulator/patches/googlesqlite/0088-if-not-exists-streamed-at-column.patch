 }
 
 // withStreamedAtColumn gives a table made by a CREATE TABLE statement with
@@ -989,7 +998,7 @@
 		columns = with
 		outputColumns = append(outputColumns, "NULL AS `"+streamedAtColumn+"`")
 	}
-	return &TableSpec{
+	spec := &TableSpec{
 		IsTemp:     isTemp,
 		NamePath:   namePath.mergePath(m1(stmt.NamePath())),
 		Columns:    columns,
@@ -999,6 +1008,13 @@
 		UpdatedAt:  now,
 		CreatedAt:  now,
 	}
+	// CloudBurrow patch (cloudburrow/cloudburrow#1458): IF NOT EXISTS
+	// gives the column when it makes the table (CreateTableStmtAction.exec).
+	if ifNotExists && !isTemp {
+		spec.streamedAtIfNew = true
+		spec.queryIfNew = fmt.Sprintf("SELECT %s FROM (%s)", strings.Join(append(outputColumns, "NULL AS `"+streamedAtColumn+"`"), ","), query)
+	}
+	return spec
 }
 
 func newType(t googlesql.Googlesql_TypeNode) *Type {
--- a/internal/stmt_action.go
+++ b/internal/stmt_action.go
@@ -89,6 +89,19 @@
 			return err
 		}
 	}
+	// CloudBurrow patch (cloudburrow/cloudburrow#1458): CREATE TABLE IF
+	// NOT EXISTS of a table that is not there makes it with the
+	// pseudo-column of the time a row was streamed, as CREATE TABLE does
+	// (withStreamedAtColumn); a table that is there is left as it is.
+	if a.spec.streamedAtIfNew {
