+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestChangeHistory is CloudBurrow's regression test of its patch 0036
+// (cloudburrow/cloudburrow#1418): every table a CREATE TABLE makes gets a
+// change table, `name$changes`, of each row inserted, deleted and updated
+// (a DELETE of the old row, _CHANGE_IS_FOR_UPDATE, and an UPDATE of the
+// new), with the time of the change, one time per statement; MERGE and
+// TRUNCATE TABLE are recorded; a wildcard and INFORMATION_SCHEMA leave
+// the change table out; DROP TABLE drops it.
+func TestChangeHistory(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	changes := func(q string) string {
+		t.Helper()
+		rows, err := db.QueryContext(ctx, q)
+		if err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		defer rows.Close()
+		var out []string
+		for rows.Next() {
+			var product, typ string
+			var inventory sql.NullInt64
+			var forUpdate bool
+			if err := rows.Scan(&product, &inventory, &typ, &forUpdate); err != nil {
+				t.Fatal(err)
+			}
+			out = append(out, fmt.Sprintf("%s %d %s %v", product, inventory.Int64, typ, forUpdate))
+		}
+		if err := rows.Err(); err != nil {
+			t.Fatal(err)
+		}
+		return strings.Join(out, "; ")
+	}
+	const read = "SELECT product, inventory, _CHANGE_TYPE, _CHANGE_IS_FOR_UPDATE FROM `p.d.Produce$changes` ORDER BY _CHANGE_TIMESTAMP, _CHANGE_TYPE DESC, product"
+	exec("CREATE TABLE `p.d.Produce` (product STRING, inventory INT64)")
+	exec("INSERT INTO `p.d.Produce` VALUES ('bananas', 20), ('carrots', 30)")
+	exec("DELETE `p.d.Produce` WHERE product = 'bananas'")
+	exec("UPDATE `p.d.Produce` SET inventory = inventory - 10 WHERE product = 'carrots'")
+	want := "bananas 20 INSERT false; carrots 30 INSERT false; bananas 20 DELETE false; carrots 20 UPDATE false; carrots 30 DELETE true"
+	if got := changes(read); got != want {
+		t.Errorf("changes:\n got %s\nwant %s", got, want)
+	}
+	var n int64
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(DISTINCT _CHANGE_TIMESTAMP) FROM `p.d.Produce$changes` WHERE _CHANGE_TYPE = 'INSERT'").Scan(&n); err != nil || n != 1 {
+		t.Errorf("one INSERT statement's change times: %d (%v), want 1", n, err)
+	}
+	var ts string
+	if err := db.QueryRowContext(ctx, "SELECT FORMAT_TIMESTAMP('%F', _CHANGE_TIMESTAMP) FROM `p.d.Produce$changes` LIMIT 1").Scan(&ts); err != nil || len(ts) != 10 {
+		t.Errorf("_CHANGE_TIMESTAMP %q (%v)", ts, err)
+	}
+
+	exec("CREATE TABLE `p.d.src` (product STRING, inventory INT64)")
+	exec("INSERT INTO `p.d.src` VALUES ('carrots', 1), ('grapes', 2)")
+	exec("MERGE `p.d.Produce` T USING `p.d.src` S ON T.product = S.product WHEN MATCHED THEN UPDATE SET inventory = S.inventory WHEN NOT MATCHED THEN INSERT (product, inventory) VALUES (S.product, S.inventory)")
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM `p.d.Produce$changes`").Scan(&n); err != nil || n != 8 {
+		t.Errorf("after MERGE: %d changes (%v), want 8", n, err)
+	}
+	exec("TRUNCATE TABLE `p.d.Produce`")
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM `p.d.Produce$changes` WHERE _CHANGE_TYPE = 'DELETE' AND NOT _CHANGE_IS_FOR_UPDATE").Scan(&n); err != nil || n != 3 {
+		t.Errorf("after TRUNCATE: %d deletes (%v), want 3", n, err)
+	}
+
+	// An UPDATE in the transaction that inserted the row (the emulator's
+	// rounding triggers) is part of the insert.
+	tx, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	exec2 := func(q string) {
+		t.Helper()
+		if _, err := tx.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	exec2("CREATE TABLE `p.d.tx` (product STRING, inventory INT64)")
+	exec2("INSERT INTO `p.d.tx` VALUES ('kiwis', 1)")
+	exec2("UPDATE `p.d.tx` SET inventory = 2 WHERE TRUE")
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	exec("UPDATE `p.d.tx` SET inventory = 3 WHERE TRUE")
+	if got := changes("SELECT product, inventory, _CHANGE_TYPE, _CHANGE_IS_FOR_UPDATE FROM `p.d.tx$changes` ORDER BY _CHANGE_TIMESTAMP, _CHANGE_TYPE DESC"); got != "kiwis 2 INSERT false; kiwis 3 UPDATE false; kiwis 2 DELETE true" {
+		t.Errorf("insert and update in one transaction, then an update: %s", got)
+	}
+
+	exec("CREATE TABLE `p.d.ctas` AS SELECT 'apples' AS product, 10 AS inventory")
+	if got := changes("SELECT product, inventory, _CHANGE_TYPE, _CHANGE_IS_FOR_UPDATE FROM `p.d.ctas$changes`"); got != "apples 10 INSERT false" {
+		t.Errorf("CREATE TABLE AS SELECT: %s", got)
+	}
+	exec("CREATE TABLE `proj.ds.wild_1` (product STRING)")
+	exec("INSERT INTO `proj.ds.wild_1` VALUES ('a'), ('b')")
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM `proj.ds.wild_*`").Scan(&n); err != nil || n != 2 {
+		t.Errorf("wildcard wild_*: %d rows (%v), want 2", n, err)
+	}
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE table_name LIKE '%$changes'").Scan(&n); err == nil && n != 0 {
+		t.Errorf("INFORMATION_SCHEMA.TABLES lists %d change tables", n)
+	}
+	// A table named by one name (the emulator's metadata) has none.
+	exec("CREATE TABLE IF NOT EXISTS plain (id INT64)")
+	exec("CREATE TABLE IF NOT EXISTS plain (id INT64)")
+	if _, err := db.QueryContext(ctx, "SELECT * FROM `plain$changes`"); err == nil {
+		t.Error("a table named by one name has a change table")
+	}
+	// Nor does one of CloudBurrow's datasets, or one with a column of a
+	// change column's name.
+	exec("CREATE TABLE `p._cloudburrow_query_results.r` (id INT64)")
+	exec("CREATE TABLE `p.d.named` (_CHANGE_TYPE STRING)")
+	for _, name := range []string{"p._cloudburrow_query_results.r$changes", "p.d.named$changes"} {
+		if _, err := db.QueryContext(ctx, "SELECT * FROM `"+name+"`"); err == nil {
+			t.Errorf("%s is there", name)
+		}
+	}
+	// CREATE TABLE IF NOT EXISTS of a table that is there keeps its history.
+	exec("CREATE TABLE IF NOT EXISTS `p.d.ctas` (product STRING, inventory INT64)")
+	if got := changes("SELECT product, inventory, _CHANGE_TYPE, _CHANGE_IS_FOR_UPDATE FROM `p.d.ctas$changes`"); got != "apples 10 INSERT false" {
+		t.Errorf("after CREATE TABLE IF NOT EXISTS: %s", got)
+	}
+	// A table taken out of the catalog by a DROP TABLE rolled back, and
+	// added again by CREATE TABLE IF NOT EXISTS (CloudBurrow's front's
+	// catalog resync), keeps its history.
+	tx, err = db.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := tx.ExecContext(ctx, "DROP TABLE `p.d.ctas`"); err != nil {
+		t.Fatal(err)
+	}
+	if err := tx.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	exec("CREATE TABLE IF NOT EXISTS `p.d.ctas` (product STRING, inventory INT64)")
+	exec("INSERT INTO `p.d.ctas` VALUES ('pears', 3)")
+	if got := changes("SELECT product, inventory, _CHANGE_TYPE, _CHANGE_IS_FOR_UPDATE FROM `p.d.ctas$changes` ORDER BY _CHANGE_TIMESTAMP"); got != "apples 10 INSERT false; pears 3 INSERT false" {
+		t.Errorf("after a rolled-back DROP TABLE and CREATE TABLE IF NOT EXISTS: %s", got)
+	}
+	exec("DROP TABLE `p.d.ctas`")
+	if _, err := db.QueryContext(ctx, "SELECT * FROM `p.d.ctas$changes`"); err == nil {
+		t.Error("the change table of a dropped table is still there")
+	}
+}
