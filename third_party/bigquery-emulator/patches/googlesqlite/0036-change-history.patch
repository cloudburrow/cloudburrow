+package internal
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	googlesql "github.com/goccy/go-googlesql"
+	"github.com/ncruces/go-sqlite3"
+
+	"github.com/goccy/googlesqlite/internal/sqlitex"
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// Change history (CloudBurrow patch, cloudburrow/cloudburrow#1418).
+//
+// BigQuery's APPENDS and CHANGES table functions read a table's history
+// of changes: each row inserted, deleted, or updated (a DELETE of the
+// old row and an UPDATE of the new), with the commit time of the change
+// (https://cloud.google.com/bigquery/docs/reference/standard-sql/time-series-functions).
+// SQLite keeps no history, so every table a CREATE TABLE makes (not a
+// temporary one, not a view, and named project.dataset.table: the
+// emulator's own metadata tables are named by one name) gets a change
+// table of its own: the same
+// columns (not its pseudo-columns) and _CHANGE_TYPE STRING,
+// _CHANGE_TIMESTAMP TIMESTAMP and _CHANGE_IS_FOR_UPDATE BOOL, filled by
+// SQLite triggers on the table. Every write reaches the table by SQLite
+// INSERT, UPDATE or DELETE (DML, MERGE, TRUNCATE TABLE, and the
+// emulator's tabledata.insertAll, loads, Storage Write API and query
+// destinations), so the triggers see them all. The change table's name
+// is the table's last path element with changeTableSuffix, which no
+// BigQuery table id has; a wildcard and INFORMATION_SCHEMA leave it out.
+// A CREATE TABLE ... AS SELECT's rows are recorded as INSERTs at its
+// creation; DROP TABLE drops it, and CREATE OR REPLACE TABLE starts it
+// again. The change time is the time of the first change of the
+// transaction, the same for every row it writes. Rows older than
+// changeRetention are dropped as new changes are recorded.
+
+// changeTableSuffix ends the last path element of a change table.
+const changeTableSuffix = "$changes"
+
+// changeRetention is how long a change is kept: BigQuery's longest time
+// travel window, seven days.
+const changeRetention = 7 * 24 * time.Hour
+
+// changeMicrosColumn is the change table's SQLite column of the change
+// time in microseconds since the epoch, indexed, which the catalog does
+// not name.
+const changeMicrosColumn = "googlesqlite_change_micros"
+
+// changeRowidColumn is the change table's SQLite column of the changed
+// row's rowid in the table.
+const changeRowidColumn = "googlesqlite_change_rowid"
+
+func isChangeTableName(name string) bool { return strings.HasSuffix(name, changeTableSuffix) }
+
+// changeTableSpec is the change table of spec, or nil when spec has none.
+func changeTableSpec(spec *TableSpec) *TableSpec {
+	if spec == nil || spec.IsTemp || spec.IsView || len(spec.NamePath) < 3 || isChangeTableName(spec.TableName()) ||
+		strings.HasPrefix(spec.NamePath[len(spec.NamePath)-1], "googlesqlite_") {
+		return nil
+	}
+	// CloudBurrow's own tables (a query's results, its scratch tables)
+	// keep none.
+	if strings.HasPrefix(spec.NamePath[len(spec.NamePath)-2], "_cloudburrow") {
+		return nil
+	}
+	for _, c := range spec.Columns {
+		// A table with a column of a change column's name (a query's
+		// results may name one so) has no change table.
+		if strings.HasPrefix(strings.ToUpper(c.Name), "_CHANGE_") {
+			return nil
+		}
+	}
+	path := append([]string{}, spec.NamePath...)
+	path[len(path)-1] += changeTableSuffix
+	cs := &TableSpec{NamePath: path, CreateMode: googlesql.ResolvedCreateStatementEnums_CreateModeCreateDefault,
+		CreatedAt: spec.CreatedAt, UpdatedAt: spec.UpdatedAt}
+	for _, c := range spec.Columns {
+		if isIngestionPseudoColumn(c.Name) {
+			continue
+		}
+		cs.Columns = append(cs.Columns, &ColumnSpec{Name: c.Name, Type: c.Type})
+	}
+	cs.Columns = append(cs.Columns,
+		&ColumnSpec{Name: "_CHANGE_TYPE", Type: &Type{Kind: int(googlesql.TypeKindTypeString)}},
+		&ColumnSpec{Name: "_CHANGE_TIMESTAMP", Type: &Type{Kind: int(googlesql.TypeKindTypeTimestamp)}},
+		&ColumnSpec{Name: "_CHANGE_IS_FOR_UPDATE", Type: &Type{Kind: int(googlesql.TypeKindTypeBool)}},
+	)
+	return cs
+}
+
+// encodedLiteral is v as the SQL literal of its stored form.
+func encodedLiteral(v value.Value) string {
+	e, err := value.EncodeValue(v)
+	if err != nil {
+		return "NULL"
+	}
+	switch x := e.(type) {
+	case bool:
+		if x {
+			return "1"
+		}
+		return "0"
+	case string:
+		return "'" + strings.ReplaceAll(x, "'", "''") + "'"
+	}
+	return fmt.Sprint(e)
+}
+
+// createChangeTable makes the change table of spec, just made, and its
+// triggers, and records the rows spec already has (CREATE TABLE ... AS
+// SELECT) as inserted.
+func createChangeTable(ctx context.Context, conn *Conn, catalog *Catalog, spec *TableSpec) error {
+	cs := changeTableSpec(spec)
+	if cs == nil {
+		return nil
+	}
+	base, change := spec.TableName(), cs.TableName()
+	if spec.CreateMode == googlesql.ResolvedCreateStatementEnums_CreateModeCreateIfNotExists {
+		if _, exists := catalog.tableMap[change]; exists {
+			return nil // the table was there, and so is its change table
+		}
+		// The table and its change table may be there without the change
+		// table in the catalog (CloudBurrow's front takes a table out of
+		// the catalog and adds it again to put the catalog in step after a
+		// failed script): it keeps its history.
+		var one int
+		if err := conn.QueryRowContext(ctx, "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", change).Scan(&one); err == nil {
+			return catalog.AddNewTableSpec(ctx, conn, cs)
+		}
+	}
+	n := len(cs.Columns) - 3
+	cols := make([]string, n)
+	defs := make([]string, 0, len(cs.Columns)+1)
+	for i, c := range cs.Columns {
+		if i < n {
+			cols[i] = "`" + c.Name + "`"
+		}
+		defs = append(defs, c.SQLiteSchema())
+	}
+	defs = append(defs, "`"+changeMicrosColumn+"` INTEGER", "`"+changeRowidColumn+"` INTEGER")
+	ins, del, upd := encodedLiteral(value.StringValue("INSERT")), encodedLiteral(value.StringValue("DELETE")),
+		encodedLiteral(value.StringValue("UPDATE"))
+	no, yes := encodedLiteral(value.BoolValue(false)), encodedLiteral(value.BoolValue(true))
+	all := strings.Join(cols, ",")
+	if n > 0 {
+		all += ","
+	}
+	target := fmt.Sprintf("INSERT INTO `%s` (%s`_CHANGE_TYPE`,`_CHANGE_TIMESTAMP`,`_CHANGE_IS_FOR_UPDATE`,`%s`,`%s`)",
+		change, all, changeMicrosColumn, changeRowidColumn)
+	row := func(prefix, typ, forUpdate string) string {
+		vals := make([]string, n)
+		for i, c := range cols {
+			vals[i] = prefix + c
+		}
+		v := strings.Join(vals, ",")
+		if n > 0 {
+			v += ","
+		}
+		return fmt.Sprintf("%s VALUES (%s%s, googlesqlite_change_timestamp(), %s, googlesqlite_change_micros(), %srowid)",
+			target, v, typ, forUpdate, prefix)
+	}
+	prune := fmt.Sprintf("DELETE FROM `%s` WHERE `%s` < googlesqlite_change_micros() - %d", change, changeMicrosColumn, changeRetention.Microseconds())
+	// An UPDATE of a row the transaction inserted (the emulator's
+	// rounding triggers, which round a NUMERIC as it is inserted) is part
+	// of the insert: the INSERT record takes the row as it is now. A
+	// BigQuery statement is a transaction of its own, so a row of any
+	// other UPDATE was there before it.
+	inserted := fmt.Sprintf("EXISTS (SELECT 1 FROM `%s` WHERE `%s` = OLD.rowid AND `%s` = googlesqlite_change_micros() AND `_CHANGE_TYPE` = %s)",
+		change, changeRowidColumn, changeMicrosColumn, ins)
+	sets := make([]string, n)
+	for i, c := range cols {
+		sets[i] = c + " = NEW." + c
+	}
+	fold := fmt.Sprintf("UPDATE `%s` SET %s WHERE `%s` = OLD.rowid AND `%s` = googlesqlite_change_micros() AND `_CHANGE_TYPE` = %s",
+		change, strings.Join(sets, ","), changeRowidColumn, changeMicrosColumn, ins)
+	trigger := func(name, event, when, body string) string {
+		if when != "" {
+			when = "WHEN " + when + " "
+		}
+		return fmt.Sprintf("CREATE TRIGGER `%s$%s` AFTER %s ON `%s` FOR EACH ROW %sBEGIN %s; %s; END",
+			change, name, event, base, when, prune, body)
+	}
+	stmts := []string{
+		fmt.Sprintf("DROP TABLE IF EXISTS `%s`", change),
+		fmt.Sprintf("DROP TRIGGER IF EXISTS `%s$insert`", change),
+		fmt.Sprintf("DROP TRIGGER IF EXISTS `%s$delete`", change),
+		fmt.Sprintf("DROP TRIGGER IF EXISTS `%s$update`", change),
+		fmt.Sprintf("DROP TRIGGER IF EXISTS `%s$fold`", change),
+		fmt.Sprintf("CREATE TABLE `%s` (%s)", change, strings.Join(defs, ",")),
+		fmt.Sprintf("CREATE INDEX `%s$time` ON `%s`(`%s`)", change, change, changeMicrosColumn),
+		fmt.Sprintf("CREATE INDEX `%s$row` ON `%s`(`%s`)", change, change, changeRowidColumn),
+		trigger("insert", "INSERT", "", row("NEW.", ins, no)),
+		trigger("delete", "DELETE", "", row("OLD.", del, no)),
+		trigger("update", "UPDATE", "NOT "+inserted, row("OLD.", del, yes)+"; "+row("NEW.", upd, no)),
+	}
+	if n > 0 {
+		stmts = append(stmts, trigger("fold", "UPDATE", inserted, fold))
+	}
+	stmts = append(stmts, fmt.Sprintf("%s SELECT %s%s, googlesqlite_change_timestamp(), %s, googlesqlite_change_micros(), rowid FROM `%s`",
+		target, all, ins, no, base))
+	for _, s := range stmts {
+		if _, err := conn.ExecContext(ctx, s); err != nil {
+			return fmt.Errorf("change history of %s: %w", base, err)
+		}
+	}
+	if _, exists := catalog.tableMap[change]; exists {
+		if err := catalog.DeleteTableSpec(ctx, conn, change); err != nil {
+			return err
+		}
+	}
+	return catalog.AddNewTableSpec(ctx, conn, cs)
+}
+
+// dropChangeTable drops the change table of the table named name, if it
+// has one.
+func dropChangeTable(ctx context.Context, conn *Conn, catalog *Catalog, name string) error {
+	if isChangeTableName(name) {
+		return nil
+	}
+	change := name + changeTableSuffix
+	if _, err := conn.ExecContext(ctx, fmt.Sprintf("DROP TABLE IF EXISTS `%s`", change)); err != nil {
+		return err
+	}
+	if _, exists := catalog.tableMap[change]; exists {
+		return catalog.DeleteTableSpec(ctx, conn, change)
+	}
+	return nil
+}
+
+// registerChangeTimeFunctions registers on conn the functions the change
+// triggers call: the time of the transaction's first change, encoded as
+// a TIMESTAMP and in microseconds, the same until the transaction ends.
+func registerChangeTimeFunctions(conn *sqlite3.Conn) error {
+	var mu sync.Mutex
+	var at time.Time
+	now := func() time.Time {
+		mu.Lock()
+		defer mu.Unlock()
+		if at.IsZero() {
+			at = time.Now().UTC().Truncate(time.Microsecond)
+		}
+		return at
+	}
+	reset := func() {
+		mu.Lock()
+		at = time.Time{}
+		mu.Unlock()
+	}
+	conn.CommitHook(func() bool { reset(); return true })
+	conn.RollbackHook(reset)
+	if err := sqlitex.RegisterFunc(conn, "googlesqlite_change_timestamp", func() (any, error) {
+		return value.EncodeValue(value.TimestampValue(now()))
+	}, sqlitex.FunctionFlags{}); err != nil {
+		return err
+	}
+	return sqlitex.RegisterFunc(conn, "googlesqlite_change_micros", func() (int64, error) {
+		return now().UnixMicro(), nil
+	}, sqlitex.FunctionFlags{})
+}
