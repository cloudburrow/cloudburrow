+
+// CloudBurrow patch (cloudburrow/cloudburrow#2134): a per-test timeout.
+// One spec case hung in the wasm analyzer and the package was killed by
+// go test's 10-minute timeout with no test named (the dump shows only
+// that a runCase was running). trackTest records each running case; the
+// watchdog fails the run, naming every case over perTestTimeout. A hang
+// inside the transpiled module that blocks a stop-the-world freezes the
+// watchdog too, so trackTest also appends "start"/"end" lines to the file
+// GOOGLESQLITE_TEST_TRACE names, unbuffered: whatever happens to the
+// process, the cases that started and never ended are in the file (the
+// Makefile's bigquery-patch-tests prints them).
+const defaultPerTestTimeout = 4 * time.Minute
+
+var (
+	runningTests sync.Map // test name -> start time
+	traceMu      sync.Mutex
+	traceFile    *os.File
+)
+
+func trackTest(t *testing.T) {
+	name := t.Name()
+	runningTests.Store(name, time.Now())
+	writeTrace("start", name)
+	t.Cleanup(func() {
+		runningTests.Delete(name)
+		writeTrace("end", name)
+	})
+}
+
+func writeTrace(event, name string) {
+	traceMu.Lock()
+	defer traceMu.Unlock()
+	if traceFile != nil {
+		_, _ = fmt.Fprintf(traceFile, "%s %s\n", event, name)
+	}
+}
+
+func startTestWatchdog() {
+	if path := os.Getenv("GOOGLESQLITE_TEST_TRACE"); path != "" {
+		f, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "GOOGLESQLITE_TEST_TRACE: %v\n", err)
+			os.Exit(2)
+		}
+		traceFile = f
+	}
+	limit := defaultPerTestTimeout
+	if v := os.Getenv("GOOGLESQLITE_PER_TEST_TIMEOUT"); v != "" {
+		d, err := time.ParseDuration(v)
+		if err != nil || d <= 0 {
+			fmt.Fprintf(os.Stderr, "GOOGLESQLITE_PER_TEST_TIMEOUT=%q: not a positive duration\n", v)
+			os.Exit(2)
+		}
+		limit = d
+	}
+	go func() {
+		for range time.Tick(limit / 8) {
+			var over []string
+			runningTests.Range(func(k, v any) bool {
+				if d := time.Since(v.(time.Time)); d > limit {
+					over = append(over, fmt.Sprintf("%s (running %s)", k, d.Round(time.Millisecond)))
+				}
+				return true
+			})
+			if len(over) == 0 {
+				continue
+			}
+			sort.Strings(over)
+			fmt.Fprintf(os.Stderr, "per-test timeout of %s exceeded by:\n", limit)
+			for _, s := range over {
+				fmt.Fprintf(os.Stderr, "\t%s\n", s)
+			}
+			debug.SetTraceback("all")
+			panic(fmt.Sprintf("per-test timeout: %d test(s) ran over %s, first %s", len(over), limit, over[0]))
+		}
+	}()
+}
