+
+// castToStringForm writes the values whose run-time form, their
+// ToString, is not the form BigQuery's CAST to STRING gives
+// (cloudburrow/cloudburrow#1202). ok is false for the others, which
+// CastValue writes. ToString itself is kept: it is also the wire form,
+// where a DATETIME is "2018-12-03T15:30:00".
+func castToStringForm(v value.Value) (s string, ok bool, err error) {
+	switch v := v.(type) {
+	case value.DatetimeValue:
+		// "2018-12-03 15:30:00", where ToString writes a T.
+		t := time.Time(v)
+		return t.Format("2006-01-02 15:04:05") + subSecondDigits(t.Nanosecond()), true, nil
+	case value.TimeValue:
+		// "15:30:00.500": sub-second digits in groups of three.
+		t := time.Time(v)
+		return t.Format("15:04:05") + subSecondDigits(t.Nanosecond()), true, nil
+	case value.FloatValue:
+		// "nan", "inf" and "-inf", where Go writes NaN, +Inf and -Inf.
+		f := float64(v)
+		switch {
+		case math.IsNaN(f):
+			return "nan", true, nil
+		case math.IsInf(f, 1):
+			return "inf", true, nil
+		case math.IsInf(f, -1):
+			return "-inf", true, nil
+		}
+		return "", false, nil
+	case value.BytesValue:
+		// The bytes read as UTF-8, where ToString writes base64.
+		if !utf8.Valid([]byte(v)) {
+			return "", false, fmt.Errorf("Invalid cast from BYTES to STRING: the bytes are not valid UTF-8")
+		}
+		return string(v), true, nil
+	case *value.IntervalValue:
+		// "1-2 3 4:5:6.500": sub-second digits in groups of three.
+		s := v.String()
+		i := strings.LastIndexByte(s, '.')
+		if i < 0 {
+			return s, true, nil
+		}
+		frac := s[i+1:]
+		for len(frac)%3 != 0 {
+			frac += "0"
+		}
+		return s[:i+1] + frac, true, nil
+	}
+	return "", false, nil
 }
+
+// hasStringForm is whether castToStringForm may write v.
+func hasStringForm(v value.Value) bool {
+	switch v.(type) {
+	case value.DatetimeValue, value.TimeValue, value.FloatValue, value.BytesValue, *value.IntervalValue:
+		return true
+	}
+	return false
+}
+
+// subSecondDigits is ".500", ".123456" or ".123456789" for ns, in
+// BigQuery's groups of three digits, and "" for none.
+func subSecondDigits(ns int) string {
+	switch {
+	case ns == 0:
+		return ""
+	case ns%1000000 == 0:
+		return fmt.Sprintf(".%03d", ns/1000000)
+	case ns%1000 == 0:
+		return fmt.Sprintf(".%06d", ns/1000)
+	}
+	return fmt.Sprintf(".%09d", ns)
+}
