+package googlesqlite_test
+
+import (
+	"database/sql"
+	"fmt"
+	"testing"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1202): a column cast to
+// STRING at run time gives the string the analyzer gives when it folds the
+// cast of the same literal, which is BigQuery's.
+func TestCastColumnToString(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=cast_to_string")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	for i, c := range []struct{ lit, want string }{
+		{"DATETIME '2018-12-03 15:30:00'", "2018-12-03 15:30:00"},
+		{"DATETIME '2018-12-03 15:30:00.5'", "2018-12-03 15:30:00.500"},
+		{"DATETIME '2018-12-03 15:30:00.123456'", "2018-12-03 15:30:00.123456"},
+		{"DATETIME '0001-01-01 00:00:00'", "0001-01-01 00:00:00"},
+		{"TIME '15:30:00'", "15:30:00"},
+		{"TIME '15:30:00.5'", "15:30:00.500"},
+		{"TIME '15:30:00.1234'", "15:30:00.123400"},
+		{"DATE '2018-12-03'", "2018-12-03"},
+		{"TRUE", "true"},
+		{"-5", "-5"},
+		{"1.0", "1"},
+		{"1e20", "1e+20"},
+		{"CAST('nan' AS FLOAT64)", "nan"},
+		{"CAST('inf' AS FLOAT64)", "inf"},
+		{"CAST('-inf' AS FLOAT64)", "-inf"},
+		{"NUMERIC '1.50'", "1.5"},
+		{"BIGNUMERIC '1.5000'", "1.5"},
+		{"b'abc'", "abc"},
+		{"b'\\xc3\\xa9'", "é"},
+		{"INTERVAL 5 DAY", "0-0 5 0:0:0"},
+		{"INTERVAL '1-2 3 4:5:6.5' YEAR TO SECOND", "1-2 3 4:5:6.500"},
+		{"INTERVAL '0:0:1.1234' HOUR TO SECOND", "0-0 0 0:0:1.123400"},
+		{"RANGE<DATE> '[2020-01-01, 2020-02-01)'", "[2020-01-01, 2020-02-01)"},
+	} {
+		var folded, col string
+		if err := db.QueryRow("SELECT CAST(" + c.lit + " AS STRING)").Scan(&folded); err != nil {
+			t.Errorf("%s folded: %v", c.lit, err)
+			continue
+		}
+		table := fmt.Sprintf("cast_to_string_%d", i)
+		if _, err := db.Exec("CREATE TABLE " + table + " AS SELECT " + c.lit + " AS c"); err != nil {
+			t.Errorf("%s: %v", c.lit, err)
+			continue
+		}
+		if err := db.QueryRow("SELECT CAST(c AS STRING) FROM " + table).Scan(&col); err != nil {
+			t.Errorf("%s column: %v", c.lit, err)
+			continue
+		}
+		if folded != c.want || col != c.want {
+			t.Errorf("CAST(%s AS STRING): folded %q, column %q, want %q", c.lit, folded, col, c.want)
+		}
+	}
+	// BYTES that are not UTF-8: CAST fails, SAFE_CAST is NULL.
+	if _, err := db.Exec("CREATE TABLE cast_to_string_bad AS SELECT b'\\xff' AS c"); err != nil {
+		t.Fatal(err)
+	}
+	var s sql.NullString
+	if err := db.QueryRow("SELECT CAST(c AS STRING) FROM cast_to_string_bad").Scan(&s); err == nil {
+		t.Errorf("CAST(b'\\xff' AS STRING) = %q, want an error", s.String)
+	}
+	if err := db.QueryRow("SELECT SAFE_CAST(c AS STRING) FROM cast_to_string_bad").Scan(&s); err != nil || s.Valid {
+		t.Errorf("SAFE_CAST(b'\\xff' AS STRING) = %v, %v; want NULL", s, err)
+	}
+}
