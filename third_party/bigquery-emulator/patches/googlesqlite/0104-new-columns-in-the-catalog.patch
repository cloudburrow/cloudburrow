+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestNewColumnSelected is CloudBurrow's regression test of its patch 0104
+// (cloudburrow/cloudburrow#1827): a column CREATE OR REPLACE TABLE or ALTER
+// TABLE ADD COLUMN adds is there for the next statement to select. The
+// catalog kept the replaced table's analyzer handle, with its old columns,
+// unless a change table's rebuild happened to follow (a table of a
+// project, dataset and name), and ALTER TABLE was a no-op.
+func TestNewColumnSelected(t *testing.T) {
+	ctx := context.Background()
+	open := func(t *testing.T) (*sql.DB, func(string), func(string) string, func(string) error) {
+		t.Helper()
+		db, err := sql.Open("googlesqlite", ":memory:")
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { db.Close() })
+		db.SetMaxOpenConns(1)
+		exec := func(q string) {
+			t.Helper()
+			if _, err := db.ExecContext(ctx, q); err != nil {
+				t.Fatalf("%s: %v", q, err)
+			}
+		}
+		scalar := func(q string) string {
+			t.Helper()
+			var s sql.NullString
+			if err := db.QueryRowContext(ctx, q).Scan(&s); err != nil {
+				t.Fatalf("%s: %v", q, err)
+			}
+			if !s.Valid {
+				return "NULL"
+			}
+			return s.String
+		}
+		fails := func(q string) error {
+			_, err := db.ExecContext(ctx, q)
+			return err
+		}
+		return db, exec, scalar, fails
+	}
+
+	// Each name form: a table with no project (no change table), one in
+	// a CloudBurrow dataset (none either) and one of a project, dataset
+	// and name (with a change table).
+	for _, table := range []string{"d.t", "`p._cloudburrow_d.t`", "`p.d.t`"} {
+		t.Run("replace "+table, func(t *testing.T) {
+			_, exec, scalar, fails := open(t)
+			exec("CREATE TABLE " + table + " (a INT64)")
+			exec("INSERT INTO " + table + " (a) VALUES (1)")
+			if got := scalar("SELECT CAST(a AS STRING) FROM " + table); got != "1" {
+				t.Errorf("a = %s, want 1", got)
+			}
+			exec("CREATE OR REPLACE TABLE " + table + " (a INT64, b STRING)")
+			exec("INSERT INTO " + table + " (a, b) VALUES (2, 'x')")
+			if got := scalar("SELECT CONCAT(CAST(a AS STRING), b) FROM " + table); got != "2x" {
+				t.Errorf("a, b = %s, want 2x", got)
+			}
+			exec("CREATE OR REPLACE TABLE " + table + " AS SELECT 'y' AS b, 3 AS c")
+			if got := scalar("SELECT CONCAT(b, CAST(c AS STRING)) FROM " + table); got != "y3" {
+				t.Errorf("b, c = %s, want y3", got)
+			}
+			if err := fails("SELECT a FROM " + table); err == nil || !strings.Contains(err.Error(), "Unrecognized name: a") {
+				t.Errorf("SELECT a of the replaced table: %v, want Unrecognized name: a", err)
+			}
+			// IF NOT EXISTS of the table there leaves it, and its columns,
+			// as they are.
+			exec("CREATE TABLE IF NOT EXISTS " + table + " (z INT64)")
+			if got := scalar("SELECT CONCAT(b, CAST(c AS STRING)) FROM " + table); got != "y3" {
+				t.Errorf("after CREATE TABLE IF NOT EXISTS: b, c = %s, want y3", got)
+			}
+		})
+		t.Run("add column "+table, func(t *testing.T) {
+			_, exec, scalar, fails := open(t)
+			exec("CREATE TABLE " + table + " (a INT64)")
+			exec("INSERT INTO " + table + " (a) VALUES (1)")
+			exec("ALTER TABLE " + table + " ADD COLUMN b STRING")
+			if got := scalar("SELECT IFNULL(b, '-') FROM " + table); got != "-" {
+				t.Errorf("b of the row there = %s, want NULL", got)
+			}
+			exec("INSERT INTO " + table + " (a, b) VALUES (2, 'x')")
+			if got := scalar("SELECT STRING_AGG(CONCAT(CAST(a AS STRING), IFNULL(b, '-')), ',' ORDER BY a) FROM " + table); got != "1-,2x" {
+				t.Errorf("rows = %s, want 1-,2x", got)
+			}
+			exec("ALTER TABLE " + table + " ADD COLUMN IF NOT EXISTS b STRING, ADD COLUMN c ARRAY<INT64>, ADD COLUMN d STRUCT<x INT64, y STRING>")
+			exec("UPDATE " + table + " SET c = [1, 2], d = STRUCT(5, 'q') WHERE a = 2")
+			if got := scalar("SELECT CONCAT(CAST(ARRAY_LENGTH(c) AS STRING), d.y, CAST(d.x AS STRING)) FROM " + table + " WHERE a = 2"); got != "2q5" {
+				t.Errorf("c, d = %s, want 2q5", got)
+			}
+			if err := fails("ALTER TABLE " + table + " ADD COLUMN b INT64"); err == nil {
+				t.Errorf("ADD COLUMN b again: no error")
+			}
+			if got := scalar("SELECT STRING_AGG(column_name, ',' ORDER BY ordinal_position) FROM " + infoSchema(table) + " WHERE table_name = 't'"); got != "a,b,c,d" {
+				t.Errorf("INFORMATION_SCHEMA.COLUMNS = %s, want a,b,c,d", got)
+			}
+		})
+	}
+
+	t.Run("alter if exists of no table", func(t *testing.T) {
+		_, exec, _, _ := open(t)
+		exec("CREATE TABLE `p.d.other` (a INT64)")
+		exec("ALTER TABLE IF EXISTS `p.d.missing` ADD COLUMN b STRING")
+	})
+
+	t.Run("temp table replaced in one script", func(t *testing.T) {
+		_, _, scalar, _ := open(t)
+		q := "CREATE TEMP TABLE tt AS SELECT 1 AS a; " +
+			"CREATE OR REPLACE TEMP TABLE tt AS SELECT 2 AS a, 'w' AS b; " +
+			"SELECT CONCAT(CAST(a AS STRING), b) FROM tt"
+		if got := scalar(q); got != "2w" {
+			t.Errorf("got %s, want 2w", got)
+		}
+	})
+}
+
+// infoSchema is the INFORMATION_SCHEMA.COLUMNS of table's dataset.
+func infoSchema(table string) string {
+	path := strings.Split(strings.Trim(table, "`"), ".")
+	return "`" + strings.Join(path[:len(path)-1], ".") + ".INFORMATION_SCHEMA.COLUMNS`"
+}
