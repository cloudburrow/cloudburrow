+package internal
+
+import (
+	"context"
+	"database/sql/driver"
+	"fmt"
+	"strings"
+
+	googlesql "github.com/goccy/go-googlesql"
+
+	"github.com/goccy/googlesqlite/internal/clock"
+)
+
+// ALTER TABLE ... ADD COLUMN. CloudBurrow patch
+// (cloudburrow/cloudburrow#1827).
+//
+// The analyzer resolved ALTER TABLE and the driver answered it as a no-op,
+// so a column it added was "Unrecognized name" in the next statement. ADD
+// COLUMN [IF NOT EXISTS] now adds the column to the SQLite table and to the
+// table's spec, which rebuilds the catalog with the new column
+// (addTableSpec). The statement's other actions stay no-ops, as before.
+// The table's change history (change_history.go) goes on recording the
+// columns it had; CloudBurrow's front carries out ALTER TABLE itself and
+// makes the table again with its history.
+
+type alterAddColumn struct {
+	column      *ColumnSpec
+	ifNotExists bool
+}
+
+// AlterTableStmtAction is an ALTER TABLE with ADD COLUMN actions.
+type AlterTableStmtAction struct {
+	namePath []string
+	ifExists bool
+	adds     []alterAddColumn
+	catalog  *Catalog
+}
+
+func (a *Analyzer) newAlterTableStmtAction(ctx context.Context, node *googlesql.ResolvedAlterTableStmt) (StmtAction, error) {
+	actions, err := node.AlterActionList()
+	if err != nil {
+		return nil, err
+	}
+	var adds []alterAddColumn
+	for _, action := range actions {
+		add, ok := action.(*googlesql.ResolvedAddColumnAction)
+		if !ok {
+			continue
+		}
+		def, err := add.ColumnDefinition()
+		if err != nil || def == nil {
+			return nil, fmt.Errorf("ALTER TABLE ADD COLUMN: no column definition: %v", err)
+		}
+		cols := newColumnsFromDef(ctx, []*googlesql.ResolvedColumnDefinition{def}, "")
+		if len(cols) != 1 {
+			return nil, fmt.Errorf("ALTER TABLE ADD COLUMN: %d columns from one definition", len(cols))
+		}
+		adds = append(adds, alterAddColumn{column: cols[0], ifNotExists: m1(add.IsIfNotExists())})
+	}
+	if len(adds) == 0 {
+		return &NoopStmtAction{}, nil
+	}
+	return &AlterTableStmtAction{
+		namePath: a.namePath.mergePath(m1(node.NamePath())),
+		ifExists: m1(node.IsIfExists()),
+		adds:     adds,
+		catalog:  a.catalog,
+	}, nil
+}
+
+func (a *AlterTableStmtAction) exec(ctx context.Context, conn *Conn) error {
+	name := formatPath(a.namePath)
+	a.catalog.mu.Lock()
+	spec, ok := a.catalog.tableMap[name]
+	a.catalog.mu.Unlock()
+	if !ok || spec.IsView {
+		if a.ifExists {
+			return nil
+		}
+		return fmt.Errorf("Table not found: %s", strings.Join(a.namePath, "."))
+	}
+	columns := append([]*ColumnSpec{}, spec.Columns...)
+	for _, add := range a.adds {
+		exists := false
+		for _, c := range columns {
+			if strings.EqualFold(c.Name, add.column.Name) {
+				exists = true
+				break
+			}
+		}
+		if exists {
+			if add.ifNotExists {
+				continue
+			}
+			return fmt.Errorf("Column already exists: %s", add.column.Name)
+		}
+		if _, err := conn.ExecContext(ctx, fmt.Sprintf("ALTER TABLE `%s` ADD COLUMN %s", spec.TableName(), add.column.SQLiteSchema())); err != nil {
+			return fmt.Errorf("ALTER TABLE %s ADD COLUMN %s: %w", name, add.column.Name, err)
+		}
+		columns = append(columns, add.column)
+	}
+	if len(columns) == len(spec.Columns) {
+		return nil
+	}
+	next := *spec
+	next.Columns = columns
+	next.CreateMode = googlesql.ResolvedCreateStatementEnums_CreateModeCreateDefault
+	next.UpdatedAt = clock.Now()
+	return a.catalog.AddNewTableSpec(ctx, conn, &next)
+}
+
+func (a *AlterTableStmtAction) Prepare(ctx context.Context, conn *Conn) (driver.Stmt, error) {
+	return nil, nil
+}
+
+func (a *AlterTableStmtAction) ExecContext(ctx context.Context, conn *Conn) (driver.Result, error) {
+	if err := a.exec(ctx, conn); err != nil {
+		return nil, err
+	}
+	return &Result{conn: conn}, nil
+}
+
+func (a *AlterTableStmtAction) QueryContext(ctx context.Context, conn *Conn) (*Rows, error) {
+	if err := a.exec(ctx, conn); err != nil {
+		return nil, err
+	}
+	return &Rows{conn: conn}, nil
+}
+
+func (a *AlterTableStmtAction) Args() []any { return nil }
+
+func (a *AlterTableStmtAction) Cleanup(ctx context.Context, conn *Conn) error { return nil }
