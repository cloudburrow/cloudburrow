+// sameTableShape reports whether the analyzer's handle of a's table is
+// b's too: the same columns (names, types, collations, defaults), primary
+// key and options. CloudBurrow patch (cloudburrow/cloudburrow#1827).
+func sameTableShape(a, b *TableSpec) bool {
+	type shape struct {
+		IsView     bool
+		Columns    []*ColumnSpec
+		PrimaryKey []string
+		Options    []*tableOptionSpec
+	}
+	x, errA := json.Marshal(shape{a.IsView, a.Columns, a.PrimaryKey, a.Options})
+	y, errB := json.Marshal(shape{b.IsView, b.Columns, b.PrimaryKey, b.Options})
+	return errA == nil && errB == nil && bytes.Equal(x, y)
+}
