+
+// CloudBurrow patch (cloudburrow/cloudburrow#1437): INTERVAL arithmetic.
+// googlesqlite v0.3.1 refused INTERVAL + INTERVAL, INTERVAL - INTERVAL,
+// INTERVAL * INT64, INTERVAL / INT64 and -INTERVAL ("unsupported add
+// operator for interval value"), and added an INTERVAL to a DATE, DATETIME
+// or TIMESTAMP by letting time.Date normalise every field, so that
+// DATE '2021-01-31' + INTERVAL 1 MONTH was 2021-03-03 where BigQuery has
+// 2021-02-28. As in GoogleSQL (googlesql/public/interval_value.cc), an
+// interval is three independent parts, months, days and nanoseconds, each
+// with its own sign and range; arithmetic works on each part, and a result
+// out of range is an error.
+
+const (
+	// IntervalMaxMonths, IntervalMaxDays and IntervalMaxNanos are
+	// GoogleSQL's IntervalValue::kMaxMonths, kMaxDays and kMaxNanos:
+	// 10,000 years of months, days (366 a year) and nanoseconds.
+	IntervalMaxMonths = 10000 * 12
+	IntervalMaxDays   = 10000 * 366
+	nanosInSecond     = int64(time.Second)
+	nanosInMinute     = int64(time.Minute)
+	nanosInHour       = int64(time.Hour)
+	nanosInDay        = 24 * nanosInHour
+)
+
+var (
+	intervalMaxNanos = new(big.Int).Mul(big.NewInt(IntervalMaxDays), big.NewInt(nanosInDay))
+	intervalMinNanos = new(big.Int).Neg(intervalMaxNanos)
+)
+
+// IntervalParts is an interval as GoogleSQL holds it: months, days and
+// nanoseconds, each signed independently.
+type IntervalParts struct {
+	Months *big.Int
+	Days   *big.Int
+	Nanos  *big.Int
+}
+
+// Parts returns the interval's months, days and nanoseconds.
+func (iv *IntervalValue) Parts() IntervalParts {
+	months := int64(iv.Years)*12 + int64(iv.Months)
+	nanos := big.NewInt(int64(iv.Hours)*nanosInHour + int64(iv.Minutes)*nanosInMinute + int64(iv.Seconds)*nanosInSecond + int64(iv.SubSecondNanos))
+	return IntervalParts{Months: big.NewInt(months), Days: big.NewInt(int64(iv.Days)), Nanos: nanos}
+}
+
+func intervalFieldError(field string, v *big.Int, max *big.Int) error {
+	return fmt.Errorf("Interval field %s '%s' is out of range %s to %s", field, v, new(big.Int).Neg(max), max)
+}
+
+// NewIntervalFromParts returns the canonical interval of months, days and
+// nanoseconds, or GoogleSQL's error for a part out of range.
+func NewIntervalFromParts(p IntervalParts) (*IntervalValue, error) {
+	maxMonths, maxDays := big.NewInt(IntervalMaxMonths), big.NewInt(IntervalMaxDays)
+	if p.Months.CmpAbs(maxMonths) > 0 {
+		return nil, intervalFieldError("months", p.Months, maxMonths)
+	}
+	if p.Days.CmpAbs(maxDays) > 0 {
+		return nil, intervalFieldError("days", p.Days, maxDays)
+	}
+	if p.Nanos.Cmp(intervalMaxNanos) > 0 || p.Nanos.Cmp(intervalMinNanos) < 0 {
+		return nil, intervalFieldError("nanos", p.Nanos, intervalMaxNanos)
+	}
+	months := p.Months.Int64()
+	out := &intervalvalue.IntervalValue{
+		Years:  int32(months / 12),
+		Months: int32(months % 12),
+		Days:   int32(p.Days.Int64()),
+	}
+	// Hours can pass the int64 nanosecond range (10,000 years is about
+	// 3.2e20 ns), so the hours come off as a big quotient.
+	hours, rem := new(big.Int).QuoRem(p.Nanos, big.NewInt(nanosInHour), new(big.Int))
+	r := rem.Int64()
+	out.Hours = int32(hours.Int64())
+	out.Minutes = int32(r / nanosInMinute)
+	r %= nanosInMinute
+	out.Seconds = int32(r / nanosInSecond)
+	out.SubSecondNanos = int32(r % nanosInSecond)
+	return &IntervalValue{IntervalValue: out}, nil
+}
+
+func (iv *IntervalValue) intervalOperand(v Value, op string) (*IntervalValue, error) {
+	other, ok := v.(*IntervalValue)
+	if !ok || other == nil || other.IntervalValue == nil {
+		return nil, fmt.Errorf("unsupported %s operator for interval value and %T", op, v)
+	}
+	return other, nil
+}
+
+func (iv *IntervalValue) Add(v Value) (Value, error) {
+	switch v.(type) {
+	case DateValue, DatetimeValue, TimestampValue:
+		// INTERVAL + DATE is DATE + INTERVAL.
+		return v.Add(iv)
+	}
+	other, err := iv.intervalOperand(v, "add")
+	if err != nil {
+		return nil, err
+	}
+	a, b := iv.Parts(), other.Parts()
+	return NewIntervalFromParts(IntervalParts{
+		Months: a.Months.Add(a.Months, b.Months),
+		Days:   a.Days.Add(a.Days, b.Days),
+		Nanos:  a.Nanos.Add(a.Nanos, b.Nanos),
+	})
+}
+
+func (iv *IntervalValue) Sub(v Value) (Value, error) {
+	other, err := iv.intervalOperand(v, "sub")
+	if err != nil {
+		return nil, err
+	}
+	a, b := iv.Parts(), other.Parts()
+	return NewIntervalFromParts(IntervalParts{
+		Months: a.Months.Sub(a.Months, b.Months),
+		Days:   a.Days.Sub(a.Days, b.Days),
+		Nanos:  a.Nanos.Sub(a.Nanos, b.Nanos),
+	})
+}
+
+// Negate is -INTERVAL: each part's sign flips.
+func (iv *IntervalValue) Negate() (*IntervalValue, error) {
+	a := iv.Parts()
+	return NewIntervalFromParts(IntervalParts{
+		Months: a.Months.Neg(a.Months),
+		Days:   a.Days.Neg(a.Days),
+		Nanos:  a.Nanos.Neg(a.Nanos),
+	})
+}
+
+func (iv *IntervalValue) Mul(v Value) (Value, error) {
+	n, ok := v.(IntValue)
+	if !ok {
+		return nil, fmt.Errorf("unsupported mul operator for interval value and %T", v)
+	}
+	a := iv.Parts()
+	f := big.NewInt(int64(n))
+	out, err := NewIntervalFromParts(IntervalParts{
+		Months: a.Months.Mul(a.Months, f),
+		Days:   a.Days.Mul(a.Days, f),
+		Nanos:  a.Nanos.Mul(a.Nanos, f),
+	})
+	if err != nil {
+		return nil, fmt.Errorf("Interval overflow during multiplication")
+	}
+	return out, nil
+}
+
+// Div is INTERVAL / INT64, as GoogleSQL's IntervalValue::Divide: the
+// remainder of the months carries into the days at 30 days a month, the
+// remainder of the days into the nanoseconds at 24 hours a day, and the
+// result is truncated to microseconds, BigQuery's precision.
+func (iv *IntervalValue) Div(v Value) (Value, error) {
+	n, ok := v.(IntValue)
+	if !ok {
+		return nil, fmt.Errorf("unsupported div operator for interval value and %T", v)
+	}
+	if n == 0 {
+		return nil, fmt.Errorf("Interval division by zero")
+	}
+	a := iv.Parts()
+	d := big.NewInt(int64(n))
+	months, monthsRem := new(big.Int).QuoRem(a.Months, d, new(big.Int))
+	days := a.Days.Add(a.Days, monthsRem.Mul(monthsRem, big.NewInt(intervalDaysInMonth)))
+	days, daysRem := new(big.Int).QuoRem(days, d, new(big.Int))
+	nanos := a.Nanos.Add(a.Nanos, daysRem.Mul(daysRem, big.NewInt(nanosInDay)))
+	nanos.Quo(nanos, d)
+	micro := big.NewInt(1000)
+	nanos.Quo(nanos, micro).Mul(nanos, micro)
+	out, err := NewIntervalFromParts(IntervalParts{Months: months, Days: days, Nanos: nanos})
+	if err != nil {
+		return nil, fmt.Errorf("Interval overflow during division")
+	}
+	return out, nil
+}
+
+// minCivil and maxCivil bound BigQuery's DATETIME and TIMESTAMP:
+// 0001-01-01 00:00:00 to 9999-12-31 23:59:59.999999.
+var (
+	minCivil = time.Date(1, 1, 1, 0, 0, 0, 0, time.UTC)
+	maxCivil = time.Date(10000, 1, 1, 0, 0, 0, 0, time.UTC)
+)
+
+// AddIntervalToTime adds sign times the interval to t as GoogleSQL does:
+// the months first, a day past the end of the month being the month's last
+// day (DATE '2021-01-31' + INTERVAL 1 MONTH is 2021-02-28), then the days,
+// then the nanoseconds. kind names the type for the out-of-range error.
+func AddIntervalToTime(t time.Time, iv *IntervalValue, sign int64, kind string) (time.Time, error) {
+	p := iv.Parts()
+	months := p.Months.Int64() * sign
+	days := p.Days.Int64() * sign
+	nanos := new(big.Int).Mul(p.Nanos, big.NewInt(sign))
+	loc := t.Location()
+	y, m, d := t.Date()
+	total := int64(y)*12 + int64(m-1) + months
+	ny, nm := total/12, total%12
+	if nm < 0 {
+		nm += 12
+		ny--
+	}
+	if ny < 1 || ny > 9999 {
+		return time.Time{}, fmt.Errorf("%s overflow: %s + INTERVAL %s", kind, t.Format("2006-01-02 15:04:05.999999"), iv.String())
+	}
+	if last := daysIn(int(ny), time.Month(nm+1)); d > last {
+		d = last
+	}
+	hh, mm, ss := t.Clock()
+	out := time.Date(int(ny), time.Month(nm+1), d, hh, mm, ss, t.Nanosecond(), loc)
+	out = out.AddDate(0, 0, int(days))
+	sec, ns := new(big.Int).QuoRem(nanos, big.NewInt(nanosInSecond), new(big.Int))
+	out = time.Unix(out.Unix()+sec.Int64(), int64(out.Nanosecond())+ns.Int64()).In(loc)
+	// A DATETIME is bounded on its wall clock, a TIMESTAMP in UTC.
+	bound := out.UTC()
+	if kind != "TIMESTAMP" {
+		bound = time.Date(out.Year(), out.Month(), out.Day(), out.Hour(), out.Minute(), out.Second(), out.Nanosecond(), time.UTC)
+	}
+	if bound.Before(minCivil) || !bound.Before(maxCivil) {
+		return time.Time{}, fmt.Errorf("%s overflow: %s + INTERVAL %s", kind, t.Format("2006-01-02 15:04:05.999999"), iv.String())
+	}
+	return out, nil
+}
+
+func daysIn(year int, month time.Month) int {
+	return time.Date(year, month+1, 0, 0, 0, 0, 0, time.UTC).Day()
+}
+
+// civilDay is the day number of t's calendar date.
+func civilDay(t time.Time) int64 {
+	y, m, d := t.Date()
+	return time.Date(y, m, d, 0, 0, 0, 0, time.UTC).Unix() / 86400
+}
+
+// IntervalBetweenDates is DATE - DATE: the days between them.
+func IntervalBetweenDates(a, b time.Time) (*IntervalValue, error) {
+	return NewIntervalFromParts(IntervalParts{Months: new(big.Int), Days: big.NewInt(civilDay(a) - civilDay(b)), Nanos: new(big.Int)})
+}
+
+// IntervalBetweenDatetimes is DATETIME - DATETIME: as BigQuery documents
+// it, the time between the two in the time part alone
+// (DATETIME "2021-06-01 12:34:56.789" - DATETIME "2021-05-31 00:00:00" is
+// 0-0 0 36:34:56.789), read on the wall clock.
+func IntervalBetweenDatetimes(a, b time.Time) (*IntervalValue, error) {
+	wall := func(t time.Time) time.Time {
+		return time.Date(t.Year(), t.Month(), t.Day(), t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), time.UTC)
+	}
+	return IntervalBetweenTimestamps(wall(a), wall(b))
+}
+
+// IntervalBetweenTimestamps is TIMESTAMP - TIMESTAMP: the time between
+// them, in the time part alone (36:34:56.789, not 1 12:34:56.789).
+func IntervalBetweenTimestamps(a, b time.Time) (*IntervalValue, error) {
+	nanos := new(big.Int).Mul(big.NewInt(a.Unix()-b.Unix()), big.NewInt(nanosInSecond))
+	nanos.Add(nanos, big.NewInt(int64(a.Nanosecond()-b.Nanosecond())))
+	return NewIntervalFromParts(IntervalParts{Months: new(big.Int), Days: new(big.Int), Nanos: nanos})
+}
