diff --git a/internal/functions/date/extract_interval.go b/internal/functions/date/extract_interval.go
--- /dev/null
+++ b/internal/functions/date/extract_interval.go
@@ -0,0 +1,38 @@
+package date
+
+import (
+	"fmt"
+	"math/big"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// extractInterval is EXTRACT(part FROM interval), as GoogleSQL's
+// IntervalValue::Extract: YEAR and MONTH of the months, DAY the days, and
+// HOUR through MICROSECOND of the time part, each keeping the part's sign.
+// CloudBurrow patch (cloudburrow/cloudburrow#1437).
+func extractInterval(iv *value.IntervalValue, part string) (value.Value, error) {
+	p := iv.Parts()
+	months := p.Months.Int64()
+	nanos := p.Nanos
+	div := func(unit int64) int64 { return new(big.Int).Quo(nanos, big.NewInt(unit)).Int64() }
+	switch part {
+	case "YEAR":
+		return value.IntValue(months / 12), nil
+	case "MONTH":
+		return value.IntValue(months % 12), nil
+	case "DAY":
+		return value.IntValue(p.Days.Int64()), nil
+	case "HOUR":
+		return value.IntValue(div(3600_000_000_000)), nil
+	case "MINUTE":
+		return value.IntValue(div(60_000_000_000) % 60), nil
+	case "SECOND":
+		return value.IntValue(div(1_000_000_000) % 60), nil
+	case "MILLISECOND":
+		return value.IntValue(div(1_000_000) % 1000), nil
+	case "MICROSECOND":
+		return value.IntValue(div(1000) % 1_000_000), nil
+	}
+	return nil, fmt.Errorf("Unsupported date part %s in EXTRACT FROM INTERVAL", part)
+}
diff --git a/internal/functions/interval/justify.go b/internal/functions/interval/justify.go
--- /dev/null
+++ b/internal/functions/interval/justify.go
@@ -0,0 +1,74 @@
+package interval
+
+import (
+	"math/big"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1437): JUSTIFY_DAYS,
+// JUSTIFY_HOURS and JUSTIFY_INTERVAL as GoogleSQL has them
+// (googlesql/public/functions/date_time_util.cc): v0.3.1 changed the
+// argument in place, carried minutes into hours by the hours (v.Hours +=
+// v.Hours / 60), and left a part's sign at odds with the next part's, where
+// GoogleSQL makes them agree (JUSTIFY_DAYS(INTERVAL '1 -1' MONTH TO DAY) is
+// 0-0 29). Each returns a new value, and a result out of range is an
+// error.
+
+const (
+	daysInMonth = 30
+	nanosInDay  = 24 * 3600 * 1_000_000_000
+)
+
+// carry moves whole units of lo into hi (unit lo's to one hi), then makes
+// lo's sign agree with hi's.
+func carry(hi, lo *big.Int, unit int64) {
+	u := big.NewInt(unit)
+	q, r := new(big.Int).QuoRem(lo, u, new(big.Int))
+	hi.Add(hi, q)
+	lo.Set(r)
+	switch {
+	case hi.Sign() > 0 && lo.Sign() < 0:
+		hi.Sub(hi, big.NewInt(1))
+		lo.Add(lo, u)
+	case hi.Sign() < 0 && lo.Sign() > 0:
+		hi.Add(hi, big.NewInt(1))
+		lo.Sub(lo, u)
+	}
+}
+
+func JUSTIFY_DAYS(v *value.IntervalValue) (value.Value, error) {
+	p := v.Parts()
+	carry(p.Months, p.Days, daysInMonth)
+	return value.NewIntervalFromParts(p)
+}
+
+func JUSTIFY_HOURS(v *value.IntervalValue) (value.Value, error) {
+	p := v.Parts()
+	carry(p.Days, p.Nanos, nanosInDay)
+	return value.NewIntervalFromParts(p)
+}
+
+func JUSTIFY_INTERVAL(v *value.IntervalValue) (value.Value, error) {
+	p := v.Parts()
+	// Whole days of the time part into the days, and whole months of the
+	// days into the months; then every part takes the sign of the whole.
+	q, r := new(big.Int).QuoRem(p.Nanos, big.NewInt(nanosInDay), new(big.Int))
+	p.Days.Add(p.Days, q)
+	p.Nanos.Set(r)
+	q, r = new(big.Int).QuoRem(p.Days, big.NewInt(daysInMonth), new(big.Int))
+	p.Months.Add(p.Months, q)
+	p.Days.Set(r)
+	total := new(big.Int).Mul(p.Months, big.NewInt(daysInMonth))
+	total.Add(total, p.Days).Mul(total, big.NewInt(nanosInDay)).Add(total, p.Nanos)
+	sign := total.Sign()
+	if sign != 0 && p.Nanos.Sign() == -sign {
+		p.Days.Sub(p.Days, big.NewInt(int64(sign)))
+		p.Nanos.Add(p.Nanos, big.NewInt(int64(sign)*nanosInDay))
+	}
+	if sign != 0 && p.Days.Sign() == -sign {
+		p.Months.Sub(p.Months, big.NewInt(int64(sign)))
+		p.Days.Add(p.Days, big.NewInt(int64(sign)*daysInMonth))
+	}
+	return value.NewIntervalFromParts(p)
+}
