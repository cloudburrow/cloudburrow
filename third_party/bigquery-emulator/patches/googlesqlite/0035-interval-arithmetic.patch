diff --git a/interval_arithmetic_test.go b/interval_arithmetic_test.go
--- /dev/null
+++ b/interval_arithmetic_test.go
@@ -0,0 +1,95 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+)
+
+// TestIntervalArithmetic is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1437): INTERVAL + INTERVAL failed "unsupported
+// add operator for interval value", as did -, * INT64, / INT64 and unary
+// minus; DATE '2021-01-31' + INTERVAL 1 MONTH was 2021-03-03 where
+// BigQuery has 2021-02-28; JUSTIFY_HOURS carried minutes by the hours, and
+// EXTRACT read the parts as given rather than canonical. The expected
+// values are BigQuery's documented results.
+func TestIntervalArithmetic(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=interval_arithmetic")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, tc := range []struct{ expr, want string }{
+		{"INTERVAL 1 DAY + INTERVAL 2 HOUR", "0-0 1 2:0:0"},
+		{"INTERVAL '1-2 3 4:5:6' YEAR TO SECOND + INTERVAL '0-11 30 20:0:0' YEAR TO SECOND", "2-1 33 24:5:6"},
+		{"INTERVAL 1 DAY - INTERVAL 2 HOUR", "0-0 1 -2:0:0"},
+		{"INTERVAL 1 YEAR - INTERVAL 13 MONTH", "-0-1 0 0:0:0"},
+		{"INTERVAL 1 DAY * 3", "0-0 3 0:0:0"},
+		{"3 * INTERVAL '1-1 1 1:1:1.5' YEAR TO SECOND", "3-3 3 3:3:4.500"},
+		{"INTERVAL 10 MONTH / 3", "0-3 10 0:0:0"},
+		{"INTERVAL 1 DAY / 7", "0-0 0 3:25:42.857142"},
+		{"INTERVAL '-1-2 3 -4:0:0' YEAR TO SECOND / -2", "0-7 -1 -10:0:0"},
+		{"-(INTERVAL '1-2 -3 4:5:6' YEAR TO SECOND)", "-1-2 3 -4:5:6"},
+		{"DATE '2021-01-31' + INTERVAL 1 MONTH", "2021-02-28 00:00:00"},
+		{"INTERVAL 1 MONTH + DATE '2020-01-31'", "2020-02-29 00:00:00"},
+		{"DATE '2021-03-31' - INTERVAL 1 MONTH", "2021-02-28 00:00:00"},
+		{"DATETIME '2021-01-31 23:00:00' + INTERVAL '0-1 1 2:0:0' YEAR TO SECOND", "2021-03-02 01:00:00"},
+		{"TIMESTAMP '2021-01-31 00:00:00+00' + INTERVAL 1 MONTH", "2021-02-28 00:00:00+00"},
+		{"TIMESTAMP '2021-05-02 00:01:02.345+00' + INTERVAL 25 HOUR", "2021-05-03 01:01:02.345+00"},
+		{"DATE '2021-05-20' - DATE '2020-04-19'", "0-0 396 0:0:0"},
+		{"DATE '0001-01-01' - DATE '9999-12-31'", "0-0 -3652058 0:0:0"},
+		{"DATETIME '2021-01-02 01:00:00' - DATETIME '2021-01-01 02:00:00'", "0-0 0 23:0:0"},
+		{"DATETIME '9999-12-31 00:00:00' - DATETIME '0001-01-01 00:00:00'", "0-0 0 87649392:0:0"},
+		{"TIMESTAMP '2021-06-01 12:34:56.789' - TIMESTAMP '2021-05-31 00:00:00'", "0-0 0 36:34:56.789"},
+		{"TIMESTAMP '9999-01-01 00:00:00+00' - TIMESTAMP '0001-01-01 00:00:00+00'", "0-0 0 87640656:0:0"},
+		{"JUSTIFY_DAYS(INTERVAL -65 DAY)", "-0-2 -5 0:0:0"},
+		{"JUSTIFY_DAYS(INTERVAL 370 DAY)", "1-0 10 0:0:0"},
+		{"JUSTIFY_DAYS(INTERVAL '1 -1' MONTH TO DAY)", "0-0 29 0:0:0"},
+		{"JUSTIFY_HOURS(INTERVAL -25 HOUR)", "0-0 -1 -1:0:0"},
+		{"JUSTIFY_HOURS(INTERVAL 125 MINUTE)", "0-0 0 2:5:0"},
+		{"JUSTIFY_HOURS(INTERVAL '1 -1' DAY TO HOUR)", "0-0 0 23:0:0"},
+		{"JUSTIFY_INTERVAL(INTERVAL '29 49:00:00' DAY TO SECOND)", "0-1 1 1:0:0"},
+		{"JUSTIFY_INTERVAL(INTERVAL '0-1 0 -1:0:0' YEAR TO SECOND)", "0-0 29 23:0:0"},
+		{"MAKE_INTERVAL(1, 6, 15)", "1-6 15 0:0:0"},
+		{"MAKE_INTERVAL(hour => 10, second => 20)", "0-0 0 10:0:20"},
+		{"MAKE_INTERVAL(1, minute => 72, hour => 10)", "1-0 0 11:12:0"},
+		{"EXTRACT(MINUTE FROM MAKE_INTERVAL(minute => 72))", "12"},
+		{"EXTRACT(HOUR FROM INTERVAL 25 HOUR)", "25"},
+		{"EXTRACT(YEAR FROM INTERVAL '-1-2 -3 -4:5:6.789999' YEAR TO SECOND)", "-1"},
+		{"EXTRACT(MONTH FROM INTERVAL '-1-2 -3 -4:5:6.789999' YEAR TO SECOND)", "-2"},
+		{"EXTRACT(SECOND FROM INTERVAL '-1-2 -3 -4:5:6.789999' YEAR TO SECOND)", "-6"},
+		{"EXTRACT(MILLISECOND FROM INTERVAL '1-2 3 4:5:6.789999' YEAR TO SECOND)", "789"},
+		{"EXTRACT(MICROSECOND FROM INTERVAL '1-2 3 4:5:6.789999' YEAR TO SECOND)", "789999"},
+		{"(SELECT SUM(EXTRACT(DAY FROM v * 2)) FROM UNNEST([INTERVAL 1 DAY, INTERVAL 2 DAY]) AS v)", "6"},
+	} {
+		var got sql.NullString
+		if err := db.QueryRowContext(ctx, "SELECT CAST("+tc.expr+" AS STRING)").Scan(&got); err != nil {
+			t.Errorf("SELECT %s: %v", tc.expr, err)
+			continue
+		}
+		if got.String != tc.want {
+			t.Errorf("SELECT %s = %q, want %q", tc.expr, got.String, tc.want)
+		}
+	}
+	for _, tc := range []struct{ expr, want string }{
+		{"INTERVAL 10000 YEAR + INTERVAL 1 MONTH", "Interval field months '120001' is out of range"},
+		{"INTERVAL 3660000 DAY + INTERVAL 1 DAY", "Interval field days"},
+		{"INTERVAL 5000 YEAR * 3", "Interval overflow during multiplication"},
+		{"INTERVAL 1 DAY / 0", "Interval division by zero"},
+		{"MAKE_INTERVAL(year => 10001)", "Interval field months"},
+		{"DATE '9999-12-31' + INTERVAL 1 DAY", "DATETIME overflow"},
+		{"TIMESTAMP '0001-01-01 00:00:00+00' - INTERVAL 1 SECOND", "TIMESTAMP overflow"},
+	} {
+		var got sql.NullString
+		err := db.QueryRowContext(ctx, "SELECT CAST("+tc.expr+" AS STRING)").Scan(&got)
+		if err == nil || !strings.Contains(err.Error(), tc.want) {
+			t.Errorf("SELECT %s: %q, %v; want an error with %q", tc.expr, got.String, err, tc.want)
+		}
+	}
+	var null sql.NullString
+	if err := db.QueryRowContext(ctx, "SELECT CAST(INTERVAL 1 DAY + CAST(NULL AS INTERVAL) AS STRING)").Scan(&null); err != nil || null.Valid {
+		t.Errorf("INTERVAL 1 DAY + NULL: %v, %v, want NULL", null, err)
+	}
+}
