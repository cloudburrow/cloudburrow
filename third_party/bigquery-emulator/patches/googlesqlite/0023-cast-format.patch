+package castformat
+
+import (
+	"fmt"
+	"math/big"
+	"strings"
+)
+
+type numFormat struct {
+	fm, blank bool
+	// intSlots are the digit ('0', '9', 'X', 'x') and group separator
+	// (',') elements before the decimal point; with V, the digits after V
+	// are integer slots too.
+	intSlots   []byte
+	fracDigits int
+	vDigits    int
+	decimal    bool
+	exponent   bool
+	hex        bool
+	roman      string // "RN" or "rn"
+	sign       string // "", "S", "MI", "PR"
+	signLead   bool
+	currency   string
+}
+
+func parseNumFormat(f string) (*numFormat, error) {
+	nf := &numFormat{}
+	bad := func(msg string) error {
+		return fmt.Errorf("invalid numeric format %q: %s", f, msg)
+	}
+	afterDecimal, afterV, sawDigit := false, false, false
+	for i := 0; i < len(f); {
+		up := strings.ToUpper(f[i:])
+		c := f[i]
+		switch {
+		case strings.HasPrefix(up, "FM"):
+			nf.fm = true
+			i += 2
+		case strings.HasPrefix(up, "EEEE"):
+			if nf.exponent {
+				return nil, bad("EEEE appears more than once")
+			}
+			nf.exponent = true
+			i += 4
+		case strings.HasPrefix(up, "RN"):
+			nf.roman = f[i : i+2]
+			i += 2
+		case strings.HasPrefix(up, "MI"), strings.HasPrefix(up, "PR"):
+			if nf.sign != "" {
+				return nil, bad("more than one sign element")
+			}
+			nf.sign = up[:2]
+			i += 2
+			if strings.TrimSpace(strings.ToUpper(f[i:])) != "" && strings.ToUpper(f[i:]) != "FM" {
+				return nil, bad(nf.sign + " must be the last element")
+			}
+		case c == 'S' || c == 's':
+			if nf.sign != "" {
+				return nil, bad("more than one sign element")
+			}
+			nf.sign = "S"
+			nf.signLead = !sawDigit && !nf.decimal
+			i++
+		case c == 'B' || c == 'b':
+			nf.blank = true
+			i++
+		case c == '0' || c == '9':
+			sawDigit = true
+			if afterDecimal {
+				nf.fracDigits++
+			} else {
+				if afterV {
+					nf.vDigits++
+				}
+				nf.intSlots = append(nf.intSlots, c)
+			}
+			i++
+		case c == 'X' || c == 'x':
+			sawDigit = true
+			nf.hex = true
+			nf.intSlots = append(nf.intSlots, c)
+			i++
+		case c == '.' || c == 'D' || c == 'd':
+			if nf.decimal {
+				return nil, bad("more than one decimal point")
+			}
+			nf.decimal, afterDecimal = true, true
+			i++
+		case c == ',' || c == 'G' || c == 'g':
+			if afterDecimal {
+				return nil, bad("group separator after the decimal point")
+			}
+			nf.intSlots = append(nf.intSlots, ',')
+			i++
+		case c == '$' || c == 'L' || c == 'l' || c == 'C' || c == 'c':
+			if nf.currency != "" {
+				return nil, bad("more than one currency element")
+			}
+			switch c {
+			case 'C':
+				nf.currency = "USD"
+			case 'c':
+				nf.currency = "usd"
+			default:
+				nf.currency = "$"
+			}
+			i++
+		case c == 'V' || c == 'v':
+			if afterV {
+				return nil, bad("V appears more than once")
+			}
+			afterV = true
+			i++
+		default:
+			return nil, bad(fmt.Sprintf("unsupported format element %q", f[i:]))
+		}
+	}
+	switch {
+	case nf.roman != "" && (len(nf.intSlots) > 0 || nf.decimal || nf.exponent || nf.sign != "" || nf.currency != "" || nf.blank || afterV):
+		return nil, bad("RN can only be used with FM")
+	case afterV && (nf.decimal || nf.exponent):
+		return nil, bad("V cannot be used with a decimal point or EEEE")
+	case nf.hex && (nf.decimal || nf.exponent || nf.currency != "" || nf.blank || afterV || strings.ContainsAny(string(nf.intSlots), "9,")):
+		return nil, bad("X can only be used with 0, FM and sign elements")
+	case nf.hex && len(nf.intSlots) > 16:
+		return nil, bad("more than 16 hexadecimal digits")
+	}
+	return nf, nil
+}
+
+// FormatNumber formats r, an INT64, FLOAT64, NUMERIC or BIGNUMERIC value,
+// as a string. special is "NaN", "+Inf" or "-Inf" for a FLOAT64 that has
+// no rational value, and "" otherwise.
+func FormatNumber(r *big.Rat, special, format string) (string, error) {
+	nf, err := parseNumFormat(format)
+	if err != nil {
+		return "", err
+	}
+	if format == "" {
+		return "", nil
+	}
+	if nf.roman != "" {
+		return formatRoman(r, special, nf)
