+package castformat
+
+import (
+	"encoding/base32"
+	"encoding/base64"
+	"encoding/hex"
+	"fmt"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+func bytesFormat(f string) (string, error) {
+	switch u := strings.ToUpper(strings.TrimSpace(f)); u {
+	case "HEX", "BASE16":
+		return "BASE16", nil
+	case "BASE2", "BASE8", "BASE32", "BASE64", "BASE64M", "ASCII":
+		return u, nil
+	case "UTF-8", "UTF8":
+		return "UTF8", nil
+	}
+	return "", fmt.Errorf("unsupported format %q for a cast between BYTES and STRING", f)
+}
+
+// FormatBytes formats b as a string.
+func FormatBytes(b []byte, format string) (string, error) {
+	f, err := bytesFormat(format)
+	if err != nil {
+		return "", err
+	}
+	switch f {
+	case "BASE16":
+		return hex.EncodeToString(b), nil
+	case "BASE2":
+		return bitsEncode(b, 1), nil
+	case "BASE8":
+		return bitsEncode(b, 3), nil
+	case "BASE32":
+		return base32.StdEncoding.EncodeToString(b), nil
+	case "BASE64":
+		return base64.StdEncoding.EncodeToString(b), nil
+	case "BASE64M":
+		s := base64.StdEncoding.EncodeToString(b)
+		var sb strings.Builder
+		for len(s) > 76 {
+			sb.WriteString(s[:76])
+			sb.WriteByte('\n')
+			s = s[76:]
+		}
+		sb.WriteString(s)
+		return sb.String(), nil
+	case "ASCII":
+		for _, c := range b {
+			if c >= 0x80 {
+				return "", fmt.Errorf("bytes are not valid ASCII")
+			}
+		}
+		return string(b), nil
+	}
+	if !utf8.Valid(b) {
+		return "", fmt.Errorf("bytes are not valid UTF-8")
+	}
+	return string(b), nil
+}
+
+// ParseBytes parses s, formatted as format, as bytes.
+func ParseBytes(s, format string) ([]byte, error) {
+	f, err := bytesFormat(format)
+	if err != nil {
+		return nil, err
+	}
+	switch f {
+	case "BASE16":
+		if len(s)%2 == 1 {
+			s = "0" + s
+		}
+		b, err := hex.DecodeString(s)
+		if err != nil {
+			return nil, fmt.Errorf("%q is not valid HEX: %w", s, err)
+		}
+		return b, nil
+	case "BASE2":
+		return bitsDecode(s, 1)
+	case "BASE8":
+		return bitsDecode(s, 3)
+	case "BASE32":
+		b, err := base32.StdEncoding.DecodeString(strings.ToUpper(s))
+		if err != nil {
+			return nil, fmt.Errorf("%q is not valid BASE32: %w", s, err)
+		}
+		return b, nil
+	case "BASE64", "BASE64M":
+		s = strings.Map(func(r rune) rune {
+			if unicode.IsSpace(r) {
+				return -1
+			}
+			return r
+		}, s)
+		b, err := base64.StdEncoding.DecodeString(s)
+		if err != nil {
+			if b2, err2 := base64.RawStdEncoding.DecodeString(s); err2 == nil {
+				return b2, nil
+			}
+			return nil, fmt.Errorf("%q is not valid BASE64: %w", s, err)
+		}
+		return b, nil
+	case "ASCII":
+		for i := 0; i < len(s); i++ {
+			if s[i] >= 0x80 {
+				return nil, fmt.Errorf("%q has characters that are not ASCII", s)
+			}
+		}
+	}
+	return []byte(s), nil
+}
+
+// bitsEncode writes b as digits of bits bits each, most significant
+// first, the last digit padded with zero bits.
+func bitsEncode(b []byte, bits int) string {
+	var sb strings.Builder
+	acc, n := 0, 0
+	for _, c := range b {
+		acc = acc<<8 | int(c)
+		n += 8
+		for n >= bits {
+			n -= bits
+			sb.WriteByte(byte('0' + (acc>>n)&(1<<bits-1)))
+		}
+		acc &= 1<<n - 1
+	}
+	if n > 0 {
+		sb.WriteByte(byte('0' + (acc<<(bits-n))&(1<<bits-1)))
+	}
+	return sb.String()
+}
+
+func bitsDecode(s string, bits int) ([]byte, error) {
+	var out []byte
+	acc, n := 0, 0
+	for i := 0; i < len(s); i++ {
+		d := int(s[i]) - '0'
+		if d < 0 || d >= 1<<bits {
+			return nil, fmt.Errorf("%q is not valid BASE%d", s, 1<<bits)
+		}
+		acc = acc<<bits | d
+		n += bits
+		if n >= 8 {
+			n -= 8
+			out = append(out, byte(acc>>n))
+			acc &= 1<<n - 1
+		}
+	}
+	if acc != 0 {
+		return nil, fmt.Errorf("%q is not valid BASE%d: trailing bits", s, 1<<bits)
+	}
+	return out, nil
+}
