+
+// bindCastFormat is CAST(x AS type FORMAT format [AT TIME ZONE zone]).
+//
+// CloudBurrow patch (cloudburrow/cloudburrow#1194, #1195): BigQuery's
+// format elements, in castformat, for each cast the FORMAT clause takes.
+func bindCastFormat(args ...value.Value) (value.Value, error) {
+	if len(args) != 6 {
+		return nil, fmt.Errorf("CAST: invalid number of arguments: got %d, want 6", len(args))
+	}
+	var fromType, toType Type
+	for i, t := range []*Type{&fromType, &toType} {
+		s, err := args[i+1].ToString()
+		if err != nil {
+			return nil, err
+		}
+		if err := json.Unmarshal([]byte(s), t); err != nil {
+			return nil, err
+		}
+	}
+	isSafeCast, err := args[3].ToBool()
+	if err != nil {
+		return nil, err
+	}
+	if args[0] == nil || args[4] == nil {
+		return nil, nil
+	}
+	format, err := args[4].ToString()
+	if err != nil {
+		return nil, err
+	}
+	loc := time.UTC
+	if args[5] != nil {
+		zone, err := args[5].ToString()
+		if err != nil {
+			return nil, err
+		}
+		if loc, err = value.ToLocation(zone); err != nil {
+			return nil, fmt.Errorf("CAST: invalid time zone %q: %w", zone, err)
+		}
+	}
+	v, err := castFormat(args[0], &fromType, &toType, format, loc)
+	if err != nil {
+		if isSafeCast {
+			return nil, nil
+		}
+		return nil, err
+	}
+	return v, nil
+}
+
+func castKind(k googlesql.TypeKind) (castformat.Kind, bool) {
+	switch k {
+	case googlesql.TypeKindTypeDate:
+		return castformat.Date, true
+	case googlesql.TypeKindTypeDatetime:
+		return castformat.Datetime, true
+	case googlesql.TypeKindTypeTime:
+		return castformat.Time, true
+	case googlesql.TypeKindTypeTimestamp:
+		return castformat.Timestamp, true
+	}
+	return 0, false
+}
+
+func castFormat(expr value.Value, fromType, toType *Type, format string, loc *time.Location) (value.Value, error) {
+	from, err := fromType.ToGoogleSQLType()
+	if err != nil {
+		return nil, err
+	}
+	to, err := toType.ToGoogleSQLType()
+	if err != nil {
+		return nil, err
+	}
+	fromKind, toKind := m1(from.Kind()), m1(to.Kind())
+	fromValue, err := CastValue(from, expr)
+	if err != nil {
+		return nil, err
+	}
+	unsupported := func() error {
+		return fmt.Errorf("CAST from %v to %v does not support a FORMAT clause", fromKind, toKind)
+	}
+	switch {
+	case fromKind == googlesql.TypeKindTypeBytes && toKind == googlesql.TypeKindTypeString:
+		b, err := fromValue.ToBytes()
+		if err != nil {
+			return nil, err
+		}
+		s, err := castformat.FormatBytes(b, format)
+		if err != nil {
+			return nil, err
+		}
+		return value.StringValue(s), nil
+	case fromKind == googlesql.TypeKindTypeString && toKind == googlesql.TypeKindTypeBytes:
+		s, err := fromValue.ToString()
+		if err != nil {
+			return nil, err
+		}
+		b, err := castformat.ParseBytes(s, format)
+		if err != nil {
+			return nil, err
+		}
+		return value.BytesValue(b), nil
+	case toKind == googlesql.TypeKindTypeString:
+		if k, ok := castKind(fromKind); ok {
+			t, err := fromValue.ToTime()
+			if err != nil {
+				return nil, err
+			}
+			s, err := castformat.FormatDatetime(t, k, format, loc)
+			if err != nil {
+				return nil, err
+			}
+			return value.StringValue(s), nil
+		}
+		var r *big.Rat
+		special := ""
+		switch v := fromValue.(type) {
+		case value.IntValue:
+			r = new(big.Rat).SetInt64(int64(v))
+		case value.FloatValue:
+			f := float64(v)
+			switch {
+			case math.IsNaN(f):
+				special = "NaN"
+			case math.IsInf(f, 1):
+				special = "+Inf"
+			case math.IsInf(f, -1):
+				special = "-Inf"
+			default:
+				r = new(big.Rat).SetFloat64(f)
+			}
+		case *value.NumericValue:
+			r = v.Rat
+		default:
+			return nil, unsupported()
+		}
+		s, err := castformat.FormatNumber(r, special, format)
+		if err != nil {
+			return nil, err
+		}
+		return value.StringValue(s), nil
+	case fromKind == googlesql.TypeKindTypeString:
+		k, ok := castKind(toKind)
+		if !ok {
+			return nil, unsupported()
+		}
+		s, err := fromValue.ToString()
+		if err != nil {
+			return nil, err
+		}
+		t, err := castformat.ParseDatetime(s, k, format, loc, time.Now())
+		if err != nil {
+			return nil, err
+		}
+		switch k {
+		case castformat.Date:
+			return value.DateValue(t), nil
+		case castformat.Datetime:
+			return value.DatetimeValue(t), nil
+		case castformat.Time:
+			return value.TimeValue(t), nil
+		}
+		return value.TimestampValue(t), nil
+	}
+	return nil, unsupported()
+}
