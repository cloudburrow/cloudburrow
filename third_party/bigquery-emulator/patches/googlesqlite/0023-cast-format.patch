+package castformat
+
+import (
+	"math/big"
+	"testing"
+	"time"
+)
+
+// The examples of BigQuery's format-elements reference.
+
+func TestFormatNumber(t *testing.T) {
+	for _, c := range []struct{ in, format, want string }{
+		{"1.2", "$999,999.999", "       $1.200"},
+		{"1234.56", "$999,999.999", "    $1,234.560"[1:]},
+		{"-12345.678", "$999,999.999", "  -$12,345.678"[1:]},
+		{"1234567.89", "$999,999.999", " $###,###.###"},
+		{"12", "99", " 12"},
+		{"12", "000", " 012"},
+		{"12", "000.000", " 012.000"},
+		{"-12", "000.000", "-012.000"},
+		{"12", "999", "  12"},
+		{"12", "999.999", "  12.000"},
+		{"-12", "999", " -12"},
+		{"43981", "XXXX", " ABCD"},
+		{"43981", "xxxx", " abcd"},
+		{"43981", "0X0x", " ABcd"},
+		{"43981", "0000000X", " 0000ABCD"},
+		{"123.58", "999.999", " 123.580"},
+		{"123.58", "999D999", " 123.580"},
+		{"12.5", "99.99", " 12.50"},
+		{"-12", "S9999", "  -12"},
+		{"-12", "9999S", "  12-"},
+		{"12", "S99", "+12"},
+		{"-12", "S99", "-12"},
+		{"12", "9999MI", "  12 "},
+		{"-12", "9999MI", "  12-"},
+		{"12", "9999PR", "   12 "},
+		{"-12", "9999PR", "  <12>"},
+		{"-12", "$999", " -$12"},
+		{"-12", "C999", " -USD12"},
+		{"-12", "c999", " -usd12"},
+		{"-12", "L999", " -$12"},
+		{"12", "$99", " $12"},
+		{"12345", "999,999", "  12,345"},
+		{"12345", "999G999", "  12,345"},
+		{"1234", "999,999", "   1,234"},
+		{"0.23", "B99.999S", "       "},
+		{"1.23", "B99.999S", " 1.230+"},
+		{"299792458", "S9.999EEEE", "+2.998E+08"},
+		{"-123456", "9.999EEEE", "-1.235E+05"},
+		{"12.5", "999999.000FM", "12.5"},
+		{"2021", "RN", "          MMXXI"},
+		{"2021", "FMrn", "mmxxi"},
+		{"23.5", "S000V00", "+02350"},
+		{"0", "999", "   0"},
+	} {
+		r, _ := new(big.Rat).SetString(c.in)
+		got, err := FormatNumber(r, "", c.format)
+		if err != nil {
+			t.Errorf("%s FORMAT %q: %v", c.in, c.format, err)
+			continue
+		}
+		if got != c.want {
+			t.Errorf("%s FORMAT %q = %q, want %q", c.in, c.format, got, c.want)
+		}
+	}
+	for _, f := range []string{"99.9.9", "TM9", "9MI9", "RN9", "X.X", "Q"} {
+		if _, err := FormatNumber(big.NewRat(1, 1), "", f); err == nil {
+			t.Errorf("FORMAT %q: want an error", f)
+		}
+	}
+}
+
+func TestBytes(t *testing.T) {
+	for _, c := range []struct {
+		in     []byte
+		format string
+		want   string
+	}{
+		{[]byte{0, 1, 0xef, 0xff}, "HEX", "0001efff"},
+		{[]byte{0x02, 0x11, 0x3b}, "BASE8", "00410473"},
+		{[]byte{0x02, 0x11, 0x3b}, "base2", "000000100001000100111011"},
+		{[]byte{0xde, 0xad, 0xbe, 0xef}, "BASE64M", "3q2+7w=="},
+		{[]byte{0xde, 0xad, 0xbe, 0xef}, "BASE64", "3q2+7w=="},
+		{[]byte{0xde, 0xad, 0xbe, 0xef}, "BASE32", "32W353Y="},
+		{[]byte("Hello"), "ASCII", "Hello"},
+		{[]byte("$"), "UTF-8", "$"},
+		{[]byte("$"), "utf8", "$"},
+	} {
+		got, err := FormatBytes(c.in, c.format)
+		if err != nil || got != c.want {
+			t.Errorf("FormatBytes(%x, %q) = %q, %v; want %q", c.in, c.format, got, err, c.want)
+		}
+		back, err := ParseBytes(c.want, c.format)
+		if err != nil || string(back) != string(c.in) {
+			t.Errorf("ParseBytes(%q, %q) = %x, %v; want %x", c.want, c.format, back, err, c.in)
+		}
+	}
+	if b, err := ParseBytes("3q2+\n7w==", "BASE64"); err != nil || string(b) != "\xde\xad\xbe\xef" {
+		t.Errorf("BASE64 with a newline: %x, %v", b, err)
+	}
+	if _, err := FormatBytes([]byte{0xff}, "ASCII"); err == nil {
+		t.Error("non-ASCII bytes: want an error")
+	}
+	if _, err := ParseBytes("zz", "HEX"); err == nil {
+		t.Error("bad HEX: want an error")
+	}
+	if _, err := FormatBytes(nil, "BASE7"); err == nil {
+		t.Error("BASE7: want an error")
+	}
+}
