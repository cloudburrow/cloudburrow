+		}
+	}
+	if month < 1 || month > 12 || day < 1 || day > 31 || hour > 23 || minute > 59 || sec > 60 {
+		return time.Time{}, fmt.Errorf("could not parse %q with format %q: a part is out of range", s, format)
+	}
+	if yday > 0 {
+		month, day = 1, yday
