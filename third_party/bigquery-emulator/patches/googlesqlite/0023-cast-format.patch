+package googlesqlite_test
+
+import (
+	"database/sql"
+	"testing"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1194, #1195): CAST's FORMAT
+// clause, and AT TIME ZONE, for literals and for columns.
+func TestCastFormat(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=cast_format")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	for _, q := range []string{
+		"CREATE TABLE t (ts TIMESTAMP, s STRING, b BYTES, n NUMERIC, i INT64, f FLOAT64)",
+		"INSERT INTO t VALUES (TIMESTAMP '2008-12-25 05:30:00+00', '2020.06.03 00:00:53+00', b'\\xde\\xad\\xbe\\xef', NUMERIC '-12345.678', 43981, 12.5)",
+	} {
+		if _, err := db.Exec(q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	for _, c := range []struct{ expr, want string }{
+		{"CAST(DATE '2018-01-30' AS STRING FORMAT 'MONTH DD, YYYY')", "JANUARY 30, 2018"},
+		{"CAST(DATETIME '2018-01-30 21:30:00' AS STRING FORMAT 'YYYY-MM-DD HH12:MI A.M.')", "2018-01-30 09:30 P.M."},
+		{"CAST(TIME '21:30:25.16' AS STRING FORMAT 'HH24:MI:SS.FF2')", "21:30:25.16"},
+		{"CAST(TIMESTAMP '2008-12-25 00:00:00+00:00' AS STRING FORMAT 'TZH')", "+00"},
+		{"CAST(TIMESTAMP '2008-12-25 00:00:00+00:00' AS STRING FORMAT 'TZH:TZM' AT TIME ZONE 'Asia/Kolkata')", "+05:30"},
+		{"(SELECT CAST(ts AS STRING FORMAT 'YYYY-MM-DD HH24:MI TZH' AT TIME ZONE 'America/New_York') FROM t)", "2008-12-25 00:30 -05"},
+		{"(SELECT CAST(ts AS STRING FORMAT 'Day, DD Mon YYYY') FROM t)", "Thursday , 25 Dec 2008"},
+		{"CAST(CAST('DEC 03, 2018' AS DATE FORMAT 'MON DD, YYYY') AS STRING)", "2018-12-03"},
+		{"CAST(CAST('03:30 P.M.' AS TIME FORMAT 'HH:MI A.M.') AS STRING)", "15:30:00"},
+		{"CAST(CAST('2018-12-03 15:30' AS DATETIME FORMAT 'YYYY-MM-DD HH24:MI') AS STRING FORMAT 'YYYY-MM-DD HH24:MI:SS')", "2018-12-03 15:30:00"},
+		{"(SELECT CAST(CAST(s AS TIMESTAMP FORMAT 'YYYY.MM.DD HH24:MI:SSTZH') AS STRING) FROM t)", "2020-06-03 00:00:53+00"},
+		{"CAST(CAST('2020-01-01 00:00' AS TIMESTAMP FORMAT 'YYYY-MM-DD HH24:MI' AT TIME ZONE 'America/New_York') AS STRING)", "2020-01-01 05:00:00+00"},
+		{"CAST(b'\\x48\\x65\\x6c\\x6c\\x6f' AS STRING FORMAT 'ASCII')", "Hello"},
+		{"(SELECT CAST(b AS STRING FORMAT 'HEX') FROM t)", "deadbeef"},
+		{"TO_HEX(CAST('3q2+7w==' AS BYTES FORMAT 'BASE64'))", "deadbeef"},
+		{"(SELECT CAST(n AS STRING FORMAT '$999,999.999') FROM t)", " -$12,345.678"},
+		{"(SELECT CAST(i AS STRING FORMAT 'xxxx') FROM t)", " abcd"},
+		{"(SELECT CAST(f AS STRING FORMAT '999999.000FM') FROM t)", "12.5"},
+		{"CAST(2021 AS STRING FORMAT 'RN')", "          MMXXI"},
+		{"CAST(-12 AS STRING FORMAT '9999PR')", "  <12>"},
+		{"CAST(CAST(NULL AS DATE) AS STRING FORMAT 'YYYY') IS NULL", "true"},
+		{"SAFE_CAST('nope' AS DATE FORMAT 'YYYY-MM-DD') IS NULL", "true"},
+	} {
+		var got string
+		if err := db.QueryRow("SELECT CAST((" + c.expr + ") AS STRING)").Scan(&got); err != nil {
+			t.Errorf("%s: %v", c.expr, err)
+			continue
+		}
+		if got != c.want {
+			t.Errorf("%s = %q, want %q", c.expr, got, c.want)
+		}
+	}
+	for _, expr := range []string{
+		"CAST('nope' AS DATE FORMAT 'YYYY-MM-DD')",
+		"CAST(DATE '2018-01-30' AS STRING FORMAT 'HH24')",
+		"CAST(b'\\xff' AS STRING FORMAT 'ASCII')",
+		"CAST(12 AS STRING FORMAT 'TM9')",
+	} {
+		var got sql.NullString
+		if err := db.QueryRow("SELECT " + expr).Scan(&got); err == nil {
+			t.Errorf("%s = %v, want an error", expr, got)
+		}
+	}
+}
