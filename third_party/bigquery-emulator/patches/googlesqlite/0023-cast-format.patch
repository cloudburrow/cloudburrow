+			sign := "+"
+			if exp < 0 {
+				sign, exp = "-", -exp
+			}
+			expStr = fmt.Sprintf("E%s%02d", sign, exp)
+		}
+	}
+	nDigits := 0
+	for _, s := range nf.intSlots {
+		if s != ',' {
+			nDigits++
+		}
+	}
+	if len(intStr) > nDigits {
+		overflow = true
+	}
+	// Assign the integer digits right-aligned to the digit slots.
+	out := make([]byte, len(nf.intSlots))
+	firstZero := -1
+	for i, s := range nf.intSlots {
+		if s == '0' {
+			firstZero = i
+			break
+		}
+	}
+	di := len(intStr) - 1
+	for i := len(nf.intSlots) - 1; i >= 0; i-- {
+		s := nf.intSlots[i]
+		if s == ',' {
+			continue
+		}
+		switch {
+		case overflow:
+			out[i] = '#'
+		case di >= 0:
+			out[i] = intStr[di]
+			di--
+		case firstZero >= 0 && i >= firstZero:
+			out[i] = '0'
+		default:
+			out[i] = ' '
+		}
+		if nf.hex && out[i] != ' ' && out[i] != '#' {
+			lower := s == 'x'
+			if s == '0' {
+				lower = false
+				for _, t := range nf.intSlots[i+1:] {
+					if t == 'X' || t == 'x' {
+						lower = t == 'x'
+						break
+					}
+				}
+			}
+			if lower {
+				out[i] = strings.ToLower(string(out[i]))[0]
+			}
+		}
+	}
+	// With no integer digit printed and no fraction, print one zero.
+	if !overflow && intStr == "" && nDigits > 0 && !nf.decimal && !nf.exponent && firstZero < 0 {
+		for i := len(nf.intSlots) - 1; i >= 0; i-- {
+			if nf.intSlots[i] != ',' {
+				out[i] = '0'
+				break
+			}
+		}
+	}
+	printed := false
+	for i, s := range nf.intSlots {
+		if s == ',' {
+			if printed {
+				out[i] = ','
+			} else {
+				out[i] = ' '
+			}
+		} else if out[i] != ' ' {
+			printed = true
+		}
+	}
+	body := string(out)
+	if nf.decimal {
+		if overflow {
+			fracStr = strings.Repeat("#", nf.fracDigits)
+		} else if nf.fm {
+			fracStr = strings.TrimRight(fracStr, "0")
+		}
+		body += "." + fracStr
+	}
+	if overflow && nf.exponent {
+		expStr = "E+##"
+	}
+	body += expStr
+	core := strings.TrimLeft(body, " ")
+	lead := strings.Repeat(" ", len(body)-len(core))
+	zero := !overflow && intStr == "" && strings.Trim(fracStr, "0") == ""
+	var res string
+	switch nf.sign {
+	case "":
+		s := " "
+		if neg && !zero {
+			s = "-"
+		}
+		res = lead + s + nf.currency + core
+	case "S":
+		s := "+"
+		if neg {
+			s = "-"
+		}
+		if zero || special == "NaN" {
+			s = " "
+		}
+		if nf.signLead {
+			res = lead + s + nf.currency + core
+		} else {
+			res = lead + nf.currency + core + s
+		}
+	case "MI":
+		s := " "
+		if neg && !zero {
+			s = "-"
+		}
+		res = lead + nf.currency + core + s
+	case "PR":
+		if neg && !zero {
+			res = lead + "<" + nf.currency + core + ">"
+		} else {
+			res = " " + lead + nf.currency + core + " "
+		}
+	}
+	if nf.blank && intStr == "" && !overflow {
+		res = strings.Repeat(" ", len(res))
+	}
+	if nf.fm {
+		res = strings.ReplaceAll(res, " ", "")
+	}
+	return res, nil
+}
+
+func pow10(n int) *big.Int {
+	return new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(n)), nil)
+}
+
+func formatRoman(r *big.Rat, special string, nf *numFormat) (string, error) {
+	if special != "" {
+		return "", fmt.Errorf("%s cannot be formatted as a Roman numeral", special)
+	}
+	q := roundHalfAway(r)
+	if !q.IsInt64() || q.Int64() < 1 || q.Int64() > 3999 {
+		return "", fmt.Errorf("RN requires a value between 1 and 3999, got %s", q)
+	}
+	n := int(q.Int64())
+	vals := []int{1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1}
+	syms := []string{"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"}
+	var sb strings.Builder
+	for i, v := range vals {
+		for n >= v {
+			sb.WriteString(syms[i])
+			n -= v
+		}
+	}
+	s := sb.String()
+	if nf.roman == "rn" {
+		s = strings.ToLower(s)
+	}
+	if nf.fm {
+		return s, nil
+	}
+	return fmt.Sprintf("%15s", s), nil
+}
