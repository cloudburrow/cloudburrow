+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestCatalogRebuildKeepsTables is CloudBurrow's regression test of its
+// patch 0062 (cloudburrow/cloudburrow#1525): the catalog keeps the names
+// each of its catalogs holds and the handle of each table, so a DROP
+// TABLE, which rebuilds the catalog, costs about the same with many
+// tables as with few, and the rebuilt catalog answers as before: the
+// tables kept resolve by every name path, the dropped one does not, a
+// table made again under a dropped name has its new columns, and
+// INFORMATION_SCHEMA still lists the tables.
+func TestCatalogRebuildKeepsTables(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	exec := func(q string) time.Duration {
+		t.Helper()
+		start := time.Now()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		return time.Since(start)
+	}
+	scalar := func(q string) string {
+		t.Helper()
+		var s string
+		if err := db.QueryRowContext(ctx, q).Scan(&s); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		return s
+	}
+	// The cost of a DROP with no other table, then with 300 more.
+	drop := func(tag string) time.Duration {
+		t.Helper()
+		var d time.Duration
+		for i := 0; i < 3; i++ {
+			exec(fmt.Sprintf("CREATE TABLE `p.scratch.%s%d` (n INT64)", tag, i))
+			d += exec(fmt.Sprintf("DROP TABLE `p.scratch.%s%d`", tag, i))
+		}
+		return d / 3
+	}
+	few := drop("few")
+	for i := 0; i < 300; i++ {
+		exec(fmt.Sprintf("CREATE TABLE `p.d%d.t%d` (n INT64, s STRING)", i/30, i))
+	}
+	exec("INSERT INTO `p.d0.t0` (n, s) VALUES (1, 'a')")
+	many := drop("many")
+	t.Logf("a DROP TABLE: %v with no other table, %v with 300", few, many)
+	// Measured with the patch: 9 ms and 26 ms; without it, 18 ms and
+	// 1.3 s. The bound leaves room for a slow machine.
+	if many > 10*few+500*time.Millisecond {
+		t.Errorf("a DROP TABLE took %v with 300 tables and %v with none", many, few)
+	}
+
+	exec("DROP TABLE `p.d0.t1`")
+	for _, q := range []string{"SELECT s FROM `p.d0.t0`", "SELECT s FROM `p`.`d0`.`t0`", "SELECT s FROM d0.t0"} {
+		if got := scalar(q); got != "a" {
+			t.Errorf("%s = %q after a DROP, want a", q, got)
+		}
+	}
+	if _, err := db.QueryContext(ctx, "SELECT * FROM `p.d0.t1`"); err == nil || !strings.Contains(err.Error(), "not found") {
+		t.Errorf("the dropped table: %v, want not found", err)
+	}
+	exec("CREATE TABLE `p.d0.t1` (x STRING, y INT64)")
+	exec("INSERT INTO `p.d0.t1` (x, y) VALUES ('b', 2)")
+	if got := scalar("SELECT FORMAT('%s%d', x, y) FROM `p.d0.t1`"); got != "b2" {
+		t.Errorf("the table made again = %q, want b2", got)
+	}
+	exec("DROP TABLE `p.d0.t2`")
+	if got := scalar("SELECT FORMAT('%s%d', x, y) FROM `p.d0.t1`"); got != "b2" {
+		t.Errorf("the table made again, after another DROP = %q, want b2", got)
+	}
+	if _, err := db.QueryContext(ctx, "SELECT n FROM `p.d0.t1`"); err == nil {
+		t.Error("the table made again still has its old column n")
+	}
+	if got := scalar("SELECT STRING_AGG(table_name, ',' ORDER BY table_name) FROM d0.INFORMATION_SCHEMA.TABLES WHERE table_name IN ('t0', 't1', 't2', 't3')"); got != "t0,t1,t3" {
+		t.Errorf("INFORMATION_SCHEMA.TABLES = %q, want t0,t1,t3", got)
+	}
+}
