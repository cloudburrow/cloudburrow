@@ -106,9 +107,57 @@ func parseTimestamp(timestamp string, loc *time.Location) (time.Time, error) {
 	if t, err := time.ParseInLocation("2006-01-02", timestamp, loc); err == nil {
 		return t, nil
 	}
+	// CloudBurrow patch (cloudburrow/cloudburrow#1189): a timestamp with a
+	// named zone, "2020-01-01 00:00:00 America/New_York", was refused (the
+	// "MST" layouts above take an abbreviation only, and Go reads one it
+	// does not know as a zero offset).
+	if i := strings.LastIndexByte(timestamp, ' '); i > 0 {
+		if zone := timestamp[i+1:]; zone != "" && (zone[0] >= 'A' && zone[0] <= 'Z' || zone[0] >= 'a' && zone[0] <= 'z') {
+			if zl, err := toLocation(zone); err == nil {
+				naive := strings.TrimSpace(timestamp[:i])
+				for _, layout := range []string{"2006-01-02 15:04:05.999999999", "2006-01-02T15:04:05.999999999", "2006-01-02"} {
+					if t, err := time.ParseInLocation(layout, naive, zl); err == nil {
+						return t, nil
+					}
+				}
+			}
+		}
+	}
 	return time.Time{}, fmt.Errorf("failed to parse timestamp. unexpected format %s", timestamp)
 }
 
+// FormatTimestamp writes t in loc the way BigQuery writes a TIMESTAMP as
+// a STRING: "2020-01-01 05:00:00.500+00", the fraction in groups of
+// three digits and none when it is zero, the offset as +HH or +HH:MM.
+// CloudBurrow patch (cloudburrow/cloudburrow#1189).
+func FormatTimestamp(t time.Time, loc *time.Location) string {
+	t = t.In(loc)
+	var b strings.Builder
+	b.WriteString(t.Format("2006-01-02 15:04:05"))
+	if ns := t.Nanosecond(); ns != 0 {
+		switch {
+		case ns%1000000 == 0:
+			fmt.Fprintf(&b, ".%03d", ns/1000000)
+		case ns%1000 == 0:
+			fmt.Fprintf(&b, ".%06d", ns/1000)
+		default:
+			fmt.Fprintf(&b, ".%09d", ns)
+		}
+	}
+	_, offset := t.Zone()
+	sign := byte('+')
+	if offset < 0 {
+		sign = '-'
+		offset = -offset
+	}
+	b.WriteByte(sign)
+	fmt.Fprintf(&b, "%02d", offset/3600)
+	if m := offset % 3600 / 60; m != 0 {
+		fmt.Fprintf(&b, ":%02d", m)
+	}
+	return b.String()
+}
