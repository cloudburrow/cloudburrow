+package googlesqlite_test
+
+import (
+	"database/sql"
+	"testing"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1189): casts and functions
+// with no zone use UTC, BigQuery's default, both where the analyzer folds
+// a literal and where the run time casts a column; an explicit zone is
+// kept.
+func TestDefaultTimeZoneIsUTC(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=default_time_zone_utc")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	for _, q := range []string{
+		"CREATE TABLE t (ts TIMESTAMP, d DATE, dt DATETIME, s STRING)",
+		"INSERT INTO t VALUES (TIMESTAMP '2020-01-01 05:00:00.5+00', DATE '2020-01-01', DATETIME '2020-01-01 00:00:00', '2020-01-01 00:00:00')",
+	} {
+		if _, err := db.Exec(q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	for _, c := range []struct{ expr, want string }{
+		// Folded by the analyzer, which used America/Los_Angeles.
+		{"CAST(CAST(DATE '2020-01-01' AS TIMESTAMP) AS STRING)", "2020-01-01 00:00:00+00"},
+		{"CAST(CAST(DATETIME '2020-01-01 00:00:00' AS TIMESTAMP) AS STRING)", "2020-01-01 00:00:00+00"},
+		{"CAST(TIMESTAMP '2020-01-01 05:00:00+00' AS STRING)", "2020-01-01 05:00:00+00"},
+		{"CAST(TIMESTAMP '2020-01-01 05:00:00.5+00' AS STRING)", "2020-01-01 05:00:00.500+00"},
+		{"CAST(CAST(TIMESTAMP '2020-01-01 05:00:00+00' AS DATE) AS STRING)", "2020-01-01"},
+		{"CAST(CAST(TIMESTAMP '2020-01-01 03:00:00+00' AS DATETIME) AS STRING)", "2020-01-01 03:00:00"},
+		{"CAST(CAST(TIMESTAMP '2020-01-01 03:00:00+00' AS TIME) AS STRING)", "03:00:00"},
+		{"CAST(CAST('2020-01-01 00:00:00 America/New_York' AS TIMESTAMP) AS STRING)", "2020-01-01 05:00:00+00"},
+		{"CAST(TIMESTAMP '2020-01-01 05:00:00+00' = '2020-01-01 05:00:00' AS STRING)", "true"},
+		// Functions with no zone argument, and with one.
+		{"STRING(TIMESTAMP(DATE '2020-01-01'))", "2020-01-01 00:00:00+00"},
+		{"STRING(TIMESTAMP(DATETIME '2020-01-01 00:00:00'))", "2020-01-01 00:00:00+00"},
+		{"STRING(TIMESTAMP('2020-01-01 00:00:00', 'America/New_York'))", "2020-01-01 05:00:00+00"},
+		{"CAST(DATE(TIMESTAMP '2020-01-01 03:00:00+00') AS STRING)", "2020-01-01"},
+		{"CAST(EXTRACT(HOUR FROM TIMESTAMP '2020-01-01 03:00:00+00') AS STRING)", "3"},
+		{"FORMAT_TIMESTAMP('%F %T %Z', TIMESTAMP '2020-01-01 03:00:00+00')", "2020-01-01 03:00:00 UTC"},
+		{"STRING(TIMESTAMP '2020-01-01 05:00:00+00', 'America/New_York')", "2020-01-01 00:00:00-05"},
+		{"STRING(TIMESTAMP '2020-01-01 05:00:00.123456+00', 'Asia/Kolkata')", "2020-01-01 10:30:00.123456+05:30"},
+		// Cast at run time, of a column.
+		{"(SELECT CAST(ts AS STRING) FROM t)", "2020-01-01 05:00:00.500+00"},
+		{"(SELECT CAST(CAST(d AS TIMESTAMP) AS STRING) FROM t)", "2020-01-01 00:00:00+00"},
+		{"(SELECT CAST(CAST(dt AS TIMESTAMP) AS STRING) FROM t)", "2020-01-01 00:00:00+00"},
+		{"(SELECT CAST(CAST(s AS TIMESTAMP) AS STRING) FROM t)", "2020-01-01 00:00:00+00"},
+		{"(SELECT CAST(CAST(CONCAT(s, ' America/New_York') AS TIMESTAMP) AS STRING) FROM t)", "2020-01-01 05:00:00+00"},
+	} {
+		var got string
+		if err := db.QueryRow("SELECT " + c.expr).Scan(&got); err != nil {
+			t.Errorf("%s: %v", c.expr, err)
+			continue
+		}
+		if got != c.want {
+			t.Errorf("%s = %q, want %q", c.expr, got, c.want)
+		}
+	}
+}
