+package internal
+
+import (
+	"context"
+	"database/sql/driver"
+	"fmt"
+	"strings"
+
+	"github.com/goccy/go-googlesql"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// typedArg is a query argument that was bound as a value.TypedParameter:
+// its encoded value, as CheckNamedValue encodes every argument, and the
+// type the parameter is declared with. Conn.CheckNamedValue makes it, so
+// the analyzer declares the parameter with its type: a NULL has no type of
+// its own, and an ARRAY's or STRUCT's encoded value says little of its
+// elements' or fields'. Analyze declares it and hands the statement its
+// encoded value (plainArgs). A driver.Valuer, should it reach SQLite.
+//
+// CloudBurrow patch (cloudburrow/cloudburrow#1816).
+type typedArg struct {
+	encoded any
+	typ     value.ParameterType
+}
+
+// Value is the encoded value.
+func (a typedArg) Value() (driver.Value, error) { return a.encoded, nil }
+
+// CheckConnNamedValue is CheckNamedValue for Conn: a TypedParameter keeps
+// its declared type (typedArg). CloudBurrow patch
+// (cloudburrow/cloudburrow#1816).
+func CheckConnNamedValue(nv *driver.NamedValue) error {
+	p, typed := nv.Value.(value.TypedParameter)
+	if err := CheckNamedValue(nv); err != nil {
+		return err
+	}
+	if typed {
+		nv.Value = typedArg{encoded: nv.Value, typ: p.DeclaredType()}
+	}
+	return nil
+}
+
+// plainArgs is args with each typedArg's encoded value in its place.
+func plainArgs(args []driver.NamedValue) []driver.NamedValue {
+	var out []driver.NamedValue
+	for i, a := range args {
+		t, ok := a.Value.(typedArg)
+		if !ok {
+			continue
+		}
+		if out == nil {
+			out = make([]driver.NamedValue, len(args))
+			copy(out, args)
+		}
+		out[i].Value = t.encoded
+	}
+	if out == nil {
+		return args
+	}
+	return out
+}
+
+type typedArgsKey struct{}
+
+// withTypedArgs is ctx with the positions of args that are typedArgs,
+// which reshapeInsertArgs leaves as they are: each is a value of its
+// declared type already, and the INSERT's columns are not the parameters
+// (VALUES (1, @p, @a) lines @a up with the second column).
+func withTypedArgs(ctx context.Context, args []driver.NamedValue) context.Context {
+	var typed map[int]bool
+	for i, a := range args {
+		if _, ok := a.Value.(typedArg); ok {
+			if typed == nil {
+				typed = map[int]bool{}
+			}
+			typed[i] = true
+		}
+	}
+	if typed == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, typedArgsKey{}, typed)
+}
+
+// typedArgPositions are the positions withTypedArgs recorded in ctx.
+func typedArgPositions(ctx context.Context) map[int]bool {
+	typed, _ := ctx.Value(typedArgsKey{}).(map[int]bool)
+	return typed
+}
+
+// declaredArgType is the GoogleSQL type a typedArg is declared with.
+func declaredArgType(v any) (googlesql.Googlesql_TypeNode, bool, bool) {
+	t, ok := v.(typedArg)
+	if !ok {
+		return nil, false, false
+	}
+	spec, err := parameterTypeSpec(t.typ)
+	if err != nil {
+		return nil, false, true
+	}
+	node, err := spec.ToGoogleSQLType()
+	if err != nil || node == nil {
+		return nil, false, true
+	}
+	return node, true, true
+}
+
+// parameterTypeSpec is t as a Type.
+func parameterTypeSpec(t value.ParameterType) (*Type, error) {
+	upper := strings.ToUpper(t.Type)
+	switch upper {
+	case "ARRAY":
+		if t.ArrayType == nil {
+			return nil, fmt.Errorf("ARRAY parameter type with no element type")
+		}
+		elem, err := parameterTypeSpec(*t.ArrayType)
+		if err != nil {
+			return nil, err
+		}
+		return &Type{Kind: int(googlesql.TypeKindTypeArray), ElementType: elem}, nil
+	case "STRUCT":
+		fields := make([]*NameWithType, 0, len(t.StructTypes))
+		for _, f := range t.StructTypes {
+			ft, err := parameterTypeSpec(f.Type)
+			if err != nil {
+				return nil, err
+			}
+			fields = append(fields, &NameWithType{Name: f.Name, Type: ft})
+		}
+		return &Type{Kind: int(googlesql.TypeKindTypeStruct), FieldTypes: fields}, nil
+	}
+	kind, ok := map[string]googlesql.TypeKind{
+		"STRING": googlesql.TypeKindTypeString, "BYTES": googlesql.TypeKindTypeBytes,
+		"INT64": googlesql.TypeKindTypeInt64, "INTEGER": googlesql.TypeKindTypeInt64, "INT": googlesql.TypeKindTypeInt64,
+		"FLOAT64": googlesql.TypeKindTypeDouble, "FLOAT": googlesql.TypeKindTypeDouble, "DOUBLE": googlesql.TypeKindTypeDouble,
+		"BOOL": googlesql.TypeKindTypeBool, "BOOLEAN": googlesql.TypeKindTypeBool,
+		"NUMERIC": googlesql.TypeKindTypeNumeric, "DECIMAL": googlesql.TypeKindTypeNumeric,
+		"BIGNUMERIC": googlesql.TypeKindTypeBignumeric, "BIGDECIMAL": googlesql.TypeKindTypeBignumeric,
+		"DATE": googlesql.TypeKindTypeDate, "TIME": googlesql.TypeKindTypeTime, "DATETIME": googlesql.TypeKindTypeDatetime,
+		"TIMESTAMP": googlesql.TypeKindTypeTimestamp, "GEOGRAPHY": googlesql.TypeKindTypeGeography,
+		"JSON": googlesql.TypeKindTypeJson, "INTERVAL": googlesql.TypeKindTypeInterval,
+	}[upper]
+	if !ok {
+		return nil, fmt.Errorf("unsupported parameter type %q", t.Type)
+	}
+	return &Type{Kind: int(kind)}, nil
+}
