+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"testing"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// TestTypedNullArrayStructParameters is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1816): a NULL parameter, positional or named,
+// was left undeclared, so `SELECT ? AS a` with a NULL was an INT64; and an
+// ARRAY's elements and a STRUCT's fields took the types of their Go values,
+// a DATE or NUMERIC one a STRING. A TypedParameter that is a NULL, an ARRAY
+// or a STRUCT is of its declared type, and so are its elements and fields.
+func TestTypedNullArrayStructParameters(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=typed_null_array_struct_parameters")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	scalar := func(typ, v string) googlesqlite.TypedParameter {
+		return googlesqlite.TypedParameter{Type: typ, Value: v}
+	}
+	null := func(typ string) googlesqlite.TypedParameter {
+		return googlesqlite.TypedParameter{Type: typ, Null: true}
+	}
+	date := googlesqlite.ParameterType{Type: "DATE"}
+	dates := googlesqlite.TypedParameter{Type: "ARRAY", ArrayType: &date,
+		ArrayValues: []googlesqlite.TypedParameter{scalar("DATE", "2024-01-02"), scalar("DATE", "2024-01-03")}}
+	fields := []googlesqlite.ParameterField{
+		{Name: "n", Type: googlesqlite.ParameterType{Type: "NUMERIC"}},
+		{Name: "b", Type: googlesqlite.ParameterType{Type: "BYTES"}},
+		{Name: "d", Type: googlesqlite.ParameterType{Type: "ARRAY", ArrayType: &date}},
+		{Name: "s", Type: googlesqlite.ParameterType{Type: "STRING"}},
+	}
+	st := googlesqlite.TypedParameter{Type: "STRUCT", StructTypes: fields,
+		StructValues: []googlesqlite.TypedParameter{scalar("NUMERIC", "1.25"), scalar("BYTES", "_wBh"), dates, null("STRING")}}
+
+	type want struct{ typ, value string }
+	for _, tc := range []struct {
+		name  string
+		sql   string // a ? or @p in it
+		arg   any
+		wants []want // a column each
+	}{
+		{"a NULL STRING", "SELECT {} AS a", null("STRING"), []want{{"STRING", "<NULL>"}}},
+		{"a NULL DATE", "SELECT {} AS a", null("DATE"), []want{{"DATE", "<NULL>"}}},
+		{"a NULL NUMERIC", "SELECT {} AS a", null("NUMERIC"), []want{{"NUMERIC", "<NULL>"}}},
+		{"a NULL BOOL", "SELECT {} AS a", null("BOOL"), []want{{"BOOL", "<NULL>"}}},
+		{"a NULL JSON", "SELECT {} AS a", null("JSON"), []want{{"JSON", "<NULL>"}}},
+		{"an ARRAY<DATE>", "SELECT {}[OFFSET(1)] AS a, ARRAY_LENGTH({}) AS n", dates,
+			[]want{{"DATE", "2024-01-03"}, {"INT64", "2"}}},
+		{"an empty ARRAY<DATE>", "SELECT ARRAY_LENGTH({}) AS n",
+			googlesqlite.TypedParameter{Type: "ARRAY", ArrayType: &date}, []want{{"INT64", "0"}}},
+		{"a NULL ARRAY<DATE>", "SELECT {} IS NULL AS a",
+			googlesqlite.TypedParameter{Type: "ARRAY", ArrayType: &date, Null: true}, []want{{"BOOL", "true"}}},
+		{"a STRUCT's fields", "SELECT {}.n AS n, TO_HEX({}.b) AS b, {}.d[OFFSET(0)] AS d, {}.s IS NULL AS s", st,
+			[]want{{"NUMERIC", "1.25"}, {"STRING", "ff0061"}, {"DATE", "2024-01-02"}, {"BOOL", "true"}}},
+		{"a NULL STRUCT", "SELECT {} IS NULL AS a",
+			googlesqlite.TypedParameter{Type: "STRUCT", StructTypes: fields, Null: true}, []want{{"BOOL", "true"}}},
+		{"an ARRAY of STRUCTs", "SELECT {}[OFFSET(0)].n AS n",
+			googlesqlite.TypedParameter{Type: "ARRAY", ArrayType: &googlesqlite.ParameterType{Type: "STRUCT", StructTypes: fields},
+				ArrayValues: []googlesqlite.TypedParameter{st}}, []want{{"NUMERIC", "1.25"}}},
+	} {
+		for _, named := range []bool{false, true} {
+			q, ref := tc.sql, "?"
+			if named {
+				ref = "@p"
+			}
+			var args []any
+			for {
+				i := indexOf(q, "{}")
+				if i < 0 {
+					break
+				}
+				q = q[:i] + ref + q[i+2:]
+				if !named {
+					args = append(args, tc.arg)
+				}
+			}
+			if named {
+				args = []any{sql.Named("p", tc.arg)}
+			}
+			rows, err := db.QueryContext(ctx, q, args...)
+			if err != nil {
+				t.Errorf("%s: %s: %v", tc.name, q, err)
+				continue
+			}
+			cts, err := rows.ColumnTypes()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !rows.Next() {
+				t.Errorf("%s: %s: no row: %v", tc.name, q, rows.Err())
+				rows.Close()
+				continue
+			}
+			got := make([]any, len(cts))
+			ptrs := make([]any, len(cts))
+			for i := range got {
+				ptrs[i] = &got[i]
+			}
+			if err := rows.Scan(ptrs...); err != nil {
+				t.Errorf("%s: %s: scan: %v", tc.name, q, err)
+				rows.Close()
+				continue
+			}
+			rows.Close()
+			if len(cts) != len(tc.wants) {
+				t.Errorf("%s: %s: %d columns, want %d", tc.name, q, len(cts), len(tc.wants))
+				continue
+			}
+			for i, w := range tc.wants {
+				var typ struct{ Name string }
+				if err := json.Unmarshal([]byte(cts[i].DatabaseTypeName()), &typ); err != nil {
+					t.Fatalf("column type %q: %v", cts[i].DatabaseTypeName(), err)
+				}
+				if typ.Name != w.typ {
+					t.Errorf("%s: %s: column %d type %s, want %s", tc.name, q, i, typ.Name, w.typ)
+				}
+				v := "<NULL>"
+				if got[i] != nil {
+					v = toText(got[i])
+				}
+				if v != w.value {
+					t.Errorf("%s: %s: column %d = %q, want %q", tc.name, q, i, v, w.value)
+				}
+			}
+		}
+	}
+
+	// Inserted into a RECORD and a REPEATED RECORD column, not lined up
+	// with the INSERT's columns by position (VALUES (1, @p, @a) put @a
+	// against r, and read its ARRAY as a STRUCT).
+	if _, err := db.ExecContext(ctx, "CREATE TABLE rt (id INT64, r STRUCT<z BYTES, n INT64>, rr ARRAY<STRUCT<z BYTES, n INT64>>)"); err != nil {
+		t.Fatal(err)
+	}
+	zn := []googlesqlite.ParameterField{{Name: "z", Type: googlesqlite.ParameterType{Type: "BYTES"}},
+		{Name: "n", Type: googlesqlite.ParameterType{Type: "INT64"}}}
+	znValue := func(z, n string) googlesqlite.TypedParameter {
+		return googlesqlite.TypedParameter{Type: "STRUCT", StructTypes: zn,
+			StructValues: []googlesqlite.TypedParameter{scalar("BYTES", z), scalar("INT64", n)}}
+	}
+	znType := googlesqlite.ParameterType{Type: "STRUCT", StructTypes: zn}
+	if _, err := db.ExecContext(ctx, "INSERT INTO rt (id, r, rr) VALUES (1, @p, @a)", sql.Named("p", znValue("/wBh", "5")),
+		sql.Named("a", googlesqlite.TypedParameter{Type: "ARRAY", ArrayType: &znType,
+			ArrayValues: []googlesqlite.TypedParameter{znValue("AQ==", "6"), znValue("/wBh", "7")}})); err != nil {
+		t.Fatalf("INSERT of STRUCTs: %v", err)
+	}
+	var got string
+	if err := db.QueryRowContext(ctx, "SELECT FORMAT('%s %d %s %d', TO_HEX(r.z), r.n, TO_HEX(rr[OFFSET(0)].z), rr[OFFSET(1)].n) FROM rt").Scan(&got); err != nil {
+		t.Fatalf("the inserted STRUCTs: %v", err)
+	} else if got != "ff0061 5 01 7" {
+		t.Errorf("the inserted STRUCTs = %q, want %q", got, "ff0061 5 01 7")
+	}
+
+	// A value that is not base64 in a STRUCT's BYTES field is refused.
+	bad := googlesqlite.TypedParameter{Type: "STRUCT", StructTypes: fields[1:2],
+		StructValues: []googlesqlite.TypedParameter{scalar("BYTES", "not base64!")}}
+	if rows, err := db.QueryContext(ctx, "SELECT @p.b", sql.Named("p", bad)); err == nil {
+		rows.Close()
+		t.Errorf("a STRUCT with a BYTES field that is not base64 was not refused")
+	}
+}
+
+func indexOf(s, sub string) int {
+	for i := 0; i+len(sub) <= len(s); i++ {
+		if s[i:i+len(sub)] == sub {
+			return i
+		}
+	}
+	return -1
+}
+
+func toText(v any) string {
+	switch x := v.(type) {
+	case []byte:
+		return string(x)
+	case string:
+		return x
+	}
+	b, _ := json.Marshal(v)
+	return string(b)
+}
