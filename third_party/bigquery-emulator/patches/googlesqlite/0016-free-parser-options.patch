--- a/internal/analyzer.go
+++ b/internal/analyzer.go
@@ -1131,7 +1131,19 @@
 	if loc == nil {
 		return nil, fmt.Errorf("failed to create parse resume location for %q: %w", query, locErr)
 	}
-	parserOpts, err := a.opt.GetParserOptions()
+	// CloudBurrow patch (cloudburrow/cloudburrow#1133, #1057, #1103):
+	// a.opt.GetParserOptions() returns a new C++ ParserOptions, which
+	// holds the arena and string pool each parse tree is built in, as a
+	// handle with no finalizer, so every statement parsed (every query,
+	// and each the emulator runs for itself at every request) leaked its
+	// parse tree in the engine's WebAssembly memory, which only grows.
+	// NewParserOptions2 makes one the Go handle owns: it is freed once no
+	// ParserOutput (each keeps its options reachable) is left.
+	langOpts, err := a.opt.Language()
+	if err != nil {
+		return nil, fmt.Errorf("failed to get language options: %w", err)
+	}
+	parserOpts, err := googlesql.NewParserOptions2(nil, nil, langOpts)
 	if err != nil {
 		return nil, fmt.Errorf("failed to get parser options: %w", err)
 	}
