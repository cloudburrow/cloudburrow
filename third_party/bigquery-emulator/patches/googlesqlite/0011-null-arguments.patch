diff --git a/null_arguments_test.go b/null_arguments_test.go
new file mode 100644
index 0000000..5b9b89e
--- /dev/null
+++ b/null_arguments_test.go
@@ -0,0 +1,98 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+)
+
+// TestNullArguments is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1109, #1121): these functions panicked, or
+// failed, on a NULL argument, where in BigQuery "If an operand is NULL, the
+// function result is NULL" unless the function says otherwise; and IN
+// returned FALSE where a comparison with NULL decides.
+func TestNullArguments(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=null_arguments")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	const p = "ST_GEOGPOINT(1, 2)"
+	// Each is NULL.
+	for _, expr := range []string{
+		"ARRAY_TO_STRING(CAST(NULL AS ARRAY<STRING>), ',')",
+		"ARRAY_TO_STRING(['a'], CAST(NULL AS STRING))",
+		"ARRAY_TO_STRING(['a'], ',', CAST(NULL AS STRING))",
+		"ARRAY_CONCAT([1], CAST(NULL AS ARRAY<INT64>))",
+		"ARRAY_REVERSE(CAST(NULL AS ARRAY<INT64>))",
+		"NET.IP_TO_STRING(CAST(NULL AS BYTES))",
+		"NET.IP_TRUNC(CAST(NULL AS BYTES), 8)",
+		"NET.IPV4_FROM_INT64(CAST(NULL AS INT64))",
+		"NET.IPV4_TO_INT64(CAST(NULL AS BYTES))",
+		"NET.PUBLIC_SUFFIX(CAST(NULL AS STRING))",
+		"NET.REG_DOMAIN(CAST(NULL AS STRING))",
+		"GENERATE_DATE_ARRAY('2020-01-01', '2020-01-03', INTERVAL CAST(NULL AS INT64) DAY)",
+		"GENERATE_DATE_ARRAY(CAST(NULL AS DATE), '2020-01-03')",
+		"GENERATE_TIMESTAMP_ARRAY('2020-01-01', '2020-01-02', INTERVAL CAST(NULL AS INT64) HOUR)",
+		"MAKE_INTERVAL(1, CAST(NULL AS INT64))",
+		"INTERVAL CAST(NULL AS INT64) DAY",
+		"JUSTIFY_DAYS(CAST(NULL AS INTERVAL))",
+		"JUSTIFY_HOURS(CAST(NULL AS INTERVAL))",
+		"JUSTIFY_INTERVAL(CAST(NULL AS INTERVAL))",
+		"JSON_TYPE(CAST(NULL AS JSON))",
+		"ST_BUFFER(" + p + ", CAST(NULL AS FLOAT64))",
+		"ST_BUFFERWITHTOLERANCE(" + p + ", CAST(NULL AS FLOAT64), 1)",
+		"ST_INTERSECTSBOX(" + p + ", CAST(NULL AS FLOAT64), 0, 10, 10)",
+		"ST_HAUSDORFFDWITHIN(" + p + ", " + p + ", CAST(NULL AS FLOAT64))",
+		"ST_DISTANCE(" + p + ", CAST(NULL AS GEOGRAPHY))",
+		"NULLIF(CAST(NULL AS INT64), 1)",
+		"CAST(NULL AS INT64) IN UNNEST([1, 2])",
+		"1 IN UNNEST([2, NULL])",
+		"1 NOT IN UNNEST([2, NULL])",
+		"1 IN (2, NULL)",
+		"CAST(NULL AS INT64) IN (1, 2)",
+	} {
+		var isNull bool
+		if err := db.QueryRowContext(ctx, "SELECT ("+expr+") IS NULL").Scan(&isNull); err != nil {
+			t.Errorf("%s: %v", expr, err)
+			continue
+		}
+		if !isNull {
+			t.Errorf("%s is not NULL", expr)
+		}
+	}
+	// Each is this value: the calls with every argument, or with the
+	// optional ones left out, are not NULL.
+	for _, tc := range []struct{ expr, want string }{
+		{"ARRAY_TO_STRING(['a', 'b'], ',')", "a,b"},
+		{"ARRAY_TO_STRING(['a', NULL], ',', 'x')", "a,x"},
+		{"CAST(ARRAY_LENGTH(GENERATE_DATE_ARRAY('2020-01-01', '2020-01-03')) AS STRING)", "3"},
+		{"CAST(MAKE_INTERVAL(hour => 10) AS STRING)", "0-0 0 10:0:0"},
+		{"CAST(ST_BUFFER(" + p + ", 10) IS NULL AS STRING)", "false"},
+		{"CAST(ST_INTERSECTSBOX(" + p + ", 0, 0, 10, 10) AS STRING)", "true"},
+		{"CAST(ST_DISTANCE(" + p + ", " + p + ") AS STRING)", "0"},
+		{"CAST(NULLIF(1, NULL) AS STRING)", "1"},
+		{"CAST(1 IN UNNEST([NULL, 1]) AS STRING)", "true"},
+		{"CAST(1 IN UNNEST([2, 3]) AS STRING)", "false"},
+		{"CAST(CAST(NULL AS INT64) IN UNNEST(CAST([] AS ARRAY<INT64>)) AS STRING)", "false"},
+		{"CAST(1 IN UNNEST(CAST(NULL AS ARRAY<INT64>)) AS STRING)", "false"},
+		{"CAST(1 IN (NULL, 1) AS STRING)", "true"},
+		{"TO_JSON_STRING(JSON_SET(JSON '{\"a\":1}', '$.a', CAST(NULL AS INT64)))", `{"a":null}`},
+	} {
+		var got sql.NullString
+		if err := db.QueryRowContext(ctx, "SELECT "+tc.expr).Scan(&got); err != nil {
+			t.Errorf("%s: %v", tc.expr, err)
+			continue
+		}
+		if !got.Valid || got.String != tc.want {
+			t.Errorf("%s = %v, want %q", tc.expr, got, tc.want)
+		}
+	}
+	// An error in BigQuery too, but not a panic.
+	var s sql.NullString
+	if err := db.QueryRowContext(ctx, "SELECT TO_JSON_STRING(JSON_OBJECT(CAST(NULL AS STRING), 1))").Scan(&s); err == nil || !strings.Contains(err.Error(), "key is NULL") {
+		t.Errorf("JSON_OBJECT(NULL, 1) = %v, %v, want the error \"a key is NULL\"", s, err)
+	}
+}
