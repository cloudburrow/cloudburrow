diff --git a/internal/function_null_args.go b/internal/function_null_args.go
new file mode 100644
index 0000000..8018e57
--- /dev/null
+++ b/internal/function_null_args.go
@@ -0,0 +1,65 @@
+package internal
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/goccy/googlesqlite/internal/functions/helper"
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1109, #1121): NULL arguments.
+//
+// In BigQuery "If an operand is NULL, the function result is NULL" unless a
+// function's description says otherwise (function call rules,
+// https://cloud.google.com/bigquery/docs/reference/standard-sql/functions-reference).
+// googlesqlite v0.3.1 hands a SQL NULL to a function as a nil value.Value,
+// and the functions below called a method on it without looking, so the
+// call panicked; nothing recovered it, and the BigQuery emulator answered
+// the query 500. Others returned an error for a NULL argument.
+//
+// nullStrictFuncs are those whose result is NULL when any argument is: the
+// call is not made then. guardBindFunc also turns a panic of any function
+// into an error naming it, so a NULL (or any value) a function does not
+// expect fails the query instead of the process's request.
+var nullStrictFuncs = map[string]bool{
+	"array_concat":             true, // "returns NULL if any input argument is NULL"
+	"array_reverse":            true,
+	"array_to_string":          true,
+	"generate_date_array":      true, // "If any argument is NULL, the function returns a NULL array"
+	"generate_timestamp_array": true,
+	"interval":                 true, // INTERVAL <NULL> DAY
+	"make_interval":            true,
+	"justify_days":             true,
+	"justify_hours":            true,
+	"justify_interval":         true,
+	"json_type":                true,
+	"net_ip_to_string":         true,
+	"net_ip_trunc":             true,
+	"net_ipv4_from_int64":      true,
+	"net_ipv4_to_int64":        true,
+	"net_public_suffix":        true,
+	"net_reg_domain":           true,
+	"st_buffer":                true,
+	"st_bufferwithtolerance":   true,
+	"st_intersectsbox":         true,
+	"st_hausdorffdwithin":      true,
+	"st_distance":              true,
+}
+
+// guardBindFunc is fn, the function registered as name, with the NULL
+// rule above and its panics returned as errors.
+func guardBindFunc(name string, fn BindFunction) BindFunction {
+	strict := nullStrictFuncs[name]
+	return func(args ...value.Value) (ret value.Value, err error) {
+		if strict && helper.ExistsNull(args) {
+			return nil, nil
+		}
+		defer func() {
+			if r := recover(); r != nil {
+				ret, err = nil, fmt.Errorf("%s: %v", strings.ToUpper(name), r)
+			}
+		}()
+		return fn(args...)
+	}
+}
