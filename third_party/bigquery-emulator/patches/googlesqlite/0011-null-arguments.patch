+}
+
+// InValues is IN of a and values.
+func InValues(a value.Value, values []value.Value) (value.Value, error) {
+	if len(values) == 0 {
+		return value.BoolValue(false), nil
 	}
+	sawNull := false
 	for _, v := range values {
-		if v == nil {
+		if a == nil || v == nil {
+			sawNull = true
 			continue
 		}
 		cond, err := a.EQ(v)
@@ -20,6 +33,9 @@ func IN(a value.Value, values ...value.Value) (value.Value, error) {
