+// castInZone casts v, of a cast zonedCast takes, in loc; ok is false for
+// any other.
+func castInZone(v value.Value, to googlesql.TypeKind, l *time.Location) (value.Value, bool, error) {
+	if ts, isTS := v.(value.TimestampValue); isTS {
+		t := time.Time(ts).In(l)
+		switch to {
+		case googlesql.TypeKindTypeString:
+			return value.StringValue(value.FormatTimestamp(t, l)), true, nil
+		case googlesql.TypeKindTypeDate:
+			return value.DateValue(t), true, nil
+		case googlesql.TypeKindTypeDatetime:
+			return value.DatetimeValue(t), true, nil
+		case googlesql.TypeKindTypeTime:
+			return value.TimeValue(t), true, nil
+		}
+		return nil, false, nil
+	}
+	if to != googlesql.TypeKindTypeTimestamp {
+		return nil, false, nil
+	}
+	switch x := v.(type) {
+	case value.StringValue:
+		t, err := value.ParseTimestamp(string(x), l)
+		if err != nil {
+			return nil, true, err
+		}
+		return value.TimestampValue(t), true, nil
+	case value.DateValue, value.DatetimeValue:
+		t, err := x.ToTime()
+		if err != nil {
+			return nil, true, err
+		}
+		return value.TimestampValue(civilIn(t, l)), true, nil
+	}
+	return nil, false, nil
+}
+
+// civilIn is the time t's wall clock reads in loc.
+func civilIn(t time.Time, loc *time.Location) time.Time {
+	return time.Date(t.Year(), t.Month(), t.Day(), t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), loc)
+}
+
+// naiveTimestampSuffix is what a TIMESTAMP literal with no zone gets to be
+// read in zone: an offset, "+05:30", or a name after a space.
+func naiveTimestampSuffix(zone string) string {
+	if m := offsetZone.FindStringSubmatch(zone); m != nil {
+		hh, mm := m[2], m[3]
+		if len(hh) == 1 {
+			hh = "0" + hh
+		}
+		if mm == "" {
+			mm = "00"
+		}
+		return fmt.Sprintf("%s%s:%s", m[1], hh, mm)
+	}
+	return " " + zone
+}
