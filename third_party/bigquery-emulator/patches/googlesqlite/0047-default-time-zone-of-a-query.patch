+++ b/internal/default_time_zone.go
@@ -0,0 +1,183 @@
+package internal
+
+import (
+	"context"
+	"fmt"
+	"regexp"
+	"strings"
+	"time"
+
+	googlesql "github.com/goccy/go-googlesql"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1456): a default time zone
+// for one query, BigQuery's project option default_time_zone: "the default
+// time zone to use in time zone-dependent GoogleSQL functions, when a time
+// zone is not specified as an argument". The engine knew UTC only (patch
+// 0022). With WithDefaultTimeZone on the query's context:
+//
+//   - a call that takes a zone and is given none gets this one, where its
+//     argument's type is TIMESTAMP (DATE, DATETIME, TIME, STRING, EXTRACT,
+//     TIMESTAMP_TRUNC, DATE_TRUNC, DATETIME_TRUNC, FORMAT_TIMESTAMP), or
+//     where it makes one (TIMESTAMP(string|date|datetime),
+//     PARSE_TIMESTAMP, CURRENT_DATE, CURRENT_DATETIME, CURRENT_TIME);
+//   - a cast between TIMESTAMP and STRING, DATE, DATETIME or TIME;
+//   - a TIMESTAMP literal with no zone, and a STRING literal cast to
+//     TIMESTAMP, read in it.
+//
+// The analyzer's own zone stays UTC (go-googlesql can build no other), so
+// a query with a zone is analyzed with literal casts unfolded
+// (getZonedAnalyzerOptions) and the run time does them.
+
+type defaultTimeZoneKey struct{}
+
+// WithDefaultTimeZone returns ctx with zone, a tz database name or an
+// offset (+05:30), the default zone of the queries run with it. "" and
+// "UTC" leave the default UTC.
+func WithDefaultTimeZone(ctx context.Context, zone string) context.Context {
+	return context.WithValue(ctx, defaultTimeZoneKey{}, zone)
+}
+
+// DefaultTimeZone returns the default zone ctx carries, "" for UTC.
+func DefaultTimeZone(ctx context.Context) string {
+	if ctx == nil {
+		return ""
+	}
+	zone, _ := ctx.Value(defaultTimeZoneKey{}).(string)
+	if strings.EqualFold(zone, "UTC") {
+		return ""
+	}
+	return zone
+}
+
+// zonedFuncs are the functions given the default zone, by name, and the
+// number of arguments of the call that gives none.
+var zonedFuncs = map[string]int{
+	"date": 1, "datetime": 1, "time": 1, "string": 1,
+	"extract": 2, "extract_date": 1,
+	"timestamp_trunc": 2, "date_trunc": 2, "datetime_trunc": 2,
+	"format_timestamp": 2, "parse_timestamp": 2, "timestamp": 1,
+	"current_date": 0, "current_datetime": 0, "current_time": 0,
+}
+
+// zoneArgument is the index of the argument whose type says whether the
+// call takes a zone: a TIMESTAMP; -1 when every call of that arity does.
+var zoneArgument = map[string]int{
+	"date": 0, "datetime": 0, "time": 0, "string": 0,
+	"extract": 0, "extract_date": 0,
+	"timestamp_trunc": -1, "date_trunc": 0, "datetime_trunc": 0,
+	"format_timestamp": -1, "parse_timestamp": -1, "timestamp": -1,
+	"current_date": -1, "current_datetime": -1, "current_time": -1,
+}
+
+// appendDefaultTimeZone gives the call node, named name (its "$" cut),
+// the default zone of ctx when it takes one and its arguments give none.
+func appendDefaultTimeZone(ctx context.Context, name string, node *ResolvedBaseFunctionCallNode, args []string) ([]string, error) {
+	zone := DefaultTimeZone(ctx)
+	if zone == "" {
+		return args, nil
+	}
+	name = strings.TrimPrefix(name, "$")
+	n, ok := zonedFuncs[name]
+	if !ok {
+		return args, nil
+	}
+	list := m1(node.ArgumentList())
+	if len(list) != n {
+		return args, nil
+	}
+	if i := zoneArgument[name]; i >= 0 {
+		if m1(m1(list[i].Type()).Kind()) != googlesql.TypeKindTypeTimestamp {
+			return args, nil
+		}
+	}
+	lit, err := literalFromValue(value.StringValue(zone))
+	if err != nil {
+		return nil, err
+	}
+	return append(args, lit), nil
+}
+
+// castTimeZone returns the SQL of the zone a cast from from to to is done
+// in, "NULL" for UTC.
+func castTimeZone(ctx context.Context, from, to googlesql.TypeKind) (string, error) {
+	zone := DefaultTimeZone(ctx)
+	if zone == "" || !zonedCast(from, to) {
+		return "NULL", nil
+	}
+	return literalFromValue(value.StringValue(zone))
+}
+
+func zonedCast(from, to googlesql.TypeKind) bool {
+	civil := func(k googlesql.TypeKind) bool {
+		switch k {
