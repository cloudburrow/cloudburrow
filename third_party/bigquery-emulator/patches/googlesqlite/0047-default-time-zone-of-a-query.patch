+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1456): a query run with
+// WithDefaultTimeZone reads and writes TIMESTAMPs in that zone wherever a
+// function or cast takes a zone and is given none, a column's as a
+// literal's; an explicit zone, and a DATETIME, are kept.
+func TestDefaultTimeZoneOfAQuery(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=default_time_zone_of_a_query")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	for _, q := range []string{
+		"CREATE TABLE t (ts TIMESTAMP, d DATE, dt DATETIME, s STRING)",
+		"INSERT INTO t VALUES (TIMESTAMP '2020-01-01 03:00:00+00', DATE '2020-01-01', DATETIME '2020-01-01 00:00:00', '2020-01-01 00:00:00')",
+	} {
+		if _, err := db.Exec(q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	// 2020-01-01 00:00:00 in New York (-05) is 1577854800.
+	cases := []struct{ expr, want string }{
+		{"STRING(ts)", "2019-12-31 22:00:00-05"},
+		{"CAST(DATE(ts) AS STRING)", "2019-12-31"},
+		{"CAST(DATETIME(ts) AS STRING)", "2019-12-31 22:00:00"},
+		{"CAST(TIME(ts) AS STRING)", "22:00:00"},
+		{"CAST(EXTRACT(HOUR FROM ts) AS STRING)", "22"},
+		{"CAST(EXTRACT(DATE FROM ts) AS STRING)", "2019-12-31"},
+		{"CAST(UNIX_SECONDS(TIMESTAMP_TRUNC(ts, DAY)) AS STRING)", "1577768400"},
+		{"FORMAT_TIMESTAMP('%F %T %Z', ts)", "2019-12-31 22:00:00 EST"},
+		{"CAST(UNIX_SECONDS(PARSE_TIMESTAMP('%F %T', s)) AS STRING)", "1577854800"},
+		{"CAST(UNIX_SECONDS(TIMESTAMP(s)) AS STRING)", "1577854800"},
+		{"CAST(UNIX_SECONDS(TIMESTAMP(d)) AS STRING)", "1577854800"},
+		{"CAST(UNIX_SECONDS(TIMESTAMP(dt)) AS STRING)", "1577854800"},
+		{"CAST(ts AS STRING)", "2019-12-31 22:00:00-05"},
+		{"CAST(CAST(ts AS DATE) AS STRING)", "2019-12-31"},
+		{"CAST(CAST(ts AS DATETIME) AS STRING)", "2019-12-31 22:00:00"},
+		{"CAST(CAST(ts AS TIME) AS STRING)", "22:00:00"},
+		{"CAST(UNIX_SECONDS(CAST(d AS TIMESTAMP)) AS STRING)", "1577854800"},
+		{"CAST(UNIX_SECONDS(CAST(dt AS TIMESTAMP)) AS STRING)", "1577854800"},
+		{"CAST(UNIX_SECONDS(CAST(s AS TIMESTAMP)) AS STRING)", "1577854800"},
+		{"CAST(UNIX_SECONDS(SAFE_CAST(s AS TIMESTAMP)) AS STRING)", "1577854800"},
+		{"CAST(ts AS STRING FORMAT 'YYYY-MM-DD HH24')", "2019-12-31 22"},
+		// Literals.
+		{"CAST(UNIX_SECONDS(TIMESTAMP '2020-01-01 00:00:00') AS STRING)", "1577854800"},
+		{"CAST(UNIX_SECONDS(TIMESTAMP '2020-01-01') AS STRING)", "1577854800"},
+		{"CAST(UNIX_SECONDS(CAST('2020-01-01 00:00:00' AS TIMESTAMP)) AS STRING)", "1577854800"},
+		{"STRING(TIMESTAMP '2020-01-01 03:00:00+00')", "2019-12-31 22:00:00-05"},
+		{"CAST(DATE(TIMESTAMP '2020-01-01 03:00:00+00') AS STRING)", "2019-12-31"},
+		{"CAST(TIMESTAMP '2020-01-01 03:00:00+00' AS STRING)", "2019-12-31 22:00:00-05"},
+		{"CAST(UNIX_SECONDS(CAST(DATE '2020-01-01' AS TIMESTAMP)) AS STRING)", "1577854800"},
+		{"CAST(CAST(TIMESTAMP '2020-01-01 03:00:00+00' AS DATE) AS STRING)", "2019-12-31"},
+		{"CAST(DATE_TRUNC(ts, MONTH) AS STRING)", "2019-12-01 00:00:00-05"},
+		// An explicit zone, a zone of its own, and a DATETIME are kept.
+		{"STRING(ts, 'UTC')", "2020-01-01 03:00:00+00"},
+		{"CAST(DATE(ts, 'UTC') AS STRING)", "2020-01-01"},
+		{"CAST(EXTRACT(HOUR FROM ts AT TIME ZONE 'UTC') AS STRING)", "3"},
+		{"CAST(UNIX_SECONDS(TIMESTAMP '2020-01-01 00:00:00+00') AS STRING)", "1577836800"},
+		{"CAST(UNIX_SECONDS(TIMESTAMP(s, 'UTC')) AS STRING)", "1577836800"},
+		{"CAST(DATE(dt) AS STRING)", "2020-01-01"},
+		{"CAST(EXTRACT(HOUR FROM dt) AS STRING)", "0"},
+		{"CAST(CAST(dt AS STRING) AS STRING)", "2020-01-01 00:00:00"},
+	}
+	run := func(ctx context.Context, expr string) (string, error) {
+		var got string
+		err := db.QueryRowContext(ctx, "SELECT "+expr+" FROM t").Scan(&got)
+		return got, err
+	}
+	ctx := googlesqlite.WithDefaultTimeZone(context.Background(), "America/New_York")
+	for _, c := range cases {
+		got, err := run(ctx, c.expr)
+		if err != nil {
+			t.Errorf("%s: %v", c.expr, err)
+			continue
+		}
+		if got != c.want {
+			t.Errorf("%s = %q, want %q", c.expr, got, c.want)
+		}
+	}
+	// An offset zone.
+	off := googlesqlite.WithDefaultTimeZone(context.Background(), "+05:30")
+	for _, c := range []struct{ expr, want string }{
+		{"STRING(ts)", "2020-01-01 08:30:00+05:30"},
+		{"CAST(UNIX_SECONDS(TIMESTAMP '2020-01-01 05:30:00') AS STRING)", "1577836800"},
+	} {
+		if got, err := run(off, c.expr); err != nil || got != c.want {
+			t.Errorf("+05:30: %s = %q, %v; want %q", c.expr, got, err, c.want)
+		}
+	}
+	// No zone, or UTC: UTC.
+	for _, ctx := range []context.Context{context.Background(), googlesqlite.WithDefaultTimeZone(context.Background(), "UTC")} {
+		if got, err := run(ctx, "STRING(ts)"); err != nil || got != "2020-01-01 03:00:00+00" {
+			t.Errorf("UTC: STRING(ts) = %q, %v", got, err)
+		}
+	}
+}
