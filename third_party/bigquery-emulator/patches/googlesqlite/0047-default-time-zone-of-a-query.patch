+package googlesqlite
+
+import (
+	"context"
+
+	"github.com/goccy/googlesqlite/internal"
+)
+
+// WithDefaultTimeZone returns ctx with zone, a tz database name or an
+// offset ("+05:30"), the default time zone of the queries run with it:
+// BigQuery's default_time_zone. Functions and casts that take a zone and
+// are given none, and TIMESTAMP literals with none, use it; "" or "UTC"
+// keeps UTC. CloudBurrow patch (cloudburrow/cloudburrow#1456).
+func WithDefaultTimeZone(ctx context.Context, zone string) context.Context {
+	return internal.WithDefaultTimeZone(ctx, zone)
+}
