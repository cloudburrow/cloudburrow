+++ b/internal/catalog_written.go
@@ -0,0 +1,33 @@
+package internal
+
+// Rows a catalog wrote (CloudBurrow patch, cloudburrow/cloudburrow#1823).
+//
+// A database has one catalog, shared by its connections, and it holds
+// every spec they saved or deleted from the moment they did. Sync reads
+// the catalog table's rows saved since the last Sync, on the connection of
+// the statement being analyzed. Since the BigQuery emulator runs reads
+// beside the writer (a file database in WAL mode), that connection may read
+// an older snapshot: one with a row a later save replaced, or a later
+// delete removed. The rows' times follow the front's clock, which moves,
+// and are compared as text (RFC3339Nano, its trailing zeros trimmed, so not
+// in time order within a second), so such an older row could pass Sync's
+// filter, and Sync put the older spec back over the newer one, or a
+// dropped table back in the catalog. This catalog is the only writer of its
+// database's rows (its process's one), so a row of a name it wrote or
+// deleted is never newer than what it holds for that name: Sync skips it.
+
+// wrote records that the catalog wrote or deleted the row name. Called
+// under c.mu.
+func (c *Catalog) wrote(name string) {
+	if c.written == nil {
+		c.written = map[string]struct{}{}
+	}
+	c.written[name] = struct{}{}
+}
+
+// holds reports whether the catalog wrote or deleted the row name, so that
+// it holds that name's newest spec, or none. Called under c.mu.
+func (c *Catalog) holds(name string) bool {
+	_, ok := c.written[name]
+	return ok
+}
