+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/goccy/googlesqlite"
+)
+
+// TestCatalogSyncOnAnOlderSnapshot is CloudBurrow's regression test
+// (cloudburrow/cloudburrow#1823): in WAL mode a reader reads the snapshot
+// its transaction began with, and the catalog's Sync, which runs on the
+// connection of the statement analyzed, read the catalog table's rows from
+// it. A row there that a later delete removed, and that passed Sync's
+// filter of times (here the clock was set back, as the front's moves), put
+// the dropped table back in the catalog: making it again failed, as a
+// table that exists.
+func TestCatalogSyncOnAnOlderSnapshot(t *testing.T) {
+	ctx := context.Background()
+	dsn := "file:" + filepath.Join(t.TempDir(), "db") + "?_pragma=busy_timeout(5000)&_pragma=journal_mode(wal)"
+	db, err := sql.Open("googlesqlite", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	exec("CREATE TABLE t (a INT64)")
+	exec("INSERT INTO t (a) VALUES (1)")
+
+	// A reader whose snapshot has the table's first spec.
+	reader, err := db.Conn(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reader.Close()
+	tx, err := reader.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback()
+	var n int64
+	if err := tx.QueryRowContext(ctx, "SELECT COUNT(*) FROM t").Scan(&n); err != nil || n != 1 {
+		t.Fatalf("COUNT(*) on the reader: %d, %v", n, err)
+	}
+
+	// The table is dropped, at a clock set back.
+	googlesqlite.SetClockOffset(-time.Hour)
+	defer googlesqlite.SetClockOffset(0)
+	exec("DROP TABLE t")
+
+	// The reader analyzes a statement, and so syncs, on its older snapshot.
+	var one int64
+	if err := tx.QueryRowContext(ctx, "SELECT 1").Scan(&one); err != nil {
+		t.Fatalf("SELECT 1 on the reader: %v", err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+
+	// The table is made again with a second column.
+	if _, err := db.ExecContext(ctx, "CREATE TABLE t (a INT64, b STRING)"); err != nil {
+		t.Fatalf("CREATE TABLE of a dropped table after a reader synced on an older snapshot: %v", err)
+	}
+	var b sql.NullString
+	if err := db.QueryRowContext(ctx, "SELECT b FROM t").Scan(&b); err != sql.ErrNoRows {
+		t.Fatalf("SELECT b FROM t: %v, want no rows", err)
+	}
+}
