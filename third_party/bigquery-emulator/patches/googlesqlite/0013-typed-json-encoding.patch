+package internal
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1116): TO_JSON_STRING,
+// TO_JSON and SAFE_TO_JSON encode their argument by its SQL type, as
+// GoogleSQL's JSON encodings table says
+// (https://cloud.google.com/bigquery/docs/reference/standard-sql/json_functions#json_encodings).
+//
+// A value reaches a function through SQLite, which has no BOOL: a stored
+// BOOL arrives as the integer 1 or 0, and each value's own ToJSON wrote
+// DATE, DATETIME, TIME and TIMESTAMP without quotes. So the formatter
+// passes the argument's static type as one more argument
+// (appendJSONArgType), the value is cast to that type first (as the row
+// scanner casts a column), and then encoded here by type.
+
+import (
+	"bytes"
+	"encoding/base64"
+	stdjson "encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"strconv"
+	"strings"
+
+	googlesql "github.com/goccy/go-googlesql"
+	"github.com/goccy/go-json"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// typedJSONFuncs are the functions the formatter passes their first
+// argument's type to, as their last argument.
+var typedJSONFuncs = map[string]bool{
+	"googlesqlite_to_json_string":      true,
+	"googlesqlite_safe_to_json_string": true,
+	"googlesqlite_to_json":             true,
+	"googlesqlite_safe_to_json":        true,
+}
+
+// appendJSONArgType appends the type of node's first argument to args, as
+// a string literal of its JSON (as CAST passes its types).
+func appendJSONArgType(node *ResolvedBaseFunctionCallNode, args []string) ([]string, error) {
+	argList, err := node.ArgumentList()
+	if err != nil || len(argList) == 0 {
+		return args, err
+	}
+	typ, err := argList[0].Type()
+	if err != nil {
+		return nil, err
+	}
+	encoded, err := json.Marshal(newType(typ))
+	if err != nil {
+		return nil, err
+	}
+	lit, err := encodeGoValue(m1(tf().MakeSimpleType(googlesql.TypeKindTypeString)), string(encoded))
+	if err != nil {
+		return nil, err
+	}
+	return append(args, fmt.Sprintf("'%s'", lit)), nil
+}
+
+// typedJSONArg splits the type the formatter appended off args, and
+// returns the first argument cast to it, and the other arguments.
+func typedJSONArg(name string, args []value.Value) (value.Value, []value.Value, error) {
+	if len(args) < 2 {
+		return nil, nil, fmt.Errorf("%s: invalid number of arguments: got %d", name, len(args))
+	}
+	encoded, err := args[len(args)-1].ToString()
+	if err != nil {
+		return nil, nil, err
+	}
+	var typ Type
+	if err := json.Unmarshal([]byte(encoded), &typ); err != nil {
+		return nil, nil, fmt.Errorf("%s: the argument's type: %w", name, err)
+	}
+	rest := args[1 : len(args)-1]
+	if args[0] == nil {
+		return nil, rest, nil
+	}
+	gt, err := typ.ToGoogleSQLType()
+	if err != nil {
+		return nil, nil, err
+	}
+	v, err := castValueWithSpec(gt, &typ, args[0])
+	if err != nil {
+		return nil, nil, err
+	}
+	return v, rest, nil
+}
+
+func bindTypedToJSONString(args ...value.Value) (value.Value, error) {
+	v, rest, err := typedJSONArg("TO_JSON_STRING", args)
+	if err != nil {
+		return nil, err
+	}
+	var pretty bool
+	if len(rest) > 0 && rest[0] != nil {
+		if pretty, err = rest[0].ToBool(); err != nil {
+			return nil, err
+		}
+	}
+	var b bytes.Buffer
+	if err := encodeJSONValue(&b, v, jsonMode{toJSONString: true}); err != nil {
+		return nil, err
+	}
+	if !pretty {
+		return value.StringValue(b.String()), nil
+	}
+	var out bytes.Buffer
+	if err := stdjson.Indent(&out, b.Bytes(), "", "  "); err != nil {
+		return nil, err
+	}
+	return value.StringValue(out.String()), nil
+}
+
+func bindTypedToJSON(args ...value.Value) (value.Value, error) {
+	v, rest, err := typedJSONArg("TO_JSON", args)
+	if err != nil {
+		return nil, err
+	}
+	if v == nil {
+		// SQL NULL, as before the patch (and SAFE_TO_JSON's spec).
+		return nil, nil
+	}
+	var mode jsonMode
+	if len(rest) > 0 && rest[0] != nil {
+		if mode.stringifyWideNumbers, err = rest[0].ToBool(); err != nil {
+			return nil, err
+		}
+	}
+	var b bytes.Buffer
+	if err := encodeJSONValue(&b, v, mode); err != nil {
+		return nil, err
+	}
+	return value.JsonValue(b.String()), nil
+}
+
+// bindTypedSafeToJSON is SAFE_TO_JSON: TO_JSON, NULL where it fails.
+func bindTypedSafeToJSON(args ...value.Value) (value.Value, error) {
+	v, err := bindTypedToJSON(args...)
+	if err != nil {
+		return nil, nil
+	}
+	return v, nil
+}
+
+type jsonMode struct {
+	// toJSONString is TO_JSON_STRING's encoding: an INT64, NUMERIC or
+	// BIGNUMERIC a double cannot hold is a string, and a STRUCT keeps
+	// duplicate field names. Otherwise TO_JSON's.
+	toJSONString bool
+	// stringifyWideNumbers is TO_JSON's stringify_wide_numbers.
+	stringifyWideNumbers bool
+}
+
+// maxExactInt is 2^53: integers in [-2^53, 2^53] are exact as doubles.
+const maxExactInt = 1 << 53
+
+var maxExactRat = new(big.Rat).SetInt64(maxExactInt)
+
+func encodeJSONValue(b *bytes.Buffer, v value.Value, mode jsonMode) error {
+	if v == nil {
+		b.WriteString("null")
+		return nil
+	}
+	switch x := v.(type) {
+	case *value.SafeValue:
+		return encodeJSONValue(b, x.Value, mode)
+	case value.BoolValue:
+		b.WriteString(strconv.FormatBool(bool(x)))
+	case value.IntValue:
+		i := int64(x)
+		wide := i < -maxExactInt || i > maxExactInt
+		if wide && (mode.toJSONString || mode.stringifyWideNumbers) {
+			b.WriteString(`"` + strconv.FormatInt(i, 10) + `"`)
+		} else {
+			b.WriteString(strconv.FormatInt(i, 10))
+		}
+	case value.FloatValue:
+		writeJSONFloat(b, float64(x))
+	case *value.NumericValue:
+		s, err := x.ToString()
+		if err != nil {
+			return err
+		}
+		abs := new(big.Rat).Abs(x.Rat)
+		wide := abs.Cmp(maxExactRat) > 0
+		switch {
+		case mode.toJSONString && (wide || !x.Rat.IsInt()):
+			b.WriteString(`"` + s + `"`)
+		case !mode.toJSONString && wide && mode.stringifyWideNumbers:
+			b.WriteString(`"` + s + `"`)
+		default:
+			b.WriteString(s)
+		}
+	case value.StringValue:
+		writeJSONString(b, string(x))
+	case value.BytesValue:
+		b.WriteString(`"` + base64.StdEncoding.EncodeToString([]byte(x)) + `"`)
+	case value.DateValue, value.DatetimeValue, value.TimeValue, value.TimestampValue:
+		s, err := v.ToJSON()
+		if err != nil {
+			return err
+		}
+		writeJSONString(b, s)
+	case *value.IntervalValue:
+		writeJSONString(b, isoInterval(x))
+	case value.JsonValue:
+		b.WriteString(string(x))
+	case *value.ArrayValue:
+		b.WriteByte('[')
+		for i, e := range x.Values {
+			if i > 0 {
+				b.WriteByte(',')
+			}
+			if err := encodeJSONValue(b, e, mode); err != nil {
+				return err
+			}
+		}
+		b.WriteByte(']')
+	case *value.StructValue:
+		b.WriteByte('{')
+		seen := map[string]bool{}
+		n := 0
+		for i, key := range x.Keys {
+			if !mode.toJSONString {
+				// TO_JSON keeps a field's first value only.
+				if seen[key] {
+					continue
+				}
+				seen[key] = true
+			}
+			if n > 0 {
+				b.WriteByte(',')
+			}
+			n++
+			writeJSONString(b, key)
+			b.WriteByte(':')
+			var e value.Value
+			if i < len(x.Values) {
+				e = x.Values[i]
+			}
+			if err := encodeJSONValue(b, e, mode); err != nil {
+				return err
+			}
+		}
+		b.WriteByte('}')
+	case *value.RangeValue:
+		b.WriteString(`{"start":`)
+		if err := encodeJSONValue(b, x.Start, mode); err != nil {
+			return err
+		}
+		b.WriteString(`,"end":`)
+		if err := encodeJSONValue(b, x.End, mode); err != nil {
+			return err
+		}
+		b.WriteByte('}')
+	default:
+		// GEOGRAPHY and the rest: as the value writes itself.
+		s, err := v.ToJSON()
+		if err != nil {
+			return err
+		}
+		b.WriteString(s)
+	}
+	return nil
+}
+
+// writeJSONFloat writes f as GoogleSQL does: +/-inf and NaN as the strings
+// "Infinity", "-Infinity" and "NaN", any other value as a number, 1.0 as
+// 1 (the shortest form that reads back as f, as encoding/json writes it).
+func writeJSONFloat(b *bytes.Buffer, f float64) {
+	switch {
+	case math.IsNaN(f):
+		b.WriteString(`"NaN"`)
+	case math.IsInf(f, 1):
+		b.WriteString(`"Infinity"`)
+	case math.IsInf(f, -1):
+		b.WriteString(`"-Infinity"`)
+	default:
+		out, _ := stdjson.Marshal(f)
+		b.Write(out)
+	}
+}
+
+// writeJSONString writes s as a JSON string, escaping ", \ and the control
+// characters U+0000 to U+001F, as GoogleSQL does, and nothing else.
+func writeJSONString(b *bytes.Buffer, s string) {
+	const hex = "0123456789abcdef"
+	b.WriteByte('"')
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch c {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\b':
+			b.WriteString(`\b`)
+		case '\f':
+			b.WriteString(`\f`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\r':
+			b.WriteString(`\r`)
+		case '\t':
+			b.WriteString(`\t`)
+		default:
+			if c < 0x20 {
+				b.WriteString(`\u00`)
+				b.WriteByte(hex[c>>4])
+				b.WriteByte(hex[c&0xf])
+			} else {
+				b.WriteByte(c)
+			}
+		}
+	}
+	b.WriteByte('"')
+}
+
+// isoInterval is iv as an ISO 8601 duration, as GoogleSQL encodes an
+// INTERVAL: INTERVAL '10:20:30.52' HOUR TO SECOND is PT10H20M30.52S,
+// INTERVAL -25 MONTH is P-2Y-1M, INTERVAL '1 5:30' DAY TO MINUTE is
+// P1DT5H30M. A zero interval is PT0S.
+func isoInterval(iv *value.IntervalValue) string {
+	c := iv.IntervalValue.Canonicalize()
+	var s strings.Builder
+	s.WriteByte('P')
+	part := func(n int32, unit byte) {
+		if n != 0 {
+			s.WriteString(strconv.FormatInt(int64(n), 10))
+			s.WriteByte(unit)
+		}
+	}
+	part(c.Years, 'Y')
+	part(c.Months, 'M')
+	part(c.Days, 'D')
+	if c.Hours != 0 || c.Minutes != 0 || c.Seconds != 0 || c.SubSecondNanos != 0 {
+		s.WriteByte('T')
+		part(c.Hours, 'H')
+		part(c.Minutes, 'M')
+		if c.Seconds != 0 || c.SubSecondNanos != 0 {
+			sec, nanos := int64(c.Seconds), int64(c.SubSecondNanos)
+			if sec < 0 || nanos < 0 {
+				s.WriteByte('-')
+				sec, nanos = -sec, -nanos
+			}
+			s.WriteString(strconv.FormatInt(sec, 10))
+			if nanos != 0 {
+				s.WriteByte('.')
+				s.WriteString(strings.TrimRight(fmt.Sprintf("%09d", nanos), "0"))
+			}
+			s.WriteByte('S')
+		}
+	}
+	if s.Len() == 1 {
+		return "PT0S"
+	}
+	return s.String()
+}
