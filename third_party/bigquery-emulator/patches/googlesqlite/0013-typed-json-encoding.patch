+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+// TestJSONEncodingOfEveryType is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1116): TO_JSON_STRING and TO_JSON encode each
+// type as GoogleSQL's JSON encodings table says, for a value read from a
+// table as for a literal. Before the patch a stored BOOL was written 1,
+// and a DATE, DATETIME, TIME or TIMESTAMP was left unquoted, which is not
+// JSON; a NUMERIC with a fraction was not a string, an INTERVAL was not an
+// ISO 8601 duration, and an INT64 beyond 2^53 was not a string.
+func TestJSONEncodingOfEveryType(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=json_encoding")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, q := range []string{
+		`CREATE TABLE t (i INT64, w INT64, f FLOAT64, inf FLOAT64, n NUMERIC, ni NUMERIC, bn BIGNUMERIC, s STRING, bb BYTES,
+			b BOOL, d DATE, dt DATETIME, tm TIME, ts TIMESTAMP, iv INTERVAL, js JSON, a ARRAY<BOOL>,
+			st STRUCT<x INT64, y BOOL, z DATE>, rts ARRAY<TIMESTAMP>, r RANGE<DATE>, nul STRING)`,
+		`INSERT t VALUES (1, 9007199254740993, 1.5, CAST('+inf' AS FLOAT64), NUMERIC '123.56', NUMERIC '-1', BIGNUMERIC '2.5',
+			'a"\\', b'Google', true, DATE '2017-03-06', DATETIME '2017-03-06 12:34:56.789012', TIME '12:34:56.789012',
+			TIMESTAMP '2017-03-06 12:34:56.789012 UTC', INTERVAL '10:20:30.52' HOUR TO SECOND, JSON '{"k":1}', [true, false],
+			STRUCT(3, false, DATE '2024-01-03'), [TIMESTAMP '2021-01-01 00:00:01.5 UTC'],
+			RANGE<DATE> '[2024-07-24, UNBOUNDED)', NULL)`,
+	} {
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	const want = `{"i":1,"w":"9007199254740993","f":1.5,"inf":"Infinity","n":"123.56","ni":-1,"bn":"2.5",` +
+		`"s":"a\"\\","bb":"R29vZ2xl","b":true,"d":"2017-03-06","dt":"2017-03-06T12:34:56.789012",` +
+		`"tm":"12:34:56.789012","ts":"2017-03-06T12:34:56.789012Z","iv":"PT10H20M30.52S","js":{"k":1},` +
+		`"a":[true,false],"st":{"x":3,"y":false,"z":"2024-01-03"},"rts":["2021-01-01T00:00:01.5Z"],` +
+		`"r":{"start":"2024-07-24","end":null},"nul":null}`
+	var got string
+	if err := db.QueryRowContext(ctx, "SELECT TO_JSON_STRING(t) FROM t").Scan(&got); err != nil {
+		t.Fatalf("TO_JSON_STRING(t): %v", err)
+	}
+	if !json.Valid([]byte(got)) {
+		t.Errorf("TO_JSON_STRING(t) is not JSON: %s", got)
+	}
+	if got != want {
+		t.Errorf("TO_JSON_STRING(t) =\n%s\nwant\n%s", got, want)
+	}
+	for q, want := range map[string]string{
+		"SELECT TO_JSON_STRING(b) FROM t":                                           `true`,
+		"SELECT TO_JSON_STRING(st) FROM t":                                          `{"x":3,"y":false,"z":"2024-01-03"}`,
+		"SELECT TO_JSON_STRING(a) FROM t":                                           `[true,false]`,
+		"SELECT TO_JSON_STRING(d) FROM t":                                           `"2017-03-06"`,
+		"SELECT TO_JSON_STRING(nul) FROM t":                                         `null`,
+		"SELECT TO_JSON_STRING(STRUCT(true AS b, DATE '2017-03-06' AS d))":          `{"b":true,"d":"2017-03-06"}`,
+		"SELECT TO_JSON_STRING(9007199254740992)":                                   `9007199254740992`,
+		"SELECT TO_JSON_STRING(NUMERIC '9007199254740993')":                         `"9007199254740993"`,
+		"SELECT TO_JSON_STRING(1.0)":                                                `1`,
+		"SELECT TO_JSON_STRING(CAST('NaN' AS FLOAT64))":                             `"NaN"`,
+		"SELECT TO_JSON_STRING(CAST('-inf' AS FLOAT64))":                            `"-Infinity"`,
+		"SELECT TO_JSON_STRING(INTERVAL 1 SECOND)":                                  `"PT1S"`,
+		"SELECT TO_JSON_STRING(INTERVAL 25 MONTH)":                                  `"P2Y1M"`,
+		"SELECT TO_JSON_STRING(INTERVAL '1 5:30' DAY TO MINUTE)":                    `"P1DT5H30M"`,
+		"SELECT TO_JSON_STRING(STRUCT(1 AS a, 2 AS a))":                             `{"a":1,"a":2}`,
+		"SELECT TO_JSON_STRING(STRUCT(1, 'x'))":                                     `{"":1,"":"x"}`,
+		"SELECT TO_JSON_STRING(RANGE<DATETIME> '[2024-07-24 10:00:00, UNBOUNDED)')": `{"start":"2024-07-24T10:00:00","end":null}`,
+		"SELECT TO_JSON_STRING(STRUCT(1 AS a, [1, 2] AS b), true)":                  "{\n  \"a\": 1,\n  \"b\": [\n    1,\n    2\n  ]\n}",
+	} {
+		var got string
+		if err := db.QueryRowContext(ctx, q).Scan(&got); err != nil {
+			t.Errorf("%s: %v", q, err)
+			continue
+		}
+		if got != want {
+			t.Errorf("%s = %s, want %s", q, got, want)
+		}
+	}
+	// TO_JSON makes a JSON value, whose object keys the engine may order
+	// as it likes, so these are compared as JSON.
+	for q, want := range map[string]string{
+		"SELECT TO_JSON_STRING(TO_JSON(t)) FROM t": `{"a":[true,false],"b":true,"bn":2.5,"bb":"R29vZ2xl","d":"2017-03-06",` +
+			`"dt":"2017-03-06T12:34:56.789012","f":1.5,"i":1,"inf":"Infinity","iv":"PT10H20M30.52S","js":{"k":1},"n":123.56,` +
+			`"ni":-1,"nul":null,"r":{"end":null,"start":"2024-07-24"},"rts":["2021-01-01T00:00:01.5Z"],"s":"a\"\\",` +
+			`"st":{"x":3,"y":false,"z":"2024-01-03"},"tm":"12:34:56.789012","ts":"2017-03-06T12:34:56.789012Z","w":9007199254740993}`,
+		"SELECT TO_JSON_STRING(TO_JSON(9007199254740993, stringify_wide_numbers => TRUE))": `"9007199254740993"`,
+		"SELECT TO_JSON_STRING(TO_JSON(NUMERIC '123.56', stringify_wide_numbers => TRUE))": `123.56`,
+		"SELECT TO_JSON_STRING(TO_JSON(STRUCT(1 AS a, 2 AS a)))":                           `{"a":1}`,
+		"SELECT TO_JSON_STRING(SAFE_TO_JSON(b)) FROM t":                                    `true`,
+		"SELECT TO_JSON_STRING(SAFE.TO_JSON(d)) FROM t":                                    `"2017-03-06"`,
+	} {
+		var got string
+		if err := db.QueryRowContext(ctx, q).Scan(&got); err != nil {
+			t.Errorf("%s: %v", q, err)
+			continue
+		}
+		if canon(got) != canon(want) || !json.Valid([]byte(got)) {
+			t.Errorf("%s = %s, want %s", q, got, want)
+		}
+	}
+}
+
+// canon is s re-encoded with sorted keys and its numbers as written.
+func canon(s string) string {
+	d := json.NewDecoder(strings.NewReader(s))
+	d.UseNumber()
+	var v any
+	if err := d.Decode(&v); err != nil {
+		return "invalid: " + s
+	}
+	b, _ := json.Marshal(v)
+	return string(b)
+}
