diff --git a/internal/value/value_int_overflow_cloudburrow_test.go b/internal/value/value_int_overflow_cloudburrow_test.go
new file mode 100644
index 0000000..c4b61e4
--- /dev/null
+++ b/internal/value/value_int_overflow_cloudburrow_test.go
@@ -0,0 +1,55 @@
+package value
+
+import (
+	"math"
+	"testing"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1599): INT64 +, - and * fail
+// on overflow, in GoogleSQL's form, and are exact up to it.
+func TestIntValueOverflow(t *testing.T) {
+	const max, min = math.MaxInt64, math.MinInt64
+	type c struct {
+		op   string
+		x, y int64
+		want int64
+		err  string
+	}
+	for _, k := range []c{
+		{"+", max, 1, 0, "int64 overflow: 9223372036854775807 + 1"},
+		{"+", min, -1, 0, "int64 overflow: -9223372036854775808 + -1"},
+		{"+", max, min, -1, ""},
+		{"+", 9007199254740993, 2, 9007199254740995, ""},
+		{"-", min, 1, 0, "int64 overflow: -9223372036854775808 - 1"},
+		{"-", 0, min, 0, "int64 overflow: 0 - -9223372036854775808"},
+		{"-", -1, min, max, ""},
+		{"*", max, 2, 0, "int64 overflow: 9223372036854775807 * 2"},
+		{"*", min, -1, 0, "int64 overflow: -9223372036854775808 * -1"},
+		{"*", -1, min, 0, "int64 overflow: -1 * -9223372036854775808"},
+		{"*", 3037000500, 3037000500, 0, "int64 overflow: 3037000500 * 3037000500"},
+		{"*", 3037000499, 3037000499, 9223372030926249001, ""},
+		{"*", -4611686018427387904, 2, min, ""},
+		{"*", min, 1, min, ""},
+		{"*", 0, min, 0, ""},
+	} {
+		var got Value
+		var err error
+		switch k.op {
+		case "+":
+			got, err = IntValue(k.x).Add(IntValue(k.y))
+		case "-":
+			got, err = IntValue(k.x).Sub(IntValue(k.y))
+		case "*":
+			got, err = IntValue(k.x).Mul(IntValue(k.y))
+		}
+		if k.err != "" {
+			if err == nil || err.Error() != k.err {
+				t.Errorf("%d %s %d = %v, %v; want %s", k.x, k.op, k.y, got, err, k.err)
+			}
+			continue
+		}
+		if err != nil || got != IntValue(k.want) {
+			t.Errorf("%d %s %d = %v, %v; want %d", k.x, k.op, k.y, got, err, k.want)
+		}
+	}
+}
