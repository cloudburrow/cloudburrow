 package math
 
 import (
+	"fmt"
 	"math"
+	"math/big"
 
 	"github.com/goccy/googlesqlite/internal/value"
 )
 
 func ABS(a value.Value) (value.Value, error) {
+	// CloudBurrow patch (cloudburrow/cloudburrow#1599): an INT64 stays an
+	// INT64, exactly; by float64, one above 2^53 lost its low bits
+	// (ABS(-9007199254740993) was 9007199254740992). BigQuery "returns an
+	// error if the argument is an integer and the output value can't be
+	// represented as the same type", which is ABS of the INT64 minimum;
+	// the message is in the form of unary minus's (patch 0005). A NUMERIC
+	// or BIGNUMERIC stays one, exactly.
+	switch v := a.(type) {
+	case value.IntValue:
+		if int64(v) == math.MinInt64 {
+			return nil, fmt.Errorf("int64 overflow: ABS(%d)", int64(v))
+		}
+		if v < 0 {
+			return -v, nil
+		}
+		return v, nil
+	case *value.NumericValue:
+		return &value.NumericValue{Rat: new(big.Rat).Abs(v.Rat), IsBigNumeric: v.IsBigNumeric}, nil
+	}
 	f64, err := a.ToFloat64()
 	if err != nil {
 		return nil, err
