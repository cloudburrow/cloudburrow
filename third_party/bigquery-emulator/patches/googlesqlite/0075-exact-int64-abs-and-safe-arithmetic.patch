+package math
+
+import (
+	"math"
+	"math/big"
+	"testing"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1599): ABS of an INT64 is
+// exact, and of the INT64 minimum an overflow error; SAFE_ADD,
+// SAFE_SUBTRACT, SAFE_MULTIPLY and SAFE_NEGATE of INT64s are exact, and
+// NULL on overflow.
+func TestABSInt64Exact(t *testing.T) {
+	for x, want := range map[int64]int64{
+		-9007199254740993:    9007199254740993,
+		-6889379130834334227: 6889379130834334227,
+		math.MaxInt64:        math.MaxInt64,
+		-math.MaxInt64:       math.MaxInt64,
+		0:                    0,
+		25:                   25,
+		-25:                  25,
+	} {
+		got, err := ABS(value.IntValue(x))
+		if err != nil || got != value.IntValue(want) {
+			t.Errorf("ABS(%d) = %v, %v; want %d", x, got, err, want)
+		}
+	}
+	if _, err := ABS(value.IntValue(math.MinInt64)); err == nil || err.Error() != "int64 overflow: ABS(-9223372036854775808)" {
+		t.Errorf("ABS(INT64 minimum): %v; want int64 overflow: ABS(-9223372036854775808)", err)
+	}
+	n, _ := new(big.Rat).SetString("-12345678901234567890123456789.123456789")
+	got, err := ABS(&value.NumericValue{Rat: n})
+	if nv, ok := got.(*value.NumericValue); err != nil || !ok || nv.Rat.FloatString(9) != "12345678901234567890123456789.123456789" {
+		t.Errorf("ABS(NUMERIC) = %v, %v", got, err)
+	}
+	if got, err := ABS(value.FloatValue(-2.5)); err != nil || got != value.FloatValue(2.5) {
+		t.Errorf("ABS(-2.5) = %v, %v", got, err)
+	}
+}
+
+func TestSafeInt64Exact(t *testing.T) {
+	const max, min = math.MaxInt64, math.MinInt64
+	type c struct {
+		x, y int64
+		want any // int64, or nil for NULL
+	}
+	check := func(name string, f func(x, y value.Value) (value.Value, error), cases []c) {
+		t.Helper()
+		for _, k := range cases {
+			got, err := f(value.IntValue(k.x), value.IntValue(k.y))
+			if err != nil {
+				t.Errorf("%s(%d, %d): %v", name, k.x, k.y, err)
+				continue
+			}
+			if k.want == nil {
+				if got != nil {
+					t.Errorf("%s(%d, %d) = %v; want NULL", name, k.x, k.y, got)
+				}
+				continue
+			}
+			if got != value.IntValue(k.want.(int64)) {
+				t.Errorf("%s(%d, %d) = %v; want %d", name, k.x, k.y, got, k.want)
+			}
+		}
+	}
+	check("SAFE_ADD", SAFE_ADD, []c{
+		{9007199254740993, 2, int64(9007199254740995)}, {max, 1, nil}, {min, -1, nil},
+		{max, min, int64(-1)}, {max - 1, 1, int64(max)}, {-5, 3, int64(-2)},
+	})
+	check("SAFE_SUBTRACT", SAFE_SUBTRACT, []c{
+		{9007199254740995, 2, int64(9007199254740993)}, {min, 1, nil}, {max, -1, nil},
+		{0, min, nil}, {-1, min, int64(max)}, {min + 1, 1, int64(min)},
+	})
+	check("SAFE_MULTIPLY", SAFE_MULTIPLY, []c{
+		{3037000499, 3037000499, int64(9223372030926249001)}, {3037000500, 3037000500, nil},
+		{-4611686018427387904, 2, int64(min)}, {4611686018427387904, 2, nil}, {min, -1, nil},
+		{min, 1, int64(min)}, {-3, 7, int64(-21)}, {-3, -7, int64(21)}, {0, min, int64(0)},
+		{9007199254740993, 1, int64(9007199254740993)},
+	})
+	for x, want := range map[int64]any{1: int64(-1), -1: int64(1), 0: int64(0), max: int64(-max), min: nil, -9007199254740993: int64(9007199254740993)} {
+		got, err := SAFE_NEGATE(value.IntValue(x))
+		if err != nil || (want == nil) != (got == nil) || want != nil && got != value.IntValue(want.(int64)) {
+			t.Errorf("SAFE_NEGATE(%d) = %v, %v; want %v", x, got, err, want)
+		}
+	}
+	// A FLOAT64 still goes by float64.
+	if got, err := SAFE_ADD(value.FloatValue(0.5), value.IntValue(1)); err != nil || got != value.FloatValue(1.5) {
+		t.Errorf("SAFE_ADD(0.5, 1) = %v, %v", got, err)
+	}
+}
