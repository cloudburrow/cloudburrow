@@ -0,0 +1,71 @@
+package math
+
+import (
+	"math"
+	"math/bits"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1599): SAFE_ADD,
+// SAFE_SUBTRACT, SAFE_MULTIPLY and SAFE_NEGATE of INT64s are INT64s,
+// exactly, and NULL where the result overflows INT64, as BigQuery
+// documents ("returns NULL if overflow occurs"); by float64, an INT64
+// above 2^53 lost its low bits and an overflow was never NULL.
+
+// safeInt64s is x and y when both are INT64s.
+func safeInt64s(x, y value.Value) (int64, int64, bool) {
+	xi, ok := x.(value.IntValue)
+	if !ok {
+		return 0, 0, false
+	}
+	yi, ok := y.(value.IntValue)
+	if !ok {
+		return 0, 0, false
+	}
+	return int64(xi), int64(yi), true
+}
+
+func safeAddInt64(x, y int64) value.Value {
+	s := x + y
+	if (x >= 0) == (y >= 0) && (s >= 0) != (x >= 0) {
+		return nil
+	}
+	return value.IntValue(s)
+}
+
+func safeSubtractInt64(x, y int64) value.Value {
+	d := x - y
+	if (x >= 0) != (y >= 0) && (d >= 0) != (x >= 0) {
+		return nil
+	}
+	return value.IntValue(d)
+}
+
+func safeMultiplyInt64(x, y int64) value.Value {
+	if x == 0 || y == 0 {
+		return value.IntValue(0)
+	}
+	ux, uy := uint64(x), uint64(y)
+	neg := (x < 0) != (y < 0)
+	if x < 0 {
+		ux = -ux
+	}
+	if y < 0 {
+		uy = -uy
+	}
+	hi, lo := bits.Mul64(ux, uy)
+	if hi != 0 {
+		return nil
+	}
+	if neg {
+		if lo > 1<<63 {
+			return nil
+		}
+		return value.IntValue(-int64(lo-1) - 1)
+	}
+	if lo > math.MaxInt64 {
+		return nil
+	}
+	return value.IntValue(int64(lo))
+}
