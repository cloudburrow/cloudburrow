+// isIngestionPseudoColumn reports whether a table column named name is
+// one of the pseudo-columns applyIngestionPartitionRewrite gives an
+// ingestion-time partitioned table (CloudBurrow patch,
+// cloudburrow/cloudburrow#1277).
+func isIngestionPseudoColumn(name string) bool {
+	return strings.EqualFold(name, "_PARTITIONTIME") || strings.EqualFold(name, "_PARTITIONDATE")
+}
