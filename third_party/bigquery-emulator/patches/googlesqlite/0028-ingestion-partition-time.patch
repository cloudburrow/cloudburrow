+// TestIngestionPartitionPseudoColumns is CloudBurrow's regression test of
+// its patch 0028 (cloudburrow/cloudburrow#1277): an ingestion-time
+// partitioned table keeps each row's ingestion time, truncated to the
+// partitioning unit, in _PARTITIONTIME (and, by day, _PARTITIONDATE);
+// SELECT * leaves them out; an INSERT may give them; and a table that is
+// not ingestion-time partitioned has neither.
+func TestIngestionPartitionPseudoColumns(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	exec(`CREATE TABLE ing_day (id INT64) PARTITION BY _PARTITIONDATE`)
+	exec(`CREATE TABLE ing_hour (id INT64) PARTITION BY TIMESTAMP_TRUNC(_PARTITIONTIME, HOUR)`)
+	exec(`CREATE TABLE plain (id INT64)`)
+	exec(`INSERT INTO ing_day (id) VALUES (1)`)
+	exec(`INSERT INTO ing_day (_PARTITIONTIME, id) VALUES (TIMESTAMP '2024-01-01', 2)`)
+	exec(`INSERT INTO ing_day (id) SELECT 3`)
+	exec(`INSERT INTO ing_hour (id) VALUES (1)`)
+
+	rows, err := db.QueryContext(ctx, `SELECT * FROM ing_day ORDER BY id`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cols, _ := rows.Columns()
+	rows.Close()
+	if strings.Join(cols, ",") != "id" {
+		t.Errorf("SELECT * columns = %v, want [id]", cols)
+	}
+
+	now := time.Now().UTC()
+	day := now.Truncate(24 * time.Hour)
+	const ts = "2006-01-02 15:04:05"
+	var got, date string
+	if err := db.QueryRowContext(ctx, `SELECT FORMAT_TIMESTAMP('%F %T', _PARTITIONTIME), CAST(_PARTITIONDATE AS STRING) FROM ing_day WHERE id = 1`).Scan(&got, &date); err != nil {
+		t.Fatal(err)
+	}
+	if got != day.Format(ts) || date != day.Format("2006-01-02") {
+		t.Errorf("id 1: _PARTITIONTIME %v, _PARTITIONDATE %s; want %v", got, date, day)
+	}
+	if err := db.QueryRowContext(ctx, `SELECT FORMAT_TIMESTAMP('%F %T', _PARTITIONTIME) FROM ing_day WHERE id = 3`).Scan(&got); err != nil || got != day.Format(ts) {
+		t.Errorf("INSERT ... SELECT: _PARTITIONTIME %v (%v), want %v", got, err, day)
+	}
+	var n int64
+	if err := db.QueryRowContext(ctx, `SELECT COUNT(*) FROM ing_day WHERE _PARTITIONTIME = TIMESTAMP('2024-01-01')`).Scan(&n); err != nil || n != 1 {
+		t.Errorf("rows of 2024-01-01: %d (%v), want 1", n, err)
+	}
+	// _PARTITIONDATE is the date of an _PARTITIONTIME an INSERT gave.
+	if err := db.QueryRowContext(ctx, `SELECT CAST(_PARTITIONDATE AS STRING) FROM ing_day WHERE id = 2`).Scan(&date); err != nil || date != "2024-01-01" {
+		t.Errorf("id 2: _PARTITIONDATE %s (%v), want 2024-01-01", date, err)
+	}
+	if err := db.QueryRowContext(ctx, `SELECT FORMAT_TIMESTAMP('%F %T', _PARTITIONTIME) FROM ing_hour`).Scan(&got); err != nil ||
+		got != now.Truncate(time.Hour).Format(ts) && got != time.Now().UTC().Truncate(time.Hour).Format(ts) {
+		t.Errorf("hour: _PARTITIONTIME %v (%v), want %v", got, err, now.Truncate(time.Hour))
+	}
+	if _, err := db.QueryContext(ctx, `SELECT _PARTITIONDATE FROM ing_hour`); err == nil {
+		t.Error("_PARTITIONDATE of an hour-partitioned table: no error")
+	}
+	if _, err := db.QueryContext(ctx, `SELECT _PARTITIONTIME FROM plain`); err == nil {
+		t.Error("_PARTITIONTIME of a table that is not partitioned: no error")
+	}
+}
