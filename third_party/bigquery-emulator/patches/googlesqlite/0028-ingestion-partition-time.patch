+// addIngestionPseudoColumns adds the pseudo-column definitions of an
+// ingestion-time partitioning expr to the column list of the CREATE
+// TABLE statement whose PARTITION BY was stripped at pos of query: the
+// list is the `( ... )` that ends just before pos. A statement without
+// one (CREATE TABLE ... AS SELECT) is left as it is.
+func addIngestionPseudoColumns(query string, pos int, expr string) string {
+	unit := ingestionPartitionUnit(expr)
+	if unit == "" {
+		return query
+	}
+	k := pos
+	for k > 0 && (query[k-1] == ' ' || query[k-1] == '\t' || query[k-1] == '\n' || query[k-1] == '\r') {
+		k--
+	}
+	if k == 0 || query[k-1] != ')' {
+		return query
+	}
+	start := strings.LastIndexByte(query[:k], ';') + 1
+	head := strings.ToUpper(query[start:k])
+	if !strings.Contains(head, "CREATE") || !strings.Contains(head, "TABLE") ||
+		strings.Contains(head, "_PARTITIONTIME") {
+		return query
+	}
+	cols := ", `_PARTITIONTIME` TIMESTAMP DEFAULT TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(), " + unit + ")"
+	if unit == "DAY" {
+		cols += ", `_PARTITIONDATE` DATE DEFAULT CURRENT_DATE()"
+	}
+	return query[:k-1] + cols + query[k-1:]
 }
 
