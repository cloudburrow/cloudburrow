+// ingestionPartitionUnit returns the partitioning unit of a PARTITION
+// BY expression of ingestion time, or "" when expr is not one.
+func ingestionPartitionUnit(expr string) string {
+	e := strings.ToUpper(strings.Join(strings.Fields(expr), ""))
+	switch e {
+	case "_PARTITIONDATE", "DATE(_PARTITIONTIME)":
+		return "DAY"
+	}
+	for _, unit := range []string{"DAY", "HOUR", "MONTH", "YEAR"} {
+		if e == "TIMESTAMP_TRUNC(_PARTITIONTIME,"+unit+")" {
+			return unit
