+++ b/dml_subquery_test.go
@@ -0,0 +1,45 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestDMLSubqueryOfAJoin is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1459): an UPDATE or DELETE whose subquery joins
+// two tables with a column of one name (k) failed "ambiguous column name:
+// k". The subquery's columns are named by ID, and the changed table's,
+// correlated, by name.
+func TestDMLSubqueryOfAJoin(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=dml_subquery_join")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	for _, q := range []string{
+		"CREATE TABLE `p.d.t` (id INT64, v STRING)",
+		"CREATE TABLE `p.d.u` (id INT64, k INT64)",
+		"CREATE TABLE `p.d.w` (k INT64, v STRING)",
+		"INSERT INTO `p.d.t` (id, v) VALUES (1, 'a'), (2, 'b'), (3, 'c')",
+		"INSERT INTO `p.d.u` (id, k) VALUES (1, 10), (2, 20)",
+		"INSERT INTO `p.d.w` (k, v) VALUES (10, 'X'), (20, 'Y')",
+		"UPDATE `p.d.t` t SET v = (SELECT w.v FROM `p.d.u` u JOIN `p.d.w` w USING (k) WHERE u.id = t.id) WHERE id IN (SELECT u.id FROM `p.d.u` u JOIN `p.d.w` w ON u.k = w.k)",
+		"DELETE FROM `p.d.t` t WHERE EXISTS (SELECT 1 FROM `p.d.u` u, `p.d.w` w WHERE u.k = w.k AND w.v = 'Y' AND u.id = t.id)",
+	} {
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	var got string
+	if err := db.QueryRowContext(ctx, "SELECT STRING_AGG(CONCAT(CAST(id AS STRING), v), ',' ORDER BY id) FROM `p.d.t`").Scan(&got); err != nil {
+		t.Fatal(err)
+	}
+	if got != "1X,3c" {
+		t.Errorf("t is %q, want 1X,3c", got)
+	}
+}
