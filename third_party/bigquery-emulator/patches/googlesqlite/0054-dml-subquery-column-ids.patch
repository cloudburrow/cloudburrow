--- a/internal/context.go
+++ b/internal/context.go
@@ -243,8 +243,32 @@
 		return nil
 	}
 	return value.(*arraySubqueryColumnNames)
+}
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1459): the columns of the
+// table an UPDATE or DELETE changes. Its statement names them by their own
+// names, as SQLite's UPDATE and DELETE know them; a subquery in it names
+// its own scans' columns by their IDs, which keeps a join's two `k`
+// columns apart, and the changed table's columns, correlated, by name.
+type dmlTargetColumnsKey struct{}
+
+func withDMLTargetColumns(ctx context.Context, scan googlesql.ResolvedNode) context.Context {
+	ids := map[int]bool{}
+	if s, ok := scan.(*googlesql.ResolvedTableScan); ok {
+		cols, _ := s.ColumnList()
+		for _, col := range cols {
+			id, _ := col.ColumnId()
+			ids[int(id)] = true
+		}
+	}
+	return context.WithValue(ctx, dmlTargetColumnsKey{}, ids)
 }
 
+func dmlTargetColumns(ctx context.Context) map[int]bool {
+	ids, _ := ctx.Value(dmlTargetColumnsKey{}).(map[int]bool)
+	return ids
+}
+
 func withUseColumnID(ctx context.Context) context.Context {
 	return context.WithValue(ctx, useColumnIDKey{}, true)
 }
