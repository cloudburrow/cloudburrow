--- /dev/null
+++ b/raw_lookup.go
@@ -0,0 +1,55 @@
+package googlesqlite
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// QueryRawContext runs query on the connection's SQLite database as SQLite
+// SQL, not GoogleSQL, in the connection's transaction if it has one. A
+// GoogleSQL WHERE comparison is compiled to a function call, which SQLite
+// cannot answer from an index, so each keyed read of a table visits every
+// row; this lets a caller that knows the stored encoding read a row by its
+// key. Values are stored encoded: a STRING as EncodeString writes it.
+// CloudBurrow patch (cloudburrow/cloudburrow#1103).
+func (c *Conn) QueryRawContext(ctx context.Context, query string, args ...any) (*sql.Rows, error) {
+	rows, err := c.conn.QueryContext(ctx, query, args...)
+	return rows, c.translateConnDone(err)
+}
+
+// EncodeString is a STRING as googlesqlite stores it in SQLite, for a
+// QueryRawContext argument. CloudBurrow patch (cloudburrow/cloudburrow#1103).
+func EncodeString(s string) (string, error) {
+	v, err := value.EncodeValue(value.StringValue(s))
+	if err != nil {
+		return "", err
+	}
+	enc, ok := v.(string)
+	if !ok {
+		return "", fmt.Errorf("googlesqlite: a STRING encoded as %T", v)
+	}
+	return enc, nil
+}
+
+// DecodeString reads a STRING column QueryRawContext returned: "" and
+// false for NULL. CloudBurrow patch (cloudburrow/cloudburrow#1103).
+func DecodeString(v any) (string, bool, error) {
+	if v == nil {
+		return "", false, nil
+	}
+	val, err := value.DecodeValue(v)
+	if err != nil {
+		return "", false, err
+	}
+	if val == nil {
+		return "", false, nil
+	}
+	s, err := val.ToString()
+	if err != nil {
+		return "", false, err
+	}
+	return s, true, nil
+}
