@@ -0,0 +1,58 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"testing"
+)
+
+// TestColumnDefaults is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1340): a column's DEFAULT applied only to an
+// INSERT ... VALUES that left the column out. INSERT ... SELECT left it
+// NULL, and the DEFAULT keyword in VALUES failed "no formatter registered
+// for ResolvedNodeKind ResolvedNodeKindResolvedDmldefault". BigQuery uses
+// the default "when the value for a column is not specified" and "when the
+// keyword DEFAULT is used in place of the value expression".
+func TestColumnDefaults(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=column_defaults")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, q := range []string{
+		"CREATE TABLE `p.d.t` (id INT64, s STRING DEFAULT 'x', n INT64 DEFAULT 7, z STRING)",
+		"INSERT INTO `p.d.t` (id) VALUES (1)",
+		"INSERT INTO `p.d.t` (id, s, n, z) VALUES (2, DEFAULT, DEFAULT, DEFAULT)",
+		"INSERT INTO `p.d.t` (id) SELECT 3",
+		"INSERT INTO `p.d.t` (id, s) SELECT id + 3, 'y' FROM UNNEST([1]) AS id",
+		"INSERT INTO `p.d.t` (id, s, n) VALUES (5, 'w', NULL)",
+	} {
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	rows, err := db.QueryContext(ctx, "SELECT id, s, n, z FROM `p.d.t` ORDER BY id")
+	if err != nil {
+		t.Fatalf("SELECT: %v", err)
+	}
+	defer rows.Close()
+	var got []string
+	for rows.Next() {
+		var id int64
+		var s, z sql.NullString
+		var n sql.NullInt64
+		if err := rows.Scan(&id, &s, &n, &z); err != nil {
+			t.Fatalf("Scan: %v", err)
+		}
+		got = append(got, fmt.Sprintf("%d %v %v %v", id, s.String, n.Int64, z.Valid))
+	}
+	want := []string{"1 x 7 false", "2 x 7 false", "3 x 7 false", "4 y 7 false", "5 w 0 false"}
+	if fmt.Sprint(got) != fmt.Sprint(want) {
+		t.Errorf("rows %v, want %v", got, want)
+	}
+	if _, err := db.ExecContext(ctx, "UPDATE `p.d.t` SET s = DEFAULT WHERE id = 1"); err == nil {
+		t.Errorf("UPDATE ... SET s = DEFAULT succeeded; it is not carried out and should fail")
+	}
+}
