+// dmlDefaultKey carries, while an INSERT row's value is formatted, the
+// SQL of its column's default, or NULL (CloudBurrow patch,
+// cloudburrow/cloudburrow#1340).
+type dmlDefaultKey struct{}
+
+// insertDefaultsKey carries the defaults of an INSERT's columns, in the
+// order of its column list, to InsertRowNode (CloudBurrow patch,
+// cloudburrow/cloudburrow#1340).
+type insertDefaultsKey struct{}
+
 func (n *InsertRowNode) FormatSQL(ctx context.Context) (string, error) {
 	if n == nil {
 		return "", nil
 	}
+	defaults, _ := ctx.Value(insertDefaultsKey{}).([]string)
 	values := []string{}
-	for _, value := range m1(n.node.ValueList()) {
-		sql, err := newNode(value).FormatSQL(ctx)
+	for i, value := range m1(n.node.ValueList()) {
+		vctx := ctx
+		if i < len(defaults) {
+			vctx = context.WithValue(ctx, dmlDefaultKey{}, defaults[i])
+		}
+		sql, err := newNode(value).FormatSQL(vctx)
 		if err != nil {
 			return "", err
 		}
 		values = append(values, sql)
 	}
 	return strings.Join(values, ","), nil
+}
+
+// columnDefaults returns the default SQL of each of columns of
+// storageTable, NULL for one without a default (CloudBurrow patch,
+// cloudburrow/cloudburrow#1340).
+func columnDefaults(ctx context.Context, storageTable string, columns []string) []string {
+	out := make([]string, len(columns))
+	for i := range out {
+		out[i] = "NULL"
+	}
+	a := analyzerFromContext(ctx)
+	if a == nil || a.catalog == nil {
+		return out
+	}
+	spec, ok := a.catalog.tableMap[storageTable]
+	if !ok || spec == nil {
+		return out
+	}
+	for i, name := range columns {
+		for _, col := range spec.Columns {
+			if strings.EqualFold(col.Name, name) && col.DefaultExpr != "" {
+				out[i] = col.DefaultExpr
+			}
+		}
+	}
+	return out
 }
 
