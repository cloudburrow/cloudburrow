--- a/internal/functions/math/div.go
+++ b/internal/functions/math/div.go
@@ -16,7 +16,9 @@
 		return nil, err
 	}
 	if yv == 0 {
-		return nil, fmt.Errorf("DIV: zero divided")
+		// CloudBurrow patch (cloudburrow/cloudburrow#1585): in GoogleSQL's
+		// form, "division by zero: DIV(1, 0)".
+		return nil, fmt.Errorf("division by zero: DIV(%d, 0)", xv)
 	}
