diff --git a/internal/functions/debugging/error.go b/internal/functions/debugging/error.go
--- a/internal/functions/debugging/error.go
+++ b/internal/functions/debugging/error.go
@@ -17,5 +17,13 @@
 	if err != nil {
 		return nil, err
 	}
-	return nil, errors.New(v)
+	// CloudBurrow patch (cloudburrow/cloudburrow#1585): the message
+	// carries ErrorFunctionPrefix, by which CloudBurrow's front tells the
+	// query's own error from the engine's and gives it BigQuery's reason;
+	// the front takes the prefix off.
+	return nil, errors.New(ErrorFunctionPrefix + v)
 }
+
+// ErrorFunctionPrefix starts the message of ERROR()'s error (CloudBurrow
+// patch, cloudburrow/cloudburrow#1585).
+const ErrorFunctionPrefix = "ERROR function: "
