diff --git a/runtime_error_messages_test.go b/runtime_error_messages_test.go
new file mode 100644
--- /dev/null
+++ b/runtime_error_messages_test.go
@@ -0,0 +1,35 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+)
+
+// TestRuntimeErrorMessages is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1585): a division by zero fails with
+// GoogleSQL's message, "division by zero: 1 / 0", not "zero divided error
+// ( 1.000000 / 0 )", and ERROR()'s message starts with "ERROR function: ",
+// by which CloudBurrow's front tells it from the engine's own errors.
+func TestRuntimeErrorMessages(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=runtime_error_messages")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, tc := range []struct{ query, want string }{
+		{"SELECT 1/0", "division by zero: 1 / 0"},
+		{"SELECT 1.5/0", "division by zero: 1.5 / 0"},
+		{"SELECT DIV(7, 0)", "division by zero: DIV(7, 0)"},
+		{"SELECT MOD(7, 0)", "division by zero: MOD(7, 0)"},
+		{"SELECT ERROR('boom')", "ERROR function: boom"},
+	} {
+		var v any
+		err := db.QueryRowContext(ctx, tc.query).Scan(&v)
+		if err == nil || !strings.HasSuffix(err.Error(), tc.want) {
+			t.Errorf("%s: %v, want an error ending %q", tc.query, err, tc.want)
+		}
+	}
+}
