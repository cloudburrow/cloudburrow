diff --git a/interval_compare_test.go b/interval_compare_test.go
new file mode 100644
index 0000000..f2e2bfe
--- /dev/null
+++ b/interval_compare_test.go
@@ -0,0 +1,55 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"testing"
+)
+
+// TestIntervalComparison is a CloudBurrow regression test
+// (cloudburrow/cloudburrow#1120): = (and <, >, ...) of two INTERVAL values
+// failed "unsupported eq operator for interval value". GoogleSQL compares
+// intervals by length, a month being 30 days and a day 24 hours.
+func TestIntervalComparison(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=interval_comparison")
+	if err != nil {
+		t.Fatalf("sql.Open: %v", err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{"INTERVAL 1 DAY = INTERVAL 1 DAY", true},
+		{"INTERVAL 1 DAY = INTERVAL 2 DAY", false},
+		{"INTERVAL 1 DAY != INTERVAL 2 DAY", true},
+		{"INTERVAL 1 MONTH = INTERVAL 30 DAY", true},
+		{"INTERVAL 1 DAY = INTERVAL 24 HOUR", true},
+		{"INTERVAL 1 YEAR = INTERVAL 360 DAY", true},
+		{"INTERVAL 1 DAY < INTERVAL 25 HOUR", true},
+		{"INTERVAL 1 DAY > INTERVAL 25 HOUR", false},
+		{"INTERVAL -1 SECOND < INTERVAL 0 SECOND", true},
+		{"INTERVAL 1 MICROSECOND > INTERVAL 0 SECOND", true},
+		{"INTERVAL 2 HOUR >= INTERVAL 120 MINUTE", true},
+		{"INTERVAL 2 HOUR <= INTERVAL 119 MINUTE", false},
+		{"INTERVAL '1-2 3 4:5:6.789' YEAR TO SECOND = INTERVAL '1-2 3 4:5:6.789' YEAR TO SECOND", true},
+	} {
+		var got bool
+		if err := db.QueryRowContext(ctx, "SELECT "+tc.expr).Scan(&got); err != nil {
+			t.Errorf("SELECT %s: %v", tc.expr, err)
+			continue
+		}
+		if got != tc.want {
+			t.Errorf("SELECT %s = %v, want %v", tc.expr, got, tc.want)
+		}
+	}
+	var n int64
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM UNNEST([INTERVAL 1 DAY, INTERVAL 2 DAY, INTERVAL 24 HOUR]) AS v WHERE v = INTERVAL 1 DAY").Scan(&n); err != nil || n != 2 {
+		t.Errorf("WHERE v = INTERVAL 1 DAY: %d, %v, want 2", n, err)
+	}
+	var null sql.NullBool
+	if err := db.QueryRowContext(ctx, "SELECT INTERVAL 1 DAY = CAST(NULL AS INTERVAL)").Scan(&null); err != nil || null.Valid {
+		t.Errorf("INTERVAL 1 DAY = NULL: %v, %v, want NULL", null, err)
+	}
+}
