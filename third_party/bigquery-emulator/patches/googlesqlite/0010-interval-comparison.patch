diff --git a/internal/value/value_interval_compare.go b/internal/value/value_interval_compare.go
new file mode 100644
index 0000000..845310d
--- /dev/null
+++ b/internal/value/value_interval_compare.go
@@ -0,0 +1,37 @@
+package value
+
+import (
+	"fmt"
+	"math/big"
+)
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1120): googlesqlite v0.3.1
+// refused every comparison of two INTERVAL values ("unsupported eq
+// operator for interval value"), where in BigQuery an INTERVAL is a
+// comparable type. GoogleSQL compares two intervals by their length in
+// nanoseconds, a month counting 30 days and a day 24 hours
+// (googlesql/public/interval_value.h, IntervalValue::GetAsNanos and its
+// comparison operators), so INTERVAL 1 MONTH = INTERVAL 30 DAY.
+
+const (
+	intervalNanosInSecond = 1_000_000_000
+	intervalSecondsInDay  = 24 * 60 * 60
+	intervalDaysInMonth   = 30
+)
+
+// nanos is the interval's length as GoogleSQL compares it.
+func (iv *IntervalValue) nanos() *big.Int {
+	months := int64(iv.Years)*12 + int64(iv.Months)
+	days := months*intervalDaysInMonth + int64(iv.Days)
+	seconds := days*intervalSecondsInDay + int64(iv.Hours)*3600 + int64(iv.Minutes)*60 + int64(iv.Seconds)
+	n := new(big.Int).Mul(big.NewInt(seconds), big.NewInt(intervalNanosInSecond))
+	return n.Add(n, big.NewInt(int64(iv.SubSecondNanos)))
+}
+
+func (iv *IntervalValue) compare(v Value, op string, ok func(int) bool) (bool, error) {
+	other, isInterval := v.(*IntervalValue)
+	if !isInterval || other == nil || other.IntervalValue == nil || iv.IntervalValue == nil {
+		return false, fmt.Errorf("unsupported %s operator for interval value and %T", op, v)
+	}
+	return ok(iv.nanos().Cmp(other.nanos())), nil
+}
