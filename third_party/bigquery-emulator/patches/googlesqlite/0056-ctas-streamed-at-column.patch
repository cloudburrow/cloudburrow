--- /dev/null
+++ b/ctas_streamed_at_column_test.go
@@ -0,0 +1,58 @@
+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"strings"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestCreateTableAsSelectStreamedAtColumn is CloudBurrow's regression
+// test of its patch 0056 (cloudburrow/cloudburrow#1458): a table made by
+// CREATE TABLE ... AS SELECT gets the pseudo-column _PARTITION_STREAMED,
+// as one made with a column list does (patch 0030): NULL on the rows the
+// SELECT gave, left out of SELECT *, and an INSERT may give it; a
+// temporary table and CREATE TABLE IF NOT EXISTS get none.
+func TestCreateTableAsSelectStreamedAtColumn(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	exec("CREATE TABLE `p.d.ctas` AS SELECT 1 AS id, 'a' AS s")
+	exec("INSERT INTO `p.d.ctas` (id, s, _PARTITION_STREAMED) VALUES (2, 'b', TIMESTAMP '2026-01-01 00:00:00+00')")
+	rows, err := db.QueryContext(ctx, "SELECT * FROM `p.d.ctas`")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cols, _ := rows.Columns()
+	rows.Close()
+	if strings.Join(cols, ",") != "id,s" {
+		t.Errorf("SELECT * columns = %v, want [id s]", cols)
+	}
+	var got string
+	if err := db.QueryRowContext(ctx, "SELECT STRING_AGG(FORMAT('%d:%s', id, IF(_PARTITION_STREAMED IS NULL, 'true', 'false')), ',' ORDER BY id) FROM `p.d.ctas`").Scan(&got); err != nil {
+		t.Fatal(err)
+	}
+	if got != "1:true,2:false" {
+		t.Errorf("_PARTITION_STREAMED IS NULL by id = %s, want 1:true,2:false", got)
+	}
+	exec("CREATE OR REPLACE TABLE `p.d.ctas` AS SELECT 3 AS id")
+	if err := db.QueryRowContext(ctx, "SELECT FORMAT('%d:%s', id, IF(_PARTITION_STREAMED IS NULL, 'true', 'false')) FROM `p.d.ctas`").Scan(&got); err != nil || got != "3:true" {
+		t.Errorf("CREATE OR REPLACE ... AS SELECT: %s (%v), want 3:true", got, err)
+	}
+	exec("CREATE TABLE IF NOT EXISTS `p.d.ine` AS SELECT 1 AS id")
+	if _, err := db.QueryContext(ctx, "SELECT _PARTITION_STREAMED FROM `p.d.ine`"); err == nil {
+		t.Error("CREATE TABLE IF NOT EXISTS ... AS SELECT has _PARTITION_STREAMED")
+	}
+}
