+package internal
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1508): collation.
+//
+// BigQuery compares the values of a STRING with the collation 'und:ci'
+// case-insensitively: its comparisons, IN, LIKE, joins, GROUP BY,
+// DISTINCT and ORDER BY
+// (https://cloud.google.com/bigquery/docs/reference/standard-sql/collation-concepts).
+// The analyzer (FEATURE_V_1_3_COLLATION_SUPPORT) reads COLLATE in DDL,
+// the COLLATE function and the collation of a table's columns
+// (ColumnSpec.Collation, an annotation on the catalog's column),
+// propagates it as the reference documents, refuses it where a function
+// does not support it, and records it on each function call, GROUP BY
+// and ORDER BY that compares collated values. The formatter compares
+// those values case-folded: a function's STRING arguments through
+// LOWER, and GROUP BY and ORDER BY by the googlesqlite_collate_ci
+// collation.
+
+import (
+	"strings"
+	"sync"
+
+	"github.com/goccy/go-googlesql"
+)
+
+// ciCollation is BigQuery's case-insensitive collation; ” (and
+// 'binary') is the default, which compares by code point.
+const ciCollation = "und:ci"
+
+// isCI reports whether c is und:ci.
+func isCI(c *googlesql.ResolvedCollation) bool {
+	if c == nil {
+		return false
+	}
+	name, err := c.CollationName()
+	return err == nil && strings.EqualFold(name, ciCollation)
+}
+
+// ciAt reports whether the i-th collation of list is und:ci.
+func ciAt(list []*googlesql.ResolvedCollation, i int) bool {
+	return i < len(list) && isCI(list[i])
+}
+
+// collatedComparisons are the functions whose STRING arguments, under
+// und:ci, compare case-folded. The others that take a collation
+// (REPLACE, SPLIT, NULLIF, ...) are run as they are, by code point.
+var collatedComparisons = map[string]bool{
+	"$equal": true, "$not_equal": true, "$less": true, "$less_or_equal": true, "$greater": true,
+	"$greater_or_equal": true, "$between": true, "$in": true, "$like": true, "$not_like": true,
+	"$is_distinct_from": true, "$is_not_distinct_from": true, "starts_with": true, "ends_with": true,
+	"strpos": true, "instr": true, "$case_with_value": true,
+}
+
+// foldCollatedArgs returns args with each STRING argument case-folded
+// when call compares them under und:ci.
+func foldCollatedArgs(call *googlesql.ResolvedFunctionCallBase, args []string) []string {
+	list, err := call.CollationList()
+	if err != nil || len(list) == 0 || !isCI(list[0]) {
+		return args
+	}
+	fn, err := call.Function()
+	if err != nil || fn == nil {
+		return args
+	}
+	name, _ := fn.FullName(false)
+	if !collatedComparisons[strings.ToLower(name)] {
+		return args
+	}
+	argList, _ := call.ArgumentList()
+	out := append([]string(nil), args...)
+	for i, arg := range argList {
+		if i >= len(out) || arg == nil {
+			break
+		}
+		if typ, _ := arg.Type(); typ != nil && m1(typ.IsString()) {
+			out[i] = "googlesqlite_lower(" + out[i] + ")"
+		}
+	}
+	return out
+}
+
+// collationOf returns the collation of a column's annotated type, or "".
+func collationOf(annotations *googlesql.AnnotationMap) string {
+	if annotations == nil {
+		return ""
+	}
+	ca, err := googlesql.NewCollationAnnotation()
+	if err != nil {
+		return ""
+	}
+	id, err := ca.Id()
+	if err != nil {
+		return ""
+	}
+	v, err := annotations.GetAnnotation(id)
+	if err != nil || v == nil {
+		return ""
+	}
+	s, _ := v.StringValue()
+	return s
+}
+
+// literalString returns the STRING literal expr is, or "".
+func literalString(expr googlesql.ResolvedExprNode) string {
+	lit, ok := expr.(*googlesql.ResolvedLiteral)
+	if !ok || lit == nil {
+		return ""
+	}
+	v, err := lit.Value()
+	if err != nil || v == nil {
+		return ""
+	}
+	s, _ := v.StringValue()
+	return s
+}
+
+// newCollatedColumn returns a catalog column of typ with the collation,
+// or nil when it has none or typ is not a STRING.
+func newCollatedColumn(tableName, name string, typ googlesql.Googlesql_TypeNode, collation string, isPseudo bool) *googlesql.SimpleColumn {
+	if collation == "" || !m1(typ.IsString()) {
+		return nil
+	}
+	am := scalarCollationMap(collation, typ)
+	if am == nil {
+		return nil
+	}
+	col, err := googlesql.NewSimpleColumn2(tableName, name, &googlesql.AnnotatedType{AnnotationMap: am, Type_: typ}, isPseudo, true)
+	if err != nil {
+		return nil
+	}
+	return col
+}
+
+// scalarCollations keeps the annotation map of each collation a STRING
+// column is given, owned by the type factory, for the process: the
+// catalog's columns point at it.
+var scalarCollations = struct {
+	sync.Mutex
+	am map[string]*googlesql.AnnotationMap
+}{am: map[string]*googlesql.AnnotationMap{}}
+
+func scalarCollationMap(collation string, typ googlesql.Googlesql_TypeNode) *googlesql.AnnotationMap {
+	scalarCollations.Lock()
+	defer scalarCollations.Unlock()
+	if am, ok := scalarCollations.am[collation]; ok {
+		return am
+	}
+	// The map is the type factory's, as the analyzer's are.
+	ca, err := googlesql.NewCollationAnnotation()
+	if err != nil {
+		return nil
+	}
+	id, err := ca.Id()
+	if err != nil {
+		return nil
+	}
+	proto, err := googlesql.NewAnnotationMapProto()
+	if err != nil {
+		return nil
+	}
+	ap, err := proto.AddAnnotations()
+	if err != nil || ap.SetId(int64(id)) != nil {
+		return nil
+	}
+	v, err := ap.MutableValue()
+	if err != nil {
+		return nil
+	}
+	sv, err := googlesql.NewSimpleValueString(collation)
+	if err != nil || sv.Serialize(v) != nil {
+		return nil
+	}
+	am, err := tf().DeserializeAnnotationMap(proto)
+	if err != nil || am == nil {
+		return nil
+	}
+	scalarCollations.am[collation] = am
+	return am
+}
+
+// collatedAggregate rewrites an aggregate over und:ci STRING values:
+// MIN and MAX compare case-folded and return one of the values as it is
+// (MIN_BY / MAX_BY of the folded value), and COUNT(DISTINCT) counts the
+// folded values. It returns the call unchanged otherwise.
+func collatedAggregate(call *googlesql.ResolvedFunctionCallBase, funcName string, args []string, distinct bool) (string, []string) {
+	list, err := call.CollationList()
+	if err != nil || len(list) == 0 || !isCI(list[0]) || len(args) == 0 {
+		return funcName, args
+	}
+	argList, _ := call.ArgumentList()
+	if len(argList) == 0 || argList[0] == nil {
+		return funcName, args
+	}
+	if typ, _ := argList[0].Type(); typ == nil || !m1(typ.IsString()) {
+		return funcName, args
+	}
+	out := append([]string(nil), args...)
+	switch funcName {
+	case "googlesqlite_min", "googlesqlite_max":
+		out = append([]string{args[0], "googlesqlite_lower(" + args[0] + ")"}, args[1:]...)
+		return funcName + "_by", out
+	case "googlesqlite_count":
+		if distinct {
+			out[0] = "googlesqlite_lower(" + args[0] + ")"
+		}
+	}
+	return funcName, out
+}
