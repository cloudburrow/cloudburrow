+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+// TestCollationUndCI is CloudBurrow patch 59's regression test
+// (cloudburrow/cloudburrow#1508): a STRING with the collation 'und:ci'
+// compares case-insensitively in comparisons, IN, LIKE, joins, GROUP BY,
+// DISTINCT, ORDER BY, MIN/MAX and COUNT(DISTINCT), as BigQuery's
+// collation reference documents; COLLATE in DDL, a table's DEFAULT
+// COLLATE and the COLLATE function give it, and COLLATE(x, '') takes it
+// away. Before the patch COLLATE failed "COLLATE is not supported" and
+// every comparison was by code point.
+func TestCollationUndCI(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:?_test=collation_und_ci")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	ctx := context.Background()
+	for _, q := range []string{
+		"CREATE TABLE `p.d.t` (s STRING COLLATE 'und:ci', n INT64)",
+		"INSERT INTO `p.d.t` (s, n) VALUES ('Abc', 1), ('aBC', 2), ('b', 3), ('B', 4), (NULL, 5)",
+		"CREATE TABLE `p.d.u` (s STRING, n INT64) DEFAULT COLLATE 'und:ci'",
+		"INSERT INTO `p.d.u` (s, n) VALUES ('Abc', 1)",
+		"CREATE TABLE `p.d.plain` (s STRING)",
+		"INSERT INTO `p.d.plain` (s) VALUES ('Abc'), ('aBC')",
+	} {
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	for _, tc := range []struct{ q, want string }{
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE s = 'ABC'", "2"},
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE s != 'ABC'", "2"},
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE s IN ('ABC', 'x')", "2"},
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE s LIKE 'ab%'", "2"},
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE s < 'b'", "2"},
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE s BETWEEN 'a' AND 'ABZ'", "2"},
+		{"SELECT COUNT(*) FROM (SELECT s FROM `p.d.t` WHERE s IS NOT NULL GROUP BY s)", "2"},
+		{"SELECT COUNT(*) FROM (SELECT DISTINCT s FROM `p.d.t` WHERE s IS NOT NULL)", "2"},
+		{"SELECT COUNT(DISTINCT s) FROM `p.d.t`", "2"},
+		{"SELECT STRING_AGG(CAST(n AS STRING), ',') FROM (SELECT n FROM `p.d.t` WHERE s IS NOT NULL ORDER BY s, n)", "1,2,3,4"},
+		{"SELECT COUNT(*) FROM `p.d.t` a JOIN `p.d.t` b ON a.s = b.s", "8"},
+		{"SELECT LOWER(MIN(s)) FROM `p.d.t`", "abc"},
+		{"SELECT LOWER(MAX(s)) FROM `p.d.t`", "b"},
+		{"SELECT MIN(s) FROM `p.d.t` WHERE n IN (3, 2)", "aBC"},
+		{"SELECT COUNT(*) FROM `p.d.u` WHERE s = 'ABC'", "1"},
+		{"SELECT COUNT(*) FROM `p.d.plain` WHERE s = 'ABC'", "0"},
+		{"SELECT COUNT(*) FROM `p.d.plain` WHERE COLLATE(s, 'und:ci') = 'ABC'", "2"},
+		{"SELECT COUNT(*) FROM `p.d.t` WHERE COLLATE(s, '') = 'Abc'", "1"},
+		{"SELECT COLLATE('a', 'und:ci') = 'A'", "true"},
+		{"SELECT UPPER(s) = 'ABC' FROM `p.d.t` WHERE n = 1", "true"},
+		{"SELECT s FROM `p.d.t` WHERE n = 2", "aBC"},
+	} {
+		var v any
+		if err := db.QueryRowContext(ctx, tc.q).Scan(&v); err != nil {
+			t.Errorf("%s: %v", tc.q, err)
+			continue
+		}
+		if got := fmt.Sprint(v); got != tc.want {
+			t.Errorf("%s = %s, want %s", tc.q, got, tc.want)
+		}
+	}
+	// A comparison of two different collations is refused.
+	_, err = db.QueryContext(ctx, "SELECT COLLATE('a', 'und:ci') = COLLATE('A', 'binary')")
+	if err == nil || !strings.Contains(strings.ToLower(err.Error()), "collation") {
+		t.Errorf("mixed collations: err %v, want a collation conflict", err)
+	}
+}
