+
+// naiveTimestampUTC returns s, a TIMESTAMP literal's text with no zone,
+// in UTC. CloudBurrow patch (cloudburrow/cloudburrow#1188): a date alone
+// gets a midnight, as the analyzer reads no offset right after a date.
+func naiveTimestampUTC(s string) string {
+	if dateOnly.MatchString(s) {
+		return strings.TrimSpace(s) + " 00:00:00+00:00"
+	}
+	return s + "+00:00"
+}
+
+// castToTimestamp reports whether the string literal query[start:end] is
+// the operand of CAST or SAFE_CAST to TIMESTAMP: CAST('<value>' AS
+// TIMESTAMP).
+func castToTimestamp(query string, start, end int) bool {
+	before := strings.TrimRight(query[:start], " \t\n\r")
+	if !strings.HasSuffix(before, "(") {
+		return false
+	}
+	before = strings.TrimRight(before[:len(before)-1], " \t\n\r")
+	upper := strings.ToUpper(before)
+	if !strings.HasSuffix(upper, "CAST") {
+		return false
+	}
+	if n := len(upper) - len("CAST"); n > 0 && isIdentCont(upper[n-1]) && !strings.HasSuffix(upper, "SAFE_CAST") {
+		return false
+	}
+	return castTimestampTail.MatchString(query[end:])
+}
+
+// rangeTimestampLiteral reports whether query, from i (just past a RANGE
+// keyword), goes on `<TIMESTAMP>` and a string literal, and where that
+// literal starts.
+func rangeTimestampLiteral(query string, i int) (int, bool) {
+	skip := func(k int) int {
+		for k < len(query) && (query[k] == ' ' || query[k] == '\t' || query[k] == '\n' || query[k] == '\r') {
+			k++
+		}
+		return k
+	}
+	k := skip(i)
+	if k >= len(query) || query[k] != '<' {
+		return 0, false
+	}
+	k = skip(k + 1)
+	if k+len("TIMESTAMP") > len(query) || !strings.EqualFold(query[k:k+len("TIMESTAMP")], "TIMESTAMP") {
+		return 0, false
+	}
+	k = skip(k + len("TIMESTAMP"))
+	if k >= len(query) || query[k] != '>' {
+		return 0, false
+	}
+	k = skip(k + 1)
+	if k >= len(query) || query[k] != '\'' && query[k] != '"' {
+		return 0, false
+	}
+	return k, true
+}
+
+// naiveRangeBoundsUTC returns a RANGE<TIMESTAMP> literal's text,
+// "[start, end)", with each bound that has no zone in UTC; UNBOUNDED and
+// NULL bounds, and any text not of that form, are kept.
+func naiveRangeBoundsUTC(s string) string {
+	t := strings.TrimSpace(s)
+	if len(t) < 2 || t[0] != '[' || t[len(t)-1] != ')' {
+		return s
+	}
+	parts := strings.Split(t[1:len(t)-1], ",")
+	if len(parts) != 2 {
+		return s
+	}
+	for i, p := range parts {
+		p = strings.TrimSpace(p)
+		if p != "" && !strings.EqualFold(p, "UNBOUNDED") && !strings.EqualFold(p, "NULL") && !timestampHasTZ(p) {
+			p = naiveTimestampUTC(p)
+		}
+		parts[i] = p
+	}
+	return "[" + parts[0] + ", " + parts[1] + ")"
 }
 
