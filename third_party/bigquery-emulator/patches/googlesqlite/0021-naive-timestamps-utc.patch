+++ b/internal/naive_timestamp_utc_test.go
@@ -0,0 +1,27 @@
+package internal
+
+import "testing"
+
+// CloudBurrow patch (cloudburrow/cloudburrow#1188): TIMESTAMP and
+// RANGE<TIMESTAMP> literals with no zone are read as UTC.
+func TestNaiveTimestampLiteralsAreUTC(t *testing.T) {
+	for in, want := range map[string]string{
+		`SELECT TIMESTAMP '2020-01-01'`:                                                         `SELECT TIMESTAMP '2020-01-01 00:00:00+00:00'`,
+		`SELECT TIMESTAMP "2020-1-2"`:                                                           `SELECT TIMESTAMP "2020-1-2 00:00:00+00:00"`,
+		`SELECT TIMESTAMP '2020-01-01 10:00:00'`:                                                `SELECT TIMESTAMP '2020-01-01 10:00:00+00:00'`,
+		`SELECT TIMESTAMP '2020-01-01 10:00:00-05'`:                                             `SELECT TIMESTAMP '2020-01-01 10:00:00-05'`,
+		`SELECT TIMESTAMP '2020-01-01 10:00:00 America/New_York'`:                               `SELECT TIMESTAMP '2020-01-01 10:00:00 America/New_York'`,
+		`SELECT RANGE<TIMESTAMP> '[2020-01-01, 2020-02-01 12:00:00)'`:                           `SELECT RANGE<TIMESTAMP> '[2020-01-01 00:00:00+00:00, 2020-02-01 12:00:00+00:00)'`,
+		`SELECT RANGE < timestamp > "[UNBOUNDED, 2020-02-01Z)"`:                                 `SELECT RANGE < timestamp > "[UNBOUNDED, 2020-02-01Z)"`,
+		`SELECT RANGE<TIMESTAMP> '[2020-01-01 00:00:00+03, NULL)'`:                              `SELECT RANGE<TIMESTAMP> '[2020-01-01 00:00:00+03, NULL)'`,
+		`SELECT RANGE<DATE> '[2020-01-01, 2020-02-01)'`:                                         `SELECT RANGE<DATE> '[2020-01-01, 2020-02-01)'`,
+		`SELECT '2020-01-01' AS TIMESTAMP_x`:                                                    `SELECT '2020-01-01' AS TIMESTAMP_x`,
+		`SELECT CAST('2020-01-01' AS TIMESTAMP), SAFE_CAST ( "2020-01-01 10:00" as timestamp )`: `SELECT CAST('2020-01-01 00:00:00+00:00' AS TIMESTAMP), SAFE_CAST ( "2020-01-01 10:00+00:00" as timestamp )`,
+		`SELECT CAST('2020-01-01 10:00:00+03' AS TIMESTAMP), CAST('2020-01-01' AS DATE)`:        `SELECT CAST('2020-01-01 10:00:00+03' AS TIMESTAMP), CAST('2020-01-01' AS DATE)`,
+		`SELECT MYCAST('2020-01-01' AS TIMESTAMP)`:                                              `SELECT MYCAST('2020-01-01' AS TIMESTAMP)`,
+	} {
+		if got := applyNaiveTimestampUTC(in); got != want {
+			t.Errorf("applyNaiveTimestampUTC(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
