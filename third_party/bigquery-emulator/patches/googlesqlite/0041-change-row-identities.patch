+package googlesqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+	"testing"
+
+	_ "github.com/goccy/googlesqlite"
+)
+
+// TestChangeHistoryRows is CloudBurrow's regression test of its patch 0041
+// (cloudburrow/cloudburrow#1460): a change table has its changes' times,
+// changed rows' rowids and order as pseudo-columns, which SELECT * leaves
+// out, and a START row of when it was made; the table as it was after
+// each statement is the last change of each row, when not a DELETE.
+func TestChangeHistoryRows(t *testing.T) {
+	db, err := sql.Open("googlesqlite", ":memory:")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	ctx := context.Background()
+	exec := func(q string) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, q); err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+	}
+	micros := func() int64 {
+		t.Helper()
+		var n int64
+		if err := db.QueryRowContext(ctx, "SELECT MAX(googlesqlite_change_micros) FROM `p.d.t$changes`").Scan(&n); err != nil {
+			t.Fatal(err)
+		}
+		return n
+	}
+	asOf := func(at int64) string {
+		t.Helper()
+		q := fmt.Sprintf("SELECT id, v FROM (SELECT id, v, _CHANGE_TYPE AS k, ROW_NUMBER() OVER (PARTITION BY googlesqlite_change_rowid ORDER BY rowid DESC) AS n "+
+			"FROM `p.d.t$changes` WHERE _CHANGE_TYPE != 'START' AND googlesqlite_change_micros <= %d) WHERE n = 1 AND k != 'DELETE' ORDER BY id", at)
+		rows, err := db.QueryContext(ctx, q)
+		if err != nil {
+			t.Fatalf("%s: %v", q, err)
+		}
+		defer rows.Close()
+		var out []string
+		for rows.Next() {
+			var id int64
+			var v string
+			if err := rows.Scan(&id, &v); err != nil {
+				t.Fatal(err)
+			}
+			out = append(out, fmt.Sprintf("%d=%s", id, v))
+		}
+		if err := rows.Err(); err != nil {
+			t.Fatal(err)
+		}
+		return strings.Join(out, " ")
+	}
+	exec("CREATE TABLE `p.d.t` (id INT64, v STRING)")
+	var start int64
+	if err := db.QueryRowContext(ctx, "SELECT googlesqlite_change_micros FROM `p.d.t$changes` WHERE _CHANGE_TYPE = 'START'").Scan(&start); err != nil {
+		t.Fatalf("START row: %v", err)
+	}
+	exec("INSERT INTO `p.d.t` VALUES (1, 'a'), (2, 'b')")
+	t1 := micros()
+	exec("UPDATE `p.d.t` SET v = 'c' WHERE id = 1")
+	t2 := micros()
+	exec("DELETE `p.d.t` WHERE id = 2")
+	t3 := micros()
+	exec("INSERT INTO `p.d.t` VALUES (3, 'd')") // may take the deleted row's rowid
+	t4 := micros()
+	for _, c := range []struct {
+		at   int64
+		want string
+	}{{start, ""}, {t1, "1=a 2=b"}, {t2, "1=c 2=b"}, {t3, "1=c"}, {t4, "1=c 3=d"}} {
+		if got := asOf(c.at); got != c.want {
+			t.Errorf("as of %d: %q, want %q", c.at, got, c.want)
+		}
+	}
+	// SELECT * leaves the pseudo-columns out.
+	rows, err := db.QueryContext(ctx, "SELECT * FROM `p.d.t$changes`")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cols, _ := rows.Columns()
+	rows.Close()
+	if got := strings.Join(cols, ","); got != "id,v,_CHANGE_TYPE,_CHANGE_TIMESTAMP,_CHANGE_IS_FOR_UPDATE" {
+		t.Errorf("SELECT * columns: %s", got)
+	}
+	// No other table has them.
+	if _, err := db.QueryContext(ctx, "SELECT googlesqlite_change_rowid FROM `p.d.t`"); err == nil {
+		t.Error("a table has the change row pseudo-columns")
+	}
+}
