+package internal
+
+import (
+	"fmt"
+
+	"github.com/goccy/googlesqlite/internal/value"
+)
+
+// Change table row identities (CloudBurrow patch,
+// cloudburrow/cloudburrow#1460).
+//
+// BigQuery's FOR SYSTEM_TIME AS OF reads a table as it was at a time in
+// its time travel window (https://cloud.google.com/bigquery/docs/time-travel).
+// A table's change table (change_history.go) records each row inserted,
+// deleted and updated with its time, so the table as it was at a time is,
+// of each of its rows, the last change recorded at or before that time,
+// when that change is not a DELETE. That needs the changed row's rowid,
+// which the change table keeps (changeRowidColumn), and the order of the
+// changes of one transaction, the change table's own rowid: this patch
+// names both, and the change time in microseconds (changeMicrosColumn),
+// as pseudo-columns of a change table, which SELECT * leaves out.
+//
+// A change table records nothing before it was made: a table rebuilt by
+// an ALTER TABLE, or made again by CREATE OR REPLACE TABLE, starts it
+// over. createChangeTable records the time it was made as a row of
+// _CHANGE_TYPE 'START', so that a reader knows from when the change
+// table holds the whole history.
+
+// changeOrderColumn is the pseudo-column of a change table's own rowid:
+// SQLite reads a column named rowid, which no change table has, as the
+// rowid.
+const changeOrderColumn = "rowid"
+
+// changeStartType is the _CHANGE_TYPE of the row that records when a
+// change table was made.
+const changeStartType = "START"
+
+// changeRowColumns returns the pseudo-columns a table named name has: the
+// row identities of a change table, none of any other table.
+func changeRowColumns(name string) []string {
+	if !isChangeTableName(name) {
+		return nil
+	}
+	return []string{changeMicrosColumn, changeRowidColumn, changeOrderColumn}
+}
+
+// changeStartRow is the statement that records, in the change table
+// named change, the time it was made.
+func changeStartRow(change string) string {
+	return fmt.Sprintf("INSERT INTO `%s` (`_CHANGE_TYPE`,`_CHANGE_TIMESTAMP`,`_CHANGE_IS_FOR_UPDATE`,`%s`) "+
+		"VALUES (%s, googlesqlite_change_timestamp(), %s, googlesqlite_change_micros())",
+		change, changeMicrosColumn, encodedLiteral(value.StringValue(changeStartType)), encodedLiteral(value.BoolValue(false)))
+}
