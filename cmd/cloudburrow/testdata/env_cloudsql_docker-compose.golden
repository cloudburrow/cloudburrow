# Paste under a service in docker-compose.yml. Generated by `cloudburrow env --format docker-compose`.
# Loopback addresses are rewritten to host.docker.internal; see docs/configuration.md for when
# a container can reach them. GOOGLE_APPLICATION_CREDENTIALS is omitted: it names a host path.
environment:
  CLOUDBURROW_CLOUDSQL_URL: "postgres://cloudburrow@host.docker.internal:9019/cloudburrow?sslmode=disable"
  CLOUDBURROW_DOMAIN: "cloudburrow.localhost"
  CLOUDBURROW_INGRESS: "http://host.docker.internal:9080"
  CLOUDBURROW_RESOURCEMANAGER_ENDPOINT: "host.docker.internal:9007"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_CLOUDRESOURCEMANAGER: "http://host.docker.internal:9007/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_IAMCREDENTIALS: "http://host.docker.internal:9005/"
  CLOUDSDK_CORE_PROJECT: "golden"
  GCE_METADATA_HOST: "host.docker.internal:9005"
  GOOGLE_CLOUD_PROJECT: "golden"
  PGDATABASE: "cloudburrow"
  PGHOST: "host.docker.internal"
  PGPORT: "9019"
  PGSSLMODE: "disable"
  PGUSER: "cloudburrow"
