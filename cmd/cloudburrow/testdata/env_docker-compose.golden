# Paste under a service in docker-compose.yml. Generated by `cloudburrow env --format docker-compose`.
# Loopback addresses are rewritten to host.docker.internal; see docs/configuration.md for when
# a container can reach them. GOOGLE_APPLICATION_CREDENTIALS is omitted: it names a host path.
environment:
  CLOUDBURROW_APIKEYS_ENDPOINT: "host.docker.internal:9029"
  CLOUDBURROW_DOMAIN: "cloudburrow.localhost"
  CLOUDBURROW_INGRESS: "http://host.docker.internal:9080"
  CLOUDBURROW_KMS_ENDPOINT: "host.docker.internal:9018"
  CLOUDBURROW_RESOURCEMANAGER_ENDPOINT: "host.docker.internal:9007"
  CLOUDBURROW_SECRETMANAGER_ENDPOINT: "host.docker.internal:9006"
  CLOUDBURROW_SERVICEUSAGE_ENDPOINT: "host.docker.internal:9023"
  CLOUDBURROW_STORAGEBATCHOPERATIONS_ENDPOINT: "host.docker.internal:9035"
  CLOUDBURROW_STORAGEINSIGHTS_ENDPOINT: "host.docker.internal:9036"
  CLOUDBURROW_STORAGETRANSFER_ENDPOINT: "host.docker.internal:9037"
  CLOUDBURROW_TASKS_ENDPOINT: "host.docker.internal:9003"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_APIKEYS: "http://host.docker.internal:9029/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_CLOUDKMS: "http://host.docker.internal:9018/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_CLOUDRESOURCEMANAGER: "http://host.docker.internal:9007/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_CLOUDTASKS: "http://host.docker.internal:9003/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_IAMCREDENTIALS: "http://host.docker.internal:9005/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_PUBSUB: "http://host.docker.internal:9002/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_SECRETMANAGER: "http://host.docker.internal:9006/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_SERVICEUSAGE: "http://host.docker.internal:9023/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_STORAGE: "http://host.docker.internal:9001/storage/v1/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_STORAGEBATCHOPERATIONS: "http://host.docker.internal:9035/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_STORAGEINSIGHTS: "http://host.docker.internal:9036/"
  CLOUDSDK_API_ENDPOINT_OVERRIDES_TRANSFER: "http://host.docker.internal:9037/"
  CLOUDSDK_AUTH_MTLS_TOKEN_HOST: "http://host.docker.internal:9005/token"
  CLOUDSDK_AUTH_TOKEN_HOST: "http://host.docker.internal:9005/token"
  CLOUDSDK_COMPONENT_MANAGER_DISABLE_UPDATE_CHECK: "true"
  CLOUDSDK_CORE_CHECK_GCE_METADATA: "false"
  CLOUDSDK_CORE_DISABLE_USAGE_REPORTING: "true"
  CLOUDSDK_CORE_PROJECT: "golden"
  CLOUDSDK_METRICS_ENVIRONMENT: "cloudburrow"
  GCE_METADATA_HOST: "host.docker.internal:9005"
  GCE_METADATA_IP: "host.docker.internal:9005"
  GCE_METADATA_ROOT: "host.docker.internal:9005"
  GOOGLE_CLOUD_PROJECT: "golden"
  PUBSUB_EMULATOR_HOST: "host.docker.internal:9002"
  STORAGE_EMULATOR_HOST: "http://host.docker.internal:9001"
  STORAGE_EMULATOR_HOST_GRPC: "host.docker.internal:9001"
