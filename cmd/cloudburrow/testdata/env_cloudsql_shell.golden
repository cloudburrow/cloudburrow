# eval "$(cloudburrow env)" to apply these to the current shell.
#
# None of this authenticates anything: CloudBurrow serves every caller,
# and the credentials file exists only so tools that insist on having one
# can run offline. See docs/credentials.md.
export CLOUDBURROW_CLOUDSQL_URL="postgres://cloudburrow@127.0.0.1:9019/cloudburrow?sslmode=disable"  # the same, as one connection string
export CLOUDBURROW_DOMAIN="cloudburrow.localhost"  # services are named <service>.<namespace>.cloudburrow.localhost
export CLOUDBURROW_INGRESS="http://127.0.0.1:9080"  # Cloud Run services are served here; see docs/networking.md
export CLOUDBURROW_RESOURCEMANAGER_ENDPOINT="127.0.0.1:9007"  # gRPC and REST, plaintext; read by no client library: pass it to option.WithEndpoint
export CLOUDSDK_API_ENDPOINT_OVERRIDES_CLOUDRESOURCEMANAGER="http://127.0.0.1:9007/"  # read by gcloud; only the v3 Projects API is served here
export CLOUDSDK_API_ENDPOINT_OVERRIDES_IAMCREDENTIALS="http://127.0.0.1:9005/"  # gcloud impersonation; local tokens, no permission is checked (docs/credentials.md)
export CLOUDSDK_CORE_PROJECT="golden"  # gcloud's project
export GCE_METADATA_HOST="127.0.0.1:9005"  # points Google's metadata lookups at this instance, not 169.254.169.254
export GOOGLE_APPLICATION_CREDENTIALS="/host/only/adc.json"  # a locally generated fixture; it authorises nothing
export GOOGLE_CLOUD_PROJECT="golden"  # the project every local resource lives under
export PGDATABASE="cloudburrow"  # Cloud SQL for PostgreSQL default database
export PGHOST="127.0.0.1"  # Cloud SQL for PostgreSQL: a local PostgreSQL; not the Cloud SQL Admin API
export PGPORT="9019"  # Cloud SQL for PostgreSQL port
export PGSSLMODE="disable"  # the local server has no TLS
export PGUSER="cloudburrow"  # Cloud SQL for PostgreSQL user; trust auth, no password
