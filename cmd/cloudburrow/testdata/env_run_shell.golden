# eval "$(cloudburrow env)" to apply these to the current shell.
#
# None of this authenticates anything: CloudBurrow serves every caller,
# and the credentials file exists only so tools that insist on having one
# can run offline. See docs/credentials.md.
export ="127.0.0.1:9007"  # Cloud Billing and Budget APIs, gRPC and REST, plaintext; read by no client library: pass it to option.WithEndpoint
export CLOUDBURROW_APIKEYS_ENDPOINT="127.0.0.1:9029"  # the API Keys API v2, REST, plaintext; read by no client library: pass http://127.0.0.1:9029/ to option.WithEndpoint
export CLOUDBURROW_DOMAIN="cloudburrow.localhost"  # services are named <service>.<namespace>.cloudburrow.localhost
export CLOUDBURROW_INGRESS="http://127.0.0.1:9080"  # Cloud Run services are served here; see docs/networking.md
export CLOUDBURROW_RESOURCEMANAGER_ENDPOINT="127.0.0.1:9007"  # gRPC and REST, plaintext; read by no client library: pass it to option.WithEndpoint
export CLOUDBURROW_RUN_ENDPOINT="127.0.0.1:9004"  # gRPC, plaintext; read by no client library: give it to a channel in code
export CLOUDBURROW_SERVICEUSAGE_ENDPOINT="127.0.0.1:9023"  # the Service Usage API v1, REST, plaintext; read by no client library: pass http://127.0.0.1:9023/ to option.WithEndpoint
export CLOUDSDK_API_ENDPOINT_OVERRIDES_APIKEYS="http://127.0.0.1:9029/"  # read by gcloud; gcloud services api-keys
export CLOUDSDK_API_ENDPOINT_OVERRIDES_CLOUDBILLING="http://127.0.0.1:9007/"  # read by gcloud billing accounts and projects; Cloud Billing is served on the Resource Manager port
export CLOUDSDK_API_ENDPOINT_OVERRIDES_CLOUDRESOURCEMANAGER="http://127.0.0.1:9007/"  # read by gcloud; its projects commands use the v1 API, served here with v3
export CLOUDSDK_API_ENDPOINT_OVERRIDES_IAMCREDENTIALS="http://127.0.0.1:9005/"  # read by gcloud for --impersonate-service-account (docs/credentials.md)
export CLOUDSDK_API_ENDPOINT_OVERRIDES_SERVICEUSAGE="http://127.0.0.1:9023/"  # read by gcloud; gcloud services list, enable and disable
export CLOUDSDK_AUTH_DISABLE_CREDENTIALS="true"  # read by gcloud: sends no credential (CloudBurrow authenticates nothing), so it never looks up a service account's Regional Access Boundary at Google
export CLOUDSDK_AUTH_MTLS_TOKEN_HOST="http://127.0.0.1:9005/token"  # read by gcloud under client certificates: refreshes go to this instance
export CLOUDSDK_AUTH_TOKEN_HOST="http://127.0.0.1:9005/token"  # read by gcloud: every credential refresh goes to this instance, not Google's token endpoint
export CLOUDSDK_COMPONENT_MANAGER_DISABLE_UPDATE_CHECK="true"  # read by gcloud: does not ask Google for component updates
export CLOUDSDK_CORE_CHECK_GCE_METADATA="false"  # read by gcloud: takes no account or project from a metadata server
export CLOUDSDK_CORE_DISABLE_USAGE_REPORTING="true"  # read by gcloud: sends no usage statistics to Google
export CLOUDSDK_CORE_PROJECT="golden"  # gcloud's project
export CLOUDSDK_METRICS_ENVIRONMENT="cloudburrow"  # read by gcloud: names its environment, so it never probes metadata.google.internal to find out
export GCE_METADATA_HOST="127.0.0.1:9005"  # points Google's metadata lookups at this instance, not 169.254.169.254
export GCE_METADATA_IP="127.0.0.1:9005"  # read by Python's google-auth and Node's gcp-metadata for their metadata ping: this instance, not 169.254.169.254
export GCE_METADATA_ROOT="127.0.0.1:9005"  # read by gcloud and older libraries for the metadata server: this instance, so metadata.google.internal is never looked up
export GOOGLE_APPLICATION_CREDENTIALS="/host/only/adc.json"  # a locally generated fixture; it authorises nothing
export GOOGLE_CLOUD_PROJECT="golden"  # the project every local resource lives under
