{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloudburrow/cloudburrow/blob/main/docs/seed.schema.json",
  "title": "CloudBurrow seed document",
  "description": "The body of POST /admin/seed. Every component is validated before any is seeded, unknown fields are refused, and re-seeding an existing resource is a 409 unless ifNotExists is true. See docs/configuration.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["components"],
  "properties": {
    "components": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "tasks": { "$ref": "#/$defs/tasks" },
        "storage": { "$ref": "#/$defs/storage" },
        "pubsub": { "$ref": "#/$defs/pubsub" },
        "secretmanager": { "$ref": "#/$defs/secretmanager" },
        "scheduler": { "$ref": "#/$defs/scheduler" }
      }
    }
  },
  "$defs": {
    "ifNotExists": {
      "type": "boolean",
      "default": false,
      "description": "Skip resources that already exist instead of failing with 409. A secret that exists is skipped whole, versions included, so a repeat never duplicates versions."
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?s$",
      "description": "A protobuf Duration in its JSON form, such as \"600s\"."
    },
    "topicName": {
      "type": "string",
      "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/topics/[A-Za-z][A-Za-z0-9._~+%-]{2,254}$"
    },
    "schemaName": {
      "type": "string",
      "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/schemas/[A-Za-z][A-Za-z0-9._~+%-]{2,254}$"
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ifNotExists": { "$ref": "#/$defs/ifNotExists" },
        "queues": {
          "type": "array",
          "items": {
            "description": "A queue's full resource name, or a queue object with its App Engine routing override.",
            "oneOf": [
              { "type": "string", "pattern": "^projects/[^/]+/locations/[^/]+/queues/[^/]+$" },
              { "$ref": "#/$defs/queue" }
            ]
          }
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "description": "A Cloud Tasks queue in the REST API's field names. This instance has no App Engine: the override is stored and sets each App Engine task's host, and every App Engine attempt fails NOT_FOUND (HTTP 404).",
      "properties": {
        "name": { "type": "string", "pattern": "^projects/[^/]+/locations/[^/]+/queues/[^/]+$" },
        "appEngineRoutingOverride": { "$ref": "#/$defs/appEngineRouting" }
      }
    },
    "appEngineRouting": {
      "type": "object",
      "additionalProperties": false,
      "description": "An AppEngineRouting. Its host is output only, computed from the service, version and instance, so it is not taken.",
      "properties": {
        "service": { "type": "string" },
        "version": { "type": "string" },
        "instance": { "type": "string" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ifNotExists": { "$ref": "#/$defs/ifNotExists" },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$" },
              "objects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "description": "At most one of content and contentBase64; neither makes an empty object.",
                  "not": { "required": ["content", "contentBase64"] },
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "content": { "type": "string" },
                    "contentBase64": { "type": "string", "contentEncoding": "base64" },
                    "contentType": { "type": "string", "default": "application/octet-stream" },
                    "metadata": { "$ref": "#/$defs/labels" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "pubsub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ifNotExists": { "$ref": "#/$defs/ifNotExists" },
        "schemas": {
          "type": "array",
          "description": "Created before the topics, each with one revision. Every definition is checked with ValidateSchema before anything is seeded.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "definition"],
            "properties": {
              "name": { "$ref": "#/$defs/schemaName" },
              "type": {
                "enum": ["AVRO"],
                "description": "AVRO only: the emulator refuses Protocol Buffer schemas as UNIMPLEMENTED."
              },
              "definition": { "type": "string", "minLength": 1, "description": "The Avro schema, as JSON text." }
            }
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/topicName" },
              "labels": { "$ref": "#/$defs/labels" },
              "messageRetentionDuration": { "$ref": "#/$defs/duration" },
              "schemaSettings": {
                "type": "object",
                "additionalProperties": false,
                "required": ["schema", "encoding"],
                "description": "Binds the topic to a schema, from this seed or one that exists; a message that does not conform is refused on publish.",
                "properties": {
                  "schema": { "$ref": "#/$defs/schemaName" },
                  "encoding": { "enum": ["JSON", "BINARY"] }
                }
              }
            }
          }
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "topic"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/subscriptions/[A-Za-z][A-Za-z0-9._~+%-]{2,254}$"
              },
              "topic": { "$ref": "#/$defs/topicName" },
              "ackDeadlineSeconds": { "type": "integer", "minimum": 10, "maximum": 600 },
              "filter": { "type": "string" },
              "labels": { "$ref": "#/$defs/labels" },
              "enableMessageOrdering": { "type": "boolean" },
              "enableExactlyOnceDelivery": {
                "type": "boolean",
                "description": "Pull subscriptions only: refused with a pushConfig, as Google refuses it."
              },
              "pushConfig": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pushEndpoint"],
                "properties": {
                  "pushEndpoint": { "type": "string", "pattern": "^https?://" },
                  "attributes": { "$ref": "#/$defs/labels" }
                }
              },
              "deadLetterPolicy": {
                "type": "object",
                "additionalProperties": false,
                "required": ["deadLetterTopic"],
                "properties": {
                  "deadLetterTopic": { "$ref": "#/$defs/topicName" },
                  "maxDeliveryAttempts": { "type": "integer", "minimum": 5, "maximum": 100 }
                }
              },
              "retryPolicy": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minimumBackoff": { "$ref": "#/$defs/duration" },
                  "maximumBackoff": { "$ref": "#/$defs/duration" }
                }
              },
              "messageRetentionDuration": {
                "$ref": "#/$defs/duration",
                "description": "How long unacknowledged messages are kept: 600s (10 minutes) to 2678400s (31 days); absent, 7 days."
              },
              "retainAckedMessages": {
                "type": "boolean",
                "description": "Keep acknowledged messages for the retention duration too."
              },
              "expirationPolicy": {
                "type": "object",
                "additionalProperties": false,
                "description": "Enforced by CloudBurrow's Pub/Sub front: the subscription is deleted once idle for its ttl. {} never expires; absent, Google's 31-day default. A ttl under 1 day, or under the message retention duration (7 days when not given), is refused before anything is seeded.",
                "properties": {
                  "ttl": { "$ref": "#/$defs/duration" }
                }
              }
            }
          }
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ifNotExists": { "$ref": "#/$defs/ifNotExists" },
        "jobs": {
          "type": "array",
          "description": "Cloud Scheduler jobs in the REST API's field names, each validated as CreateJob validates it. A seeded job is ENABLED, with its next run computed from its schedule.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "schedule"],
            "description": "Exactly one of httpTarget, pubsubTarget and appEngineHttpTarget.",
            "oneOf": [{ "required": ["httpTarget"] }, { "required": ["pubsubTarget"] }, { "required": ["appEngineHttpTarget"] }],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/[a-z0-9-]+/jobs/[A-Za-z0-9_-]{1,500}$"
              },
              "description": { "type": "string" },
              "schedule": { "type": "string", "description": "A unix-cron expression, such as \"*/5 * * * *\"." },
              "timeZone": { "type": "string", "default": "Etc/UTC", "description": "An IANA time zone." },
              "httpTarget": {
                "type": "object",
                "additionalProperties": false,
                "required": ["uri"],
                "description": "At most one of body and bodyBase64, and at most one of oidcToken and oauthToken. A token is minted locally, signed with the instance's own key, at each attempt.",
                "allOf": [
                  { "not": { "required": ["body", "bodyBase64"] } },
                  { "not": { "required": ["oidcToken", "oauthToken"] } }
                ],
                "properties": {
                  "uri": { "type": "string", "pattern": "^https?://" },
                  "httpMethod": {
                    "type": "string",
                    "enum": ["POST", "GET", "HEAD", "PUT", "DELETE", "PATCH", "OPTIONS"],
                    "default": "POST"
                  },
                  "headers": { "$ref": "#/$defs/labels" },
                  "body": { "type": "string" },
                  "bodyBase64": { "type": "string", "contentEncoding": "base64" },
                  "oidcToken": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["serviceAccountEmail"],
                    "description": "An OIDC ID token for the account; the audience defaults to the uri.",
                    "properties": {
                      "serviceAccountEmail": { "type": "string" },
                      "audience": { "type": "string" }
                    }
                  },
                  "oauthToken": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["serviceAccountEmail"],
                    "description": "An OAuth access token for the account; the scope defaults to https://www.googleapis.com/auth/cloud-platform.",
                    "properties": {
                      "serviceAccountEmail": { "type": "string" },
                      "scope": { "type": "string" }
                    }
                  }
                }
              },
              "pubsubTarget": {
                "type": "object",
                "additionalProperties": false,
                "required": ["topicName"],
                "description": "Data or at least one attribute is required; at most one of data and dataBase64.",
                "not": { "required": ["data", "dataBase64"] },
                "properties": {
                  "topicName": { "$ref": "#/$defs/topicName" },
                  "data": { "type": "string" },
                  "dataBase64": { "type": "string", "contentEncoding": "base64" },
                  "attributes": { "$ref": "#/$defs/labels" }
                }
              },
              "appEngineHttpTarget": {
                "type": "object",
                "additionalProperties": false,
                "description": "An App Engine target, validated as CreateJob validates it: relativeUri begins with / (empty is /), and a body is allowed only with POST or PUT. At most one of body and bodyBase64. This instance has no App Engine, so every attempt fails NOT_FOUND (HTTP 404).",
                "not": { "required": ["body", "bodyBase64"] },
                "properties": {
                  "httpMethod": {
                    "type": "string",
                    "enum": ["POST", "GET", "HEAD", "PUT", "DELETE", "PATCH", "OPTIONS"],
                    "default": "POST"
                  },
                  "relativeUri": { "type": "string", "pattern": "^(/.*)?$", "default": "/" },
                  "headers": { "$ref": "#/$defs/labels" },
                  "appEngineRouting": { "$ref": "#/$defs/appEngineRouting" },
                  "body": { "type": "string" },
                  "bodyBase64": { "type": "string", "contentEncoding": "base64" }
                }
              },
              "retryConfig": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "retryCount": { "type": "integer", "minimum": 0, "maximum": 5 },
                  "maxRetryDuration": { "$ref": "#/$defs/duration" },
                  "minBackoffDuration": { "$ref": "#/$defs/duration" },
                  "maxBackoffDuration": { "$ref": "#/$defs/duration" },
                  "maxDoublings": { "type": "integer", "minimum": 0 }
                }
              },
              "attemptDeadline": {
                "$ref": "#/$defs/duration",
                "description": "Between 15s and 1800s; 180s when unset."
              }
            }
          }
        }
      }
    },
    "secretmanager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ifNotExists": { "$ref": "#/$defs/ifNotExists" },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^projects/[^/]+/secrets/[A-Za-z0-9_-]{1,255}$" },
              "labels": { "$ref": "#/$defs/labels" },
              "annotations": { "$ref": "#/$defs/labels" },
              "versions": {
                "type": "array",
                "description": "Added in order, so the last is latest.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "maxProperties": 1,
                  "properties": {
                    "data": { "type": "string" },
                    "dataBase64": { "type": "string", "contentEncoding": "base64" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
