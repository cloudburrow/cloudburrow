# A Compute Engine VM's image as a systemd container (#1963): the official
# Debian or Ubuntu container image, by pinned digest, with systemd, sshd and
# CloudBurrow's guest scripts. Distribution packages are installed from the
# distribution's own archive; nothing here is linked into CloudBurrow.
#
# The archive is read through its snapshot service at one fixed time,
# APT_SNAPSHOT (#2258): snapshot.debian.org for Debian, snapshot.ubuntu.com
# for Ubuntu (whose archive.ubuntu.com carries arm64 as well as amd64, so
# one snapshot serves both), so a build installs the same package versions
# every time and does not depend on a live mirror's health (a debian-12
# build failed in CI on a mirror download error, apt-get exit 100). The
# snapshot's Release files are past their Valid-Until, so the snapshot
# sources alone skip that check; their signatures are still verified
# against the base's own archive keyring. Downloads are retried.
# snapshot.ubuntu.com is HTTPS only and the base has no CA certificates,
# so apt is given distroless's bundle (the image dependencies.json pins
# for internal/storageimage) for that one host.
# Move APT_SNAPSHOT with the bases' digests.
#
# conntrack (conntrack-tools) lists a Cloud NAT gateway pod's connections
# over netlink: Ubuntu's and many distributions' kernels are built without
# CONFIG_NF_CONNTRACK_PROCFS, so /proc/net/nf_conntrack is absent on them.
ARG BASE
FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2 AS ca
FROM ${BASE}
ENV container=docker DEBIAN_FRONTEND=noninteractive
ARG APT_SNAPSHOT=20261120T000000Z
COPY --from=ca /etc/ssl/certs/ca-certificates.crt /etc/apt/cloudburrow-snapshot-ca.crt
RUN . /etc/os-release \
 && printf '%s\n' 'Acquire::Retries "5";' 'Acquire::https::snapshot.ubuntu.com::CaInfo "/etc/apt/cloudburrow-snapshot-ca.crt";' \
      > /etc/apt/apt.conf.d/80cloudburrow-snapshot \
 && case "$ID" in \
      debian) printf '%s\n' \
        'Types: deb' "URIs: http://snapshot.debian.org/archive/debian/${APT_SNAPSHOT}" \
        "Suites: ${VERSION_CODENAME} ${VERSION_CODENAME}-updates" 'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' 'Check-Valid-Until: no' '' \
        'Types: deb' "URIs: http://snapshot.debian.org/archive/debian-security/${APT_SNAPSHOT}" \
        "Suites: ${VERSION_CODENAME}-security" 'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' 'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/debian.sources ;; \
      ubuntu) printf '%s\n' \
        'Types: deb' "URIs: https://snapshot.ubuntu.com/ubuntu/${APT_SNAPSHOT}" \
        "Suites: ${VERSION_CODENAME} ${VERSION_CODENAME}-updates ${VERSION_CODENAME}-backports ${VERSION_CODENAME}-security" \
        'Components: main universe restricted multiverse' \
        'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' 'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/ubuntu.sources ;; \
      *) echo "no archive snapshot for $ID" >&2; exit 1 ;; \
    esac \
 && rm -f /etc/apt/sources.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv dbus openssh-server sudo curl ca-certificates iproute2 procps less nftables conntrack netcat-openbsd socat e2fsprogs \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && rm -f /etc/ssh/ssh_host_* \
 && (userdel -r ubuntu 2>/dev/null || true)
# Google's Ops Agent (#2139), pinned, from Google's own package repository
# as add-google-cloud-ops-agent-repo.sh adds it (signed by Google's apt
# key), with rsyslog for its default syslog receiver (/var/log/syslog) and
# perl-base for the agent's in-guest metadata relay. It runs only behind
# CloudBurrow's egress fence (usr/lib/cloudburrow/ops-agent).
ARG OPS_AGENT_VERSION=2.73.0
RUN . /etc/os-release \
 && curl -fsS --retry 3 https://packages.cloud.google.com/apt/doc/apt-key.gpg --create-dirs -o /etc/apt/keyrings/google-cloud-ops-agent.asc \
 && echo "deb [signed-by=/etc/apt/keyrings/google-cloud-ops-agent.asc] https://packages.cloud.google.com/apt google-cloud-ops-agent-${VERSION_CODENAME}-all main" > /etc/apt/sources.list.d/google-cloud-ops-agent.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends rsyslog perl-base "google-cloud-ops-agent=${OPS_AGENT_VERSION}~${ID}${VERSION_ID}" \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && groupadd -r cloudburrow-opsagent
# A Shielded VM's vTPM and HTTPS metadata server credentials (#2179):
# swtpm (BSD-3-Clause), which the vTPM container beside the guest runs
# from this image, from the distribution's archive; Google's guest agent,
# pinned, from Google's own package repository (Ubuntu's own archive on
# Ubuntu, as Ubuntu's Compute Engine images have it), for its MDS mTLS
# job alone (etc/default/instance_configs.cfg) behind CloudBurrow's
# egress fence (usr/lib/cloudburrow/guest-agent-fence).
ARG GUEST_AGENT_VERSION=1:20261021.00-g1
RUN . /etc/os-release \
 && apt-get update \
 && apt-get install -y --no-install-recommends swtpm \
 && if [ "$ID" = debian ]; then \
      curl -fsS --retry 3 https://packages.cloud.google.com/apt/doc/apt-key.gpg -o /etc/apt/keyrings/google-compute-engine.asc \
      && echo "deb [signed-by=/etc/apt/keyrings/google-compute-engine.asc] https://packages.cloud.google.com/apt google-compute-engine-${VERSION_CODENAME}-stable main" > /etc/apt/sources.list.d/google-compute-engine.list \
      && apt-get update && apt-get install -y --no-install-recommends "google-guest-agent=${GUEST_AGENT_VERSION}"; \
    else apt-get install -y --no-install-recommends google-guest-agent; fi \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && groupadd -r cloudburrow-guestagent
COPY root/ /
RUN chmod 0755 /usr/lib/cloudburrow/* \
 && systemctl mask systemd-udevd.service systemd-udevd-kernel.socket systemd-udevd-control.socket getty.target console-getty.service systemd-logind.service \
 && systemctl enable cloudburrow-network.service cloudburrow-vpc.service cloudburrow-relay6.service cloudburrow-guest-agent.service google-startup-scripts.service \
    cloudburrow-ops-agent-fence.service cloudburrow-metadata-server.service google-cloud-ops-agent.service \
    cloudburrow-firmware.service cloudburrow-guest-agent-fence.service \
 && /usr/lib/cloudburrow/guest-agent-units \
 && (systemctl enable ssh.service 2>/dev/null || systemctl enable sshd.service) \
 && echo '%google-sudoers ALL=(ALL:ALL) NOPASSWD:ALL' > /etc/sudoers.d/google_sudoers && chmod 0440 /etc/sudoers.d/google_sudoers \
 && groupadd -f google-sudoers
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
