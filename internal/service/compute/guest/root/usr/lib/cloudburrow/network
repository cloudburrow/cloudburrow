#!/bin/sh
# Gives every login the metadata endpoint's environment (#1963). The
# internal IP Compute Engine reserved for the guest in its subnet is on
# vpc0, which cloudburrow-vpc.service keeps (#1968).
set -u
{
  [ -n "${GCE_METADATA_HOST:-}" ] && echo "GCE_METADATA_HOST=${GCE_METADATA_HOST}"
  [ -n "${GOOGLE_CLOUD_PROJECT:-}" ] && echo "GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT}"
} > /etc/environment.cloudburrow
grep -v '^GCE_METADATA_HOST=\|^GOOGLE_CLOUD_PROJECT=' /etc/environment 2>/dev/null > /etc/environment.tmp || true
cat /etc/environment.cloudburrow >> /etc/environment.tmp
mv /etc/environment.tmp /etc/environment
rm -f /etc/environment.cloudburrow
echo "CloudBurrow guest: internal IP ${CLOUDBURROW_INTERNAL_IP:-none}" | /usr/lib/cloudburrow/console cloudburrow-network
