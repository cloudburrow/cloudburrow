#!/usr/bin/perl
# The Ops Agent's metadata server in the guest (#2139), on 127.0.0.1:8169,
# which the agent's units name as GCE_METADATA_HOST and Fluent Bit's
# metadata_server. Google's agent reads the instance's identity (project,
# zone, instance ID and name) and its service account's token from the
# metadata server at a fixed path; here an instance's own attributes are
# served by the Compute Engine port under the instance's token
# (CLOUDBURROW_GUEST_METADATA, http://HOST:PORT/cloudburrow/guest/TOKEN) and
# its tokens by the metadata server (GCE_METADATA_HOST), so each GET of
# /computeMetadata/v1/... is relayed to the one that answers it. Nothing
# else is relayed: only those two CloudBurrow endpoints are ever dialled.
use strict;
use warnings;
use IO::Socket::INET;

my $guest = $ENV{CLOUDBURROW_GUEST_METADATA} // '';
my $meta  = $ENV{GCE_METADATA_HOST} // '';
my ($gh, $gp, $gprefix) = $guest =~ m{^http://([^/:]+):(\d+)(/.*?)/?$}
  or die "CLOUDBURROW_GUEST_METADATA is not set: no metadata relay\n";
my ($mh, $mp) = $meta =~ m{^([^/:]+):(\d+)$}
  or die "GCE_METADATA_HOST is not set: no metadata relay\n";

my $srv = IO::Socket::INET->new(LocalAddr => '127.0.0.1', LocalPort => 8169, Listen => 64,
  ReuseAddr => 1, Proto => 'tcp') or die "listen 127.0.0.1:8169: $!\n";
$SIG{CHLD} = 'IGNORE';

sub reply {
  my ($c, $code, $msg) = @_;
  print $c "HTTP/1.0 $code $msg\r\nContent-Type: text/plain\r\nMetadata-Flavor: Google\r\n"
    . "Content-Length: " . (length($msg) + 1) . "\r\nConnection: close\r\n\r\n$msg\n";
}

sub serve {
  my ($c) = @_;
  $c->autoflush(1);
  alarm 60;
  my $line = <$c>;
  return unless defined $line;
  my ($method, $target) = $line =~ m{^(\S+) (\S+) HTTP/1\.[01]\r?\n$}
    or return reply($c, 400, 'Bad Request');
  my %h;
  while (my $l = <$c>) {
    last if $l =~ /^\r?\n$/;
    $h{lc $1} = $2 if $l =~ /^([^:]+):\s*(.*?)\r?\n$/;
  }
  return reply($c, 405, 'Method Not Allowed') unless $method eq 'GET';
  return reply($c, 403, 'Missing Metadata-Flavor:Google header.')
    unless ($h{'metadata-flavor'} // '') eq 'Google';
  my ($path, $query) = split /\?/, $target, 2;
  return reply($c, 404, 'Not Found') unless $path =~ m{^/computeMetadata/v1/} && $path !~ m{\.\.};
  my ($host, $port, $upath);
  if ($path =~ m{^/computeMetadata/v1/instance/service-accounts(/|$)} || $path eq '/computeMetadata/v1/project/numeric-project-id') {
    ($host, $port, $upath) = ($mh, $mp, $path);
  } else {
    ($host, $port, $upath) = ($gh, $gp, $gprefix . $path);
  }
  $upath .= "?$query" if defined $query;
  my $u = IO::Socket::INET->new(PeerAddr => $host, PeerPort => $port, Proto => 'tcp', Timeout => 10)
    or return reply($c, 502, 'Bad Gateway');
  print $u "GET $upath HTTP/1.0\r\nHost: $host:$port\r\nMetadata-Flavor: Google\r\nConnection: close\r\n\r\n";
  # The status line and headers, a redirect's Location given back without
  # the Compute port's guest prefix (a directory named without its slash).
  while (my $l = <$u>) {
    $l =~ s{^(Location:\s*)(?:https?://[^/]+)?\Q$gprefix\E}{$1}i;
    print $c $l;
    last if $l =~ /^\r?\n$/;
  }
  my $buf;
  while (read($u, $buf, 65536)) {
    print $c $buf;
  }
  close $u;
}

while (1) {
  my $c = $srv->accept or next;
  my $pid = fork;
  if (!defined $pid) {
    close $c;
    next;
  }
  if ($pid) {
    close $c;
    next;
  }
  close $srv;
  serve($c);
  close $c;
  exit 0;
}
