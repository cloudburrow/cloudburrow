#!/bin/sh
# Reads one value of this instance's metadata from its metadata server
# (#1963, #2177), metadata.google.internal, as the guest environment does.
exec curl -sf --noproxy '*' --retry 10 --retry-connrefused --retry-delay 1 -H 'Metadata-Flavor: Google' "http://metadata.google.internal/computeMetadata/v1/$1"
