#!/bin/sh
# The guest's side of its VPC network (#1968). Every 2 seconds it reports
# its pod IP to CloudBurrow's Compute Engine API and reads back its
# network's configuration, which it applies when it changes:
#   - the firewall: the nftables ruleset of the VPC firewall rules that
#     apply to this instance, applied first and atomically, so no packet
#     crosses vpc0 before its rules are in force;
#   - the segment: vpc0, a VXLAN device whose VNI is the network's, holding
#     the instance's internal IP, an on-link route per subnet range of the
#     network, and a static neighbour and forwarding entry per peer VM
#     (its internal IP, its MAC, its pod IP), and a route through the router
#     appliance per prefix Cloud Router learned over BGP (routevia);
#   - IPv6 (dual-stack interfaces, #2140): the instance's IPv6 address on
#     vpc0, an on-link route per dual-stack /64 of the network and a
#     permanent neighbour and forwarding entry per peer's IPv6 address, so
#     IPv6 crosses the same VXLAN segment; an IPv6-only interface gets no
#     addr and no IPv4 routes;
#   - IPv6 internal load balancers: each forwarding rule address on lo,
#     for relay6 to carry to its listener;
#   - internal DNS: INSTANCE.ZONE.c.PROJECT.internal of every instance on
#     the network, in a block of /etc/hosts;
#   - the relays (#2160): each VPC address and port of a load balancer or
#     Secure Web Proxy gateway the instance reaches is redirected (by the
#     ruleset's relay chain) to a local socat, which opens a connection to
#     CloudBurrow's relay port and begins it with the PROXY protocol
#     version 2 header CloudBurrow gave for it (the instance's internal IP,
#     the address dialled and the instance's guest token), so the load
#     balancer or proxy sees this instance as the connection's source;
#     each UDP one (#2180) to a local udprelay, which carries each client's
#     datagrams as one framed flow with the same kind of header.
set -u
URL="${CLOUDBURROW_GUEST_METADATA}/cloudburrow/vpc"
RUN=/run/cloudburrow-vpc
mkdir -p "$RUN"
log() { echo "$*" | /usr/lib/cloudburrow/console cloudburrow-vpc; }

val() { sed -n "s/^$1 //p" "$RUN/conf" | head -n 1; }

apply() {
  sed -n '/^nft$/,$p' "$RUN/conf" | sed 1d > "$RUN/ruleset"
  { echo "table inet cloudburrow"; echo "delete table inet cloudburrow"; cat "$RUN/ruleset"; } > "$RUN/ruleset.nft"
  if ! nft -f "$RUN/ruleset.nft"; then
    log "cannot apply the firewall rules"
    return 1
  fi
  # A Cloud Run gateway (gateways.go) forwards between eth0 and vpc0.
  if grep -qx forward "$RUN/conf"; then
    echo 1 > /proc/sys/net/ipv4/ip_forward
  fi
  # A Cloud NAT gateway's pod (natgateways.go): its conntrack timeouts.
  sed -n 's/^sysctl //p' "$RUN/conf" | while read -r k v; do
    echo "$v" > "/proc/sys/net/netfilter/$k" 2>/dev/null
  done
  vni=$(val vni); mtu=$(val mtu); addr=$(val addr); mac=$(val mac)
  if [ "$(cat "$RUN/vni" 2>/dev/null)" != "$vni" ] || ! ip link show vpc0 >/dev/null 2>&1; then
    ip link del vpc0 2>/dev/null
    if ! ip link add vpc0 type vxlan id "$vni" dstport 4789 dev eth0 nolearning; then
      log "cannot make vpc0"
      return 1
    fi
    echo "$vni" > "$RUN/vni"
  fi
  max=$(( $(cat /sys/class/net/eth0/mtu) - 50 ))
  [ "$mtu" -gt "$max" ] && mtu=$max
  addr6=$(val addr6)
  if [ -n "$addr6" ]; then
    echo 0 > /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null
    echo 0 > /proc/sys/net/ipv6/conf/vpc0/disable_ipv6 2>/dev/null
  else
    echo 1 > /proc/sys/net/ipv6/conf/vpc0/disable_ipv6 2>/dev/null
  fi
  ip link set vpc0 address "$mac" mtu "$mtu" up
  # An IPv6-only interface (stackType IPV6_ONLY) has no IPv4 address and
  # no IPv4 route.
  if [ -n "$addr" ]; then
    ip addr replace "$addr/32" dev vpc0
  else
    ip -4 addr flush dev vpc0
  fi
  # Pins (#2140): a /32 through eth0 for each address the guest itself
  # needs over its pod interface: the cluster DNS servers, the metadata
  # server's (the guest URL's host) and each peer's pod (the VXLAN
  # underlay). A subnet may legitimately overlap the cluster's ranges
  # (10.96.0.0/24 is a valid subnet on Google), and its on-link route on
  # vpc0 would otherwise take the guest's DNS, its metadata (so its SSH
  # keys) and its underlay with it.
  pgw=$(ip -4 route show default dev eth0 | sed -n 's/^default via \([0-9.]*\).*/\1/p' | head -n 1)
  {
    sed -n 's/^nameserver[[:space:]]*\([0-9.]*\)[[:space:]]*$/\1/p' /etc/resolv.conf
    [ -n "$HOSTIP" ] && echo "$HOSTIP"
    sed -n 's/^peer6\{0,1\} [^ ]* [^ ]* \([0-9.]*\)$/\1/p' "$RUN/conf"
  } | grep -v '^$' | sort -u > "$RUN/pins.new"
  if [ -f "$RUN/pins" ]; then
    while read -r ip; do
      grep -qx "$ip" "$RUN/pins.new" || ip route del "$ip/32" dev eth0 2>/dev/null
    done < "$RUN/pins"
  fi
  if [ -n "$pgw" ]; then
    while read -r ip; do
      ip route replace "$ip/32" via "$pgw" dev eth0
    done < "$RUN/pins.new"
  fi
  mv "$RUN/pins.new" "$RUN/pins"
  # Routes: one per subnet range; stale ones removed.
  sed -n 's/^route //p' "$RUN/conf" > "$RUN/routes"
  while read -r cidr; do
    ip route replace "$cidr" dev vpc0 scope link src "$addr"
  done < "$RUN/routes"
  # Dynamic routes Cloud Router learned over BGP (bgpspeakers.go): PREFIX
  # through the router appliance at NEXTHOP, on the segment.
  sed -n 's/^routevia //p' "$RUN/conf" > "$RUN/routesvia"
  while read -r cidr hop; do
    ip route replace "$cidr" via "$hop" dev vpc0 onlink src "$addr"
  done < "$RUN/routesvia"
  # Cloud NAT (natgateways.go): the internet through the NAT gateway's
  # pod at the subnet's gateway address; private ranges, the cluster's and
  # the metadata server's stay on eth0.
  nat=$(val nat)
  sed -n 's/^natkeep //p' "$RUN/conf" > "$RUN/natkeep.new"
  if [ -f "$RUN/natkeep" ]; then
    while read -r cidr; do
      grep -qx "$cidr" "$RUN/natkeep.new" || ip route del "$cidr" dev eth0 2>/dev/null
    done < "$RUN/natkeep"
  fi
  mv "$RUN/natkeep.new" "$RUN/natkeep"
  if [ -n "$nat" ] && [ -n "$addr" ]; then
    gw=$(ip -4 route show default dev eth0 | sed -n 's/^default via \([0-9.]*\).*/\1/p' | head -n 1)
    while read -r cidr; do
      ip route replace "$cidr" via "$gw" dev eth0
    done < "$RUN/natkeep"
    for cidr in 0.0.0.0/1 128.0.0.0/1; do
      ip route replace "$cidr" via "$nat" dev vpc0 onlink src "$addr"
      echo "$cidr" >> "$RUN/routes"
    done
  fi
  ip -4 route show dev vpc0 | while read -r cidr _; do
    grep -qx "$cidr" "$RUN/routes" || grep -q "^$cidr " "$RUN/routesvia" || ip route del "$cidr" dev vpc0
  done
  # IPv6: the address, its routes and its peers' neighbour entries.
  sed -n 's/^route6 //p' "$RUN/conf" > "$RUN/routes6"
  sed -n 's/^peer6 //p' "$RUN/conf" > "$RUN/peers6"
  if [ -n "$addr6" ]; then
    ip -6 addr replace "$addr6/128" dev vpc0 nodad
    ip -6 addr show dev vpc0 scope global | sed -n 's/.* inet6 \([0-9a-f:]*\)\/.*/\1/p' | while read -r a; do
      [ "$a" = "$addr6" ] || ip -6 addr del "$a/128" dev vpc0
    done
    while read -r cidr; do
      ip -6 route replace "$cidr" dev vpc0 src "$addr6"
    done < "$RUN/routes6"
    ip -6 route show dev vpc0 | while read -r cidr _; do
      case "$cidr" in fe80:*) continue ;; esac
      grep -qx "$cidr" "$RUN/routes6" || ip -6 route del "$cidr" dev vpc0
    done
    while read -r ip pmac pod; do
      ip -6 neigh replace "$ip" lladdr "$pmac" dev vpc0 nud permanent
      [ -n "$pod" ] && bridge fdb replace "$pmac" dev vpc0 dst "$pod" self permanent
    done < "$RUN/peers6"
  fi
  # IPv6 internal forwarding rules (vpcservices.go): each address on lo,
  # where relay6 takes the VM's connections to it.
  sed -n 's/^relay6 //p' "$RUN/conf" > "$RUN/relay6.new"
  if [ -s "$RUN/relay6.new" ]; then
    echo 0 > /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null
    echo 0 > /proc/sys/net/ipv6/conf/lo/disable_ipv6 2>/dev/null
  fi
  cut -d' ' -f1 "$RUN/relay6.new" | sort -u > "$RUN/relay6addrs.new"
  if [ -f "$RUN/relay6addrs" ]; then
    while read -r a; do
      grep -qx "$a" "$RUN/relay6addrs.new" || ip -6 addr del "$a/128" dev lo 2>/dev/null
    done < "$RUN/relay6addrs"
  fi
  while read -r a; do
    ip -6 addr replace "$a/128" dev lo nodad
  done < "$RUN/relay6addrs.new"
  mv "$RUN/relay6addrs.new" "$RUN/relay6addrs"
  mv "$RUN/relay6.new" "$RUN/relay6"
  # Peers: a permanent neighbour and forwarding entry each.
  sed -n 's/^peer //p' "$RUN/conf" > "$RUN/peers"
  while read -r ip pmac pod; do
    ip neigh replace "$ip" lladdr "$pmac" dev vpc0 nud permanent
    bridge fdb replace "$pmac" dev vpc0 dst "$pod" self permanent
  done < "$RUN/peers"
  ip neigh show dev vpc0 | while read -r ip _ pmac _; do
    grep -q "^$ip " "$RUN/peers" "$RUN/peers6" || ip neigh del "$ip" dev vpc0
  done
  bridge fdb show dev vpc0 | while read -r pmac kw dst _; do
    [ "$kw" = dst ] || continue
    case "$pmac" in 42:01:*|42:02:*) grep -q " $pmac " "$RUN/peers" "$RUN/peers6" || bridge fdb del "$pmac" dev vpc0 dst "$dst" self ;; esac
  done
  # Internal DNS.
  pod=$1
  {
    sed '/^# cloudburrow-vpc begin$/,/^# cloudburrow-vpc end$/d' /etc/hosts | grep -v "^$pod[[:space:]]"
    echo "# cloudburrow-vpc begin"
    sed -n 's/^host //p' "$RUN/conf"
    echo "# cloudburrow-vpc end"
  } > "$RUN/hosts"
  cat "$RUN/hosts" > /etc/hosts
  log "vpc0 $addr ${addr6:+$addr6 }(VNI $vni), $(wc -l < "$RUN/peers") peers, $(grep -c ' comment ' "$RUN/ruleset") firewall entries"
  relays
}

# relays keeps one local socat per "relay LOCAL ADDRESS PORT HEADER" line
# and one udprelay per "relayudp ..." line, restarting them all when the
# lines or the relay's port change.
relays() {
  umask 077
  sed -n 's/^relay //p' "$RUN/conf" > "$RUN/relays.new"
  sed -n 's/^relayudp //p' "$RUN/conf" > "$RUN/relays-udp.new"
  rport=$(val relayport)
  key="$(val relayhost) $rport $(cat "$RUN/relays.new" "$RUN/relays-udp.new")"
  [ "$key" = "$(cat "$RUN/relays.key" 2>/dev/null)" ] && return 0
  if [ -f "$RUN/relays.pids" ]; then
    while read -r pid; do kill "$pid" 2>/dev/null; done < "$RUN/relays.pids"
  fi
  : > "$RUN/relays.pids"
  host=$(val relayhost)
  if [ -z "$host" ]; then
    hp=${CLOUDBURROW_GUEST_METADATA#*://}; hp=${hp%%/*}; host=${hp%:*}
  fi
  if [ -n "$rport" ]; then
    while read -r lp ip port hdr; do
      printf '%s' "$hdr" | base64 -d > "$RUN/relay-$lp.hdr"
      # socat ends an address at an unescaped colon, so the inner
      # address's colons are escaped.
      socat TCP-LISTEN:"$lp",bind=127.0.0.1,reuseaddr,fork \
        SYSTEM:"cat $RUN/relay-$lp.hdr - | socat -t 30 - TCP\:$host\:$rport" </dev/null >/dev/null 2>&1 &
      echo $! >> "$RUN/relays.pids"
    done < "$RUN/relays.new"
    while read -r lp ip port hdr; do
      printf '%s' "$hdr" | base64 -d > "$RUN/relay-udp-$lp.hdr"
      if ! command -v perl >/dev/null 2>&1; then
        log "cannot relay UDP to $ip:$port: no perl in this image"
        continue
      fi
      perl /usr/lib/cloudburrow/udprelay "$lp" "$host" "$rport" "$RUN/relay-udp-$lp.hdr" </dev/null >/dev/null 2>&1 &
      echo $! >> "$RUN/relays.pids"
    done < "$RUN/relays-udp.new"
  fi
  printf '%s' "$key" > "$RUN/relays.key"
  log "relaying $(wc -l < "$RUN/relays.new") load balancer and gateway addresses, $(wc -l < "$RUN/relays-udp.new") UDP"
}

# The guest URL's host, resolved while the cluster DNS is reachable; kept
# when a later lookup fails.
HOST=$(printf '%s' "$URL" | sed -E 's#^[a-z]+://##; s#[:/].*$##')
HOSTIP=""
last=""
while true; do
  h=$(getent ahostsv4 "$HOST" 2>/dev/null | awk 'NR==1 {print $1}')
  if [ -n "$h" ] && [ "$h" != "$HOSTIP" ]; then
    HOSTIP=$h
    last=""
  fi
  pod=$(ip -4 -o addr show dev eth0 scope global | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p' | grep -vx "${CLOUDBURROW_INTERNAL_IP:-none}" | head -n 1)
  if conf=$(curl -sf -m 5 -H 'Metadata-Flavor: Google' "$URL?pod=$pod") && [ -n "$conf" ]; then
    if [ "$conf" != "$last" ]; then
      printf '%s\n' "$conf" > "$RUN/conf"
      apply "$pod" && last=$conf
    fi
  fi
  sleep 2
done
