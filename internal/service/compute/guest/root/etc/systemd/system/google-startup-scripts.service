[Unit]
Description=Google Compute Engine Startup Scripts
After=network-online.target cloudburrow-network.service cloudburrow-metadata-server.service cloudburrow-guest-agent.service
[Service]
Type=oneshot
RemainAfterExit=yes
PassEnvironment=CLOUDBURROW_GUEST_METADATA GCE_METADATA_HOST GOOGLE_CLOUD_PROJECT
ExecStart=/usr/lib/cloudburrow/startup-script
KillMode=process
[Install]
WantedBy=multi-user.target
