[Unit]
Description=CloudBurrow: the Ops Agent's metadata server (this instance's attributes and tokens)
After=network-online.target cloudburrow-network.service
Wants=network-online.target
Before=google-cloud-ops-agent.service google-cloud-ops-agent-fluent-bit.service google-cloud-ops-agent-opentelemetry-collector.service
[Service]
PassEnvironment=CLOUDBURROW_GUEST_METADATA GCE_METADATA_HOST
ExecStart=/usr/lib/cloudburrow/ops-agent-metadata
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
