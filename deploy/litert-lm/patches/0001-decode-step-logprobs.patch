+// limitations under the License.
+
+#include "runtime/core/decode_step_observer.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <mutex>  // NOLINT
+#include <numeric>
+#include <utility>
+#include <vector>
+
+#include "absl/types/span.h"  // from @com_google_absl
+
+namespace litert::lm {
+namespace {
+
+std::mutex& ObserverMutex() {
+  static std::mutex* mu = new std::mutex();
+  return *mu;
+}
+
+DecodeStepObserver& Observer() {
+  static DecodeStepObserver* observer = new DecodeStepObserver();
+  return *observer;
+}
+
+int& TopK() {
+  static int top_k = 0;
+  return top_k;
+}
+
+}  // namespace
+
+void SetDecodeStepObserver(DecodeStepObserver observer, int top_k) {
+  std::lock_guard<std::mutex> lock(ObserverMutex());
+  Observer() = std::move(observer);
+  TopK() = std::max(0, top_k);
+}
+
+bool HasDecodeStepObserver() {
+  std::lock_guard<std::mutex> lock(ObserverMutex());
+  return static_cast<bool>(Observer());
+}
+
+int DecodeStepObserverTopK() {
+  std::lock_guard<std::mutex> lock(ObserverMutex());
+  return TopK();
+}
+
+void NotifyDecodeStep(const DecodeStepLogprobs& step) {
+  DecodeStepObserver observer;
+  {
+    std::lock_guard<std::mutex> lock(ObserverMutex());
+    observer = Observer();
+  }
+  if (observer) observer(step);
+}
+
+DecodeStepLogprobs ComputeDecodeStepLogprobs(absl::Span<const float> logits,
+                                             int chosen_id, int top_k) {
+  DecodeStepLogprobs out;
+  out.chosen.token_id = chosen_id;
+  const int vocab = static_cast<int>(logits.size());
+  if (vocab == 0) return out;
+  float max_logit = -std::numeric_limits<float>::infinity();
+  for (float v : logits) {
+    if (v > max_logit) max_logit = v;
+  }
+  double sum = 0.0;
+  for (float v : logits) {
+    if (std::isfinite(v)) sum += std::exp(static_cast<double>(v - max_logit));
+  }
+  const double log_z = static_cast<double>(max_logit) + std::log(sum);
+  auto log_prob = [&](int id) {
+    return static_cast<float>(
+        std::min(0.0, static_cast<double>(logits[id]) - log_z));
+  };
+  if (chosen_id >= 0 && chosen_id < vocab) {
+    out.chosen.log_probability = log_prob(chosen_id);
+  } else {
+    out.chosen.log_probability = -std::numeric_limits<float>::infinity();
+  }
+  const int k = std::min(top_k, vocab);
+  if (k <= 0) return out;
+  std::vector<int> ids(vocab);
+  std::iota(ids.begin(), ids.end(), 0);
+  auto higher = [&](int a, int b) {
+    return logits[a] > logits[b] || (logits[a] == logits[b] && a < b);
+  };
+  std::partial_sort(ids.begin(), ids.begin() + k, ids.end(), higher);
+  out.top.reserve(k);
+  for (int i = 0; i < k; ++i) {
+    out.top.push_back({ids[i], log_prob(ids[i])});
+  }
+  return out;
+}
+
+}  // namespace litert::lm
