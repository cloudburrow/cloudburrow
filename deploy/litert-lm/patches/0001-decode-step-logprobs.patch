+#ifndef THIRD_PARTY_ODML_LITERT_LM_RUNTIME_CORE_DECODE_STEP_OBSERVER_H_
+#define THIRD_PARTY_ODML_LITERT_LM_RUNTIME_CORE_DECODE_STEP_OBSERVER_H_
+
+#include <functional>
+#include <vector>
+
+#include "absl/types/span.h"  // from @com_google_absl
+
+namespace litert::lm {
+
+// One token and its log-probability under the model's distribution at a
+// decode step: the log-softmax of the step's logits as the model produced
+// them, before any decoding constraint, temperature, top-k or top-p.
+struct TokenLogprob {
+  int token_id = 0;
+  float log_probability = 0.0f;
+};
+
+// What an observer learns about one decode step of one output candidate.
+struct DecodeStepLogprobs {
+  int candidate = 0;
+  // The token the sampler chose, with its log-probability.
+  TokenLogprob chosen;
+  // The `top_k` most probable tokens, most probable first.
+  std::vector<TokenLogprob> top;
+};
+
+using DecodeStepObserver = std::function<void(const DecodeStepLogprobs&)>;
+
+// Installs `observer` for every later decode step that samples outside the
+// executor (SessionConfig::SetUseExternalSampler), in every session of this
+// process, with the `top_k` (>= 0) most probable tokens of each step. An
+// empty observer removes it. The observer runs on the decode thread.
+void SetDecodeStepObserver(DecodeStepObserver observer, int top_k);
+
+// Whether an observer is installed, and its top-k.
+bool HasDecodeStepObserver();
+int DecodeStepObserverTopK();
+
+// Calls the installed observer, if any, with `step`.
+void NotifyDecodeStep(const DecodeStepLogprobs& step);
+
+// The log-softmax of `logits` (one candidate's row) at `chosen_id`, and its
+// `top_k` most probable tokens.
+DecodeStepLogprobs ComputeDecodeStepLogprobs(absl::Span<const float> logits,
+                                             int chosen_id, int top_k);
+
+}  // namespace litert::lm
+
+#endif  // THIRD_PARTY_ODML_LITERT_LM_RUNTIME_CORE_DECODE_STEP_OBSERVER_H_
